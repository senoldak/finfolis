{
  // Cloudflare ayarı: site yalnızca statik dosyalar olarak yayınlanır (ücretsiz); Worker kodu yoktur.
  "name": "finfolis",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "finfolis.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
