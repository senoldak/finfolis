---
// TÜFE'den Arındırılmış BİST 30 İnteraktif Eğrisi (finfolis Kimlik v2).
// Pure SVG + External JS: CSP 'self' uyumlu (sıfır inline style ve sıfır inline script).
interface Nokta {
  tarih: string;
  yil: number;
  ay: number;
  bistKapanis: number;
  tufeCarpani: number;
  reelEndeks: number;
}

interface Donem {
  id: string;
  no: number;
  ad: string;
  ozet: string;
  aralik: string;
  bant: string;
  sinirlar: [string, string];
}

interface Props {
  noktalar: Nokta[];
  donemler: Donem[];
  zirve: { tarih: string; reelEndeks: number };
  dip: { tarih: string; reelEndeks: number };
}

const { noktalar = [], donemler = [], zirve, dip } = Astro.props;
const son = noktalar.at(-1);
---

<div class="reel-interaktif-kapsayici" id="reelGrafikKapsayici">
  <!-- Üst Kontrol Barı -->
  <div class="grafik-kontrol-bar">
    <div class="kontrol-baslik-blok">
      <span class="grafik-kategori-etiket">İNTERAKTİF ANALİZ · REEL GETİRİ</span>
      <h2 class="grafik-ana-baslik">TÜFE’den Temizlenmiş BİST 30</h2>
      <p class="grafik-alt-aciklama">Borsa İstanbul'un resmi enflasyona göre satın alma gücü seyri</p>
    </div>

    <div class="kontrol-gruplari">
      <!-- Görünüm Modu (Reel vs Karşılaştırma) -->
      <div class="filtre-kumesi" role="group" aria-label="Gösterim modu">
        <button type="button" class="filtre-btn aktif" id="btnModReel" data-mod="reel">
          Yalnız Reel
        </button>
        <button type="button" class="filtre-btn" id="btnModKiyas" data-mod="kiyas">
          Nominal vs Reel
        </button>
      </div>

      <!-- Zaman Aralığı Seçicisi -->
      <div class="filtre-kumesi" role="group" aria-label="Zaman aralığı">
        <button type="button" class="filtre-btn" data-aralik="12">1 Yıl</button>
        <button type="button" class="filtre-btn" data-aralik="36">3 Yıl</button>
        <button type="button" class="filtre-btn" data-aralik="60">5 Yıl</button>
        <button type="button" class="filtre-btn aktif" data-aralik="tum">Tümü (12Y)</button>
      </div>
    </div>
  </div>

  <!-- Lejant ve Canlı Metrik Göstergesi -->
  <div class="canli-lejant-bar">
    <div class="lejant-kalemleri">
      <div class="lejant-oge" id="lejantReel">
        <span class="cizgi-ornek reel"></span>
        <span class="lejant-ad">Reel BİST 30:</span>
        <strong class="lejant-deger" id="lejantReelDeger">{son?.reelEndeks.toFixed(1)} puan</strong>
      </div>
      <div class="lejant-oge gizli" id="lejantNominal">
        <span class="cizgi-ornek nominal"></span>
        <span class="lejant-ad">Nominal BİST:</span>
        <strong class="lejant-deger" id="lejantNominalDeger">-</strong>
      </div>
      <div class="lejant-oge">
        <span class="cizgi-ornek baz"></span>
        <span class="lejant-ad">100 Eşiği (Eylül 2014)</span>
      </div>
    </div>

    <!-- Hızlı Alım Gücü Simülatörü Özet Kutusu -->
    <div class="simulasyon-kutusu" id="simulasyonKutusu">
      <span class="sim-etiket">10.000 TL Satın Alma Gücü:</span>
      <strong class="sim-deger" id="simDeger">₺7.900</strong>
      <span class="sim-not" id="simNot">(Eylül 2014'teki 10.000 TL'nin bugünkü reel karşılığı)</span>
    </div>
  </div>

  <!-- Dinamik Pure SVG Çizim Alanı -->
  <div class="svg-cizim-alani" id="svgCizimAlani">
    <svg
      id="reelSvg"
      viewBox="0 0 880 430"
      class="reel-canli-svg"
      role="img"
      aria-label="TÜFE'den arındırılmış interaktif BİST 30 grafiği"
      preserveAspectRatio="xMidYMid meet"
    >
      <!-- Dinamik Izgara ve Eksenler -->
      <g id="izgaraGrubu"></g>
      <line id="tabanCizgisi" x1="50" y1="385" x2="855" y2="385" class="svg-taban-cizgi" />
      <line id="bazCizgisi" x1="50" y1="0" x2="855" y2="0" class="svg-baz-cizgi" />
      <text id="bazCizgisiMetin" x="850" y="0" text-anchor="end" class="svg-baz-yazi">100 BAZ EŞİĞİ</text>
      <g id="xEtiketGrubu"></g>

      <!-- Eğriler -->
      <path id="nominalYol" fill="none" class="svg-nominal-yol" display="none" />
      <path id="reelYol" fill="none" class="svg-reel-yol" />

      <!-- Zirve ve Dip Pinleri -->
      <g id="ekstremGrubu"></g>

      <!-- İmleç Takip Çizgisi ve Noktaları -->
      <g id="imlecGrubu" display="none">
        <line id="imlecCizgi" x1="0" y1="25" x2="0" y2="385" class="svg-imlec-cizgi" />
        <circle id="imlecReelNokta" cx="0" cy="0" r="5" class="svg-imlec-reel" />
        <circle id="imlecNominalNokta" cx="0" cy="0" r="4" class="svg-imlec-nominal" display="none" />
      </g>

      <!-- CSP Uyumlu Pure SVG Tooltip (Sıfır HTML inline-style) -->
      <g id="canliTooltip" display="none" class="svg-canli-tooltip">
        <rect id="ttBg" x="0" y="0" width="186" height="94" class="svg-tt-bg" />
        <line x1="8" y1="23" x2="178" y2="23" class="svg-tt-ayrac" />
        <text id="ttTarih" x="10" y="16" class="svg-tt-tarih">Eylül 2023</text>
        <text x="10" y="39" class="svg-tt-etiket">Reel Endeks:</text>
        <text id="ttReel" x="176" y="39" text-anchor="end" class="svg-tt-deger ana">114.2 puan</text>
        <text x="10" y="55" class="svg-tt-etiket">Nominal BİST:</text>
        <text id="ttNominal" x="176" y="55" text-anchor="end" class="svg-tt-deger">7.836 TL</text>
        <text x="10" y="70" class="svg-tt-etiket">TÜFE Artışı:</text>
        <text id="ttTufe" x="176" y="70" text-anchor="end" class="svg-tt-deger">6.94 kat</text>
        <line x1="8" y1="76" x2="178" y2="76" class="svg-tt-ayrac kesik" />
        <text x="10" y="87" class="svg-tt-etiket">10.000 TL:</text>
        <text id="ttSim" x="176" y="87" text-anchor="end" class="svg-tt-deger vurgu">₺11.420</text>
      </g>

      <!-- Görünmez Etkileşim Yüzeyi -->
      <rect
        id="etkilesimYuzeyi"
        x="50"
        y="25"
        width="805"
        height="360"
        fill="transparent"
        class="svg-etkilesim-alani"
      />
    </svg>
  </div>

  <!-- Tıklanabilir Rejim Kartları (Dönem Odaklanması) -->
  <div class="rejim-bolumu-baslik">
    <span class="rejim-baslik-etiket">TARİHSEL PİYASA REJİMLERİ</span>
    <span class="rejim-ipucu">Grafikte o döneme odaklanmak için tıklayın</span>
    <button type="button" class="rejim-sifirla-btn gizli" id="btnRejimSifirla">Odaklanmayı Kaldır ✕</button>
  </div>

  <div class="rejimler-izgara">
    {
      donemler.map((d) => (
        <button
          type="button"
          class="rejim-karti-btn"
          data-rejim-id={d.id}
        >
          <div class="rejim-ust">
            <span class="rejim-no">{d.no}</span>
            <span class="rejim-aralik">{d.aralik}</span>
          </div>
          <h3 class="rejim-baslik">{d.ad}</h3>
          <p class="rejim-ozet">{d.ozet}</p>
          <div class="rejim-bant">
            <span>Reel Bant:</span>
            <strong>{d.bant}</strong>
          </div>
        </button>
      ))
    }
  </div>

  <!-- CSP Uyumlu Veri ve Harici Betik -->
  <script type="application/json" id="reelBistVeriJson" set:html={JSON.stringify({ noktalar, donemler, zirve, dip })} />
  <script is:inline src="/reel-bist-grafik.js" defer></script>
</div>

<style>
  .gizli {
    display: none !important;
  }

  .reel-interaktif-kapsayici {
    background: var(--paper);
    border: 1px solid var(--hair);
    padding: 24px;
    margin: 28px 0;
  }

  /* Üst Kontrol Barı */
  .grafik-kontrol-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 16px;
  }

  .grafik-kategori-etiket {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--toprak-text);
  }

  .grafik-ana-baslik {
    margin: 3px 0 2px;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .grafik-alt-aciklama {
    margin: 0;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .kontrol-gruplari {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .filtre-kumesi {
    display: inline-flex;
    background: var(--paper-2);
    border: 1px solid var(--hair);
    padding: 2px;
  }

  .filtre-btn {
    border: none;
    background: transparent;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-2);
    padding: 5px 11px;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .filtre-btn:hover {
    color: var(--ink);
  }

  .filtre-btn.aktif {
    background: var(--ink);
    color: var(--paper);
  }

  /* Lejant ve Simülatör Barı */
  .canli-lejant-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 16px;
    font-size: 0.82rem;
  }

  .lejant-kalemleri {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .lejant-oge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .cizgi-ornek {
    display: inline-block;
    width: 14px;
    height: 2px;
  }

  .cizgi-ornek.reel {
    background: var(--ink);
    height: 3px;
  }

  .cizgi-ornek.nominal {
    border-top: 2px dashed var(--muted);
    height: 0;
  }

  .cizgi-ornek.baz {
    border-top: 2px dashed var(--toprak);
    height: 0;
  }

  .lejant-deger {
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* Simülatör Kutucuğu */
  .simulasyon-kutusu {
    display: flex;
    align-items: baseline;
    gap: 6px;
    background: var(--paper-2);
    border: 1px solid var(--hair);
    padding: 4px 10px;
    font-size: 0.78rem;
  }

  .sim-etiket {
    color: var(--muted);
  }

  .sim-deger {
    font-family: var(--sans);
    font-weight: 700;
    color: var(--toprak-text);
    font-variant-numeric: tabular-nums;
    font-size: 0.9rem;
  }

  .sim-not {
    font-size: 0.7rem;
    color: var(--muted);
  }

  /* SVG Çizim Alanı */
  .svg-cizim-alani {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .reel-canli-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .svg-kilavuz-cizgi {
    stroke: var(--hair, #cfccc2);
    stroke-width: 1;
  }

  .svg-taban-cizgi {
    stroke: var(--hair, #cfccc2);
    stroke-width: 1;
  }

  .svg-baz-cizgi {
    stroke: var(--toprak, #c2502b);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }

  .svg-eksen-yazi {
    font-family: var(--sans);
    font-size: 11px;
    fill: var(--muted, #5d5b55);
    font-variant-numeric: tabular-nums;
  }

  .svg-baz-yazi {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 700;
    fill: var(--toprak-text, #a8431f);
    letter-spacing: 0.05em;
  }

  .svg-pin-daire {
    fill: var(--paper, #f4f3ee);
    stroke: var(--ink, #1b1b1b);
    stroke-width: 1.5;
  }

  .svg-pin-yazi {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    fill: var(--ink-2, #3d3c38);
    font-variant-numeric: tabular-nums;
  }

  .svg-nominal-yol {
    stroke: var(--muted, #5d5b55);
    stroke-width: 1.75;
    stroke-dasharray: 3 3;
    opacity: 0.8;
  }

  .svg-reel-yol {
    stroke: var(--ink, #1b1b1b);
    stroke-width: 2.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .svg-imlec-cizgi {
    stroke: var(--ink-2, #3d3c38);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }

  .svg-imlec-reel {
    fill: var(--paper, #f4f3ee);
    stroke: var(--toprak, #c2502b);
    stroke-width: 2.5;
  }

  .svg-imlec-nominal {
    fill: var(--paper, #f4f3ee);
    stroke: var(--muted, #5d5b55);
    stroke-width: 2;
  }

  .svg-etkilesim-alani {
    cursor: crosshair;
  }

  /* SVG Tooltip Stilleri (CSP Safe: HTML Değil, SVG İçi) */
  .svg-tt-bg {
    fill: #e9e7df;
    stroke: #1b1b1b;
    stroke-width: 1;
  }

  .svg-tt-ayrac {
    stroke: #cfccc2;
    stroke-width: 1;
  }

  .svg-tt-ayrac.kesik {
    stroke-dasharray: 2 2;
  }

  .svg-tt-tarih {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    fill: #a8431f;
  }

  .svg-tt-etiket {
    font-family: var(--sans);
    font-size: 10px;
    fill: #5d5b55;
  }

  .svg-tt-deger {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    fill: #1b1b1b;
    font-variant-numeric: tabular-nums;
  }

  .svg-tt-deger.ana {
    font-size: 11px;
    font-weight: 700;
  }

  .svg-tt-deger.vurgu {
    font-size: 11px;
    font-weight: 700;
    fill: #a8431f;
  }

  /* Rejim Butonları Paneli */
  .rejim-bolumu-baslik {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--hair);
    flex-wrap: wrap;
  }

  .rejim-baslik-etiket {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rejim-ipucu {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .rejim-sifirla-btn {
    border: none;
    background: transparent;
    color: var(--toprak-text);
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: underline;
    margin-left: auto;
  }

  .rejimler-izgara {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 12px;
  }

  .rejim-karti-btn {
    background: var(--paper-2);
    border: 1px solid var(--hair);
    border-left: 3px solid var(--hair);
    padding: 12px 14px;
    text-align: left;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.15s ease;
  }

  .rejim-karti-btn:hover {
    border-color: var(--ink);
    border-left-color: var(--toprak);
    background: #ffffff;
  }

  .rejim-karti-btn.secili {
    border-color: var(--toprak);
    border-left-color: var(--toprak);
    background: #ffffff;
    outline: 2px solid var(--toprak);
  }

  .rejim-ust {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .rejim-no {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--toprak-text);
  }

  .rejim-aralik {
    font-size: 0.74rem;
    color: var(--muted);
  }

  .rejim-baslik {
    margin: 0 0 4px;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
  }

  .rejim-ozet {
    margin: 0 0 8px;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .rejim-bant {
    font-size: 0.74rem;
    color: var(--muted);
  }

  .rejim-bant strong {
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 820px) {
    .rejimler-izgara {
      grid-template-columns: repeat(2, 1fr);
    }
    .canli-lejant-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 540px) {
    .rejimler-izgara {
      grid-template-columns: 1fr;
    }
    .kontrol-gruplari {
      width: 100%;
    }
    .filtre-kumesi {
      width: 100%;
      justify-content: space-between;
    }
    .filtre-btn {
      flex: 1;
      text-align: center;
      padding: 6px 4px;
    }
  }
</style>
