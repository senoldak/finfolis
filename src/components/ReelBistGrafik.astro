---
// TÜFE'den Temizlenmiş BİST 30 Reel Getiri Grafiği (DESIGN.md uyumlu pure SVG).
// Harici bağımlılık veya CDN gerektirmez, Cloudflare CSP 'self' uyumludur.
interface Nokta {
  tarih: string;
  yil: number;
  ay: number;
  bistKapanis: number;
  tufeCarpani: number;
  reelEndeks: number;
}

interface Donem {
  id: string;
  ad: string;
  aralik: string;
  bant: string;
  renk: string;
  sinirlar: [string, string];
}

interface Props {
  noktalar: Nokta[];
  donemler: Donem[];
}

const { noktalar = [], donemler = [] } = Astro.props;

const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const ayYilMetni = (tarih: string) => {
  const [y, m] = tarih.split('-').map(Number);
  return `${AYLAR[m - 1]} ${y}`;
};

// Grafik Boyutları
const W = 880;
const H = 440;
const PAD = { top: 35, right: 35, bottom: 50, left: 55 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const yMin = 50;
const yMax = 170;
const yRange = yMax - yMin;

const xCoord = (index: number) => {
  if (noktalar.length <= 1) return PAD.left;
  return PAD.left + (index / (noktalar.length - 1)) * plotW;
};

const yCoord = (val: number) => {
  const clamped = Math.max(yMin, Math.min(yMax, val));
  return PAD.top + (1 - (clamped - yMin) / yRange) * plotH;
};

// Ana Çizgi Yolu (Line Path)
const linePath = noktalar
  .map((p, i) => `${i === 0 ? 'M' : 'L'} ${xCoord(i).toFixed(1)} ${yCoord(p.reelEndeks).toFixed(1)}`)
  .join(' ');

// Y Eksen Kılavuz Çizgileri
const yTicks = [60, 80, 100, 120, 140, 160];

// X Eksen Yıl Etiketleri (Her Eylül ayı veya 2 yılda bir)
const xTicks = noktalar
  .map((p, i) => ({ p, i }))
  .filter(({ p }) => p.ay === 9 && p.yil % 2 === 0);

// Rejim Bölgeleri (Arka Plan Dikdörtgenleri)
const donemKutulari = donemler.map((d) => {
  const i1 = Math.max(0, noktalar.findIndex((p) => p.tarih >= d.sinirlar[0]));
  let i2 = noktalar.findIndex((p) => p.tarih > d.sinirlar[1]);
  if (i2 === -1) i2 = noktalar.length - 1;
  const x1 = xCoord(i1);
  const x2 = xCoord(i2);
  return {
    ...d,
    x: x1,
    width: Math.max(10, x2 - x1),
  };
});

const son = noktalar.at(-1);
---

<div class="reel-grafik-kapsayici">
  <div class="grafik-ust-bilgi">
    <div class="grafik-baslik-grup">
      <span class="grafik-etiket-kucuk">ENDEKS · REEL GETİRİ</span>
      <h2 class="grafik-ana-baslik">TÜFE’den Temizlenmiş BİST 30 Endeksi</h2>
    </div>
    <div class="grafik-lejant-cubuk">
      <div class="lejant-oge"><span class="lejant-renk cizgi-renk"></span> BİST 30 (Reel)</div>
      <div class="lejant-oge"><span class="lejant-renk baz-cizgi"></span> 100 Baz (Eylül 2014)</div>
    </div>
  </div>

  <div class="svg-sarici" id="reel-grafik-alani">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      class="reel-svg"
      role="img"
      aria-label="TÜFE'den arındırılmış BİST 30 endeksi grafiği (2014-2026)"
      focusable="false"
    >
      <defs>
        <pattern id="grid-dots" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1" fill="var(--hair)" />
        </pattern>
      </defs>

      <!-- Rejim / Bölge Dikdörtgenleri (Referans görseldeki 4 ana dönem) -->
      {
        donemKutulari.map((d) => (
          <g class="donem-grup">
            <rect
              x={d.x}
              y={PAD.top}
              width={d.width}
              height={plotH}
              fill={d.renk}
              rx="4"
              opacity="0.85"
            />
            <text
              x={d.x + d.width / 2}
              y={PAD.top + 16}
              text-anchor="middle"
              class="donem-metin"
            >
              {d.ad}
            </text>
          </g>
        ))
      }

      <!-- Y Eksen Çizgileri ve Değerleri -->
      {
        yTicks.map((val) => (
          <g class="y-eksen-cizgi">
            <line
              x1={PAD.left}
              y1={yCoord(val)}
              x2={W - PAD.right}
              y2={yCoord(val)}
              stroke={val === 100 ? 'var(--toprak)' : 'var(--hair)'}
              stroke-width={val === 100 ? '1.5' : '1'}
              stroke-dasharray={val === 100 ? '4 3' : 'none'}
            />
            <text
              x={PAD.left - 10}
              y={yCoord(val) + 4}
              text-anchor="end"
              class={val === 100 ? 'eksen-yazi baz-yazi' : 'eksen-yazi'}
            >
              {val}
            </text>
          </g>
        ))
      }

      <!-- 100 Baz Gösterge Etiketi -->
      <text
        x={W - PAD.right}
        y={yCoord(100) - 6}
        text-anchor="end"
        class="baz-etiket-metin"
      >
        Eylül 2014 = 100
      </text>

      <!-- X Eksen Yıl Etiketleri -->
      {
        xTicks.map(({ p, i }) => (
          <g class="x-eksen-etiket">
            <line
              x1={xCoord(i)}
              y1={H - PAD.bottom}
              x2={xCoord(i)}
              y2={H - PAD.bottom + 6}
              stroke="var(--hair)"
              stroke-width="1"
            />
            <text
              x={xCoord(i)}
              y={H - PAD.bottom + 20}
              text-anchor="middle"
              class="eksen-yazi"
            >
              01/09/{p.yil}
            </text>
          </g>
        ))
      }

      <!-- Ana Eğri (Reel BİST 30) -->
      <path
        d={linePath}
        fill="none"
        stroke="var(--ink)"
        stroke-width="2.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="ana-cizgi"
      />

      <!-- İnteraktif Takip Çizgisi ve Noktası (JS ile kontrol edilir) -->
      <g id="takip-grup" style="display: none;">
        <line
          id="takip-cizgi"
          x1="0"
          y1={PAD.top}
          x2="0"
          y2={H - PAD.bottom}
          stroke="var(--ink)"
          stroke-width="1"
          stroke-dasharray="3 3"
        />
        <circle id="takip-halka" cx="0" cy="0" r="6" fill="var(--paper)" stroke="var(--toprak)" stroke-width="2.5" />
      </g>

      <!-- Görünmez Etkileşim Katmanı -->
      <rect
        id="etkilesim-alani"
        x={PAD.left}
        y={PAD.top}
        width={plotW}
        height={plotH}
        fill="transparent"
        style="cursor: crosshair;"
      />
    </svg>

    <!-- Bilgi Kartı (Tooltip) -->
    <div id="grafik-tooltip" class="grafik-ipucu" style="display: none;">
      <div class="ipucu-tarih" id="ipucu-tarih"></div>
      <div class="ipucu-satir">
        <span class="ipucu-etiket">Reel Endeks:</span>
        <strong class="ipucu-deger" id="ipucu-reel"></strong>
      </div>
      <div class="ipucu-satir">
        <span class="ipucu-etiket">BİST 30 Kapanış:</span>
        <span class="ipucu-deger" id="ipucu-nominal"></span>
      </div>
      <div class="ipucu-satir">
        <span class="ipucu-etiket">TÜFE Çarpanı:</span>
        <span class="ipucu-deger" id="ipucu-tufe"></span>
      </div>
    </div>
  </div>

  <div class="grafik-alt-not">
    <span>İpucu: Grafik üzerinde gezinerek aylık nominal kapanış ve enflasyon çarpanını inceleyebilirsiniz.</span>
  </div>
</div>

<script is:inline define:vars={{ noktalar, PAD, W, H, yMin, yMax }}>
  (function () {
    const alani = document.getElementById('reel-grafik-alani');
    const etkilesim = document.getElementById('etkilesim-alani');
    const takipGrup = document.getElementById('takip-grup');
    const takipCizgi = document.getElementById('takip-cizgi');
    const takipHalka = document.getElementById('takip-halka');
    const tooltip = document.getElementById('grafik-tooltip');
    const ipucuTarih = document.getElementById('ipucu-tarih');
    const ipucuReel = document.getElementById('ipucu-reel');
    const ipucuNominal = document.getElementById('ipucu-nominal');
    const ipucuTufe = document.getElementById('ipucu-tufe');

    if (!alani || !etkilesim || !noktalar || noktalar.length === 0) return;

    const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
    const plotW = W - PAD.left - PAD.right;
    const plotH = H - PAD.top - PAD.bottom;
    const yRange = yMax - yMin;

    function guncelle(clientX, clientY) {
      const rect = etkilesim.getBoundingClientRect();
      const relX = clientX - rect.left;
      if (relX < 0 || relX > rect.width) {
        gizle();
        return;
      }

      const oran = relX / rect.width;
      const index = Math.round(oran * (noktalar.length - 1));
      const p = noktalar[Math.max(0, Math.min(noktalar.length - 1, index))];
      if (!p) return;

      const svgX = PAD.left + (index / (noktalar.length - 1)) * plotW;
      const clampedVal = Math.max(yMin, Math.min(yMax, p.reelEndeks));
      const svgY = PAD.top + (1 - (clampedVal - yMin) / yRange) * plotH;

      takipGrup.style.display = 'block';
      takipCizgi.setAttribute('x1', svgX);
      takipCizgi.setAttribute('x2', svgX);
      takipHalka.setAttribute('cx', svgX);
      takipHalka.setAttribute('cy', svgY);

      ipucuTarih.textContent = `${AYLAR[p.ay - 1]} ${p.yil}`;
      ipucuReel.textContent = p.reelEndeks.toFixed(1);
      ipucuNominal.textContent = p.bistKapanis.toLocaleString('tr-TR') + ' TL';
      ipucuTufe.textContent = p.tufeCarpani.toFixed(2) + 'x';

      tooltip.style.display = 'block';

      // Tooltip konumu
      const konteynerRect = alani.getBoundingClientRect();
      const ekranX = clientX - konteynerRect.left;
      const tooltipW = tooltip.offsetWidth || 180;

      let sol = ekranX + 16;
      if (sol + tooltipW > konteynerRect.width - 10) {
        sol = ekranX - tooltipW - 16;
      }
      tooltip.style.left = Math.max(8, sol) + 'px';
      tooltip.style.top = Math.max(8, clientY - konteynerRect.top - 20) + 'px';
    }

    function gizle() {
      takipGrup.style.display = 'none';
      tooltip.style.display = 'none';
    }

    etkilesim.addEventListener('mousemove', (e) => guncelle(e.clientX, e.clientY));
    etkilesim.addEventListener('mouseleave', gizle);

    etkilesim.addEventListener('touchmove', (e) => {
      if (e.touches && e.touches[0]) {
        guncelle(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });
    etkilesim.addEventListener('touchend', gizle);
  })();
</script>

<style>
  .reel-grafik-kapsayici {
    background: var(--paper);
    border: 1px solid var(--hair);
    padding: 24px 28px;
    margin: 28px 0;
  }

  .grafik-ust-bilgi {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 16px;
  }

  .grafik-etiket-kucuk {
    display: block;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--toprak-text);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .grafik-ana-baslik {
    margin: 4px 0 0;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .grafik-lejant-cubuk {
    display: flex;
    gap: 20px;
    font-size: 0.85rem;
    color: var(--ink-2);
  }

  .lejant-oge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .lejant-renk {
    display: inline-block;
    width: 14px;
    height: 3px;
  }

  .cizgi-renk {
    background: var(--ink);
    height: 3px;
  }

  .baz-cizgi {
    border-top: 2px dashed var(--toprak);
    height: 0;
  }

  .svg-sarici {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .reel-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .donem-metin {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
    fill: var(--ink-2);
    opacity: 0.8;
  }

  .eksen-yazi {
    font-family: var(--sans);
    font-size: 11px;
    fill: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .baz-yazi {
    fill: var(--toprak-text);
    font-weight: 700;
  }

  .baz-etiket-metin {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 700;
    fill: var(--toprak-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ana-cizgi {
    vector-effect: non-scaling-stroke;
  }

  .grafik-ipucu {
    position: absolute;
    pointer-events: none;
    background: #ffffff;
    color: var(--ink);
    border: 1px solid var(--ink);
    padding: 10px 14px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    font-family: var(--sans);
    z-index: 10;
    min-width: 175px;
  }

  .ipucu-tarih {
    font-weight: 700;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 4px;
    margin-bottom: 6px;
    color: var(--toprak-text);
  }

  .ipucu-satir {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.8rem;
    line-height: 1.45;
  }

  .ipucu-etiket {
    color: var(--muted);
  }

  .ipucu-deger {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .grafik-alt-not {
    margin-top: 14px;
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .reel-grafik-kapsayici {
      padding: 16px 14px;
    }
    .grafik-ana-baslik {
      font-size: 1.15rem;
    }
    .donem-metin {
      display: none;
    }
  }
</style>
