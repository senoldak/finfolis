---
// TÜFE'den Arındırılmış BİST 30 Reel Getiri Grafiği (finfolis Kimlik v2: Kâğıt & Mürekkep, tek vurgu pişmiş toprak).
// Harici kütüphane veya CDN içermez; Cloudflare CSP 'self' uyumludur.
interface Nokta {
  tarih: string;
  yil: number;
  ay: number;
  bistKapanis: number;
  tufeCarpani: number;
  reelEndeks: number;
}

interface Donem {
  id: string;
  no: number;
  ad: string;
  ozet: string;
  aralik: string;
  bant: string;
  sinirlar: [string, string];
}

interface Props {
  noktalar: Nokta[];
  donemler: Donem[];
  zirve: { tarih: string; reelEndeks: number };
  dip: { tarih: string; reelEndeks: number };
}

const { noktalar = [], donemler = [], zirve, dip } = Astro.props;

// Grafik Boyutları
const W = 880;
const H = 400;
const PAD = { top: 30, right: 35, bottom: 45, left: 50 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const yMin = 50;
const yMax = 165;
const yRange = yMax - yMin;

const xCoord = (index: number) => {
  if (noktalar.length <= 1) return PAD.left;
  return PAD.left + (index / (noktalar.length - 1)) * plotW;
};

const yCoord = (val: number) => {
  const clamped = Math.max(yMin, Math.min(yMax, val));
  return PAD.top + (1 - (clamped - yMin) / yRange) * plotH;
};

// Çizgi Yolu
const linePath = noktalar
  .map((p, i) => `${i === 0 ? 'M' : 'L'} ${xCoord(i).toFixed(1)} ${yCoord(p.reelEndeks).toFixed(1)}`)
  .join(' ');

// Y Eksen Kılavuzları
const yTicks = [60, 80, 100, 120, 140, 160];

// X Eksen Etiketleri (Her 2 yılda bir Eylül)
const xTicks = noktalar
  .map((p, i) => ({ p, i }))
  .filter(({ p }) => p.ay === 9 && p.yil % 2 === 0);

// Dönem sınır çizgileri (Dikey kesik ayraçlar)
const bolgeAyraclari = donemler.slice(1).map((d) => {
  const idx = noktalar.findIndex((p) => p.tarih >= d.sinirlar[0]);
  return {
    x: idx !== -1 ? xCoord(idx) : 0,
    no: d.no,
    ad: d.ad,
  };
});

// Zirve ve Dip Koordinatları
const zirveIdx = noktalar.findIndex((p) => p.tarih === zirve?.tarih);
const dipIdx = noktalar.findIndex((p) => p.tarih === dip?.tarih);
const sonIdx = noktalar.length - 1;
const son = noktalar[sonIdx];
---

<div class="reel-grafik-kapsayici">
  <!-- Grafik Üst Başlık & Lejant -->
  <div class="grafik-ust-bilgi">
    <div>
      <span class="grafik-kategori">ENDEKS · REEL SATIN ALMA GÜCÜ</span>
      <h2 class="grafik-ana-baslik">TÜFE’den Temizlenmiş BİST 30</h2>
    </div>
    <div class="grafik-lejant">
      <div class="lejant-oge">
        <span class="lejant-cizgi ana"></span>
        <span>Reel Endeks Seyri</span>
      </div>
      <div class="lejant-oge">
        <span class="lejant-cizgi baz"></span>
        <span>100 Bazı (Eylül 2014)</span>
      </div>
    </div>
  </div>

  <!-- Pure SVG Grafik -->
  <div class="svg-sarici" id="reel-grafik-alani">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      class="reel-svg"
      role="img"
      aria-label="TÜFE'den arındırılmış BİST 30 endeksi grafiği"
      focusable="false"
    >
      <!-- Y Eksen Kılavuz Çizgileri -->
      {
        yTicks.map((val) => (
          <g class="y-eksen-cizgi">
            <line
              x1={PAD.left}
              y1={yCoord(val)}
              x2={W - PAD.right}
              y2={yCoord(val)}
              stroke={val === 100 ? 'var(--toprak)' : 'var(--hair)'}
              stroke-width={val === 100 ? '1.5' : '1'}
              stroke-dasharray={val === 100 ? '4 3' : 'none'}
            />
            <text
              x={PAD.left - 8}
              y={yCoord(val) + 4}
              text-anchor="end"
              class={val === 100 ? 'eksen-yazi baz-yazi' : 'eksen-yazi'}
            >
              {val}
            </text>
          </g>
        ))
      }

      <!-- 100 Baz Metni -->
      <text
        x={W - PAD.right}
        y={yCoord(100) - 6}
        text-anchor="end"
        class="baz-etiket-metin"
      >
        Eylül 2014 = 100 (Satın Alma Gücü Eşiği)
      </text>

      <!-- Dönem Ayrım Çizgileri (Sakin editoryal ayraçlar) -->
      {
        bolgeAyraclari.map((b) => (
          <g class="donem-ayrac">
            <line
              x1={b.x}
              y1={PAD.top}
              x2={b.x}
              y2={H - PAD.bottom}
              stroke="var(--boncuk)"
              stroke-width="1"
              stroke-dasharray="2 3"
            />
          </g>
        ))
      }

      <!-- X Eksen Yıl Etiketleri -->
      {
        xTicks.map(({ p, i }) => (
          <g class="x-eksen-etiket">
            <line
              x1={xCoord(i)}
              y1={H - PAD.bottom}
              x2={xCoord(i)}
              y2={H - PAD.bottom + 5}
              stroke="var(--hair)"
              stroke-width="1"
            />
            <text
              x={xCoord(i)}
              y={H - PAD.bottom + 18}
              text-anchor="middle"
              class="eksen-yazi"
            >
              {p.yil}
            </text>
          </g>
        ))
      }

      <!-- Ana Eğri (Mürekkep) -->
      <path
        d={linePath}
        fill="none"
        stroke="var(--ink)"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="ana-cizgi"
      />

      <!-- Zirve İşareti -->
      {
        zirveIdx !== -1 && (
          <g class="isaret-zirve">
            <circle
              cx={xCoord(zirveIdx)}
              cy={yCoord(zirve.reelEndeks)}
              r="3.5"
              fill="var(--paper)"
              stroke="var(--ink)"
              stroke-width="1.5"
            />
            <text
              x={xCoord(zirveIdx)}
              y={yCoord(zirve.reelEndeks) - 10}
              text-anchor="middle"
              class="isaret-metin"
            >
              Zirve: {zirve.reelEndeks}
            </text>
          </g>
        )
      }

      <!-- Dip İşareti -->
      {
        dipIdx !== -1 && (
          <g class="isaret-dip">
            <circle
              cx={xCoord(dipIdx)}
              cy={yCoord(dip.reelEndeks)}
              r="3.5"
              fill="var(--paper)"
              stroke="var(--ink)"
              stroke-width="1.5"
            />
            <text
              x={xCoord(dipIdx)}
              y={yCoord(dip.reelEndeks) + 15}
              text-anchor="middle"
              class="isaret-metin"
            >
              Dip: {dip.reelEndeks}
            </text>
          </g>
        )
      }

      <!-- Son Nokta (Pişmiş Toprak Boncuk) -->
      {
        son && (
          <circle
            cx={xCoord(sonIdx)}
            cy={yCoord(son.reelEndeks)}
            r="4.5"
            fill="var(--toprak)"
          />
        )
      }

      <!-- İnteraktif Takip Çizgisi -->
      <g id="takip-grup" style="display: none;">
        <line
          id="takip-cizgi"
          x1="0"
          y1={PAD.top}
          x2="0"
          y2={H - PAD.bottom}
          stroke="var(--ink-2)"
          stroke-width="1"
          stroke-dasharray="2 2"
        />
        <circle id="takip-halka" cx="0" cy="0" r="5" fill="var(--paper)" stroke="var(--toprak)" stroke-width="2" />
      </g>

      <!-- Görünmez Etkileşim Katmanı -->
      <rect
        id="etkilesim-alani"
        x={PAD.left}
        y={PAD.top}
        width={plotW}
        height={plotH}
        fill="transparent"
        style="cursor: crosshair;"
      />
    </svg>

    <!-- Bilgi Kartı (Tooltip - Tamamen finfolis stilinde: keskin kenar, gölgesiz, kâğıt zemin) -->
    <div id="grafik-tooltip" class="grafik-ipucu" style="display: none;">
      <div class="ipucu-baslik" id="ipucu-tarih"></div>
      <div class="ipucu-icerik">
        <div class="ipucu-oge">
          <span class="etiket">Reel Endeks</span>
          <span class="deger vurgu" id="ipucu-reel"></span>
        </div>
        <div class="ipucu-oge">
          <span class="etiket">BİST 30</span>
          <span class="deger" id="ipucu-nominal"></span>
        </div>
        <div class="ipucu-oge">
          <span class="etiket">TÜFE Artışı</span>
          <span class="deger" id="ipucu-tufe"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Rejimler Paneli (finfolis Editoryal Tasarımı) -->
  <div class="rejimler-izgara">
    {
      donemler.map((d) => (
        <div class="rejim-karti">
          <div class="rejim-ust">
            <span class="rejim-no">{d.no}</span>
            <span class="rejim-aralik">{d.aralik}</span>
          </div>
          <h3 class="rejim-baslik">{d.ad}</h3>
          <p class="rejim-ozet">{d.ozet}</p>
          <div class="rejim-bant">
            <span>Reel Bant:</span>
            <strong>{d.bant}</strong>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script is:inline define:vars={{ noktalar, PAD, W, H, yMin, yMax }}>
  (function () {
    const alani = document.getElementById('reel-grafik-alani');
    const etkilesim = document.getElementById('etkilesim-alani');
    const takipGrup = document.getElementById('takip-grup');
    const takipCizgi = document.getElementById('takip-cizgi');
    const takipHalka = document.getElementById('takip-halka');
    const tooltip = document.getElementById('grafik-tooltip');
    const ipucuTarih = document.getElementById('ipucu-tarih');
    const ipucuReel = document.getElementById('ipucu-reel');
    const ipucuNominal = document.getElementById('ipucu-nominal');
    const ipucuTufe = document.getElementById('ipucu-tufe');

    if (!alani || !etkilesim || !noktalar || noktalar.length === 0) return;

    const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
    const plotW = W - PAD.left - PAD.right;
    const plotH = H - PAD.top - PAD.bottom;
    const yRange = yMax - yMin;

    function guncelle(clientX, clientY) {
      const rect = etkilesim.getBoundingClientRect();
      const relX = clientX - rect.left;
      if (relX < 0 || relX > rect.width) {
        gizle();
        return;
      }

      const oran = relX / rect.width;
      const index = Math.round(oran * (noktalar.length - 1));
      const p = noktalar[Math.max(0, Math.min(noktalar.length - 1, index))];
      if (!p) return;

      const svgX = PAD.left + (index / (noktalar.length - 1)) * plotW;
      const clampedVal = Math.max(yMin, Math.min(yMax, p.reelEndeks));
      const svgY = PAD.top + (1 - (clampedVal - yMin) / yRange) * plotH;

      takipGrup.style.display = 'block';
      takipCizgi.setAttribute('x1', svgX);
      takipCizgi.setAttribute('x2', svgX);
      takipHalka.setAttribute('cx', svgX);
      takipHalka.setAttribute('cy', svgY);

      ipucuTarih.textContent = `${AYLAR[p.ay - 1]} ${p.yil}`;
      ipucuReel.textContent = p.reelEndeks.toFixed(1) + ' puan';
      ipucuNominal.textContent = p.bistKapanis.toLocaleString('tr-TR') + ' TL';
      ipucuTufe.textContent = p.tufeCarpani.toFixed(2) + 'x';

      tooltip.style.display = 'block';

      const konteynerRect = alani.getBoundingClientRect();
      const ekranX = clientX - konteynerRect.left;
      const tooltipW = tooltip.offsetWidth || 190;

      let sol = ekranX + 16;
      if (sol + tooltipW > konteynerRect.width - 10) {
        sol = ekranX - tooltipW - 16;
      }
      tooltip.style.left = Math.max(6, sol) + 'px';
      tooltip.style.top = Math.max(6, clientY - konteynerRect.top - 20) + 'px';
    }

    function gizle() {
      takipGrup.style.display = 'none';
      tooltip.style.display = 'none';
    }

    etkilesim.addEventListener('mousemove', (e) => guncelle(e.clientX, e.clientY));
    etkilesim.addEventListener('mouseleave', gizle);

    etkilesim.addEventListener('touchmove', (e) => {
      if (e.touches && e.touches[0]) {
        guncelle(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });
    etkilesim.addEventListener('touchend', gizle);
  })();
</script>

<style>
  .reel-grafik-kapsayici {
    background: var(--paper);
    border: 1px solid var(--hair);
    padding: 24px;
    margin: 28px 0;
  }

  .grafik-ust-bilgi {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 14px;
  }

  .grafik-kategori {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--toprak-text);
  }

  .grafik-ana-baslik {
    margin: 4px 0 0;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .grafik-lejant {
    display: flex;
    gap: 20px;
    font-size: 0.82rem;
    color: var(--ink-2);
  }

  .lejant-oge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .lejant-cizgi {
    display: inline-block;
    width: 14px;
    height: 2px;
  }

  .lejant-cizgi.ana {
    background: var(--ink);
    height: 2.5px;
  }

  .lejant-cizgi.baz {
    border-top: 2px dashed var(--toprak);
    height: 0;
  }

  .svg-sarici {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .reel-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .eksen-yazi {
    font-family: var(--sans);
    font-size: 11px;
    fill: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .baz-yazi {
    fill: var(--toprak-text);
    font-weight: 700;
  }

  .baz-etiket-metin {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 700;
    fill: var(--toprak-text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .isaret-metin {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 600;
    fill: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .ana-cizgi {
    vector-effect: non-scaling-stroke;
  }

  /* finfolis kimliğine uygun tooltip: sıfır gölge, keskin köşeler, kâğıt zemin */
  .grafik-ipucu {
    position: absolute;
    pointer-events: none;
    background: var(--paper-2);
    border: 1px solid var(--ink);
    padding: 8px 12px;
    font-family: var(--sans);
    z-index: 10;
    min-width: 170px;
  }

  .ipucu-baslik {
    font-weight: 700;
    font-size: 0.82rem;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 3px;
    margin-bottom: 5px;
    color: var(--toprak-text);
  }

  .ipucu-icerik {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ipucu-oge {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    gap: 12px;
  }

  .ipucu-oge .etiket {
    color: var(--muted);
  }

  .ipucu-oge .deger {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .ipucu-oge .deger.vurgu {
    color: var(--ink);
    font-weight: 700;
  }

  /* 4 Kolonlu Editoryal Rejimler Izgarası */
  .rejimler-izgara {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 24px;
    border-top: 1px solid var(--hair);
    padding-top: 20px;
  }

  .rejim-karti {
    background: var(--paper-2);
    padding: 12px 14px;
    border-left: 2px solid var(--hair);
  }

  .rejim-karti:hover {
    border-left-color: var(--toprak);
  }

  .rejim-ust {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 4px;
  }

  .rejim-no {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--toprak-text);
  }

  .rejim-aralik {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .rejim-baslik {
    margin: 0 0 4px;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--ink);
  }

  .rejim-ozet {
    margin: 0 0 8px;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .rejim-bant {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .rejim-bant strong {
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .rejimler-izgara {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .rejimler-izgara {
      grid-template-columns: 1fr;
    }
  }
</style>
