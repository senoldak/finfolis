---
// TÜFE'den Arındırılmış BİST 30 İnteraktif Eğrisi (finfolis Kimlik v2).
// Pure SVG + Vanilla JS: Dinamik zaman aralığı (1Y, 3Y, 5Y, Tümü), Nominal vs Reel ikili karşılaştırma,
// tıklanabilir rejim odaklanması ve alım gücü simülatörü. Harici kütüphane içermez.
interface Nokta {
  tarih: string;
  yil: number;
  ay: number;
  bistKapanis: number;
  tufeCarpani: number;
  reelEndeks: number;
}

interface Donem {
  id: string;
  no: number;
  ad: string;
  ozet: string;
  aralik: string;
  bant: string;
  sinirlar: [string, string];
}

interface Props {
  noktalar: Nokta[];
  donemler: Donem[];
  zirve: { tarih: string; reelEndeks: number };
  dip: { tarih: string; reelEndeks: number };
}

const { noktalar = [], donemler = [], zirve, dip } = Astro.props;
const son = noktalar.at(-1);
---

<div class="reel-interaktif-kapsayici" id="reelGrafikKapsayici">
  <!-- Üst Kontrol Barı -->
  <div class="grafik-kontrol-bar">
    <div class="kontrol-baslik-blok">
      <span class="grafik-kategori-etiket">İNTERAKTİF ANALİZ · REEL GETİRİ</span>
      <h2 class="grafik-ana-baslik">TÜFE’den Temizlenmiş BİST 30</h2>
      <p class="grafik-alt-aciklama">Borsa İstanbul'un resmi enflasyona göre satın alma gücü seyri</p>
    </div>

    <div class="kontrol-gruplari">
      <!-- Görünüm Modu (Reel vs Karşılaştırma) -->
      <div class="filtre-kumesi" role="group" aria-label="Gösterim modu">
        <button type="button" class="filtre-btn aktif" id="btnModReel" data-mod="reel">
          Yalnız Reel
        </button>
        <button type="button" class="filtre-btn" id="btnModKiyas" data-mod="kiyas">
          Nominal vs Reel
        </button>
      </div>

      <!-- Zaman Aralığı Seçicisi -->
      <div class="filtre-kumesi" role="group" aria-label="Zaman aralığı">
        <button type="button" class="filtre-btn" data-aralik="12">1 Yıl</button>
        <button type="button" class="filtre-btn" data-aralik="36">3 Yıl</button>
        <button type="button" class="filtre-btn" data-aralik="60">5 Yıl</button>
        <button type="button" class="filtre-btn aktif" data-aralik="tum">Tümü (12Y)</button>
      </div>
    </div>
  </div>

  <!-- Lejant ve Canlı Metrik Göstergesi -->
  <div class="canli-lejant-bar">
    <div class="lejant-kalemleri">
      <div class="lejant-oge" id="lejantReel">
        <span class="cizgi-ornek reel"></span>
        <span class="lejant-ad">Reel BİST 30:</span>
        <strong class="lejant-deger" id="lejantReelDeger">{son?.reelEndeks.toFixed(1)} puan</strong>
      </div>
      <div class="lejant-oge" id="lejantNominal" style="display: none;">
        <span class="cizgi-ornek nominal"></span>
        <span class="lejant-ad">Nominal BİST (100 Bazlı):</span>
        <strong class="lejant-deger" id="lejantNominalDeger">-</strong>
      </div>
      <div class="lejant-oge">
        <span class="cizgi-ornek baz"></span>
        <span class="lejant-ad">100 Eşiği (Eylül 2014)</span>
      </div>
    </div>

    <!-- Hızlı Alım Gücü Simülatörü Özet Kutusu -->
    <div class="simulasyon-kutusu" id="simulasyonKutusu">
      <span class="sim-etiket">10.000 TL Satın Alma Gücü:</span>
      <strong class="sim-deger" id="simDeger">₺7.900</strong>
      <span class="sim-not" id="simNot">(Eylül 2014'teki 10.000 TL'nin bugünkü reel karşılığı)</span>
    </div>
  </div>

  <!-- Dinamik Pure SVG Çizim Alanı -->
  <div class="svg-cizim-alani" id="svgCizimAlani">
    <svg
      id="reelSvg"
      viewBox="0 0 880 430"
      class="reel-canli-svg"
      role="img"
      aria-label="TÜFE'den arındırılmış interaktif BİST 30 grafiği"
      preserveAspectRatio="xMidYMid meet"
    >
      <!-- Dönem / Rejim Vurgu Alanı (Tıklanınca aydınlanır) -->
      <rect id="rejimVurguKutusu" x="0" y="25" width="0" height="360" fill="var(--paper-2)" opacity="0" />

      <!-- Dinamik Izgara ve Eksenler -->
      <g id="izgaraGrubu"></g>
      <line id="tabanCizgisi" x1="50" y1="385" x2="855" y2="385" stroke="var(--hair)" stroke-width="1" />
      <line id="bazCizgisi" x1="50" y1="0" x2="855" y2="0" stroke="var(--toprak)" stroke-width="1.5" stroke-dasharray="4 3" />
      <text id="bazCizgisiMetin" x="850" y="0" text-anchor="end" class="svg-baz-yazi">100 BAZ EŞİĞİ</text>
      <g id="xEtiketGrubu"></g>

      <!-- Eğriler -->
      <path id="nominalYol" fill="none" stroke="var(--muted)" stroke-width="1.75" stroke-dasharray="3 3" opacity="0.8" style="display: none;" />
      <path id="reelYol" fill="none" stroke="var(--ink)" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" />

      <!-- Zirve ve Dip Pinleri -->
      <g id="ekstremGrubu"></g>

      <!-- İmleç Takip Çizgisi ve Noktaları -->
      <g id="imlecGrubu" style="display: none;">
        <line id="imlecCizgi" x1="0" y1="25" x2="0" y2="385" stroke="var(--ink-2)" stroke-width="1" stroke-dasharray="2 2" />
        <circle id="imlecReelNokta" cx="0" cy="0" r="5" fill="var(--paper)" stroke="var(--toprak)" stroke-width="2.5" />
        <circle id="imlecNominalNokta" cx="0" cy="0" r="4" fill="var(--paper)" stroke="var(--muted)" stroke-width="2" style="display: none;" />
      </g>

      <!-- Görünmez Etkileşim Yüzeyi -->
      <rect
        id="etkilesimYuzeyi"
        x="50"
        y="25"
        width="805"
        height="360"
        fill="transparent"
        style="cursor: crosshair;"
      />
    </svg>

    <!-- İnteraktif Tooltip (HUD) -->
    <div id="canliTooltip" class="canli-tooltip" style="display: none;">
      <div class="tt-baslik" id="ttTarih">Eylül 2023</div>
      <div class="tt-govde">
        <div class="tt-satir ana">
          <span class="tt-etiket">Reel Endeks:</span>
          <strong class="tt-deger" id="ttReel">114.2 puan</strong>
        </div>
        <div class="tt-satir">
          <span class="tt-etiket">Nominal BİST:</span>
          <span class="tt-deger" id="ttNominal">7.836 TL</span>
        </div>
        <div class="tt-satir">
          <span class="tt-etiket">TÜFE Artışı:</span>
          <span class="tt-deger" id="ttTufe">6.94 kat</span>
        </div>
        <div class="tt-satir sim">
          <span class="tt-etiket">10.000 TL Değeri:</span>
          <strong class="tt-deger vurgu" id="ttSim">₺11.420</strong>
        </div>
      </div>
    </div>
  </div>

  <!-- Tıklanabilir Rejim Kartları (Dönem Odaklanması) -->
  <div class="rejim-bolumu-baslik">
    <span class="rejim-baslik-etiket">TARİHSEL PİYASA REJİMLERİ</span>
    <span class="rejim-ipucu">Grafikte o döneme odaklanmak için tıklayın</span>
    <button type="button" class="rejim-sifirla-btn" id="btnRejimSifirla" style="display: none;">Odaklanmayı Kaldır ✕</button>
  </div>

  <div class="rejimler-izgara">
    {
      donemler.map((d) => (
        <button
          type="button"
          class="rejim-karti-btn"
          data-rejim-id={d.id}
          data-sinir-bas={d.sinirlar[0]}
          data-sinir-bit={d.sinirlar[1]}
        >
          <div class="rejim-ust">
            <span class="rejim-no">{d.no}</span>
            <span class="rejim-aralik">{d.aralik}</span>
          </div>
          <h3 class="rejim-baslik">{d.ad}</h3>
          <p class="rejim-ozet">{d.ozet}</p>
          <div class="rejim-bant">
            <span>Reel Bant:</span>
            <strong>{d.bant}</strong>
          </div>
        </button>
      ))
    }
  </div>
</div>

<!-- CSP Uyumlu Veri ve Etkileşim Scripti -->
<script is:inline define:vars={{ noktalar, donemler, zirve, dip }}>
  (function () {
    const kapsayici = document.getElementById('reelGrafikKapsayici');
    const svg = document.getElementById('reelSvg');
    const etkilesim = document.getElementById('etkilesimYuzeyi');
    const izgaraGrubu = document.getElementById('izgaraGrubu');
    const xEtiketGrubu = document.getElementById('xEtiketGrubu');
    const reelYol = document.getElementById('reelYol');
    const nominalYol = document.getElementById('nominalYol');
    const bazCizgisi = document.getElementById('bazCizgisi');
    const bazCizgisiMetin = document.getElementById('bazCizgisiMetin');
    const ekstremGrubu = document.getElementById('ekstremGrubu');
    const imlecGrubu = document.getElementById('imlecGrubu');
    const imlecCizgi = document.getElementById('imlecCizgi');
    const imlecReelNokta = document.getElementById('imlecReelNokta');
    const imlecNominalNokta = document.getElementById('imlecNominalNokta');
    const rejimVurguKutusu = document.getElementById('rejimVurguKutusu');
    const btnRejimSifirla = document.getElementById('btnRejimSifirla');

    const lejantNominal = document.getElementById('lejantNominal');
    const lejantReelDeger = document.getElementById('lejantReelDeger');
    const lejantNominalDeger = document.getElementById('lejantNominalDeger');
    const simDeger = document.getElementById('simDeger');
    const simNot = document.getElementById('simNot');

    const tooltip = document.getElementById('canliTooltip');
    const ttTarih = document.getElementById('ttTarih');
    const ttReel = document.getElementById('ttReel');
    const ttNominal = document.getElementById('ttNominal');
    const ttTufe = document.getElementById('ttTufe');
    const ttSim = document.getElementById('ttSim');

    if (!kapsayici || !svg || !etkilesim || !noktalar || noktalar.length === 0) return;

    const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
    const W = 880;
    const H = 430;
    const PAD = { top: 25, right: 35, bottom: 45, left: 50 };
    const plotW = W - PAD.left - PAD.right;
    const plotH = H - PAD.top - PAD.bottom;

    // Nominal 100 bazlı seriyi hesapla
    const bazBist = noktalar[0].bistKapanis;
    const zenginNoktalar = noktalar.map((p) => ({
      ...p,
      nominalEndeks: (p.bistKapanis / bazBist) * 100,
    }));

    // Durum Değişkenleri
    let aktifAralik = 'tum'; // '12', '36', '60', 'tum'
    let aktifMod = 'reel'; // 'reel', 'kiyas'
    let aktifRejim = null; // null veya rejim id
    let gorunenNoktalar = [...zenginNoktalar];

    function filtrele() {
      if (aktifRejim) {
        const d = donemler.find((r) => r.id === aktifRejim);
        if (d) {
          gorunenNoktalar = zenginNoktalar.filter((p) => p.tarih >= d.sinirlar[0] && p.tarih <= d.sinirlar[1]);
        }
      } else if (aktifAralik === 'tum') {
        gorunenNoktalar = [...zenginNoktalar];
      } else {
        const aySayisi = parseInt(aktifAralik, 10);
        gorunenNoktalar = zenginNoktalar.slice(-aySayisi);
      }
      if (gorunenNoktalar.length < 2) gorunenNoktalar = [...zenginNoktalar];
      ciz();
    }

    function ciz() {
      const len = gorunenNoktalar.length;

      // Y ölçeği hesaplama
      let minVal, maxVal;
      if (aktifMod === 'kiyas') {
        const tumDegerler = gorunenNoktalar.flatMap((p) => [p.reelEndeks, p.nominalEndeks]);
        minVal = Math.min(...tumDegerler);
        maxVal = Math.max(...tumDegerler);
      } else {
        const reelDegerler = gorunenNoktalar.map((p) => p.reelEndeks);
        minVal = Math.min(...reelDegerler);
        maxVal = Math.max(...reelDegerler);
      }

      // Estetik boşluk payı
      const marjin = (maxVal - minVal) * 0.12 || 10;
      const yMin = Math.max(0, Math.floor((minVal - marjin) / 10) * 10);
      const yMax = Math.ceil((maxVal + marjin) / 10) * 10;
      const yRange = yMax - yMin || 1;

      const xPos = (i) => PAD.left + (i / (len - 1)) * plotW;
      const yPos = (v) => PAD.top + (1 - (v - yMin) / yRange) * plotH;

      // 1. Izgara ve Y Eksen Çizgileri
      izgaraGrubu.innerHTML = '';
      const adimSayisi = 5;
      const adim = Math.max(10, Math.round((yMax - yMin) / adimSayisi / 10) * 10);
      for (let v = yMin; v <= yMax; v += adim) {
        const y = yPos(v);
        if (y < PAD.top || y > H - PAD.bottom) continue;

        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', PAD.left);
        line.setAttribute('y1', y);
        line.setAttribute('x2', W - PAD.right);
        line.setAttribute('y2', y);
        line.setAttribute('stroke', 'var(--hair, #cfccc2)');
        line.setAttribute('stroke-width', '1');
        izgaraGrubu.appendChild(line);

        const txt = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        txt.setAttribute('x', PAD.left - 8);
        txt.setAttribute('y', y + 4);
        txt.setAttribute('text-anchor', 'end');
        txt.setAttribute('class', 'svg-eksen-yazi');
        txt.textContent = v;
        izgaraGrubu.appendChild(txt);
      }

      // 100 Baz Çizgisi Konumu
      if (100 >= yMin && 100 <= yMax) {
        const y100 = yPos(100);
        bazCizgisi.style.display = 'block';
        bazCizgisi.setAttribute('y1', y100);
        bazCizgisi.setAttribute('y2', y100);
        bazCizgisiMetin.style.display = 'block';
        bazCizgisiMetin.setAttribute('y', y100 - 6);
      } else {
        bazCizgisi.style.display = 'none';
        bazCizgisiMetin.style.display = 'none';
      }

      // 2. X Eksen Etiketleri
      xEtiketGrubu.innerHTML = '';
      const adimX = Math.max(1, Math.floor(len / 6));
      for (let i = 0; i < len; i += adimX) {
        const p = gorunenNoktalar[i];
        const x = xPos(i);

        const tick = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        tick.setAttribute('x1', x);
        tick.setAttribute('y1', H - PAD.bottom);
        tick.setAttribute('x2', x);
        tick.setAttribute('y2', H - PAD.bottom + 5);
        tick.setAttribute('stroke', 'var(--hair, #cfccc2)');
        xEtiketGrubu.appendChild(tick);

        const txt = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        txt.setAttribute('x', x);
        txt.setAttribute('y', H - PAD.bottom + 18);
        txt.setAttribute('text-anchor', 'middle');
        txt.setAttribute('class', 'svg-eksen-yazi');
        txt.textContent = `${AYLAR[p.ay - 1].slice(0, 3)} ${String(p.yil).slice(2)}`;
        xEtiketGrubu.appendChild(txt);
      }

      // 3. Eğrileri Çiz
      const reelD = gorunenNoktalar
        .map((p, i) => `${i === 0 ? 'M' : 'L'} ${xPos(i).toFixed(1)} ${yPos(p.reelEndeks).toFixed(1)}`)
        .join(' ');
      reelYol.setAttribute('d', reelD);

      if (aktifMod === 'kiyas') {
        const nomD = gorunenNoktalar
          .map((p, i) => `${i === 0 ? 'M' : 'L'} ${xPos(i).toFixed(1)} ${yPos(p.nominalEndeks).toFixed(1)}`)
          .join(' ');
        nominalYol.setAttribute('d', nomD);
        nominalYol.style.display = 'block';
        lejantNominal.style.display = 'inline-flex';
        imlecNominalNokta.style.display = 'block';
      } else {
        nominalYol.style.display = 'none';
        lejantNominal.style.display = 'none';
        imlecNominalNokta.style.display = 'none';
      }

      // 4. Ekstrem Pinleri (Yalnızca tam veya geniş aralıkta gösterilir)
      ekstremGrubu.innerHTML = '';
      if (!aktifRejim && gorunenNoktalar.length > 20) {
        const zP = gorunenNoktalar.find((p) => p.tarih === zirve?.tarih);
        if (zP) {
          const zI = gorunenNoktalar.indexOf(zP);
          ekstremNoktaEkle(xPos(zI), yPos(zP.reelEndeks), `Zirve: ${zP.reelEndeks}`, 'ust');
        }
        const dP = gorunenNoktalar.find((p) => p.tarih === dip?.tarih);
        if (dP) {
          const dI = gorunenNoktalar.indexOf(dP);
          ekstremNoktaEkle(xPos(dI), yPos(dP.reelEndeks), `Dip: ${dP.reelEndeks}`, 'alt');
        }
      }

      // Son noktanın değerlerini güncelle
      const sonP = gorunenNoktalar.at(-1);
      if (sonP) {
        lejantReelDeger.textContent = `${sonP.reelEndeks.toFixed(1)} puan`;
        lejantNominalDeger.textContent = `${sonP.nominalEndeks.toFixed(0)} puan (₺${sonP.bistKapanis.toLocaleString('tr-TR')})`;
        guncelleSimulasyon(sonP);
      }
    }

    function ekstremNoktaEkle(x, y, metin, yon) {
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      c.setAttribute('cx', x);
      c.setAttribute('cy', y);
      c.setAttribute('r', '3.5');
      c.setAttribute('fill', 'var(--paper, #f4f3ee)');
      c.setAttribute('stroke', 'var(--ink, #1b1b1b)');
      c.setAttribute('stroke-width', '1.5');
      g.appendChild(c);

      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      t.setAttribute('x', x);
      t.setAttribute('y', yon === 'ust' ? y - 10 : y + 16);
      t.setAttribute('text-anchor', 'middle');
      t.setAttribute('class', 'svg-pin-yazi');
      t.textContent = metin;
      g.appendChild(t);

      ekstremGrubu.appendChild(g);
    }

    function guncelleSimulasyon(p) {
      // 10.000 TL Eylül 2014'teki reel değerle bugünkü karşılığı
      const guncelAlimGucu = Math.round(10000 * (p.reelEndeks / 100));
      simDeger.textContent = `₺${guncelAlimGucu.toLocaleString('tr-TR')}`;
      simNot.textContent = `(${AYLAR[p.ay - 1]} ${p.yil} noktasında 10.000 TL'nin reel alım gücü)`;
    }

    // İmleç ve Etkileşim
    function etkilesimGuncelle(clientX, clientY) {
      const rect = etkilesim.getBoundingClientRect();
      const relX = clientX - rect.left;
      if (relX < 0 || relX > rect.width) {
        gizle();
        return;
      }

      const len = gorunenNoktalar.length;
      const oran = relX / rect.width;
      const idx = Math.max(0, Math.min(len - 1, Math.round(oran * (len - 1))));
      const p = gorunenNoktalar[idx];
      if (!p) return;

      const x = PAD.left + (idx / (len - 1)) * plotW;

      // Y koordinatını o anki eğriden al
      let minVal, maxVal;
      if (aktifMod === 'kiyas') {
        const tum = gorunenNoktalar.flatMap((pt) => [pt.reelEndeks, pt.nominalEndeks]);
        minVal = Math.min(...tum);
        maxVal = Math.max(...tum);
      } else {
        const reelD = gorunenNoktalar.map((pt) => pt.reelEndeks);
        minVal = Math.min(...reelD);
        maxVal = Math.max(...reelD);
      }
      const marjin = (maxVal - minVal) * 0.12 || 10;
      const yMin = Math.max(0, Math.floor((minVal - marjin) / 10) * 10);
      const yMax = Math.ceil((maxVal + marjin) / 10) * 10;
      const yRange = yMax - yMin || 1;
      const yReel = PAD.top + (1 - (p.reelEndeks - yMin) / yRange) * plotH;
      const yNom = PAD.top + (1 - (p.nominalEndeks - yMin) / yRange) * plotH;

      imlecGrubu.style.display = 'block';
      imlecCizgi.setAttribute('x1', x);
      imlecCizgi.setAttribute('x2', x);
      imlecReelNokta.setAttribute('cx', x);
      imlecReelNokta.setAttribute('cy', yReel);

      if (aktifMod === 'kiyas') {
        imlecNominalNokta.setAttribute('cx', x);
        imlecNominalNokta.setAttribute('cy', yNom);
      }

      // HUD Tooltip Doldur
      ttTarih.textContent = `${AYLAR[p.ay - 1]} ${p.yil}`;
      ttReel.textContent = `${p.reelEndeks.toFixed(1)} puan`;
      ttNominal.textContent = `₺${p.bistKapanis.toLocaleString('tr-TR')}`;
      ttTufe.textContent = `${p.tufeCarpani.toFixed(2)} kat`;

      const simTl = Math.round(10000 * (p.reelEndeks / 100));
      ttSim.textContent = `₺${simTl.toLocaleString('tr-TR')}`;

      tooltip.style.display = 'block';
      const cizimRect = svg.getBoundingClientRect();
      const ekranX = clientX - cizimRect.left;
      const ttW = tooltip.offsetWidth || 195;

      let sol = ekranX + 16;
      if (sol + ttW > cizimRect.width - 10) {
        sol = ekranX - ttW - 16;
      }
      tooltip.style.left = Math.max(6, sol) + 'px';
      tooltip.style.top = Math.max(6, clientY - cizimRect.top - 20) + 'px';

      // Canlı lejant değerlerini de eşzamanlı güncelle
      lejantReelDeger.textContent = `${p.reelEndeks.toFixed(1)} puan`;
      lejantNominalDeger.textContent = `${p.nominalEndeks.toFixed(0)} puan (₺${p.bistKapanis.toLocaleString('tr-TR')})`;
      guncelleSimulasyon(p);
    }

    function gizle() {
      imlecGrubu.style.display = 'none';
      tooltip.style.display = 'none';
      const sonP = gorunenNoktalar.at(-1);
      if (sonP) {
        lejantReelDeger.textContent = `${sonP.reelEndeks.toFixed(1)} puan`;
        lejantNominalDeger.textContent = `${sonP.nominalEndeks.toFixed(0)} puan (₺${sonP.bistKapanis.toLocaleString('tr-TR')})`;
        guncelleSimulasyon(sonP);
      }
    }

    etkilesim.addEventListener('mousemove', (e) => etkilesimGuncelle(e.clientX, e.clientY));
    etkilesim.addEventListener('mouseleave', gizle);

    // Mobil Dokunmatik Desteği
    etkilesim.addEventListener('touchstart', (e) => {
      if (e.touches && e.touches[0]) {
        etkilesimGuncelle(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    etkilesim.addEventListener('touchmove', (e) => {
      if (e.touches && e.touches[0]) {
        etkilesimGuncelle(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    etkilesim.addEventListener('touchend', () => {
      setTimeout(gizle, 2500); // Mobilde 2.5 sn okunabilmesi için bekle
    });

    // Zaman Aralığı Butonları
    kapsayici.querySelectorAll('[data-aralik]').forEach((btn) => {
      btn.addEventListener('click', () => {
        kapsayici.querySelectorAll('[data-aralik]').forEach((b) => b.classList.remove('aktif'));
        btn.classList.add('aktif');
        aktifAralik = btn.getAttribute('data-aralik');
        aktifRejim = null;
        rejimVurguKutusu.setAttribute('opacity', '0');
        btnRejimSifirla.style.display = 'none';
        kapsayici.querySelectorAll('.rejim-karti-btn').forEach((b) => b.classList.remove('secili'));
        filtrele();
      });
    });

    // Gösterim Modu Butonları (Reel vs Kıyas)
    kapsayici.querySelectorAll('[data-mod]').forEach((btn) => {
      btn.addEventListener('click', () => {
        kapsayici.querySelectorAll('[data-mod]').forEach((b) => b.classList.remove('aktif'));
        btn.classList.add('aktif');
        aktifMod = btn.getAttribute('data-mod');
        ciz();
      });
    });

    // Rejim Kartları Tıklama Etkileşimi
    kapsayici.querySelectorAll('.rejim-karti-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-rejim-id');
        if (aktifRejim === id) {
          // Zaten seçiliyse sıfırla
          aktifRejim = null;
          btn.classList.remove('secili');
          btnRejimSifirla.style.display = 'none';
        } else {
          kapsayici.querySelectorAll('.rejim-karti-btn').forEach((b) => b.classList.remove('secili'));
          btn.classList.add('secili');
          aktifRejim = id;
          btnRejimSifirla.style.display = 'inline-block';
        }
        filtrele();
      });
    });

    btnRejimSifirla.addEventListener('click', () => {
      aktifRejim = null;
      btnRejimSifirla.style.display = 'none';
      kapsayici.querySelectorAll('.rejim-karti-btn').forEach((b) => b.classList.remove('secili'));
      filtrele();
    });

    // İlk çizim
    filtrele();
  })();
</script>

