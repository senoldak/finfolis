---
import Change from './Change.astro';
import { sektorler, sayi, SEKTOR_VERISI } from '../lib/sektorler';

interface Props {
  baslikGoster?: boolean;
}

const { baslikGoster = true } = Astro.props;

// Yalnız canlı gelen son puan ve günlük değişim gösterilir; haftalık, aylık, yılbaşı getirisi ve piyasa değeri canlı
// veriden hesaplanmadığı için yoktur. Varsayılan sıralama: günlük değişime göre çoktan aza.
const siraliGunluk = [...sektorler].sort((a, b) => b.gunluk - a.gunluk);
const enYukselen = siraliGunluk[0];
const enDusen = siraliGunluk[siraliGunluk.length - 1];
---

<section class="sektor-karnesi-alani" aria-labelledby="sektor-baslik">
  {
    baslikGoster && (
      <header class="sektor-baslik-alani">
        <div class="baslik-metin">
          <span class="etiket">BIST GÖSTERGELERİ</span>
          <h2 id="sektor-baslik" class="bolum-baslik">
            Sektör Endeksleri
          </h2>
          <p class="sektor-alt-metin">
            Borsa İstanbul'daki sektör ve tematik endekslerin son puanı, günlük değişimi ve lokomotif şirketleri.
          </p>
        </div>
      </header>
    )
  }

  <!-- Günün en çok yükselen ve düşen endeksi -->
  <div class="sektor-ozet-kutulari">
    <div class="ozet-kart" id="kart-lider">
      <span class="ozet-etiket" id="etiket-lider">GÜNÜN EN ÇOK YÜKSELENİ</span>
      <strong class="ozet-deger kazanc" id="deger-lider-kod">{enYukselen.kod}</strong>
      <span class="ozet-ad" id="deger-lider-ad">{enYukselen.ad}</span>
      <span class={`ozet-oran ${enYukselen.gunluk >= 0 ? 'pozitif' : 'negatif'}`} id="deger-lider-oran">{enYukselen.gunluk >= 0 ? '▲' : '▼'} %{sayi(Math.abs(enYukselen.gunluk), 1)}</span>
    </div>
    <div class="ozet-kart" id="kart-dusen">
      <span class="ozet-etiket" id="etiket-dusen">GÜNÜN EN ÇOK DÜŞENİ</span>
      <strong class="ozet-deger kayip" id="deger-dusen-kod">{enDusen.kod}</strong>
      <span class="ozet-ad" id="deger-dusen-ad">{enDusen.ad}</span>
      <span class={`ozet-oran ${enDusen.gunluk >= 0 ? 'pozitif' : 'negatif'}`} id="deger-dusen-oran">{enDusen.gunluk >= 0 ? '▲' : '▼'} %{sayi(Math.abs(enDusen.gunluk), 1)}</span>
    </div>
  </div>

  <!-- Kontrol Çubuğu: Kategori Filtreleri ve Görsel İndir Butonu -->
  <div class="tablo-kontrolleri">
    <div class="kontrol-grubu">
      <span class="kontrol-etiket">Kategori:</span>
      <div class="buton-grubu" role="toolbar" aria-label="Sektör kategorisi">
        <button type="button" class="filtre-btn aktif" data-kategori="hepsi">Tümü ({sektorler.length})</button>
        <button type="button" class="filtre-btn" data-kategori="ana-endeks">Ana Endeksler</button>
        <button type="button" class="filtre-btn" data-kategori="sektorler">Sektörler</button>
        <button type="button" class="filtre-btn" data-kategori="tema">Tematik & Pazar</button>
      </div>
    </div>

    <div class="kontrol-grubu aksiyon-grubu">
      <button type="button" class="aksiyon-btn" id="btn-kart-indir" title="Sosyal medya için karne görseli indir">
        <span class="btn-ikon" aria-hidden="true">📷</span>
        <span>Görsel İndir (PNG)</span>
      </button>
    </div>
  </div>

  <!-- Tablo -->
  <div class="cizelge-kaydir">
    <table class="cizelge sektor-tablosu" data-sektor-tablo>
      <caption class="sr-only">BIST sektör ve tematik endekslerinin son puanı ve günlük değişimi</caption>
      <thead>
        <tr>
          <th scope="col" aria-sort="none">
            <button type="button" class="sirala" data-anahtar="kod">Endeks</button>
          </th>
          <th scope="col" aria-sort="none">
            <button type="button" class="sirala" data-anahtar="ad">Açıklama</button>
          </th>
          <th scope="col" class="sayisal" aria-sort="none">
            <button type="button" class="sirala" data-anahtar="deger">Son Puan</button>
          </th>
          <th scope="col" class="sayisal" aria-sort="descending">
            <button type="button" class="sirala" data-anahtar="gunluk">Günlük %</button>
          </th>
          <th scope="col" class="aksiyon-kolonu">
            <span class="sr-only">Detay</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {
          siraliGunluk.map((s) => {
            return (
              <>
                <tr
                  class="ana-satir"
                  data-kod={s.kod}
                  data-ad={s.ad}
                  data-kategori={s.kategori}
                  data-deger={s.deger}
                  data-gunluk={s.gunluk}
                  tabindex="0"
                  role="button"
                  aria-expanded="false"
                  aria-controls={`detay-${s.kod}`}
                >
                  <th scope="row" class="kod-hucre">
                    <span class="endeks-kodu">{s.kod}</span>
                  </th>
                  <td>
                    <span class="endeks-aciklama">{s.ad}</span>
                  </td>
                  <td class="sayisal deger-hucre">
                    {s.deger > 0 ? sayi(s.deger, 2) : '—'}
                  </td>
                  <td class="sayisal">
                    <Change value={s.gunluk} />
                  </td>
                  <td class="aksiyon-hucre">
                    <span class="detay-tetikleyici" aria-hidden="true">Detay ▾</span>
                  </td>
                </tr>
                <tr id={`detay-${s.kod}`} class="detay-satiri gizli" aria-hidden="true">
                  <td colspan="5">
                    <div class="detay-kutusu">
                      <div class="detay-bolum">
                        <span class="detay-baslik">Endeks Kapsamı ve Tanımı</span>
                        <p class="detay-metin">{s.tanim ?? s.aciklama}</p>
                      </div>

                      {s.hisseler && s.hisseler.length > 0 && (
                        <div class="detay-bolum">
                          <span class="detay-baslik">Öne Çıkan Lokomotif Hisseler</span>
                          <div class="hisse-rozetleri">
                            {s.hisseler.map((hisse) => (
                              <span class="hisse-etiket">{hisse}</span>
                            ))}
                          </div>
                        </div>
                      )}

                      {s.dinamik && (
                        <div class="detay-bolum">
                          <span class="detay-baslik">Piyasa Dinamiği ve Hassasiyet</span>
                          <p class="detay-metin dinamik-metin">{s.dinamik}</p>
                        </div>
                      )}
                    </div>
                  </td>
                </tr>
              </>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <footer class="sektor-dipnot">
    <p class="veri-notu">
      Kaynak: {SEKTOR_VERISI.kaynak.ad} · Son güncelleme: {new Date(SEKTOR_VERISI.guncelleme).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' })}.
      Son puan ve günlük değişim bir önceki kapanışa göredir; veri alınamayan endekste son alınan değer kalır. Detayları görmek
      için herhangi bir satıra tıklayabilirsiniz.
    </p>
  </footer>

  <!-- Gizli Canvas (Görsel İndirme için) -->
  <canvas id="sosyal-kart-canvas" width="1200" height="675" class="gizli" aria-hidden="true"></canvas>
</section>

<script>
  // Sektör Karnesi Etkileşim Motoru
  const tablo = document.querySelector<HTMLTableElement>('table[data-sektor-tablo]');
  if (tablo) {
    const govde = tablo.tBodies[0];
    const basliklar = tablo.querySelectorAll<HTMLTableCellElement>('thead th');

    // 2. TABLO SIRALAMA
    function sirala(anahtar: string, artan: boolean) {
      const satirlar = Array.from(govde.querySelectorAll<HTMLTableRowElement>('tr.ana-satir'));
      const ciftler = satirlar.map((s) => ({
        ana: s,
        detay: document.getElementById(`detay-${s.dataset.kod}`),
      }));

      ciftler.sort((a, b) => {
        const va = a.ana.dataset[anahtar] ?? '';
        const vb = b.ana.dataset[anahtar] ?? '';
        if (va === '' || vb === '') return va === '' ? (vb === '' ? 0 : 1) : -1;
        if (anahtar === 'kod' || anahtar === 'ad') {
          const cmp = va.localeCompare(vb, 'tr');
          return artan ? cmp : -cmp;
        }
        const numA = Number(va);
        const numB = Number(vb);
        return artan ? numA - numB : numB - numA;
      });

      ciftler.forEach(({ ana, detay }) => {
        govde.appendChild(ana);
        if (detay) govde.appendChild(detay);
      });
    }

    basliklar.forEach((th) => {
      const dugme = th.querySelector<HTMLButtonElement>('button.sirala');
      dugme?.addEventListener('click', () => {
        const anahtar = dugme.dataset.anahtar!;
        const onceki = th.getAttribute('aria-sort');
        const yeni =
          onceki === 'descending'
            ? 'ascending'
            : onceki === 'ascending'
              ? 'descending'
              : anahtar === 'kod' || anahtar === 'ad'
                ? 'ascending'
                : 'descending';

        basliklar.forEach((b) => b.setAttribute('aria-sort', 'none'));
        th.setAttribute('aria-sort', yeni);
        sirala(anahtar, yeni === 'ascending');
      });
    });

    // 3. KATEGORİ FİLTRELEME
    const filtreButonlari = document.querySelectorAll<HTMLButtonElement>('.filtre-btn');
    filtreButonlari.forEach((btn) => {
      btn.addEventListener('click', () => {
        filtreButonlari.forEach((b) => b.classList.remove('aktif'));
        btn.classList.add('aktif');

        const kat = btn.dataset.kategori;
        const anaSatirlar = Array.from(govde.querySelectorAll<HTMLTableRowElement>('tr.ana-satir'));

        anaSatirlar.forEach((satir) => {
          const skat = satir.dataset.kategori || '';
          const detay = document.getElementById(`detay-${satir.dataset.kod}`);
          let goster = false;

          if (kat === 'hepsi') goster = true;
          else if (kat === 'ana-endeks') goster = skat === 'ana-endeks' || skat === 'ana-sektor';
          else if (kat === 'sektorler') goster = ['mali', 'sinai', 'hizmet', 'teknoloji'].includes(skat);
          else if (kat === 'tema') goster = ['tema', 'pazar', 'endeks'].includes(skat);

          if (goster) {
            satir.classList.remove('gizli');
          } else {
            satir.classList.add('gizli');
            if (detay) detay.classList.add('gizli');
          }
        });
      });
    });

    // 4. SATIR DETAYI (AKORDEON)
    govde.addEventListener('click', (e) => {
      const anaSatir = (e.target as HTMLElement).closest<HTMLTableRowElement>('tr.ana-satir');
      if (!anaSatir) return;

      const kod = anaSatir.dataset.kod;
      const detay = document.getElementById(`detay-${kod}`);
      if (!detay) return;

      const acik = !detay.classList.contains('gizli');
      if (acik) {
        detay.classList.add('gizli');
        detay.setAttribute('aria-hidden', 'true');
        anaSatir.setAttribute('aria-expanded', 'false');
        anaSatir.classList.remove('secili-satir');
      } else {
        detay.classList.remove('gizli');
        detay.setAttribute('aria-hidden', 'false');
        anaSatir.setAttribute('aria-expanded', 'true');
        anaSatir.classList.add('secili-satir');
      }
    });

    // Klavyeyle açma (Enter / Space)
    govde.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const anaSatir = (e.target as HTMLElement).closest<HTMLTableRowElement>('tr.ana-satir');
        if (anaSatir) {
          e.preventDefault();
          anaSatir.click();
        }
      }
    });

    // 5. GÖRSEL OLARAK PAYLAŞ / PNG İNDİR (Canvas Çizici)
    const btnKartIndir = document.getElementById('btn-kart-indir');
    const canvas = document.getElementById('sosyal-kart-canvas') as HTMLCanvasElement;

    if (btnKartIndir && canvas) {
      btnKartIndir.addEventListener('click', () => {
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const W = 1200;
        const H = 675;
        canvas.width = W;
        canvas.height = H;

        // Kâğıt zemin
        ctx.fillStyle = '#f4f3ee';
        ctx.fillRect(0, 0, W, H);

        // İnce kenar çizgisi
        ctx.strokeStyle = '#cfccc2';
        ctx.lineWidth = 4;
        ctx.strokeRect(20, 20, W - 40, H - 40);

        // Üst kırmızı/toprak marka bandı
        ctx.fillStyle = '#c2502b';
        ctx.fillRect(20, 20, W - 40, 10);

        // Başlık alanı
        ctx.fillStyle = '#a8431f';
        ctx.font = 'bold 20px "Bricolage Grotesque", system-ui, sans-serif';
        ctx.fillText('FİNFOLİS · BİST GÖSTERGELERİ', 60, 75);

        ctx.fillStyle = '#1b1b1b';
        ctx.font = 'bold 38px "Bricolage Grotesque", system-ui, sans-serif';
        ctx.fillText('BIST Sektör Endeksleri (Günlük değişim)', 60, 125);

        // Tarih damgası
        ctx.fillStyle = '#5d5b55';
        ctx.font = '18px "Bricolage Grotesque", system-ui, sans-serif';
        const bugunStr = new Date().toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
        ctx.fillText(`Kapanış Verileri · ${bugunStr}`, 60, 160);

        // Verileri topla (ilk 5 ve son 5)
        const satirlar = Array.from(govde.querySelectorAll<HTMLTableRowElement>('tr.ana-satir'));
        const sirali = satirlar
          .map((s) => ({
            kod: s.dataset.kod || '',
            ad: s.dataset.ad || '',
            getiri: Number(s.dataset.gunluk || 0),
          }))
          .sort((a, b) => b.getiri - a.getiri);

        const kazananlar = sirali.slice(0, 5);
        const kaybedenler = sirali.slice(-5).reverse();

        // Sol Kolon: En Çok Kazandıranlar
        ctx.fillStyle = '#e9e7df';
        ctx.fillRect(60, 195, 510, 380);
        ctx.strokeStyle = '#cfccc2';
        ctx.lineWidth = 1;
        ctx.strokeRect(60, 195, 510, 380);

        ctx.fillStyle = '#3f7350';
        ctx.font = 'bold 22px "Bricolage Grotesque", system-ui, sans-serif';
        ctx.fillText('▲ EN ÇOK YÜKSELEN SEKTÖRLER', 85, 235);

        kazananlar.forEach((s, idx) => {
          const y = 280 + idx * 56;
          ctx.fillStyle = '#1b1b1b';
          ctx.font = 'bold 20px monospace';
          ctx.fillText(s.kod.padEnd(6), 85, y);

          ctx.font = '18px "Bricolage Grotesque", system-ui, sans-serif';
          ctx.fillText(s.ad.slice(0, 22), 170, y);

          ctx.fillStyle = '#3f7350';
          ctx.font = 'bold 20px "Bricolage Grotesque", monospace';
          const yuzde = `${s.getiri >= 0 ? '+' : '−'} %${Math.abs(s.getiri).toFixed(1)}`;
          ctx.fillText(yuzde, 470, y);
        });

        // Sağ Kolon: En Çok Gerileyenler
        ctx.fillStyle = '#e9e7df';
        ctx.fillRect(630, 195, 510, 380);
        ctx.strokeStyle = '#cfccc2';
        ctx.lineWidth = 1;
        ctx.strokeRect(630, 195, 510, 380);

        ctx.fillStyle = '#a3243b';
        ctx.font = 'bold 22px "Bricolage Grotesque", system-ui, sans-serif';
        ctx.fillText('▼ EN ÇOK GERİLEYEN SEKTÖRLER', 655, 235);

        kaybedenler.forEach((s, idx) => {
          const y = 280 + idx * 56;
          ctx.fillStyle = '#1b1b1b';
          ctx.font = 'bold 20px monospace';
          ctx.fillText(s.kod.padEnd(6), 655, y);

          ctx.font = '18px "Bricolage Grotesque", system-ui, sans-serif';
          ctx.fillText(s.ad.slice(0, 22), 740, y);

          ctx.fillStyle = '#a3243b';
          ctx.font = 'bold 20px "Bricolage Grotesque", monospace';
          const yuzde = `${s.getiri >= 0 ? '+' : '−'} %${Math.abs(s.getiri).toFixed(1)}`;
          ctx.fillText(yuzde, 1040, y);
        });

        // Alt Bilgi / İmza
        ctx.fillStyle = '#5d5b55';
        ctx.font = '16px "Bricolage Grotesque", system-ui, sans-serif';
        ctx.fillText('finfolis · Karmaşadan uzakta · finfolis.com/veri/sektorler/', 60, 625);

        // İndirmeyi başlat
        const dataUrl = canvas.toDataURL('image/png');
        const link = document.createElement('a');
        link.download = `finfolis-bist-sektor-karnesi-${new Date().toISOString().slice(0, 10)}.png`;
        link.href = dataUrl;
        link.click();
      });
    }
  }
</script>

<style>
  .sektor-karnesi-alani {
    margin-bottom: 48px;
  }

  .sektor-baslik-alani {
    margin-bottom: 24px;
    border-bottom: 1px solid var(--hair, #cfccc2);
    padding-bottom: 16px;
  }

  .etiket {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--toprak-text, #a8431f);
    margin-bottom: 6px;
  }

  .sektor-alt-metin {
    color: var(--muted, #5d5b55);
    font-size: 0.95rem;
    margin-top: 4px;
  }

  /* Aksiyon Düğmesi (Görsel İndir) */
  .aksiyon-btn {
    all: unset;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--paper, #f4f3ee);
    border: 1px solid var(--ink, #1b1b1b);
    color: var(--ink, #1b1b1b);
    padding: 6px 12px;
    font-size: 0.82rem;
    font-weight: 700;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .aksiyon-btn:hover {
    background: var(--ink, #1b1b1b);
    color: #fff;
  }

  /* 3'lü Hızlı Özet Kutuları */
  .sektor-ozet-kutulari {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .ozet-kart {
    background: var(--paper-2, #e9e7df);
    border: 1px solid var(--hair, #cfccc2);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ozet-etiket {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted, #5d5b55);
  }

  .ozet-deger {
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--ink, #1b1b1b);
    font-variant-numeric: tabular-nums;
  }

  .ozet-deger.kazanc {
    color: var(--green, #3f7350);
  }

  .ozet-deger.kayip {
    color: var(--red, #a3243b);
  }

  .ozet-ad {
    font-size: 0.88rem;
    color: var(--ink-2, #3d3c38);
  }

  .ozet-oran {
    font-size: 0.95rem;
    font-weight: 700;
    margin-top: 4px;
    font-variant-numeric: tabular-nums;
  }

  .ozet-oran.pozitif {
    color: var(--green, #3f7350);
  }

  .ozet-oran.negatif {
    color: var(--red, #a3243b);
  }

  /* Kontrol Çubuğu (Dönem, Kategori ve İndir) */
  .tablo-kontrolleri {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    background: var(--paper-2, #e9e7df);
    border: 1px solid var(--hair, #cfccc2);
    padding: 10px 14px;
    margin-bottom: 16px;
  }

  .kontrol-grubu {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .kontrol-etiket {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted, #5d5b55);
  }

  .buton-grubu {
    display: flex;
    gap: 4px;
  }

  .donem-btn,
  .filtre-btn {
    all: unset;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 5px 10px;
    background: var(--paper, #f4f3ee);
    border: 1px solid var(--hair, #cfccc2);
    color: var(--ink-2, #3d3c38);
    transition: all 0.15s ease;
  }

  .donem-btn:hover,
  .filtre-btn:hover {
    background: #fff;
    border-color: var(--ink, #1b1b1b);
  }

  .donem-btn.aktif,
  .filtre-btn.aktif {
    background: var(--ink, #1b1b1b);
    color: #fff;
    border-color: var(--ink, #1b1b1b);
  }

  .aksiyon-grubu {
    margin-left: auto;
  }

  /* Tablo */
  .cizelge-kaydir {
    /* Ekran okuyucu metinleri (sr-only, mutlak konumlu) kutunun dışına taşıp sayfayı genişletmesin. */
    position: relative;
    overflow-x: auto;
    border-top: 2px solid var(--ink, #1b1b1b);
  }

  .sektor-tablosu {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--sans);
    font-variant-numeric: tabular-nums;
  }

  .sektor-tablosu th,
  .sektor-tablosu td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--hair, #cfccc2);
    vertical-align: middle;
  }

  .ana-satir {
    cursor: pointer;
    transition: background-color 0.12s ease;
  }

  .ana-satir:hover {
    background-color: var(--paper-2, #e9e7df);
  }

  .ana-satir.secili-satir {
    background-color: var(--paper-2, #e9e7df);
    border-bottom-color: transparent;
  }

  .kod-hucre {
    font-weight: 700;
    white-space: nowrap;
    width: 90px;
  }

