---
import { simgeler } from '../lib/piyasa';

// Bir Isotype satırı: miktar / birim kadar simge, son simge kesirliyse kısmen çizilir.
// Simgeler onluk gruplar halinde dizilir ki okur saymakta zorlanmasın.
interface Props {
  miktar: number;
  birim: number;
  simge: string;
  soluk?: boolean;
}

const { miktar, birim, simge, soluk = false } = Astro.props;
const list = simgeler(miktar, birim);
const gruplar: number[][] = [];
list.forEach((k, i) => {
  if (i % 10 === 0) gruplar.push([]);
  gruplar[gruplar.length - 1].push(k);
});
---

<span class:list={['iso', { 'iso-soluk': soluk }]} aria-hidden="true">
  {
    gruplar.map((g) => (
      <span class="iso-grup">
        {g.map((k) => (
          <svg viewBox={`0 0 ${24 * k} 24`} class:list={{ 'iso-kesir': k < 1 }}>
            <use href={`#s-${simge}`} />
          </svg>
        ))}
      </span>
    ))
  }
</span>
