---
import { RESMI, sayiYaz } from '../lib/resmi';
import itoVerisi from '../data/ito-enflasyon.json';
import { birlestirReelGetiriVerisi } from '../lib/reel-getiri.mjs';

// Son 21 ayı al (Ocak 2025 - Eylül 2026)
const noktalar = birlestirReelGetiriVerisi({
  tufeSatirlari: RESMI.enflasyon?.satirlar ?? [],
  itoSatirlari: itoVerisi.satirlar ?? [],
  faizGecmisi: RESMI.faiz?.gecmis ?? [],
  aySayisi: 21,
});

const W = 880;
const H = 380;
const PAD_L = 50;
const PAD_R = 75;
const PAD_T = 30;
const PAD_B = 45;

const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

// Y ekseni min 0, max 6 (% değişim)
const minVal = 0;
const maxVal = 6;
const valRange = maxVal - minVal;

const x = (i: number) => PAD_L + (i / Math.max(noktalar.length - 1, 1)) * plotW;
const y = (v: number) => PAD_T + (1 - (v - minVal) / valRange) * plotH;

// Y ekseni çizgileri: %0, %1, %2, %3, %4, %5, %6
const yKılavuzlar = [0, 1, 2, 3, 4, 5, 6];

// Çizgi yolları (SVG path d)
const tufeYol = noktalar.map((p, i) => `${i === 0 ? 'M' : 'L'} ${x(i).toFixed(1)} ${y(p.tufe).toFixed(1)}`).join(' ');
const itoNoktalari = noktalar.filter((p) => p.ito != null);
const itoYol = itoNoktalari.map((p, i) => {
  const index = noktalar.indexOf(p);
  return `${i === 0 ? 'M' : 'L'} ${x(index).toFixed(1)} ${y(p.ito!).toFixed(1)}`;
}).join(' ');
const tcmbYol = noktalar.map((p, i) => `${i === 0 ? 'M' : 'L'} ${x(i).toFixed(1)} ${y(p.tcmbFaiz).toFixed(1)}`).join(' ');

const son = noktalar.at(-1);
---

<section class="reel-getiri-bolumu" aria-labelledby="reel-getiri-baslik">
  <div class="reel-getiri-baslik-alani">
    <div class="baslik-metin">
      <span class="bolum-rozet">Karşılaştırma</span>
      <h2 id="reel-getiri-baslik" class="bolum-baslik">Aylık Reel Getiri & Enflasyon Kıyası</h2>
      <p class="bolum-aciklama">
        TCMB politika faizinin aylık basit getirisi ile TÜİK (Türkiye geneli) ve İTO (İstanbul) aylık enflasyonlarının son 21 aylık seyri.
      </p>
    </div>

    <div class="grafik-lejant-kutusu" role="legend" aria-label="Grafik göstergeleri">
      <div class="lejant-oge lejant-tcmb">
        <span class="lejant-cizgi"></span>
        <span class="lejant-ad">TCMB aylık faiz</span>
        <strong class="lejant-deger">%{son ? sayiYaz(son.tcmbFaiz, 2) : '3,08'}</strong>
      </div>
      <div class="lejant-oge lejant-ito">
        <span class="lejant-cizgi"></span>
        <span class="lejant-ad">İTO aylık enflasyon</span>
        <strong class="lejant-deger">%{son?.ito ? sayiYaz(son.ito, 2) : '2,11'}</strong>
      </div>
      <div class="lejant-oge lejant-tufe">
        <span class="lejant-cizgi"></span>
        <span class="lejant-ad">TÜFE aylık enflasyon</span>
        <strong class="lejant-deger">%{son ? sayiYaz(son.tufe, 2) : '1,84'}</strong>
      </div>
    </div>
  </div>

  <div class="grafik-sarma">
    <svg class="reel-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Aylık enflasyon ve faiz karşılaştırma grafiği">
      <!-- Arka Plan Grid / Kılavuz Çizgileri -->
      <g class="grid-cizgileri">
        {yKılavuzlar.map((val) => (
          <g class="grid-satir">
            <line
              x1={PAD_L}
              y1={y(val)}
              x2={W - PAD_R}
              y2={y(val)}
              stroke="var(--soluk)"
              stroke-width={val === 0 ? "1.5" : "1"}
              stroke-dasharray={val === 0 ? undefined : "3 3"}
            />
            <text x={PAD_L - 10} y={y(val) + 4} text-anchor="end" class="eksen-yazi">
              {sayiYaz(val, 2)}
            </text>
          </g>
        ))}
      </g>

      <!-- Çizgiler -->
      <!-- 1. TCMB Aylık Faiz (Yeşil) -->
      <path d={tcmbYol} fill="none" stroke="#3f7350" stroke-width="2.75" stroke-linejoin="round" stroke-linecap="round" />

      <!-- 2. İTO Aylık Enflasyon (Mavi) -->
      <path d={itoYol} fill="none" stroke="#2d5a7b" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" />

      <!-- 3. TÜİK TÜFE Aylık (Kırmızı) -->
      <path d={tufeYol} fill="none" stroke="#a3243b" stroke-width="2.75" stroke-linejoin="round" stroke-linecap="round" />

      <!-- X Ekseni Etiketleri -->
      <g class="x-eksen-yazilari">
        {noktalar.map((p, i) => {
          // İki ayda bir ve son ay etiketlensin (kalabalık olmaması için)
          const etiketGoster = i % 2 === 0 || i === noktalar.length - 1;
          return etiketGoster ? (
            <text x={x(i)} y={H - 15} text-anchor="middle" class="eksen-yazi">
              {p.etiket}
            </text>
          ) : null;
        })}
      </g>

      <!-- Sağ uçtaki son değer kutucukları -->
      {son && (
        <g class="son-degerler">
          <!-- TCMB (Yeşil) -->
          <text x={x(noktalar.length - 1) + 10} y={y(son.tcmbFaiz) + 4} fill="#3f7350" class="son-deger-yazi">
            {sayiYaz(son.tcmbFaiz, 2)}
          </text>
          <!-- İTO (Mavi) -->
          {son.ito != null && (
            <text x={x(noktalar.length - 1) + 10} y={y(son.ito) + 4} fill="#2d5a7b" class="son-deger-yazi">
              {sayiYaz(son.ito, 2)}
            </text>
          )}
          <!-- TÜFE (Kırmızı) -->
          <text x={x(noktalar.length - 1) + 10} y={y(son.tufe) + 4} fill="#a3243b" class="son-deger-yazi">
            {sayiYaz(son.tufe, 2)}
          </text>
        </g>
      )}

      <!-- Noktalar ve Hover Alanları -->
      {noktalar.map((p, i) => (
        <g class="nokta-kolon" tabindex="0">
          <!-- Dikey hover çizgisi -->
          <line
            x1={x(i)}
            y1={PAD_T}
            x2={x(i)}
            y2={H - PAD_B}
            stroke="var(--ink)"
            stroke-width="1"
            stroke-dasharray="2 2"
            class="hover-kilavuz"
          />

          <!-- Noktalar -->
          <circle cx={x(i)} cy={y(p.tcmbFaiz)} r="3.5" fill="#3f7350" class="nokta" />
          {p.ito != null && <circle cx={x(i)} cy={y(p.ito)} r="3" fill="#2d5a7b" class="nokta" />}
          <circle cx={x(i)} cy={y(p.tufe)} r="3.5" fill="#a3243b" class="nokta" />

          <!-- Tıklama/Hover kapsayıcı görünmez rect -->
          <rect
            x={x(i) - (plotW / noktalar.length) / 2}
            y={PAD_T}
            width={plotW / noktalar.length}
            height={plotH}
            fill="transparent"
            class="kolon-tetikleyici"
          >
            <title>{`${p.tamEtiket}\nTCMB Faiz: %${sayiYaz(p.tcmbFaiz, 2)}\nİTO Enflasyon: ${p.ito != null ? `%${sayiYaz(p.ito, 2)}` : 'Veri yok'}\nTÜİK TÜFE: %${sayiYaz(p.tufe, 2)}\nAylık Reel Fark: ${p.reelFark >= 0 ? '+' : ''}${sayiYaz(p.reelFark, 2)} puan`}</title>
          </rect>
        </g>
      ))}
    </svg>
  </div>

  <!-- "Bu grafik ne anlatır?" Rehber Kutusu -->
  <aside class="grafik-rehber-kutusu">
    <div class="rehber-baslik-alani">
      <svg class="rehber-simge" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="16" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12.01" y2="8" />
      </svg>
      <h3>Bu grafik ne anlatır?</h3>
    </div>
    <div class="rehber-govde">
      <p>
        <strong>Aylık Reel Getiri Dengesi:</strong> Tasarruf sahibinin parasının alım gücünü koruyabilmesi için TL faiz getirisinin (<span class="renk-yesil">yeşil çizgi</span>), çarşı-pazarda hissedilen aylık fiyat artışının (<span class="renk-mavi">mavi çizgi</span>) ve resmi enflasyonun (<span class="renk-kirmizi">kırmızı çizgi</span>) üzerinde kalması gerekir.
      </p>
      <p>
        Kırmızı ve mavi çizgilerin yeşil çizginin altında kaldığı dönemler, mevduat/TL faizinin aylık enflasyonu yendiğini (pozitif aylık reel faiz sağlandığını) ifade eder. Son açıklanan ay itibarıyla TCMB aylık faiz karşılığı (%{son ? sayiYaz(son.tcmbFaiz, 2) : '3,08'}), hem İTO (%{son?.ito ? sayiYaz(son.ito, 2) : '2,11'}) hem de TÜFE (%{son ? sayiYaz(son.tufe, 2) : '1,84'}) enflasyonunun üzerinde seyretmektedir.
      </p>
    </div>
  </aside>
</section>

<style>
  .reel-getiri-bolumu {
    margin: 40px 0;
    padding: 24px;
    background: var(--paper);
    border: 1px solid var(--hair);
  }

  .reel-getiri-baslik-alani {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 20px;
  }

  .baslik-metin {
    max-width: 540px;
  }

  .bolum-rozet {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--toprak-text);
    margin-bottom: 4px;
  }

  .bolum-baslik {
    margin: 0 0 6px 0;
    font-family: var(--sans);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink);
  }

  .bolum-aciklama {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .grafik-lejant-kutusu {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: var(--paper-2);
    padding: 12px 16px;
    border: 1px solid var(--hair);
    min-width: 220px;
  }

  .lejant-oge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--sans);
    font-size: 0.85rem;
  }

  .lejant-cizgi {
    width: 16px;
    height: 3px;
    border-radius: 1px;
  }

  .lejant-tcmb .lejant-cizgi { background: #3f7350; }
  .lejant-ito .lejant-cizgi { background: #2d5a7b; }
  .lejant-tufe .lejant-cizgi { background: #a3243b; }

  .lejant-ad {
    color: var(--ink-2);
    flex-grow: 1;
  }

  .lejant-deger {
    font-feature-settings: 'tnum';
    color: var(--ink);
  }

  .grafik-sarma {
    width: 100%;
    overflow-x: auto;
    margin: 16px 0;
    padding-bottom: 8px;
  }

  .reel-svg {
    display: block;
    width: 100%;
    min-width: 640px;
    height: auto;
    overflow: visible;
  }

  .eksen-yazi {
    font-family: var(--sans);
    font-size: 11px;
    fill: var(--muted);
    font-feature-settings: 'tnum';
  }

  .son-deger-yazi {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 700;
    font-feature-settings: 'tnum';
  }

  .nokta-kolon .hover-kilavuz {
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .nokta-kolon:hover .hover-kilavuz,
  .nokta-kolon:focus .hover-kilavuz {
    opacity: 1;
  }

  .kolon-tetikleyici {
    cursor: crosshair;
  }

  .grafik-rehber-kutusu {
    margin-top: 24px;
    padding: 16px 20px;
    background: var(--paper-2);
    border-left: 4px solid var(--toprak);
  }

  .rehber-baslik-alani {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .rehber-simge {
    color: var(--toprak);
    flex-shrink: 0;
  }

  .rehber-baslik-alani h3 {
    margin: 0;
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
  }

  .rehber-govde p {
    margin: 0 0 8px 0;
    font-family: var(--sans);
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .rehber-govde p:last-child {
    margin-bottom: 0;
  }

  .renk-yesil { color: #3f7350; font-weight: 600; }
  .renk-mavi { color: #2d5a7b; font-weight: 600; }
  .renk-kirmizi { color: #a3243b; font-weight: 600; }

  @media (max-width: 640px) {
    .reel-getiri-bolumu {
      padding: 16px;
    }

    .grafik-lejant-kutusu {
      width: 100%;
    }
  }
</style>
