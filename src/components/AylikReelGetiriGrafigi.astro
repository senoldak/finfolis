---
import { RESMI, sayiYaz } from '../lib/resmi';
import itoVerisi from '../data/ito-enflasyon.json';
import { birlestirReelGetiriVerisi } from '../lib/reel-getiri.mjs';

// Son 21 ayı al (Ocak 2025 - Eylül 2026)
const noktalar = birlestirReelGetiriVerisi({
  tufeSatirlari: RESMI.enflasyon?.satirlar ?? [],
  itoSatirlari: itoVerisi.satirlar ?? [],
  faizGecmisi: RESMI.faiz?.gecmis ?? [],
  aySayisi: 21,
});

const W = 880;
const H = 380;
const PAD_L = 50;
const PAD_R = 75;
const PAD_T = 30;
const PAD_B = 45;

const plotW = W - PAD_L - PAD_R;
const plotH = H - PAD_T - PAD_B;

// Y ekseni min 0, max 6 (% değişim)
const minVal = 0;
const maxVal = 6;
const valRange = maxVal - minVal;

const x = (i: number, len = noktalar.length) => PAD_L + (i / Math.max(len - 1, 1)) * plotW;
const y = (v: number) => PAD_T + (1 - (v - minVal) / valRange) * plotH;

// Y ekseni çizgileri: %0, %1, %2, %3, %4, %5, %6
const yKılavuzlar = [0, 1, 2, 3, 4, 5, 6];

// Başlangıç çizgi yolları (SSR)
const tufeYol = noktalar.map((p, i) => `${i === 0 ? 'M' : 'L'} ${x(i).toFixed(1)} ${y(p.tufe).toFixed(1)}`).join(' ');
const itoNoktalari = noktalar.filter((p) => p.ito != null);
const itoYol = itoNoktalari.map((p, i) => {
  const index = noktalar.indexOf(p);
  return `${i === 0 ? 'M' : 'L'} ${x(index).toFixed(1)} ${y(p.ito!).toFixed(1)}`;
}).join(' ');
const tcmbYol = noktalar.map((p, i) => `${i === 0 ? 'M' : 'L'} ${x(i).toFixed(1)} ${y(p.tcmbFaiz).toFixed(1)}`).join(' ');

const son = noktalar.at(-1);
---

<section
  class="reel-getiri-bolumu"
  id="reel-getiri-kapsayici"
  data-noktalar={JSON.stringify(noktalar)}
  aria-labelledby="reel-getiri-baslik"
>
  <div class="reel-getiri-baslik-alani">
    <div class="baslik-metin">
      <span class="bolum-rozet">İnteraktif Karşılaştırma</span>
      <h2 id="reel-getiri-baslik" class="bolum-baslik">Aylık Reel Getiri & Enflasyon Kıyası</h2>
      <p class="bolum-aciklama">
        TCMB politika faizinin aylık basit getirisi ile TÜİK ve İTO aylık enflasyonları. Grafikte bir aya dokunarak detayları inceleyebilirsiniz.
      </p>
    </div>

    <!-- Dönem Filtre Butonları -->
    <div class="filtre-ve-kontroller">
      <div class="donem-filtreleri" role="group" aria-label="Zaman aralığı seçimi">
        <button type="button" class="donem-btn" data-ay="12">Son 12 Ay</button>
        <button type="button" class="donem-btn aktif" data-ay="21">Son 21 Ay</button>
      </div>
    </div>
  </div>

  <!-- İnteraktif Seri Aç/Kapa Lejantı -->
  <div class="grafik-lejant-kutusu" role="toolbar" aria-label="Göstergeleri aç/kapat">
    <button type="button" class="lejant-btn aktif" id="btn-tcmb" data-seri="tcmb" title="TCMB serisini gizle/göster">
      <span class="lejant-cizgi cizgi-tcmb"></span>
      <span class="lejant-ad">TCMB aylık faiz</span>
      <strong class="lejant-deger" id="lejant-tcmb-val">%{son ? sayiYaz(son.tcmbFaiz, 2) : '3,08'}</strong>
    </button>
    <button type="button" class="lejant-btn aktif" id="btn-ito" data-seri="ito" title="İTO serisini gizle/göster">
      <span class="lejant-cizgi cizgi-ito"></span>
      <span class="lejant-ad">İTO perakende</span>
      <strong class="lejant-deger" id="lejant-ito-val">%{son?.ito ? sayiYaz(son.ito, 2) : '2,11'}</strong>
    </button>
    <button type="button" class="lejant-btn aktif" id="btn-tufe" data-seri="tufe" title="TÜFE serisini gizle/göster">
      <span class="lejant-cizgi cizgi-tufe"></span>
      <span class="lejant-ad">TÜİK resmi TÜFE</span>
      <strong class="lejant-deger" id="lejant-tufe-val">%{son ? sayiYaz(son.tufe, 2) : '1,84'}</strong>
    </button>
  </div>

  <!-- Grafik Alanı ve Dinamik Takipçi -->
  <div class="grafik-sarma" id="grafik-alani">
    <svg class="reel-svg" id="reel-svg-el" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Aylık enflasyon ve faiz karşılaştırma grafiği">
      <!-- Arka Plan Grid Çizgileri -->
      <g class="grid-cizgileri">
        {yKılavuzlar.map((val) => (
          <g class="grid-satir">
            <line
              x1={PAD_L}
              y1={y(val)}
              x2={W - PAD_R}
              y2={y(val)}
              stroke="var(--soluk)"
              stroke-width={val === 0 ? "1.5" : "1"}
              stroke-dasharray={val === 0 ? undefined : "3 3"}
            />
            <text x={PAD_L - 10} y={y(val) + 4} text-anchor="end" class="eksen-yazi">
              {sayiYaz(val, 2)}
            </text>
          </g>
        ))}
      </g>

      <!-- Çizgiler -->
      <path id="seri-tcmb-path" d={tcmbYol} fill="none" stroke="#3f7350" stroke-width="2.75" stroke-linejoin="round" stroke-linecap="round" />
      <path id="seri-ito-path" d={itoYol} fill="none" stroke="#2d5a7b" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" />
      <path id="seri-tufe-path" d={tufeYol} fill="none" stroke="#a3243b" stroke-width="2.75" stroke-linejoin="round" stroke-linecap="round" />

      <!-- X Ekseni Etiketleri Grubu -->
      <g id="x-eksen-grubu" class="x-eksen-yazilari">
        {noktalar.map((p, i) => {
          const etiketGoster = i % 2 === 0 || i === noktalar.length - 1;
          return etiketGoster ? (
            <text x={x(i)} y={H - 15} text-anchor="middle" class="eksen-yazi">
              {p.etiket}
            </text>
          ) : null;
        })}
      </g>

      <!-- Dinamik Takip Çizgisi ve Noktaları (CSP için inline style yerine SVG visibility kullanılır) -->
      <g id="takip-grubu" class="takip-grubu" visibility="hidden">
        <line id="takip-cizgi" x1="0" y1={PAD_T} x2="0" y2={H - PAD_B} stroke="var(--ink)" stroke-width="1.2" stroke-dasharray="3 3" />
        <circle id="takip-nokta-tcmb" cx="0" cy="0" r="5" fill="#3f7350" stroke="#ffffff" stroke-width="2" />
        <circle id="takip-nokta-ito" cx="0" cy="0" r="4.5" fill="#2d5a7b" stroke="#ffffff" stroke-width="2" />
        <circle id="takip-nokta-tufe" cx="0" cy="0" r="5" fill="#a3243b" stroke="#ffffff" stroke-width="2" />
      </g>

      <!-- Sağ uçtaki son değer metinleri -->
      {son && (
        <g id="son-degerler-grubu" class="son-degerler">
          <text id="son-val-tcmb" x={x(noktalar.length - 1) + 10} y={y(son.tcmbFaiz) + 4} fill="#3f7350" class="son-deger-yazi">
            {sayiYaz(son.tcmbFaiz, 2)}
          </text>
          {son.ito != null && (
            <text id="son-val-ito" x={x(noktalar.length - 1) + 10} y={y(son.ito) + 4} fill="#2d5a7b" class="son-deger-yazi">
              {sayiYaz(son.ito, 2)}
            </text>
          )}
          <text id="son-val-tufe" x={x(noktalar.length - 1) + 10} y={y(son.tufe) + 4} fill="#a3243b" class="son-deger-yazi">
            {sayiYaz(son.tufe, 2)}
          </text>
        </g>
      )}

      <!-- SVG İçi Güvenli Tooltip (CSP dostu: HTML inline style yerine doğrudan SVG transform ile taşınır) -->
      <g id="svg-tooltip-grubu" class="svg-tooltip" visibility="hidden">
        <rect id="tt-bg" class="tt-kutu" x="0" y="0" width="200" height="114" rx="2" />
        <text id="tt-tarih" class="tt-baslik" x="12" y="22">Eylül 2026</text>
        <line x1="12" y1="28" x2="188" y2="28" stroke="var(--soluk)" stroke-width="1" />
        <!-- TCMB -->
        <circle cx="18" cy="42" r="3.5" fill="#3f7350" />
        <text class="tt-etiket" x="28" y="45">TCMB Faiz:</text>
        <text id="tt-tcmb" class="tt-rakam" x="188" y="45" text-anchor="end">%3,08</text>
        <!-- İTO -->
        <circle cx="18" cy="62" r="3.5" fill="#2d5a7b" />
        <text class="tt-etiket" x="28" y="65">İTO Enflasyon:</text>
        <text id="tt-ito" class="tt-rakam" x="188" y="65" text-anchor="end">%2,11</text>
        <!-- TÜFE -->
        <circle cx="18" cy="82" r="3.5" fill="#a3243b" />
        <text class="tt-etiket" x="28" y="85">TÜİK TÜFE:</text>
        <text id="tt-tufe" class="tt-rakam" x="188" y="85" text-anchor="end">%1,84</text>
        <!-- Durum Rozeti -->
        <line x1="12" y1="92" x2="188" y2="92" stroke="var(--soluk)" stroke-width="1" stroke-dasharray="2 2" />
        <text id="tt-durum" class="tt-durum" x="100" y="106" text-anchor="middle">+1,24 puan reel getiri</text>
      </g>

      <!-- Şeffaf Etkileşim Katmanı -->
      <rect
        id="etkilesim-yuzeyi"
        class="etkilesim-katmani"
        x={PAD_L}
        y={PAD_T}
        width={plotW}
        height={plotH}
        fill="transparent"
      />
    </svg>
  </div>

  <!-- İnteraktif Alım Gücü Simülasyonu -->
  <div class="reel-simulasyon-karti">
    <div class="simulasyon-baslik">
      <strong id="sim-ay-adi">{son ? son.tamEtiket : 'Son Ay'}</strong> İtibarıyla 10.000 TL Tasarrufun Aylık Akıbeti:
    </div>
    <div class="simulasyon-izgara">
      <div class="sim-kutu sim-kazanc">
        <span class="sim-etiket">TCMB Aylık Faiz Getirisi</span>
        <span class="sim-tutar" id="sim-faiz-tl">+308 TL</span>
      </div>
      <div class="sim-kutu sim-kayip">
        <span class="sim-etiket">TÜFE Enflasyonu Erimişi</span>
        <span class="sim-tutar" id="sim-enflasyon-tl">-184 TL</span>
      </div>
      <div class="sim-kutu sim-net sim-net-pozitif" id="sim-net-kutu">
        <span class="sim-etiket">Net Aylık Alım Gücü</span>
        <span class="sim-tutar" id="sim-net-tl">+124 TL</span>
      </div>
    </div>
  </div>

  <!-- "Bu grafik ne anlatır?" Rehber Kutusu -->
  <aside class="grafik-rehber-kutusu">
    <div class="rehber-baslik-alani">
      <svg class="rehber-simge" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="16" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12.01" y2="8" />
      </svg>
      <h3>Bu grafik ne anlatır?</h3>
    </div>
    <div class="rehber-govde">
      <p>
        <strong>Aylık Reel Getiri Dengesi:</strong> Tasarruf sahibinin parasının alım gücünü koruyabilmesi için TL faiz getirisinin (<span class="renk-yesil">yeşil çizgi</span>), çarşı-pazarda hissedilen aylık fiyat artışının (<span class="renk-mavi">mavi çizgi</span>) ve resmi enflasyonun (<span class="renk-kirmizi">kırmızı çizgi</span>) üzerinde kalması gerekir.
      </p>
      <p>
        Kırmızı ve mavi çizgilerin yeşil çizginin altında kaldığı aylar, mevduat/TL faizinin aylık enflasyonu yendiğini (pozitif aylık reel faiz sağlandığını) ifade eder.
      </p>
    </div>
  </aside>
</section>

<!-- CSP Uyumlu Harici Paketlenmiş İstemci Kodu (Astro bundle ile /_astro/*.js olarak sunulur, CSP script-src 'self' ile 100% uyumludur) -->
<script>
  interface NoktaVeri {
    yil: number;
    ay: number;
    etiket: string;
    tamEtiket: string;
    tufe: number;
    ito: number | null;
    tcmbFaiz: number;
    reelFark: number;
  }

  const kapsayici = document.getElementById('reel-getiri-kapsayici');
  if (kapsayici) {
    const rawData: NoktaVeri[] = JSON.parse(kapsayici.getAttribute('data-noktalar') || '[]');
    const yuzey = document.getElementById('etkilesim-yuzeyi') as SVGRectElement | null;
    const takipGrubu = document.getElementById('takip-grubu') as SVGGElement | null;
    const takipCizgi = document.getElementById('takip-cizgi') as SVGLineElement | null;
    const takipTcmb = document.getElementById('takip-nokta-tcmb') as SVGCircleElement | null;
    const takipIto = document.getElementById('takip-nokta-ito') as SVGCircleElement | null;
    const takipTufe = document.getElementById('takip-nokta-tufe') as SVGCircleElement | null;
    const svgTooltip = document.getElementById('svg-tooltip-grubu') as SVGGElement | null;

    const ttTarih = document.getElementById('tt-tarih');
    const ttTcmb = document.getElementById('tt-tcmb');
    const ttIto = document.getElementById('tt-ito');
    const ttTufe = document.getElementById('tt-tufe');
    const ttDurum = document.getElementById('tt-durum');

    const simAyAdi = document.getElementById('sim-ay-adi');
    const simFaizTl = document.getElementById('sim-faiz-tl');
    const simEnfTl = document.getElementById('sim-enflasyon-tl');
    const simNetTl = document.getElementById('sim-net-tl');
    const simNetKutu = document.getElementById('sim-net-kutu');

    const pathTcmb = document.getElementById('seri-tcmb-path') as SVGPathElement | null;
    const pathIto = document.getElementById('seri-ito-path') as SVGPathElement | null;
    const pathTufe = document.getElementById('seri-tufe-path') as SVGPathElement | null;
    const xEksenGrubu = document.getElementById('x-eksen-grubu');

    const sonValTcmb = document.getElementById('son-val-tcmb');
    const sonValIto = document.getElementById('son-val-ito');
    const sonValTufe = document.getElementById('son-val-tufe');

    if (yuzey && rawData.length > 0) {
      let aktifNoktalar = [...rawData];
      const W = 880;
      const H = 380;
      const PAD_L = 50;
      const PAD_R = 75;
      const PAD_T = 30;
      const PAD_B = 45;
      const minVal = 0;
      const maxVal = 6;

      const plotW = W - PAD_L - PAD_R;
      const plotH = H - PAD_T - PAD_B;
      const valRange = maxVal - minVal;

      const hesaplaX = (i: number, len: number) => PAD_L + (i / Math.max(len - 1, 1)) * plotW;
      const hesaplaY = (v: number) => PAD_T + (1 - (v - minVal) / valRange) * plotH;

      function ciz(yeniNoktalar: NoktaVeri[]) {
        aktifNoktalar = yeniNoktalar;
        const len = aktifNoktalar.length;

        // TCMB path
        if (pathTcmb) {
          const tcmbD = aktifNoktalar.map((p, i) => `${i === 0 ? 'M' : 'L'} ${hesaplaX(i, len).toFixed(1)} ${hesaplaY(p.tcmbFaiz).toFixed(1)}`).join(' ');
          pathTcmb.setAttribute('d', tcmbD);
        }

        // İTO path
        if (pathIto) {
          const itoD = aktifNoktalar
            .filter((p) => p.ito != null)
            .map((p, i) => {
              const idx = aktifNoktalar.indexOf(p);
              return `${i === 0 ? 'M' : 'L'} ${hesaplaX(idx, len).toFixed(1)} ${hesaplaY(p.ito!).toFixed(1)}`;
            }).join(' ');
          pathIto.setAttribute('d', itoD);
        }

        // TÜFE path
        if (pathTufe) {
          const tufeD = aktifNoktalar.map((p, i) => `${i === 0 ? 'M' : 'L'} ${hesaplaX(i, len).toFixed(1)} ${hesaplaY(p.tufe).toFixed(1)}`).join(' ');
          pathTufe.setAttribute('d', tufeD);
        }

        // X ekseni
        if (xEksenGrubu) {
          xEksenGrubu.innerHTML = '';
          aktifNoktalar.forEach((p, i) => {
            const goster = i % 2 === 0 || i === len - 1;
            if (goster) {
              const txt = document.createElementNS('http://www.w3.org/2000/svg', 'text');
              txt.setAttribute('x', String(hesaplaX(i, len)));
              txt.setAttribute('y', String(H - 15));
              txt.setAttribute('text-anchor', 'middle');
              txt.setAttribute('class', 'eksen-yazi');
              txt.textContent = p.etiket;
              xEksenGrubu.appendChild(txt);
            }
          });
        }

        // Son değerler
        const sonNokta = aktifNoktalar[len - 1];
        if (sonNokta) {
          const lastX = String(hesaplaX(len - 1, len) + 10);
          if (sonValTcmb) {
            sonValTcmb.setAttribute('x', lastX);
            sonValTcmb.setAttribute('y', String(hesaplaY(sonNokta.tcmbFaiz) + 4));
            sonValTcmb.textContent = sonNokta.tcmbFaiz.toLocaleString('tr-TR', { minimumFractionDigits: 2 });
          }
          if (sonValIto && sonNokta.ito != null) {
            sonValIto.setAttribute('x', lastX);
            sonValIto.setAttribute('y', String(hesaplaY(sonNokta.ito) + 4));
            sonValIto.textContent = sonNokta.ito.toLocaleString('tr-TR', { minimumFractionDigits: 2 });
          }
          if (sonValTufe) {
            sonValTufe.setAttribute('x', lastX);
            sonValTufe.setAttribute('y', String(hesaplaY(sonNokta.tufe) + 4));
            sonValTufe.textContent = sonNokta.tufe.toLocaleString('tr-TR', { minimumFractionDigits: 2 });
          }
          guncelleSimulasyon(sonNokta);
        }
      }

      function guncelleSimulasyon(p: NoktaVeri) {
        if (!p || !simAyAdi || !simFaizTl || !simEnfTl || !simNetTl || !simNetKutu) return;
        simAyAdi.textContent = p.tamEtiket;
        const anapara = 10000;
        const faizGetirisi = Math.round((anapara * p.tcmbFaiz) / 100);
        const enfKaybi = Math.round((anapara * p.tufe) / 100);
        const net = faizGetirisi - enfKaybi;

        simFaizTl.textContent = `+${faizGetirisi.toLocaleString('tr-TR')} TL`;
        simEnfTl.textContent = `-${enfKaybi.toLocaleString('tr-TR')} TL`;
        simNetTl.textContent = `${net >= 0 ? '+' : ''}${net.toLocaleString('tr-TR')} TL`;

        if (net >= 0) {
          simNetKutu.className = 'sim-kutu sim-net sim-net-pozitif';
        } else {
          simNetKutu.className = 'sim-kutu sim-net sim-net-negatif';
        }
      }

      // Dönem filtre butonları
      const donemBtnler = kapsayici.querySelectorAll<HTMLButtonElement>('.donem-btn');
      donemBtnler.forEach((btn) => {
        btn.addEventListener('click', () => {
          donemBtnler.forEach((b) => b.classList.remove('aktif'));
          btn.classList.add('aktif');
          const aySayisi = Number(btn.getAttribute('data-ay') || 21);
          ciz(rawData.slice(-aySayisi));
        });
      });

      // Seri Aç/Kapa butonları (CSP için SVG visibility kullanılır)
      const seriBtnler = kapsayici.querySelectorAll<HTMLButtonElement>('.lejant-btn');
      seriBtnler.forEach((btn) => {
        btn.addEventListener('click', () => {
          const seri = btn.getAttribute('data-seri');
          const aktif = btn.classList.toggle('aktif');
          const gorunurluk = aktif ? 'visible' : 'hidden';

          if (seri === 'tcmb') {
            if (pathTcmb) pathTcmb.setAttribute('visibility', gorunurluk);
            if (sonValTcmb) sonValTcmb.setAttribute('visibility', gorunurluk);
            if (takipTcmb) takipTcmb.setAttribute('visibility', gorunurluk);
          } else if (seri === 'ito') {
            if (pathIto) pathIto.setAttribute('visibility', gorunurluk);
            if (sonValIto) sonValIto.setAttribute('visibility', gorunurluk);
            if (takipIto) takipIto.setAttribute('visibility', gorunurluk);
          } else if (seri === 'tufe') {
            if (pathTufe) pathTufe.setAttribute('visibility', gorunurluk);
            if (sonValTufe) sonValTufe.setAttribute('visibility', gorunurluk);
            if (takipTufe) takipTufe.setAttribute('visibility', gorunurluk);
          }
        });
      });

      // Fare / Dokunmatik Takipçi (SVG içindeki koordinatlarla ve SVG transform ile taşınır)
      function fareTakip(clientX: number) {
        if (!yuzey || !takipGrubu || !takipCizgi || !takipTcmb || !takipTufe || !svgTooltip) return;
        const rect = yuzey.getBoundingClientRect();
        const relX = clientX - rect.left;
        if (relX < 0 || relX > rect.width) {
          gizle();
          return;
        }

        const len = aktifNoktalar.length;
        const index = Math.max(0, Math.min(len - 1, Math.round((relX / rect.width) * (len - 1))));
        const p = aktifNoktalar[index];
        if (!p) return;

        const curX = hesaplaX(index, len);
        takipGrubu.setAttribute('visibility', 'visible');
        takipCizgi.setAttribute('x1', String(curX));
        takipCizgi.setAttribute('x2', String(curX));

        takipTcmb.setAttribute('cx', String(curX));
        takipTcmb.setAttribute('cy', String(hesaplaY(p.tcmbFaiz)));

        if (takipIto) {
          if (p.ito != null) {
            takipIto.setAttribute('cx', String(curX));
            takipIto.setAttribute('cy', String(hesaplaY(p.ito)));
            takipIto.setAttribute('visibility', 'visible');
          } else {
            takipIto.setAttribute('visibility', 'hidden');
          }
        }

        takipTufe.setAttribute('cx', String(curX));
        takipTufe.setAttribute('cy', String(hesaplaY(p.tufe)));

        // SVG Tooltip doldur
        if (ttTarih) ttTarih.textContent = p.tamEtiket;
        if (ttTcmb) ttTcmb.textContent = `%${p.tcmbFaiz.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}`;
        if (ttIto) ttIto.textContent = p.ito != null ? `%${p.ito.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}` : 'Veri yok';
        if (ttTufe) ttTufe.textContent = `%${p.tufe.toLocaleString('tr-TR', { minimumFractionDigits: 2 })}`;

        if (ttDurum) {
          if (p.reelFark >= 0) {
            ttDurum.textContent = `+${p.reelFark.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} puan reel getiri`;
            ttDurum.setAttribute('class', 'tt-durum durum-pozitif');
          } else {
            ttDurum.textContent = `${p.reelFark.toLocaleString('tr-TR', { minimumFractionDigits: 2 })} puan negatif reel faiz`;
            ttDurum.setAttribute('class', 'tt-durum durum-negatif');
          }
        }

        // Tooltip konumu (SVG içinde sol/sağ taşma kontrolü)
        let ttX = curX + 14;
        if (ttX + 210 > W - PAD_R) {
          ttX = curX - 214;
        }
        const ttY = Math.max(10, Math.min(H - PAD_B - 120, hesaplaY(p.tufe) - 50));
        svgTooltip.setAttribute('transform', `translate(${ttX.toFixed(1)}, ${ttY.toFixed(1)})`);
        svgTooltip.setAttribute('visibility', 'visible');

        guncelleSimulasyon(p);
      }

      function gizle() {
        if (takipGrubu) takipGrubu.setAttribute('visibility', 'hidden');
        if (svgTooltip) svgTooltip.setAttribute('visibility', 'hidden');
        const sonNokta = aktifNoktalar[aktifNoktalar.length - 1];
        if (sonNokta) guncelleSimulasyon(sonNokta);
      }

      yuzey.addEventListener('mousemove', (e) => fareTakip(e.clientX));
      yuzey.addEventListener('mouseleave', gizle);

      yuzey.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0) fareTakip(e.touches[0].clientX);
      }, { passive: true });

      yuzey.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) fareTakip(e.touches[0].clientX);
      }, { passive: true });

      yuzey.addEventListener('touchend', gizle);
    }
  }
</script>

