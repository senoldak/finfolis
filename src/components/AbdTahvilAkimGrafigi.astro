---
// Türkiye'nin Aylık ABD Hazine Tahvili Net Alım-Satımları (TIC) İnteraktif Grafiği
// finfolis tasarım dili: Kâğıt & mürekkep, sıfır harici JS kütüphanesi bağımlılığı.
export interface TahvilAkimNokta {
  donem: string; // '2026-08'
  etiket: string; // 'Ağustos 2026'
  netAkim: number; // Milyon USD
  stok: number | null; // Milyon USD
  tcmbStok: number | null; // Milyon USD
  tcmbAylikFark: number | null; // Milyon USD
}

interface Props {
  seri: TahvilAkimNokta[];
}

const { seri = [] } = Astro.props;

// Varsayılan görünüm: 2024-03'ten itibaren (Görseldeki periyot, yaklaşık son 30 ay)
const varsayilanSeri = seri.filter((s) => s.donem >= '2024-03');

// SVG Sabit Koordinatları
const W = 920;
const H = 420;
const PAD_TOP = 45;
const PAD_BOTTOM = 65;
const PAD_LEFT = 65;
const PAD_RIGHT = 35;

const innerW = W - PAD_LEFT - PAD_RIGHT;
const innerH = H - PAD_TOP - PAD_BOTTOM;

// İlk SSR Y ekseni sınırları
const vals = varsayilanSeri.map((d) => d.netAkim);
const minValSSR = -15000;
const maxValSSR = 11000;
const rangeSSR = maxValSSR - minValSSR;

const yToPx = (v: number) => PAD_TOP + (1 - (v - minValSSR) / rangeSSR) * innerH;
const sifirY = yToPx(0);

// Izgara seviyeleri
const izgaraSeviyeleriSSR = [-15000, -10000, -5000, 0, 5000, 10000];

// Barlar
const n = varsayilanSeri.length;
const slotW = innerW / Math.max(n, 1);
const barW = Math.max(10, Math.min(22, slotW * 0.72));

// Son nokta
const sonNokta = varsayilanSeri.at(-1) ?? {
  donem: '—',
  etiket: '—',
  netAkim: 0,
  stok: 0,
  tcmbStok: 0,
  tcmbAylikFark: 0,
};

// Son 4 ay toplamı (Nisan-Ağustos 2026)
const son4AyItems = seri.filter((s) => s.donem >= '2026-04' && s.donem <= '2026-08');
const son4AyTicNet = son4AyItems.reduce((acc, s) => acc + s.netAkim, 0);
---

<div class="interaktif-grafik-kapsayici" data-abd-tahvil-grafik data-seri={JSON.stringify(seri)}>
  <!-- Üst Bar: Başlık ve Filtre Düğmeleri -->
  <div class="grafik-kontrol-cubugu">
    <div class="grafik-baslik-alani">
      <h3 class="grafik-ana-baslik">Türkiye'nin aylık ABD tahvili alım-satımları</h3>
      <p class="grafik-alt-bilgi">Milyon USD · ABD Hazine Bakanlığı (TIC: FORTREASNET12807) &amp; TCMB Rezerv Portföyü</p>
    </div>

    <div class="grafik-filtre-kumeleri">
      <!-- Görünüm Seçici -->
      <div class="dugme-kumesi" role="group" aria-label="Grafik görünüm modu">
        <button type="button" class="filtre-btn aktif" data-mod="bar">Aylık Net Akım</button>
        <button type="button" class="filtre-btn" data-mod="karsilastirma">TIC vs TCMB</button>
        <button type="button" class="filtre-btn" data-mod="kumulatif">Kümülatif Akım</button>
      </div>

      <!-- Zaman Aralığı -->
      <div class="dugme-kumesi" role="group" aria-label="Zaman aralığı filtreleri">
        <button type="button" class="filtre-btn" data-aralik="12">Son 12 Ay</button>
        <button type="button" class="filtre-btn aktif" data-aralik="2024">2024'ten Bugüne</button>
        <button type="button" class="filtre-btn" data-aralik="60">Son 5 Yıl</button>
        <button type="button" class="filtre-btn" data-aralik="tum">Tümü (2018–26)</button>
      </div>
    </div>
  </div>

  <!-- Canlı İnceleme ve KPI Kartları -->
  <div class="canli-gosterge-paneli">
    <div class="canli-kutu">
      <span class="canli-etiket">Seçili Dönem</span>
      <span class="canli-deger" id="tic-canli-donem">{sonNokta.etiket}</span>
      <span class="canli-alt" id="tic-canli-kod">{sonNokta.donem}</span>
    </div>

    <div class="canli-kutu">
      <span class="canli-etiket">TIC Net Tahvil Alım/Satımı</span>
      <span class={`canli-deger ${sonNokta.netAkim >= 0 ? 'pozitif' : 'negatif'}`} id="tic-canli-net">
        {sonNokta.netAkim >= 0 ? '+' : ''}{sonNokta.netAkim.toLocaleString('tr-TR')} M $
      </span>
      <span class="canli-alt" id="tic-canli-milyar">
        {sonNokta.netAkim >= 0 ? '+' : ''}{(sonNokta.netAkim / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} milyar $
      </span>
    </div>

    <div class="canli-kutu">
      <span class="canli-etiket">TCMB Menkul Değişimi (Δ)</span>
      <span class="canli-deger ikincil-sayi" id="tic-canli-tcmb-fark">
        {sonNokta.tcmbAylikFark !== null ? (sonNokta.tcmbAylikFark >= 0 ? `+${sonNokta.tcmbAylikFark.toLocaleString('tr-TR')} M $` : `${sonNokta.tcmbAylikFark.toLocaleString('tr-TR')} M $`) : '—'}
      </span>
      <span class="canli-alt" id="tic-canli-tcmb-stok">
        Stok: {sonNokta.tcmbStok ? `$${(sonNokta.tcmbStok / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} Mr` : '—'}
      </span>
    </div>

    <div class="canli-kutu">
      <span class="canli-etiket">Toplam ABD Tahvil Stoğu</span>
      <span class="canli-deger ikincil-sayi" id="tic-canli-stok">
        {sonNokta.stok ? `$${(sonNokta.stok / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} milyar` : '—'}
      </span>
      <span class="canli-alt">Kısa + Uzun Hazine Portföyü</span>
    </div>

    <div class="canli-kutu" style="align-items: flex-start; justify-content: center;">
      <span class="canli-etiket">Durum &amp; Analiz</span>
      <span class="durum-rozet pozitif-rozet" id="tic-canli-rozet">
        {sonNokta.netAkim >= 0 ? 'Net Tahvil Alımı' : 'Net Tahvil Satışı / İtfa'}
      </span>
    </div>
  </div>

  <!-- SVG Çizim Alanı -->
  <div class="svg-cerceve">
    <svg viewBox={`0 0 ${W} ${H}`} class="tic-svg-grafigi" role="img" aria-label="Türkiye'nin aylık ABD tahvili alım-satımları grafiği">
      <!-- Vurgu Kutusu Katmanı (Son 4-5 ay açık sarı arka plan) -->
      <g id="tic-katman-vurgu"></g>

      <!-- Izgara Katmanı -->
      <g id="tic-katman-izgara">
        {izgaraSeviyeleriSSR.map((iv) => {
          const y = yToPx(iv);
          const isZero = iv === 0;
          return (
            <g>
              <line
                x1={PAD_LEFT}
                y1={y.toFixed(1)}
                x2={W - PAD_RIGHT}
                y2={y.toFixed(1)}
                stroke={isZero ? '#18181b' : '#e4e4e7'}
                stroke-width={isZero ? '1.5' : '1'}
                stroke-dasharray={isZero ? 'none' : '3 3'}
              />
              <text
                x={PAD_LEFT - 12}
                y={(y + 4).toFixed(1)}
                fill={isZero ? '#18181b' : '#71717a'}
                font-size="11"
                font-weight={isZero ? '700' : '400'}
                text-anchor="end"
              >
                {iv === 0 ? '0' : (iv > 0 ? `+${iv / 1000}.000` : `${iv / 1000}.000`)}
              </text>
            </g>
          );
        })}
      </g>

      <!-- Barlar Katmanı -->
      <g id="tic-katman-barlar">
        {varsayilanSeri.map((item, i) => {
          const x = PAD_LEFT + i * slotW + (slotW - barW) / 2;
          const val = item.netAkim;
          const yVal = yToPx(val);
          const barY = val >= 0 ? yVal : sifirY;
          const barH = Math.max(2, Math.abs(yVal - sifirY));
          const dolgu = val >= 0 ? '#2563eb' : '#c2502b';

          return (
            <rect
              class="tic-bar-eleman"
              x={x.toFixed(1)}
              y={barY.toFixed(1)}
              width={barW.toFixed(1)}
              height={barH.toFixed(1)}
              fill={dolgu}
              rx="1"
              data-idx={i}
            />
          );
        })}
      </g>

      <!-- Çizgi / Kümülatif Katmanı -->
      <g id="tic-katman-cizgi" style="display: none;">
        <path id="tic-cizgi-yolu" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        <path id="tic-alan-yolu" fill="#2563eb" fill-opacity="0.08" />
        <path id="tic-tcmb-cizgi-yolu" fill="none" stroke="#c2502b" stroke-width="2" stroke-dasharray="4 4" stroke-linecap="round" />
      </g>

      <!-- Etiketler Katmanı (Tepe/Dip Değerler) -->
      <g id="tic-katman-etiketler"></g>

      <!-- X Ekseni Tarih Etiketleri -->
      <g id="tic-katman-tarihler"></g>

      <!-- İnteraktif Kılavuz Çizgisi ve Odak Noktası -->
      <line id="tic-rehber-dikey" y1={PAD_TOP} y2={H - PAD_BOTTOM} stroke="#1b1b1b" stroke-width="1.2" stroke-dasharray="3 3" style="display: none; pointer-events: none;" />
      <circle id="tic-odak-noktasi" r="5" fill="#2563eb" stroke="#ffffff" stroke-width="2" style="display: none; pointer-events: none;" />

      <!-- Tooltip Kutusu (SVG içinde gezen balon) -->
      <g id="tic-tooltip-grup" style="display: none; pointer-events: none;">
        <rect id="tic-tooltip-bg" fill="#1b1b1b" rx="4" opacity="0.92" />
        <text id="tic-tooltip-tarih" fill="#e4e4e7" font-size="11" font-weight="600" />
        <text id="tic-tooltip-deger" fill="#ffffff" font-size="13" font-weight="700" />
        <text id="tic-tooltip-ek" fill="#93c5fd" font-size="10" />
      </g>

      <!-- Şeffaf Etkileşim Katmanı -->
      <rect
        id="tic-etkilesim-alani"
        x={PAD_LEFT}
        y={PAD_TOP}
        width={innerW}
        height={innerH}
        fill="transparent"
        style="cursor: crosshair;"
      />
    </svg>
  </div>

  <!-- Lejant ve Kaynak Notu -->
  <div class="grafik-alt-bilgiler">
    <div class="grafik-lejant" id="tic-lejant-alani">
      <span class="lejant-oge">
        <span class="renk-kutu pozitif-kutu"></span> Pozitif: Net Tahvil Alımı (Mavi)
      </span>
      <span class="lejant-oge">
        <span class="renk-kutu negatif-kutu"></span> Negatif: Net Tahvil Satışı / İtfa (Kırmızı)
      </span>
      <span class="lejant-oge vurgu-lejant">
        <span class="renk-kutu sari-kutu"></span> Son 4-5 Ay Alım Dönemi (~$4 Mr)
      </span>
    </div>
    <div class="grafik-kaynak-notu">
      <span>● Kaynak: ABD Hazine Bakanlığı (TIC System - Series: FORTREASNET12807) &amp; TCMB EVDS (IMF SDDS: TP.REZVARPD.K3)</span>
      <span>● Veri gecikmesi: T+45 gün · Ay sonu resmî takas verileri</span>
    </div>
  </div>
</div>

<script>
  function baslatAbdTahvilGrafigi() {
    const kapsayici = document.querySelector('[data-abd-tahvil-grafik]') as HTMLElement | null;
    if (!kapsayici) return;

    interface NoktaVerisi {
      donem: string;
      etiket: string;
      netAkim: number;
      stok: number | null;
      tcmbStok: number | null;
      tcmbAylikFark: number | null;
    }

    const tumSeri: NoktaVerisi[] = JSON.parse(kapsayici.dataset.seri || '[]');
    if (tumSeri.length === 0) return;

    // Başlangıç: 2024'ten bugüne (Görseldeki periyot)
    let aktifSeri: NoktaVerisi[] = tumSeri.filter((s) => s.donem >= '2024-03');
    let aktifMod: 'bar' | 'karsilastirma' | 'kumulatif' = 'bar';

    // SVG Elemanları
    const katmanVurgu = document.getElementById('tic-katman-vurgu');
    const katmanIzgara = document.getElementById('tic-katman-izgara');
    const katmanBarlar = document.getElementById('tic-katman-barlar');
    const katmanCizgi = document.getElementById('tic-katman-cizgi');
    const katmanEtiketler = document.getElementById('tic-katman-etiketler');
    const katmanTarihler = document.getElementById('tic-katman-tarihler');
    const cizgiYolu = document.getElementById('tic-cizgi-yolu') as SVGPathElement | null;
    const alanYolu = document.getElementById('tic-alan-yolu') as SVGPathElement | null;
    const tcmbCizgiYolu = document.getElementById('tic-tcmb-cizgi-yolu') as SVGPathElement | null;
    const rehberDikey = document.getElementById('tic-rehber-dikey') as SVGLineElement | null;
    const odakNoktasi = document.getElementById('tic-odak-noktasi') as SVGCircleElement | null;
    const etkilesim = document.getElementById('tic-etkilesim-alani') as SVGRectElement | null;

    // Tooltip Elemanları
    const tooltipGrup = document.getElementById('tic-tooltip-grup');
    const tooltipBg = document.getElementById('tic-tooltip-bg') as SVGRectElement | null;
    const tooltipTarih = document.getElementById('tic-tooltip-tarih');
    const tooltipDeger = document.getElementById('tic-tooltip-deger');
    const tooltipEk = document.getElementById('tic-tooltip-ek');

    // Canlı Kart Elemanları
    const canliDonem = document.getElementById('tic-canli-donem');
    const canliKod = document.getElementById('tic-canli-kod');
    const canliNet = document.getElementById('tic-canli-net');
    const canliMilyar = document.getElementById('tic-canli-milyar');
    const canliTcmbFark = document.getElementById('tic-canli-tcmb-fark');
    const canliTcmbStok = document.getElementById('tic-canli-tcmb-stok');
    const canliStok = document.getElementById('tic-canli-stok');
    const canliRozet = document.getElementById('tic-canli-rozet');
    const lejantAlani = document.getElementById('tic-lejant-alani');

    // Koordinat Boyutları
    const W = 920;
    const H = 420;
    const PAD_TOP = 45;
    const PAD_BOTTOM = 65;
    const PAD_LEFT = 65;
    const PAD_RIGHT = 35;
    const innerW = W - PAD_LEFT - PAD_RIGHT;
    const innerH = H - PAD_TOP - PAD_BOTTOM;

    function renderGrafigi() {
      const len = aktifSeri.length;
      if (len === 0) return;

      // 1. Dinamik Min/Max ve Ölçekleme
      let minY = -16000;
      let maxY = 12000;

      if (aktifMod === 'kumulatif') {
        // Kümülatif toplam hesapla
        let kum = 0;
        const kumVals = aktifSeri.map((d) => (kum += d.netAkim));
        const minK = Math.min(0, ...kumVals);
        const maxK = Math.max(0, ...kumVals);
        minY = Math.floor((minK - 2000) / 5000) * 5000;
        maxY = Math.ceil((maxK + 2000) / 5000) * 5000;
      } else {
        const netVals = aktifSeri.map((d) => d.netAkim);
        const tcmbVals = aktifMod === 'karsilastirma' ? aktifSeri.map((d) => d.tcmbAylikFark || 0) : [];
        const combined = [...netVals, ...tcmbVals];
        const minVal = Math.min(-5000, ...combined);
        const maxVal = Math.max(5000, ...combined);
        minY = Math.floor((minVal - 1500) / 5000) * 5000;
        maxY = Math.ceil((maxVal + 1500) / 5000) * 5000;
      }

      const rangeY = maxY - minY || 1;
      const yPx = (v: number) => PAD_TOP + (1 - (v - minY) / rangeY) * innerH;
      const zeroY = yPx(0);

      // 2. Izgara Çizgileri
      if (katmanIzgara) {
        let izgaraHtml = '';
        const step = (maxY - minY) > 25000 ? 5000 : ((maxY - minY) > 10000 ? 2500 : 1000);
        for (let v = minY; v <= maxY; v += step) {
          const py = yPx(v);
          const isZero = v === 0;
          izgaraHtml += `
            <g class="izgara-cizgi-grup">
              <line x1="${PAD_LEFT}" y1="${py.toFixed(1)}" x2="${W - PAD_RIGHT}" y2="${py.toFixed(1)}" stroke="${isZero ? '#18181b' : '#e4e4e7'}" stroke-width="${isZero ? 1.5 : 1}" stroke-dasharray="${isZero ? 'none' : '3 3'}" />
              <text x="${PAD_LEFT - 12}" y="${(py + 4).toFixed(1)}" fill="${isZero ? '#18181b' : '#71717a'}" font-size="11" font-weight="${isZero ? 700 : 400}" text-anchor="end">
                ${v === 0 ? '0' : (v > 0 ? `+${(v / 1000).toFixed(0)}.000` : `${(v / 1000).toFixed(0)}.000`)}
              </text>
            </g>
          `;
        }
        katmanIzgara.innerHTML = izgaraHtml;
      }

      // 3. Vurgu Kutusu (Nisan-Ağustos 2026 dönemi)
      if (katmanVurgu) {
        const nisanIdx = aktifSeri.findIndex((s) => s.donem === '2026-04');
        const agustosIdx = aktifSeri.findIndex((s) => s.donem === '2026-08');
        if (nisanIdx !== -1 && agustosIdx !== -1 && aktifMod !== 'kumulatif') {
          const slotW = innerW / len;
          const basX = PAD_LEFT + nisanIdx * slotW - 3;
          const bitX = PAD_LEFT + (agustosIdx + 1) * slotW + 3;
          const kutuW = bitX - basX;
          const kutuY = yPx(Math.min(maxY, 2500));
          const kutuH = yPx(Math.max(minY, -1500)) - kutuY;

          katmanVurgu.innerHTML = `
            <rect x="${basX.toFixed(1)}" y="${kutuY.toFixed(1)}" width="${kutuW.toFixed(1)}" height="${kutuH.toFixed(1)}" fill="#fef3c7" fill-opacity="0.65" rx="4" />
            <text x="${(basX + kutuW / 2).toFixed(1)}" y="${(kutuY - 8).toFixed(1)}" fill="#92400e" font-size="10.5" font-weight="700" text-anchor="middle">Son 4 Ay Alım (~$4 Mr)</text>
          `;
        } else {
          katmanVurgu.innerHTML = '';
        }
      }

      // 4. Görünüm Modlarına Göre Çizim
      if (aktifMod === 'bar' || aktifMod === 'karsilastirma') {
        if (katmanBarlar) katmanBarlar.style.display = 'block';
        if (katmanCizgi) katmanCizgi.style.display = 'none';

        const slotW = innerW / len;
        let barHtml = '';
        let etiketHtml = '';

        if (aktifMod === 'bar') {
          const barW = Math.max(6, Math.min(26, slotW * 0.72));
          aktifSeri.forEach((item, i) => {
            const x = PAD_LEFT + i * slotW + (slotW - barW) / 2;
            const val = item.netAkim;
            const yVal = yPx(val);
            const barY = val >= 0 ? yVal : zeroY;
            const barH = Math.max(2, Math.abs(yVal - zeroY));
            const dolgu = val >= 0 ? '#2563eb' : '#c2502b';

            barHtml += `
              <rect class="tic-bar-eleman" x="${x.toFixed(1)}" y="${barY.toFixed(1)}" width="${barW.toFixed(1)}" height="${barH.toFixed(1)}" fill="${dolgu}" rx="1" data-idx="${i}" />
            `;

            // Belirgin zirve ve dipleri etiketle (len <= 40 iken)
            if (len <= 40 && Math.abs(val) >= 5000) {
              const etiketY = val >= 0 ? barY - 8 : barY + barH + 15;
              const renk = val >= 0 ? '#1e40af' : '#c2502b';
              etiketHtml += `
                <text x="${(x + barW / 2).toFixed(1)}" y="${etiketY.toFixed(1)}" fill="${renk}" font-size="11" font-weight="700" text-anchor="middle">
                  ${val > 0 ? '+' : ''}${val.toLocaleString('tr-TR')}
                </text>
              `;
            }
          });
        } else {
          // 'karsilastirma' modu: TIC vs TCMB ikili bar
          const singleBarW = Math.max(4, Math.min(14, slotW * 0.42));
          aktifSeri.forEach((item, i) => {
            const baseX = PAD_LEFT + i * slotW + (slotW - singleBarW * 2 - 2) / 2;
            // Bar 1: TIC
            const v1 = item.netAkim;
            const y1 = yPx(v1);
            const bar1Y = v1 >= 0 ? y1 : zeroY;
            const bar1H = Math.max(2, Math.abs(y1 - zeroY));

            // Bar 2: TCMB Fark
            const v2 = item.tcmbAylikFark || 0;
            const y2 = yPx(v2);
            const bar2Y = v2 >= 0 ? y2 : zeroY;
            const bar2H = Math.max(2, Math.abs(y2 - zeroY));

            barHtml += `
              <g class="tic-cift-bar-grup" data-idx="${i}">
                <rect class="tic-bar-eleman tic-bar-v1" x="${baseX.toFixed(1)}" y="${bar1Y.toFixed(1)}" width="${singleBarW.toFixed(1)}" height="${bar1H.toFixed(1)}" fill="#2563eb" rx="1" />
                <rect class="tic-bar-eleman tic-bar-v2" x="${(baseX + singleBarW + 2).toFixed(1)}" y="${bar2Y.toFixed(1)}" width="${singleBarW.toFixed(1)}" height="${bar2H.toFixed(1)}" fill="#d97706" rx="1" />
              </g>
            `;
          });
        }

        if (katmanBarlar) katmanBarlar.innerHTML = barHtml;
        if (katmanEtiketler) katmanEtiketler.innerHTML = etiketHtml;
      } else if (aktifMod === 'kumulatif') {
        if (katmanBarlar) katmanBarlar.style.display = 'none';
        if (katmanEtiketler) katmanEtiketler.innerHTML = '';
        if (katmanCizgi) katmanCizgi.style.display = 'block';

        let kum = 0;
        const pts: { x: number; y: number }[] = [];
        aktifSeri.forEach((item, i) => {
          kum += item.netAkim;
          const cx = PAD_LEFT + (i / Math.max(len - 1, 1)) * innerW;
          const cy = yPx(kum);
          pts.push({ x: cx, y: cy });
        });

        const lineD = pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
        const areaD = `${lineD} L ${pts.at(-1)!.x.toFixed(1)} ${zeroY.toFixed(1)} L ${pts[0].x.toFixed(1)} ${zeroY.toFixed(1)} Z`;

        if (cizgiYolu) cizgiYolu.setAttribute('d', lineD);
        if (alanYolu) alanYolu.setAttribute('d', areaD);
        if (tcmbCizgiYolu) tcmbCizgiYolu.setAttribute('d', '');
      }

      // 5. X Ekseni Tarih Etiketleri
      if (katmanTarihler) {
        let xHtml = '';
        const step = Math.max(1, Math.ceil(len / 8));
        aktifSeri.forEach((item, i) => {
          if (i % step === 0 || i === len - 1) {
            const cx = aktifMod === 'kumulatif'
              ? PAD_LEFT + (i / Math.max(len - 1, 1)) * innerW
              : PAD_LEFT + i * (innerW / len) + (innerW / len) / 2;

            xHtml += `
              <text x="${cx.toFixed(1)}" y="${H - PAD_BOTTOM + 22}" fill="#4b5563" font-size="11" font-weight="600" text-anchor="middle" transform="rotate(-28 ${cx.toFixed(1)} ${H - PAD_BOTTOM + 22})">
                ${item.donem}
              </text>
            `;
          }
        });
        katmanTarihler.innerHTML = xHtml;
      }

      // Lejant güncelle
      if (lejantAlani) {
        if (aktifMod === 'karsilastirma') {
          lejantAlani.innerHTML = `
            <span class="lejant-oge"><span class="renk-kutu" style="background: #2563eb;"></span> TIC Net Tahvil Alım/Satımı</span>
            <span class="lejant-oge"><span class="renk-kutu" style="background: #d97706;"></span> TCMB Menkul Portföy Aylık Değişimi (Δ)</span>
          `;
        } else if (aktifMod === 'kumulatif') {
          lejantAlani.innerHTML = `
            <span class="lejant-oge"><span class="renk-kutu" style="background: #2563eb;"></span> Dönem İçi Kümülatif Net Tahvil Alım/Satım Eğrisi</span>
          `;
        } else {
          lejantAlani.innerHTML = `
            <span class="lejant-oge"><span class="renk-kutu pozitif-kutu"></span> Pozitif: Net Tahvil Alımı (Mavi)</span>
            <span class="lejant-oge"><span class="renk-kutu negatif-kutu"></span> Negatif: Net Tahvil Satışı / İtfa (Kırmızı)</span>
            <span class="lejant-oge vurgu-lejant"><span class="renk-kutu sari-kutu"></span> Son 4-5 Ay Alım Dönemi (~$4 Mr)</span>
          `;
        }
      }

      // Son noktayı canlı kartlara yükle
      kartGuncelle(aktifSeri.at(-1)!);
    }

    function kartGuncelle(d: NoktaVerisi) {
      if (!d) return;
      if (canliDonem) canliDonem.textContent = d.etiket;
      if (canliKod) canliKod.textContent = d.donem;

      if (canliNet) {
        const isPos = d.netAkim >= 0;
        canliNet.className = `canli-deger ${isPos ? 'pozitif' : 'negatif'}`;
        canliNet.textContent = `${isPos ? '+' : ''}${d.netAkim.toLocaleString('tr-TR')} M $`;
      }

      if (canliMilyar) {
        const isPos = d.netAkim >= 0;
        const milVal = (d.netAkim / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        canliMilyar.textContent = `${isPos ? '+' : ''}${milVal} milyar $`;
      }

      if (canliTcmbFark) {
        if (d.tcmbAylikFark !== null) {
          const isPos = d.tcmbAylikFark >= 0;
          canliTcmbFark.textContent = `${isPos ? '+' : ''}${d.tcmbAylikFark.toLocaleString('tr-TR')} M $`;
          canliTcmbFark.style.color = isPos ? 'var(--yukselis, #2563eb)' : 'var(--dusus, #c2502b)';
        } else {
          canliTcmbFark.textContent = '—';
          canliTcmbFark.style.color = 'inherit';
        }
      }

      if (canliTcmbStok) {
        canliTcmbStok.textContent = d.tcmbStok
          ? `Stok: $${(d.tcmbStok / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} Mr`
          : '—';
      }

      if (canliStok) {
        canliStok.textContent = d.stok
          ? `$${(d.stok / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} milyar`
          : '—';
      }

      if (canliRozet) {
        if (d.donem >= '2026-04' && d.donem <= '2026-08') {
          canliRozet.className = 'durum-rozet ozel-rozet';
          canliRozet.textContent = '★ TCMB $4 Mr Alım Dönemi';
        } else if (d.netAkim >= 4500) {
          canliRozet.className = 'durum-rozet pozitif-rozet';
          canliRozet.textContent = 'Rekor Net Alım';
        } else if (d.netAkim <= -5000) {
          canliRozet.className = 'durum-rozet negatif-rozet';
          canliRozet.textContent = 'Büyük İtfa / Satış';
        } else if (d.netAkim >= 0) {
          canliRozet.className = 'durum-rozet pozitif-rozet';
          canliRozet.textContent = 'Net Tahvil Alımı';
        } else {
          canliRozet.className = 'durum-rozet negatif-rozet';
          canliRozet.textContent = 'Net Tahvil Satışı';
        }
      }
    }

    // Takip / Hover Fonksiyonu
    function takipEt(e: MouseEvent | TouchEvent) {
      if (!etkilesim) return;
      const rect = etkilesim.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;

      if (clientX < rect.left || clientX > rect.right) return;

      const normX = (clientX - rect.left) / rect.width;
      const len = aktifSeri.length;
      const idx = Math.max(0, Math.min(len - 1, Math.floor(normX * len)));
      const d = aktifSeri[idx];
      if (!d) return;

      kartGuncelle(d);

      // Kılavuz Çizgisi Konumu
      const slotW = innerW / len;
      const cx = aktifMod === 'kumulatif'
        ? PAD_LEFT + (idx / Math.max(len - 1, 1)) * innerW
        : PAD_LEFT + idx * slotW + slotW / 2;

      if (rehberDikey) {
        rehberDikey.setAttribute('x1', cx.toFixed(1));
        rehberDikey.setAttribute('x2', cx.toFixed(1));
        rehberDikey.style.display = 'block';
      }

      // Bar Vurgulama
      if (katmanBarlar) {
        const barlar = katmanBarlar.querySelectorAll('.tic-bar-eleman');
        barlar.forEach((b) => {
          const elIdx = parseInt(b.getAttribute('data-idx') || '-1', 10);
          if (elIdx === idx) {
            b.classList.add('secili');
          } else {
            b.classList.remove('secili');
          }
        });
      }

      // Tooltip Balonu Konumlandırma
      if (tooltipGrup && tooltipBg && tooltipTarih && tooltipDeger && tooltipEk) {
        tooltipTarih.textContent = d.etiket;
        const isPos = d.netAkim >= 0;
        tooltipDeger.textContent = `${isPos ? '+' : ''}${d.netAkim.toLocaleString('tr-TR')} M $ (${(d.netAkim / 1000).toFixed(2)} Mr)`;
        tooltipDeger.setAttribute('fill', isPos ? '#60a5fa' : '#f87171');
        tooltipEk.textContent = d.tcmbAylikFark !== null ? `TCMB Menkul Δ: ${d.tcmbAylikFark >= 0 ? '+' : ''}${d.tcmbAylikFark} M $` : '';

        // Konum hesaplama
        const tipW = 190;
        const tipH = 68;
        let tipX = cx + 12;
        if (tipX + tipW > W - PAD_RIGHT) {
          tipX = cx - tipW - 12;
        }
        let tipY = PAD_TOP + 10;

        tooltipBg.setAttribute('x', tipX.toString());
        tooltipBg.setAttribute('y', tipY.toString());
        tooltipBg.setAttribute('width', tipW.toString());
        tooltipBg.setAttribute('height', tipH.toString());

        tooltipTarih.setAttribute('x', (tipX + 10).toString());
        tooltipTarih.setAttribute('y', (tipY + 18).toString());

        tooltipDeger.setAttribute('x', (tipX + 10).toString());
        tooltipDeger.setAttribute('y', (tipY + 38).toString());

        tooltipEk.setAttribute('x', (tipX + 10).toString());
        tooltipEk.setAttribute('y', (tipY + 54).toString());

        tooltipGrup.style.display = 'block';
      }
    }

    function takipBitti() {
      if (rehberDikey) rehberDikey.style.display = 'none';
      if (odakNoktasi) odakNoktasi.style.display = 'none';
      if (tooltipGrup) tooltipGrup.style.display = 'none';
      if (katmanBarlar) {
        katmanBarlar.querySelectorAll('.tic-bar-eleman').forEach((b) => b.classList.remove('secili'));
      }
      kartGuncelle(aktifSeri.at(-1)!);
    }

    if (etkilesim) {
      etkilesim.addEventListener('mousemove', takipEt);
      etkilesim.addEventListener('mouseleave', takipBitti);
      etkilesim.addEventListener('touchstart', takipEt, { passive: true });
      etkilesim.addEventListener('touchmove', takipEt, { passive: true });
      etkilesim.addEventListener('touchend', takipBitti);
    }

    // Filtre Butonları: Zaman Aralığı
    const aralikButonlari = kapsayici.querySelectorAll('[data-aralik]');
    aralikButonlari.forEach((btn) => {
      btn.addEventListener('click', () => {
        aralikButonlari.forEach((b) => b.classList.remove('aktif'));
        btn.classList.add('aktif');
        const val = btn.getAttribute('data-aralik');
        if (val === '12') aktifSeri = tumSeri.slice(-12);
        else if (val === '2024') aktifSeri = tumSeri.filter((s) => s.donem >= '2024-03');
        else if (val === '60') aktifSeri = tumSeri.slice(-60);
        else aktifSeri = [...tumSeri];
        renderGrafigi();
      });
    });

    // Filtre Butonları: Görünüm Modu
    const modButonlari = kapsayici.querySelectorAll('[data-mod]');
    modButonlari.forEach((btn) => {
      btn.addEventListener('click', () => {
        modButonlari.forEach((b) => b.classList.remove('aktif'));
        btn.classList.add('aktif');
        aktifMod = (btn.getAttribute('data-mod') as 'bar' | 'karsilastirma' | 'kumulatif') || 'bar';
        renderGrafigi();
      });
    });

    // İlk Çizim
    renderGrafigi();
  }

  // Astro sayfa geçişleri ve DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', baslatAbdTahvilGrafigi);
  } else {
    baslatAbdTahvilGrafigi();
  }
  document.addEventListener('astro:page-load', baslatAbdTahvilGrafigi);
</script>

