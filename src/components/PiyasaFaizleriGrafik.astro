---
import type { PiyasaFaizleriSatiri } from '../lib/resmi';
import { sayiYaz } from '../lib/resmi';

interface Props {
  satirlar: PiyasaFaizleriSatiri[];
}

const { satirlar = [] } = Astro.props;
const son = satirlar.at(-1);

const SERILER = [
  { id: 'ihtiyac', ad: 'İhtiyaç kredisi', renk: '#1b1b1b', kalinlik: 2.75 },
  { id: 'mevduat', ad: '1-3 ay mevduat', renk: '#5d5b55', kalinlik: 2 },
  { id: 'politika', ad: 'TCMB politika faizi', renk: '#c2502b', kalinlik: 2, basamak: true },
  { id: 'tasit', ad: 'Taşıt kredisi', renk: '#2d6a4f', kalinlik: 2 },
  { id: 'konut', ad: 'Konut kredisi', renk: '#d96b27', kalinlik: 2 },
] as const;
---

<div class="faiz-interaktif-kart" id="faizInteraktifKart">
  <!-- Üst Kontrol Çubuğu -->
  <div class="grafik-baslik-bar">
    <div class="baslik-metin">
      <h2 class="grafik-ana-baslik">Piyasa faizleri karşılaştırma grafiği</h2>
      <p class="grafik-ipucu-metin">TCMB haftalık akım verileri · Serileri gizlemek veya odaklanmak için lejanta tıklayın</p>
    </div>

    <div class="filtre-gruplari">
      <!-- Zaman Aralığı -->
      <div class="filtre-kumesi" role="group" aria-label="Zaman aralığı seçimi">
        <button type="button" class="filtre-btn" data-aralik="13">Son 3 ay</button>
        <button type="button" class="filtre-btn" data-aralik="26">Son 6 ay</button>
        <button type="button" class="filtre-btn aktif" data-aralik="tum">Tümü</button>
      </div>

      <!-- Oran Modu -->
      <div class="filtre-kumesi" role="group" aria-label="Faiz gösterim modu">
        <button type="button" class="filtre-btn aktif" data-mod="aylik" id="btnModAylik">Aylık basit (%)</button>
        <button type="button" class="filtre-btn" data-mod="yillik" id="btnModYillik">Yıllık basit (%)</button>
      </div>
    </div>
  </div>

  <!-- Tıklanabilir & Filtrelenebilir İnteraktif Lejant -->
  <div class="interaktif-lejant" id="interaktifLejant">
    {
      SERILER.map((s) => {
        const yillikVal = son ? (son as any)[s.id] : null;
        const aylikVal = yillikVal != null ? yillikVal / 12 : null;
        return (
          <button
            type="button"
            class="lejant-dugme aktif"
            data-seri-id={s.id}
            title={`${s.ad} serisini aç/kapat veya üzerine gelerek odaklan`}
          >
            <span class="lejant-renk-kutu" style={`background-color: ${s.renk};`}></span>
            <span class="lejant-baslik">{s.ad}</span>
            <span class="lejant-canli-deger">
              <span class="deger-metin" data-deger-turu="aylik">%{sayiYaz(aylikVal ?? 0, 2)}</span>
              <span class="deger-metin" data-deger-turu="yillik" style="display: none;">%{sayiYaz(yillikVal ?? 0, 2)}</span>
            </span>
          </button>
        );
      })
    }
  </div>

  <!-- SVG Grafik Alanı -->
  <div class="grafik-cizim-alani" id="grafikCizimAlani">
    <svg
      id="faizSvg"
      viewBox="0 0 880 460"
      class="faiz-canli-svg"
      role="img"
      aria-label="Piyasa faizleri interaktif eğrileri"
      preserveAspectRatio="xMidYMid meet"
    >
      <!-- Dinamik Eksen Izgaraları (JS çizer) -->
      <g id="izgaraGrubu"></g>
      <line id="tabanCizgisi" x1="52" y1="410" x2="856" y2="410" stroke="var(--hair, #cfccc2)" stroke-width="1" />
      <g id="xEtiketGrubu"></g>

      <!-- Çizgi Eğrileri Grubu -->
      <g id="egrilerGrubu"></g>

      <!-- İmleç Dikey Çizgisi ve Noktalar -->
      <g id="imlecGrubu" style="display: none;">
        <line id="imlecCizgi" x1="0" y1="24" x2="0" y2="410" stroke="var(--ink, #1b1b1b)" stroke-width="1" stroke-dasharray="3 3" />
        <g id="imlecNoktalar"></g>
      </g>

      <!-- Görünmez Etkileşim Yüzeyi -->
      <rect
        id="etkilesimYuzeyi"
        x="52"
        y="24"
        width="804"
        height="386"
        fill="transparent"
        style="cursor: crosshair;"
      />
    </svg>

    <!-- Dinamik Yüzen Bilgi Kartı (HUD / Tooltip) -->
    <div id="canliTooltip" class="canli-tooltip" style="display: none;">
      <div class="tooltip-baslik-satir">
        <span class="tooltip-tarih" id="ttTarih">16 Ekim 2026</span>
        <span class="tooltip-mod-etiket" id="ttModEtiket">Aylık basit</span>
      </div>
      <div class="tooltip-listesi" id="ttListesi"></div>
      <div class="tooltip-ozet" id="ttMakas"></div>
    </div>
  </div>

  <!-- CSP Uyumlu JSON Veri Deposu -->
  <script type="application/json" id="faizVeriJson" set:html={JSON.stringify(satirlar)} />
  <script is:inline src="/faiz-grafik.js" defer></script>
</div>

<style>
  .faiz-interaktif-kart {
    margin: 28px 0;
    padding: 24px;
    background: #ffffff;
    border: 1px solid var(--soluk, #e4e1d7);
  }

  .grafik-baslik-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .grafik-ana-baslik {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink, #1b1b1b);
    margin: 0;
  }

  .grafik-ipucu-metin {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.85rem;
    color: var(--muted, #5d5b55);
    margin: 4px 0 0 0;
  }

  .filtre-gruplari {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .filtre-kumesi {
    display: inline-flex;
    background: var(--paper, #f4f3ee);
    border: 1px solid var(--hair, #cfccc2);
    padding: 2px;
  }

  .filtre-btn {
    border: none;
    background: transparent;
    padding: 6px 12px;
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted, #5d5b55);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filtre-btn.aktif {
    background: var(--ink, #1b1b1b);
    color: #ffffff;
  }

  /* Lejant Düğmeleri */
  .interaktif-lejant {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
    gap: 10px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--soluk, #e4e1d7);
  }

  .lejant-dugme {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: transparent;
    border: 1px solid transparent;
    padding: 6px 8px;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }

  .lejant-dugme:not(.aktif) {
    opacity: 0.35;
    filter: grayscale(1);
  }

  .lejant-dugme:hover {
    background: var(--paper, #f4f3ee);
    border-color: var(--hair, #cfccc2);
  }

  .lejant-renk-kutu {
    width: 22px;
    height: 4px;
    margin-bottom: 6px;
    display: inline-block;
  }

  .lejant-baslik {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted, #5d5b55);
  }

  .lejant-canli-deger {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink, #1b1b1b);
    font-variant-numeric: tabular-nums;
  }

  /* Grafik SVG Alanı */
  .grafik-cizim-alani {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .faiz-canli-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  :global(.eksen-metin) {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 11px;
    fill: var(--muted, #5d5b55);
    font-weight: 500;
  }

  /* Canlı Tooltip */
  .canli-tooltip {
    position: absolute;
    pointer-events: none;
    background: #ffffff;
    border: 1px solid var(--ink, #1b1b1b);
    padding: 10px 14px;
    box-shadow: 3px 3px 0px rgba(27, 27, 27, 0.12);
    z-index: 20;
    min-width: 210px;
  }

  .tooltip-baslik-satir {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--hair, #cfccc2);
    padding-bottom: 4px;
    margin-bottom: 6px;
  }

  .tooltip-tarih {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--toprak, #c2502b);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tooltip-mod-etiket {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.75rem;
    color: var(--muted, #5d5b55);
  }

  .tooltip-listesi {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  :global(.tt-satir) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.85rem;
    gap: 8px;
  }

  :global(.tt-satir.odakli) {
    font-weight: 700;
  }

  :global(.tt-nokta) {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
  }

  :global(.tt-ad) {
    color: var(--muted, #5d5b55);
    flex-grow: 1;
    font-size: 0.8rem;
  }

  :global(.tt-deger) {
    font-weight: 700;
    color: var(--ink, #1b1b1b);
    font-variant-numeric: tabular-nums;
  }

  :global(.tt-deger small) {
    font-size: 0.75rem;
    color: var(--muted, #5d5b55);
    font-weight: 400;
  }

  .tooltip-ozet {
    margin-top: 8px;
    padding-top: 6px;
    border-top: 1px dashed var(--hair, #cfccc2);
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.78rem;
    color: var(--ink, #1b1b1b);
  }

  .tooltip-ozet strong {
    color: var(--toprak, #c2502b);
  }

  @media (max-width: 600px) {
    /* Telefonda SVG ekrana sığdırılınca yazılar 3-4 piksele iniyordu: grafik en az 640 px çizilir, kutusunda yatay kaydırılır. */
    .grafik-cizim-alani {
      overflow-x: auto;
    }

    .faiz-canli-svg {
      min-width: 640px;
    }
  }
</style>
