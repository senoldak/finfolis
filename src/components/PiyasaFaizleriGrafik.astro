---
import type { PiyasaFaizleriSatiri } from '../lib/resmi';
import { gunYaz, sayiYaz } from '../lib/resmi';

interface Props {
  satirlar: PiyasaFaizleriSatiri[];
}

const { satirlar = [] } = Astro.props;

// Seri tanımları ve renkleri
const SERILER = [
  { id: 'ihtiyac', ad: 'İhtiyaç kredisi', renk: '#1b1b1b', kalinlik: 2.75 },
  { id: 'mevduat', ad: '1-3 ay mevduat', renk: '#5d5b55', kalinlik: 2 },
  { id: 'politika', ad: 'TCMB politika faizi', renk: '#c2502b', kalinlik: 2, basamak: true },
  { id: 'tasit', ad: 'Taşıt kredisi', renk: '#2d6a4f', kalinlik: 2 },
  { id: 'konut', ad: 'Konut kredisi', renk: '#d96b27', kalinlik: 2 },
  { id: 'tahvil5Y', ad: '5 yıllık tahvil', renk: '#635380', kalinlik: 1.75 },
] as const;

// Grafik boyutları
const W = 880;
const H = 460;
const PAD_SOL = 54;
const PAD_SAG = 24;
const PAD_UST = 28;
const PAD_ALT = 54;
const PLOT_W = W - PAD_SOL - PAD_SAG;
const PLOT_H = H - PAD_UST - PAD_ALT;

const n = Math.max(satirlar.length, 1);
const xCoord = (idx: number) => PAD_SOL + (idx / Math.max(n - 1, 1)) * PLOT_W;

// Aylık eksen: 2.0% - 4.6%
const MIN_AY = 2.0;
const MAX_AY = 4.6;
const yCoordAylik = (val: number) => PAD_UST + (1 - (val - MIN_AY) / (MAX_AY - MIN_AY)) * PLOT_H;

// Yıllık eksen: 24% - 55%
const MIN_YIL = 24;
const MAX_YIL = 55.2;
const yCoordYillik = (val: number) => PAD_UST + (1 - (val - MIN_YIL) / (MAX_YIL - MIN_YIL)) * PLOT_H;

// Çizgi yolları (SVG path)
const yollar = SERILER.map((seri) => {
  const noktalarAylik = satirlar.map((s, idx) => {
    const raw = (s as any)[seri.id];
    const val = typeof raw === 'number' ? raw / 12 : null;
    return { x: xCoord(idx), y: val != null ? yCoordAylik(val) : null, val };
  });

  const noktalarYillik = satirlar.map((s, idx) => {
    const raw = (s as any)[seri.id];
    const val = typeof raw === 'number' ? raw : null;
    return { x: xCoord(idx), y: val != null ? yCoordYillik(val) : null, val };
  });

  const ciz = (noktalar: typeof noktalarAylik) => {
    let d = '';
    for (let i = 0; i < noktalar.length; i++) {
      const pt = noktalar[i];
      if (pt.y == null) continue;
      if (!d) {
        d = `M ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}`;
      } else {
        if (seri.basamak) {
          // Basamak çizgi (TCMB politika faizi)
          const onceki = noktalar[i - 1];
          if (onceki && onceki.y != null) {
            d += ` H ${pt.x.toFixed(1)} V ${pt.y.toFixed(1)}`;
          } else {
            d += ` L ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}`;
          }
        } else {
          d += ` L ${pt.x.toFixed(1)} ${pt.y.toFixed(1)}`;
        }
      }
    }
    return d;
  };

  return {
    ...seri,
    pathAylik: ciz(noktalarAylik),
    pathYillik: ciz(noktalarYillik),
    sonAylik: noktalarAylik.at(-1)?.val,
    sonYillik: noktalarYillik.at(-1)?.val,
  };
});

// Y ekseni çizgileri
const ticksAylik = [2.0, 2.5, 3.0, 3.5, 4.0, 4.5];
const ticksYillik = [25, 30, 35, 40, 45, 50, 55];

// X ekseni tarih etiketleri (her ~6 haftada bir)
const adim = Math.max(1, Math.floor(n / 6));
const xTicks = satirlar
  .map((s, idx) => ({ ...s, idx }))
  .filter((_, i) => i === 0 || i % adim === 0 || i === n - 1);
---

<div class="faiz-grafik-kapsayici" id="faizGrafikKapsayici" data-mod="aylik">
  <div class="grafik-kontrol-satiri">
    <div class="grafik-baslik-alani">
      <h2 class="grafik-baslik">Piyasa faizleri zaman serisi</h2>
      <p class="grafik-altbaslik">TCMB haftalık akım verileriyle karşılaştırmalı görünüm</p>
    </div>
    <div class="mod-dugmeleri" role="group" aria-label="Faiz görünüm modu">
      <button type="button" class="mod-btn aktif" data-hedef="aylik" id="btnAylik">Aylık basit (%)</button>
      <button type="button" class="mod-btn" data-hedef="yillik" id="btnYillik">Yıllık basit (%)</button>
    </div>
  </div>

  <div class="grafik-alan" id="grafikEtkilesimAlani">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      class="faiz-svg"
      role="img"
      aria-label="Piyasa faizleri grafiği: ihtiyaç, taşıt ve konut kredileri, 1-3 ay mevduat, politika faizi ve 5 yıllık tahvil"
      preserveAspectRatio="xMidYMid meet"
    >
      <!-- Arka plan grid ve eksenler -->
      <g class="grid-cizgileri">
        {
          ticksAylik.map((t) => (
            <g class="tick-aylik">
              <line
                x1={PAD_SOL}
                y1={yCoordAylik(t)}
                x2={W - PAD_SAG}
                y2={yCoordAylik(t)}
                stroke="var(--soluk, #e4e1d7)"
                stroke-width="1"
                stroke-dasharray="3 3"
              />
              <text x={PAD_SOL - 8} y={yCoordAylik(t) + 4} text-anchor="end" class="eksen-yazi">
                %{sayiYaz(t, 2)}
              </text>
            </g>
          ))
        }
        {
          ticksYillik.map((t) => (
            <g class="tick-yillik">
              <line
                x1={PAD_SOL}
                y1={yCoordYillik(t)}
                x2={W - PAD_SAG}
                y2={yCoordYillik(t)}
                stroke="var(--soluk, #e4e1d7)"
                stroke-width="1"
                stroke-dasharray="3 3"
              />
              <text x={PAD_SOL - 8} y={yCoordYillik(t) + 4} text-anchor="end" class="eksen-yazi">
                %{sayiYaz(t, 0)}
              </text>
            </g>
          ))
        }
      </g>

      <!-- X ekseni taban çizgisi -->
      <line
        x1={PAD_SOL}
        y1={H - PAD_ALT}
        x2={W - PAD_SAG}
        y2={H - PAD_ALT}
        stroke="var(--hair, #cfccc2)"
        stroke-width="1"
      />

      <!-- X ekseni tarih etiketleri -->
      <g class="x-etiketleri">
        {
          xTicks.map((t) => (
            <text x={xCoord(t.idx)} y={H - PAD_ALT + 20} text-anchor="middle" class="eksen-yazi">
              {t.tarih.slice(8, 10)}.{t.tarih.slice(5, 7)}.{t.tarih.slice(2, 4)}
            </text>
          ))
        }
      </g>

      <!-- Çizgiler: Aylık Görünüm -->
      <g class="yollar-aylik">
        {
          yollar.map((y) => (
            <path
              d={y.pathAylik}
              fill="none"
              stroke={y.renk}
              stroke-width={y.kalinlik}
              stroke-linejoin="round"
              stroke-linecap="round"
              class={`faiz-cizgi faiz-cizgi-${y.id}`}
            />
          ))
        }
      </g>

      <!-- Çizgiler: Yıllık Görünüm -->
      <g class="yollar-yillik">
        {
          yollar.map((y) => (
            <path
              d={y.pathYillik}
              fill="none"
              stroke={y.renk}
              stroke-width={y.kalinlik}
              stroke-linejoin="round"
              stroke-linecap="round"
              class={`faiz-cizgi faiz-cizgi-${y.id}`}
            />
          ))
        }
      </g>

      <!-- İmleç Dikey Çizgisi -->
      <line
        id="imlecCizgi"
        x1="0"
        y1={PAD_UST}
        x2="0"
        y2={H - PAD_ALT}
        stroke="var(--ink-2, #3d3c38)"
        stroke-width="1"
        stroke-dasharray="2 2"
        style="display: none;"
      />
    </svg>

    <!-- Bilgi Kartı / Tooltip -->
    <div id="grafikTooltip" class="grafik-tooltip" style="display: none;">
      <div class="tooltip-tarih" id="tooltipTarih">16 Ekim 2026</div>
      <div class="tooltip-satirlar" id="tooltipSatirlar"></div>
    </div>
  </div>

  <!-- Lejant (Açıklama Listesi) -->
  <div class="grafik-lejant-izgara">
    {
      yollar.map((y) => (
        <div class={`lejant-ogesi lejant-${y.id}`} data-seri={y.id}>
          <span class="lejant-renk" style={`background-color: ${y.renk};`}></span>
          <span class="lejant-ad">{y.ad}</span>
          <span class="lejant-deger">
            <span class="deger-aylik">%{sayiYaz(y.sonAylik ?? 0, 2)}</span>
            <span class="deger-yillik">%{sayiYaz(y.sonYillik ?? 0, 2)}</span>
          </span>
        </div>
      ))
    }
  </div>

  <!-- Veri Verileri JSON (Etkileşim Scripti için) -->
  <script is:inline define:vars={{ satirlar, W, H, PAD_SOL, PAD_SAG, PLOT_W, n }}>
    const container = document.getElementById('faizGrafikKapsayici');
    const btnAylik = document.getElementById('btnAylik');
    const btnYillik = document.getElementById('btnYillik');
    const svg = container?.querySelector('.faiz-svg');
    const imlec = document.getElementById('imlecCizgi');
    const tooltip = document.getElementById('grafikTooltip');
    const tooltipTarih = document.getElementById('tooltipTarih');
    const tooltipSatirlar = document.getElementById('tooltipSatirlar');

    const SERI_ISIMLERI = {
      ihtiyac: { ad: 'İhtiyaç kredisi', renk: '#1b1b1b' },
      mevduat: { ad: '1-3 ay mevduat', renk: '#5d5b55' },
      politika: { ad: 'TCMB politika', renk: '#c2502b' },
      tasit: { ad: 'Taşıt kredisi', renk: '#2d6a4f' },
      konut: { ad: 'Konut kredisi', renk: '#d96b27' },
      tahvil5Y: { ad: '5Y tahvil', renk: '#635380' },
    };

    function setMod(mod) {
      if (!container) return;
      container.setAttribute('data-mod', mod);
      if (mod === 'aylik') {
        btnAylik?.classList.add('aktif');
        btnYillik?.classList.remove('aktif');
      } else {
        btnYillik?.classList.add('aktif');
        btnAylik?.classList.remove('aktif');
      }
    }

    btnAylik?.addEventListener('click', () => setMod('aylik'));
    btnYillik?.addEventListener('click', () => setMod('yillik'));

    // İmleç ve Tooltip Takibi
    if (svg && imlec && tooltip) {
      svg.addEventListener('mousemove', (e) => {
        const rect = svg.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const svgX = (mouseX / rect.width) * W;

        if (svgX < PAD_SOL || svgX > W - PAD_SAG) {
          imlec.style.display = 'none';
          tooltip.style.display = 'none';
          return;
        }

        const oran = (svgX - PAD_SOL) / PLOT_W;
        const idx = Math.min(Math.max(0, Math.round(oran * (n - 1))), n - 1);
        const secili = satirlar[idx];
        if (!secili) return;

        const xPos = PAD_SOL + (idx / Math.max(n - 1, 1)) * PLOT_W;
        imlec.setAttribute('x1', xPos);
        imlec.setAttribute('x2', xPos);
        imlec.style.display = 'block';

        const gun = secili.tarih.slice(8, 10);
        const ay = secili.tarih.slice(5, 7);
        const yil = secili.tarih.slice(0, 4);
        tooltipTarih.textContent = `${gun}.${ay}.${yil}`;

        const isAylik = container.getAttribute('data-mod') === 'aylik';
        let html = '';
        for (const [key, meta] of Object.entries(SERI_ISIMLERI)) {
          const yillikVal = secili[key];
          if (yillikVal == null) continue;
          const aylikVal = yillikVal / 12;
          const gosterilen = isAylik ? `%${aylikVal.toFixed(2)}` : `%${yillikVal.toFixed(2)}`;
          html += `
            <div class="tooltip-satir">
              <span class="tt-renk" style="background:${meta.renk};"></span>
              <span class="tt-ad">${meta.ad}</span>
              <span class="tt-deger">${gosterilen}</span>
            </div>
          `;
        }
        tooltipSatirlar.innerHTML = html;

        // Tooltip yerleşimi
        const screenX = (xPos / W) * rect.width;
        tooltip.style.display = 'block';
        if (screenX > rect.width * 0.65) {
          tooltip.style.left = `${screenX - 180}px`;
        } else {
          tooltip.style.left = `${screenX + 16}px`;
        }
        tooltip.style.top = '40px';
      });

      svg.addEventListener('mouseleave', () => {
        imlec.style.display = 'none';
        tooltip.style.display = 'none';
      });
    }
  </script>
</div>

<style>
  .faiz-grafik-kapsayici {
    margin: 28px 0;
    padding: 24px;
    background: #ffffff;
    border: 1px solid var(--soluk, #e4e1d7);
    border-radius: 0px;
  }

  .grafik-kontrol-satiri {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .grafik-baslik {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--ink, #1b1b1b);
  }

  .grafik-altbaslik {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.9rem;
    color: var(--muted, #5d5b55);
    margin: 4px 0 0 0;
  }

  .mod-dugmeleri {
    display: inline-flex;
    background: var(--paper, #f4f3ee);
    border: 1px solid var(--hair, #cfccc2);
    padding: 2px;
  }

  .mod-btn {
    border: none;
    background: transparent;
    padding: 6px 14px;
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted, #5d5b55);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mod-btn.aktif {
    background: var(--ink, #1b1b1b);
    color: #ffffff;
  }

  .grafik-alan {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .faiz-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .eksen-yazi {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 11px;
    fill: var(--muted, #5d5b55);
    font-weight: 500;
  }

  /* Mod Görünüm Mantığı */
  .faiz-grafik-kapsayici[data-mod='aylik'] .tick-yillik,
  .faiz-grafik-kapsayici[data-mod='aylik'] .yollar-yillik,
  .faiz-grafik-kapsayici[data-mod='aylik'] .deger-yillik {
    display: none;
  }

  .faiz-grafik-kapsayici[data-mod='yillik'] .tick-aylik,
  .faiz-grafik-kapsayici[data-mod='yillik'] .yollar-aylik,
  .faiz-grafik-kapsayici[data-mod='yillik'] .deger-aylik {
    display: none;
  }

  /* Lejant Izgarası */
  .grafik-lejant-izgara {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--hair, #cfccc2);
  }

  .lejant-ogesi {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lejant-renk {
    display: inline-block;
    width: 24px;
    height: 4px;
    margin-bottom: 4px;
    border-radius: 0px;
  }

  .lejant-ad {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted, #5d5b55);
  }

  .lejant-deger {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink, #1b1b1b);
    font-variant-numeric: tabular-nums;
  }

  /* Tooltip */
  .grafik-tooltip {
    position: absolute;
    pointer-events: none;
    background: #ffffff;
    border: 1px solid var(--ink, #1b1b1b);
    padding: 10px 14px;
    box-shadow: 2px 2px 0px rgba(27, 27, 27, 0.1);
    z-index: 10;
    min-width: 170px;
  }

  .tooltip-tarih {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--toprak, #c2502b);
    margin-bottom: 6px;
    border-bottom: 1px solid var(--hair, #cfccc2);
    padding-bottom: 4px;
  }

  .tooltip-satirlar {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  :global(.tooltip-satir) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.85rem;
  }

  :global(.tt-renk) {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
  }

  :global(.tt-ad) {
    color: var(--muted, #5d5b55);
    flex-grow: 1;
    font-size: 0.8rem;
  }

  :global(.tt-deger) {
    font-weight: 700;
    color: var(--ink, #1b1b1b);
    font-variant-numeric: tabular-nums;
  }
</style>
