---
import type { PiyasaFaizleriSatiri } from '../lib/resmi';
import { sayiYaz } from '../lib/resmi';

interface Props {
  satirlar: PiyasaFaizleriSatiri[];
}

const { satirlar = [] } = Astro.props;
const son = satirlar.at(-1);

const SERILER = [
  { id: 'ihtiyac', ad: 'İhtiyaç kredisi', renk: '#1b1b1b', kalinlik: 2.75 },
  { id: 'mevduat', ad: '1-3 ay mevduat', renk: '#5d5b55', kalinlik: 2 },
  { id: 'politika', ad: 'TCMB politika faizi', renk: '#c2502b', kalinlik: 2, basamak: true },
  { id: 'tasit', ad: 'Taşıt kredisi', renk: '#2d6a4f', kalinlik: 2 },
  { id: 'konut', ad: 'Konut kredisi', renk: '#d96b27', kalinlik: 2 },
  { id: 'tahvil5Y', ad: '5 yıllık tahvil', renk: '#635380', kalinlik: 1.75 },
] as const;
---

<div class="faiz-interaktif-kart" id="faizInteraktifKart">
  <!-- Üst Kontrol Çubuğu -->
  <div class="grafik-baslik-bar">
    <div class="baslik-metin">
      <h2 class="grafik-ana-baslik">Piyasa faizleri karşılaştırma grafiği</h2>
      <p class="grafik-ipucu-metin">TCMB haftalık akım verileri · Serileri gizlemek veya odaklanmak için lejanta tıklayın</p>
    </div>

    <div class="filtre-gruplari">
      <!-- Zaman Aralığı -->
      <div class="filtre-kumesi" role="group" aria-label="Zaman aralığı seçimi">
        <button type="button" class="filtre-btn" data-aralik="13">Son 3 ay</button>
        <button type="button" class="filtre-btn" data-aralik="26">Son 6 ay</button>
        <button type="button" class="filtre-btn aktif" data-aralik="tum">Tümü</button>
      </div>

      <!-- Oran Modu -->
      <div class="filtre-kumesi" role="group" aria-label="Faiz gösterim modu">
        <button type="button" class="filtre-btn aktif" data-mod="aylik" id="btnModAylik">Aylık basit (%)</button>
        <button type="button" class="filtre-btn" data-mod="yillik" id="btnModYillik">Yıllık basit (%)</button>
      </div>
    </div>
  </div>

  <!-- Tıklanabilir & Filtrelenebilir İnteraktif Lejant -->
  <div class="interaktif-lejant" id="interaktifLejant">
    {
      SERILER.map((s) => {
        const yillikVal = son ? (son as any)[s.id] : null;
        const aylikVal = yillikVal != null ? yillikVal / 12 : null;
        return (
          <button
            type="button"
            class="lejant-dugme aktif"
            data-seri-id={s.id}
            title={`${s.ad} serisini aç/kapat veya üzerine gelerek odaklan`}
          >
            <span class="lejant-renk-kutu" style={`background-color: ${s.renk};`}></span>
            <span class="lejant-baslik">{s.ad}</span>
            <span class="lejant-canli-deger">
              <span class="deger-metin" data-deger-turu="aylik">%{sayiYaz(aylikVal ?? 0, 2)}</span>
              <span class="deger-metin" data-deger-turu="yillik" style="display: none;">%{sayiYaz(yillikVal ?? 0, 2)}</span>
            </span>
          </button>
        );
      })
    }
  </div>

  <!-- SVG Grafik Alanı -->
  <div class="grafik-cizim-alani" id="grafikCizimAlani">
    <svg
      id="faizSvg"
      viewBox="0 0 880 460"
      class="faiz-canli-svg"
      role="img"
      aria-label="Piyasa faizleri interaktif eğrileri"
      preserveAspectRatio="xMidYMid meet"
    >
      <!-- Dinamik Eksen Izgaraları (JS çizer) -->
      <g id="izgaraGrubu"></g>
      <line id="tabanCizgisi" x1="50" y1="410" x2="856" y2="410" stroke="var(--hair, #cfccc2)" stroke-width="1" />
      <g id="xEtiketGrubu"></g>

      <!-- Çizgi Eğrileri Grubu -->
      <g id="egrilerGrubu"></g>

      <!-- İmleç Dikey Çizgisi ve Noktalar -->
      <g id="imlecGrubu" style="display: none;">
        <line id="imlecCizgi" x1="0" y1="24" x2="0" y2="410" stroke="var(--ink, #1b1b1b)" stroke-width="1" stroke-dasharray="3 3" />
        <g id="imlecNoktalar"></g>
      </g>

      <!-- Görünmez Etkileşim Yüzeyi -->
      <rect
        id="etkilesimYuzeyi"
        x="50"
        y="24"
        width="806"
        height="386"
        fill="transparent"
        style="cursor: crosshair;"
      />
    </svg>

    <!-- Dinamik Yüzen Bilgi Kartı (HUD / Tooltip) -->
    <div id="canliTooltip" class="canli-tooltip" style="display: none;">
      <div class="tooltip-baslik-satir">
        <span class="tooltip-tarih" id="ttTarih">16 Ekim 2026</span>
        <span class="tooltip-mod-etiket" id="ttModEtiket">Aylık basit</span>
      </div>
      <div class="tooltip-listesi" id="ttListesi"></div>
      <div class="tooltip-ozet" id="ttMakas"></div>
    </div>
  </div>

  <!-- CSP Uyumlu JSON Veri Deposu -->
  <script type="application/json" id="faizVeriJson" set:html={JSON.stringify(satirlar)} />
</div>

<!-- Bundled (Vite) Script: CSP 'self' uyumlu -->
<script>
  interface FaizNoktasi {
    tarih: string;
    ihtiyac: number;
    mevduat: number;
    politika: number;
    tasit: number;
    konut: number;
    tahvil5Y?: number | null;
  }

  const SERILER = [
    { id: 'ihtiyac', ad: 'İhtiyaç kredisi', renk: '#1b1b1b', kalinlik: 2.75 },
    { id: 'mevduat', ad: '1-3 ay mevduat', renk: '#5d5b55', kalinlik: 2 },
    { id: 'politika', ad: 'TCMB politika faizi', renk: '#c2502b', kalinlik: 2, basamak: true },
    { id: 'tasit', ad: 'Taşıt kredisi', renk: '#2d6a4f', kalinlik: 2 },
    { id: 'konut', ad: 'Konut kredisi', renk: '#d96b27', kalinlik: 2 },
    { id: 'tahvil5Y', ad: '5 yıllık tahvil', renk: '#635380', kalinlik: 1.75 },
  ] as const;

  const dataScript = document.getElementById('faizVeriJson');
  if (dataScript && dataScript.textContent) {
    const tumSatirlar: FaizNoktasi[] = JSON.parse(dataScript.textContent);

    const kart = document.getElementById('faizInteraktifKart')!;
    const svg = document.getElementById('faizSvg') as unknown as SVGSVGElement;
    const izgaraGrubu = document.getElementById('izgaraGrubu')!;
    const xEtiketGrubu = document.getElementById('xEtiketGrubu')!;
    const egrilerGrubu = document.getElementById('egrilerGrubu')!;
    const imlecGrubu = document.getElementById('imlecGrubu')!;
    const imlecCizgi = document.getElementById('imlecCizgi')!;
    const imlecNoktalar = document.getElementById('imlecNoktalar')!;
    const etkilesim = document.getElementById('etkilesimYuzeyi')!;
    const tooltip = document.getElementById('canliTooltip')!;
    const ttTarih = document.getElementById('ttTarih')!;
    const ttModEtiket = document.getElementById('ttModEtiket')!;
    const ttListesi = document.getElementById('ttListesi')!;
    const ttMakas = document.getElementById('ttMakas')!;

    // Durum Değişkenleri
    let aktifMod: 'aylik' | 'yillik' = 'aylik';
    let aktifAralik: number | 'tum' = 'tum';
    const gorunenSeriler = new Set<string>(SERILER.map((s) => s.id));
    let odakSeri: string | null = null;

    // Boyutlar
    const W = 880;
    const H = 460;
    const PAD = { top: 24, right: 24, bottom: 50, left: 52 };
    const plotW = W - PAD.left - PAD.right;
    const plotH = H - PAD.top - PAD.bottom;

    function getFiltreliVeri(): FaizNoktasi[] {
      if (aktifAralik === 'tum') return tumSatirlar;
      return tumSatirlar.slice(-aktifAralik);
    }

    function cizGrafik() {
      const noktalar = getFiltreliVeri();
      if (!noktalar || noktalar.length === 0) return;

      const n = noktalar.length;

      // Min ve Max hesapla
      let minVal = Infinity;
      let maxVal = -Infinity;

      for (const pt of noktalar) {
        for (const seri of SERILER) {
          if (!gorunenSeriler.has(seri.id)) continue;
          const raw = (pt as any)[seri.id];
          if (typeof raw === 'number' && Number.isFinite(raw)) {
            const v = aktifMod === 'aylik' ? raw / 12 : raw;
            if (v < minVal) minVal = v;
            if (v > maxVal) maxVal = v;
          }
        }
      }

      if (!Number.isFinite(minVal) || !Number.isFinite(maxVal)) {
        minVal = aktifMod === 'aylik' ? 2.0 : 24;
        maxVal = aktifMod === 'aylik' ? 4.5 : 54;
      }

      // Eksen payları
      const pay = (maxVal - minVal) * 0.1 || 0.5;
      const yMin = Math.max(0, minVal - pay);
      const yMax = maxVal + pay;
      const yRange = yMax - yMin;

      const xCoord = (idx: number) => PAD.left + (idx / Math.max(n - 1, 1)) * plotW;
      const yCoord = (val: number) => PAD.top + (1 - (val - yMin) / yRange) * plotH;

      // 1. Grid ve Y Eksen Etiketleri
      let izgaraHtml = '';
      const basamakSayisi = 5;
      for (let i = 0; i <= basamakSayisi; i++) {
        const v = yMin + (i / basamakSayisi) * yRange;
        const y = yCoord(v);
        const yazi = aktifMod === 'aylik' ? `%${v.toFixed(2)}` : `%${v.toFixed(1)}`;
        izgaraHtml += `
          <line x1="${PAD.left}" y1="${y.toFixed(1)}" x2="${W - PAD.right}" y2="${y.toFixed(1)}" stroke="#e4e1d7" stroke-width="1" stroke-dasharray="3 3" />
          <text x="${PAD.left - 8}" y="${(y + 4).toFixed(1)}" text-anchor="end" class="eksen-metin">${yazi}</text>
        `;
      }
      izgaraGrubu.innerHTML = izgaraHtml;

      // 2. X Eksen Tarih Etiketleri
      let xHtml = '';
      const adim = Math.max(1, Math.floor(n / 6));
      for (let i = 0; i < n; i++) {
        if (i === 0 || i % adim === 0 || i === n - 1) {
          const pt = noktalar[i];
          const x = xCoord(i);
          const gun = pt.tarih.slice(8, 10);
          const ay = pt.tarih.slice(5, 7);
          const yil = pt.tarih.slice(2, 4);
          xHtml += `
            <text x="${x.toFixed(1)}" y="${H - PAD.bottom + 20}" text-anchor="middle" class="eksen-metin">${gun}.${ay}.${yil}</text>
          `;
        }
      }
      xEtiketGrubu.innerHTML = xHtml;

      // 3. Seri Çizgileri
      let cizgilerHtml = '';
      for (const seri of SERILER) {
        if (!gorunenSeriler.has(seri.id)) continue;

        let d = '';
        for (let i = 0; i < n; i++) {
          const raw = (noktalar[i] as any)[seri.id];
          if (typeof raw !== 'number' || !Number.isFinite(raw)) continue;
          const val = aktifMod === 'aylik' ? raw / 12 : raw;
          const x = xCoord(i);
          const y = yCoord(val);

          if (!d) {
            d = `M ${x.toFixed(1)} ${y.toFixed(1)}`;
          } else {
            if (seri.basamak) {
              const oncekiRaw = (noktalar[i - 1] as any)[seri.id];
              const oncekiVal = aktifMod === 'aylik' ? oncekiRaw / 12 : oncekiRaw;
              const oncekiY = yCoord(oncekiVal);
              d += ` H ${x.toFixed(1)} V ${y.toFixed(1)}`;
            } else {
              d += ` L ${x.toFixed(1)} ${y.toFixed(1)}`;
            }
          }
        }

        const isOdak = odakSeri === null || odakSeri === seri.id;
        const opacity = isOdak ? '1' : '0.15';
        const kalinlik = isOdak && odakSeri === seri.id ? seri.kalinlik + 1.25 : seri.kalinlik;

        cizgilerHtml += `
          <path
            d="${d}"
            fill="none"
            stroke="${seri.renk}"
            stroke-width="${kalinlik}"
            stroke-linecap="round"
            stroke-linejoin="round"
            opacity="${opacity}"
            style="transition: opacity 0.2s ease, stroke-width 0.2s ease;"
          />
        `;
      }
      egrilerGrubu.innerHTML = cizgilerHtml;
    }

    // Lejant Canlı Değer Güncelleme
    function guncelleLejantRakamlari(nokta: FaizNoktasi) {
      document.querySelectorAll<HTMLElement>('.lejant-dugme').forEach((btn) => {
        const id = btn.dataset.seriId;
        if (!id) return;
        const raw = (nokta as any)[id];
        if (typeof raw !== 'number') return;
        const elAylik = btn.querySelector('[data-deger-turu="aylik"]');
        const elYillik = btn.querySelector('[data-deger-turu="yillik"]');
        if (elAylik) elAylik.textContent = `%${(raw / 12).toFixed(2)}`;
        if (elYillik) elYillik.textContent = `%${raw.toFixed(2)}`;
      });
    }

    // Tooltip ve Takip İmleci
    function guncelleImlec(clientX: number) {
      const noktalar = getFiltreliVeri();
      if (!noktalar || noktalar.length === 0) return;

      const rect = etkilesim.getBoundingClientRect();
      const mouseX = clientX - rect.left;
      if (mouseX < 0 || mouseX > rect.width) {
        imlecGrubu.style.display = 'none';
        tooltip.style.display = 'none';
        return;
      }

      const n = noktalar.length;
      const oran = Math.max(0, Math.min(1, mouseX / rect.width));
      const idx = Math.min(Math.max(0, Math.round(oran * (n - 1))), n - 1);
      const pt = noktalar[idx];
      if (!pt) return;

      const x = PAD.left + (idx / Math.max(n - 1, 1)) * plotW;
      imlecCizgi.setAttribute('x1', x.toFixed(1));
      imlecCizgi.setAttribute('x2', x.toFixed(1));

      // Min ve Max hesapla (nokta Y pozisyonları için)
      let minVal = Infinity;
      let maxVal = -Infinity;
      for (const p of noktalar) {
        for (const seri of SERILER) {
          if (!gorunenSeriler.has(seri.id)) continue;
          const raw = (p as any)[seri.id];
          if (typeof raw === 'number') {
            const v = aktifMod === 'aylik' ? raw / 12 : raw;
            if (v < minVal) minVal = v;
            if (v > maxVal) maxVal = v;
          }
        }
      }
      const pay = (maxVal - minVal) * 0.1 || 0.5;
      const yMin = Math.max(0, minVal - pay);
      const yMax = maxVal + pay;
      const yRange = yMax - yMin;
      const yCoord = (val: number) => PAD.top + (1 - (val - yMin) / yRange) * plotH;

      // Daire noktaları çiz
      let noktalarSvg = '';
      let ttHtml = '';
      for (const seri of SERILER) {
        if (!gorunenSeriler.has(seri.id)) continue;
        const raw = (pt as any)[seri.id];
        if (typeof raw !== 'number') continue;
        const val = aktifMod === 'aylik' ? raw / 12 : raw;
        const y = yCoord(val);

        noktalarSvg += `
          <circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="4" fill="${seri.renk}" stroke="#ffffff" stroke-width="1.5" />
        `;

        const degerStr = aktifMod === 'aylik' ? `%${(raw / 12).toFixed(2)}` : `%${raw.toFixed(2)}`;
        const ikincilStr = aktifMod === 'aylik' ? `yıllık %${raw.toFixed(1)}` : `aylık %${(raw / 12).toFixed(2)}`;

        ttHtml += `
          <div class="tt-satir ${odakSeri === seri.id ? 'odakli' : ''}">
            <span class="tt-nokta" style="background:${seri.renk};"></span>
            <span class="tt-ad">${seri.ad}</span>
            <span class="tt-deger">${degerStr} <small>(${ikincilStr})</small></span>
          </div>
        `;
      }
      imlecNoktalar.innerHTML = noktalarSvg;
      imlecGrubu.style.display = 'block';

      // Tooltip doldur
      const gun = pt.tarih.slice(8, 10);
      const ay = pt.tarih.slice(5, 7);
      const yil = pt.tarih.slice(0, 4);
      ttTarih.textContent = `${gun}.${ay}.${yil}`;
      ttModEtiket.textContent = aktifMod === 'aylik' ? 'Aylık basit' : 'Yıllık basit';
      ttListesi.innerHTML = ttHtml;

      // Makas (İhtiyaç - Mevduat)
      if (pt.ihtiyac && pt.mevduat) {
        const makasAylik = (pt.ihtiyac - pt.mevduat) / 12;
        ttMakas.innerHTML = `<span>Kredi - Mevduat Farkı:</span> <strong>+${makasAylik.toFixed(2)} puan</strong> (aylık)`;
      } else {
        ttMakas.innerHTML = '';
      }

      // Tooltip konumu
      const screenX = (x / W) * rect.width;
      tooltip.style.display = 'block';
      if (screenX > rect.width * 0.6) {
        tooltip.style.left = `${screenX - 220}px`;
      } else {
        tooltip.style.left = `${screenX + 16}px`;
      }
      tooltip.style.top = '30px';

      // Lejant rakamlarını imlecin olduğu tarihe güncelle
      guncelleLejantRakamlari(pt);
    }

    function gizleImlec() {
      imlecGrubu.style.display = 'none';
      tooltip.style.display = 'none';
      // Son tarihe geri al
      const son = tumSatirlar.at(-1);
      if (son) guncelleLejantRakamlari(son);
    }

    // Etkileşim Olayları (Mouse & Touch)
    etkilesim.addEventListener('mousemove', (e) => guncelleImlec(e.clientX));
    etkilesim.addEventListener('mouseleave', gizleImlec);

    etkilesim.addEventListener('touchmove', (e) => {
      if (e.touches[0]) {
        guncelleImlec(e.touches[0].clientX);
      }
    }, { passive: true });
    etkilesim.addEventListener('touchend', gizleImlec);

    // Mod Değiştirme Dinleyicileri
    document.querySelectorAll<HTMLButtonElement>('[data-mod]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-mod]').forEach((b) => b.classList.remove('aktif'));
        btn.classList.add('aktif');
        aktifMod = btn.dataset.mod as 'aylik' | 'yillik';

        // Lejant görünümünü değiştir
        document.querySelectorAll<HTMLElement>('[data-deger-turu]').forEach((el) => {
          el.style.display = el.dataset.degerTuru === aktifMod ? 'inline' : 'none';
        });

        cizGrafik();
      });
    });

    // Zaman Aralığı Değiştirme Dinleyicileri
    document.querySelectorAll<HTMLButtonElement>('[data-aralik]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-aralik]').forEach((b) => b.classList.remove('aktif'));
        btn.classList.add('aktif');
        const val = btn.dataset.aralik;
        aktifAralik = val === 'tum' ? 'tum' : Number(val);
        cizGrafik();
      });
    });

    // Lejant Tıklama (Aç/Kapa) ve Hover (Spotlight/Odak)
    document.querySelectorAll<HTMLButtonElement>('.lejant-dugme').forEach((btn) => {
      const seriId = btn.dataset.seriId!;

      btn.addEventListener('click', () => {
        if (gorunenSeriler.has(seriId)) {
          if (gorunenSeriler.size > 1) {
            gorunenSeriler.delete(seriId);
            btn.classList.remove('aktif');
          }
        } else {
          gorunenSeriler.add(seriId);
          btn.classList.add('aktif');
        }
        cizGrafik();
      });

      btn.addEventListener('mouseenter', () => {
        odakSeri = seriId;
        cizGrafik();
      });

      btn.addEventListener('mouseleave', () => {
        odakSeri = null;
        cizGrafik();
      });
    });

    // İlk Çizim
    cizGrafik();
  }
</script>

<style>
  .faiz-interaktif-kart {
    margin: 28px 0;
    padding: 24px;
    background: #ffffff;
    border: 1px solid var(--soluk, #e4e1d7);
  }

  .grafik-baslik-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .grafik-ana-baslik {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--ink, #1b1b1b);
    margin: 0;
  }

  .grafik-ipucu-metin {
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.85rem;
    color: var(--muted, #5d5b55);
    margin: 4px 0 0 0;
  }

  .filtre-gruplari {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .filtre-kumesi {
    display: inline-flex;
    background: var(--paper, #f4f3ee);
    border: 1px solid var(--hair, #cfccc2);
    padding: 2px;
  }

  .filtre-btn {
    border: none;
    background: transparent;
    padding: 6px 12px;
    font-family: var(--sans, 'Bricolage Grotesque', sans-serif);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted, #5d5b55);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filtre-btn.aktif {
    background: var(--ink, #1b1b1b);
    color: #ffffff;
  }

  /* Lejant Düğmeleri */
  .interaktif-lejant {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
    gap: 10px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--soluk, #e4e1d7);
  }

  .lejant-dugme {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: transparent;
    border: 1px solid transparent;
    padding: 6px 8px;
    cursor: pointer;
    text-align: left;
    transition: background 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }

  .lejant-dugme:not(.aktif) {
    opacity: 0.35;
    filter: grayscale(1);
  }

  .lejant-dugme:hover {
    background: var(--paper, #f4f3ee);
    border-color: var(--hair, #cfccc2);
  }

  .lejant-renk-kutu {
    width: 22px;
    height: 4px;
    margin-bottom: 6px;
    display: inline-block;
