---
// finfolis Veri Gösterge Kartı: Sayı, mini eğri (SVG sparkline) ve editoryal yönlendirme.
// DESIGN.md: Kâğıt zemin, mürekkep çizgi, pişmiş toprak kategori vurgusu, sıfır gölge.
interface Props {
  href: string;
  kategori: string;
  baslik: string;
  deger: string;
  birim?: string;
  degisim?: string;
  degisimYon?: 'yukselis' | 'dusus' | 'notr';
  aciklama: string;
  kaynak?: string;
  seri?: number[];
  // Küçük grafikte noktanın üzerine gelince yazılacak metin; yoksa değer seriBicim'e göre yazılır.
  seriMetinleri?: string[];
  seriBicim?: 'yuzde' | 'puan' | 'milyarUsd' | 'milyarTl' | 'yil' | 'kur' | 'endeks';
  oneCikan?: boolean;
}

const {
  href,
  kategori,
  baslik,
  deger,
  birim,
  degisim,
  degisimYon = 'notr',
  aciklama,
  kaynak,
  seri = [],
  seriMetinleri,
  seriBicim = 'endeks',
  oneCikan = false,
} = Astro.props;

// Küçük grafikteki değer etiketi.
const sayi = (v: number, o: number) =>
  `${v < 0 ? '−' : ''}${Math.abs(v).toLocaleString('tr-TR', { minimumFractionDigits: o, maximumFractionDigits: o })}`;
const bicimle = (v: number) => {
  if (seriBicim === 'yuzde') return `${v < 0 ? '−' : ''}%${sayi(Math.abs(v), 1)}`;
  if (seriBicim === 'puan') return `${sayi(v, 1)} puan`;
  if (seriBicim === 'milyarUsd') return `${sayi(v, 1)} milyar $`;
  if (seriBicim === 'milyarTl') return `${sayi(v, 1)} milyar TL`;
  if (seriBicim === 'yil') return `${sayi(v, 1)} yıl`;
  if (seriBicim === 'kur') return `${sayi(v, 4)} TL`;
  return sayi(v, Math.abs(v) >= 100 ? 1 : 2);
};

// Mini SVG Eğrisi Hesaplama
const W = 200;
const H = 44;
const PAD = 3;

let cizgiYolu = '';
let sonNoktaX = 0;
let sonNoktaY = 0;
let noktalar: [number, number, string][] = [];

if (seri.length >= 2) {
  const min = Math.min(...seri);
  const max = Math.max(...seri);
  const aralik = max - min || 1;

  const x = (i: number) => PAD + (i / (seri.length - 1)) * (W - 2 * PAD);
  const y = (v: number) => PAD + (1 - (v - min) / aralik) * (H - 2 * PAD);

  cizgiYolu = seri
    .map((v, i) => `${i === 0 ? 'M' : 'L'} ${x(i).toFixed(1)} ${y(v).toFixed(1)}`)
    .join(' ');

  sonNoktaX = x(seri.length - 1);
  sonNoktaY = y(seri.at(-1)!);
  noktalar = seri.map((v, i) => [
    Number(x(i).toFixed(1)),
    Number(y(v).toFixed(1)),
    seriMetinleri?.[i] ?? bicimle(v),
  ]);
}
---

<a href={href} class={`veri-kart ${oneCikan ? 'one-cikan' : ''}`}>
  <div class="kart-ust">
    <span class="kart-kategori">{kategori}</span>
    {kaynak && <span class="kart-kaynak">{kaynak}</span>}
  </div>

  <h3 class="kart-baslik">{baslik}</h3>

  <div class="kart-ana-deger">
    <span class="sayi">{deger}</span>
    {birim && <small class="birim">{birim}</small>}
  </div>

  <div class="kart-orta-blok">
    {
      degisim && (
        <span class={`kart-degisim ${degisimYon}`}>
          {degisim}
        </span>
      )
    }
    <p class="kart-aciklama">{aciklama}</p>
  </div>

  {
    cizgiYolu && (
      <div class="kart-grafik-alani" data-sparkline={JSON.stringify(noktalar)}>
        <svg
          viewBox={`0 0 ${W} ${H}`}
          class="kart-sparkline"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d={cizgiYolu}
            fill="none"
            stroke="var(--ink-2)"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            vector-effect="non-scaling-stroke"
          />
          <circle
            cx={sonNoktaX}
            cy={sonNoktaY}
            r="3"
            fill="var(--toprak)"
          />
          <line class="sp-imlec" x1="0" x2="0" y1="0" y2={H} visibility="hidden" vector-effect="non-scaling-stroke" />
          <circle class="sp-nokta" r="3.5" cx="0" cy="0" visibility="hidden" />
        </svg>
        <span class="sp-ipucu" hidden></span>
      </div>
    )
  }

  <div class="kart-alt">
    <span class="kart-link-metin">Veriyi incele</span>
    <span class="kart-ok" aria-hidden="true">→</span>
  </div>
</a>

<script>
  // Küçük grafik: imlecin altındaki noktanın değerini gösterir. Ekran koordinatı SVG koordinatına çevrilir (grafik
  // orantılı ölçeklendiği için kenarlarda boşluk kalabilir).
  for (const alan of document.querySelectorAll<HTMLElement>('[data-sparkline]')) {
    const noktalar = JSON.parse(alan.dataset.sparkline || '[]') as [number, number, string][];
    const svg = alan.querySelector('svg');
    const imlec = alan.querySelector<SVGLineElement>('.sp-imlec');
    const nokta = alan.querySelector<SVGCircleElement>('.sp-nokta');
    const ipucu = alan.querySelector<HTMLElement>('.sp-ipucu');
    if (!svg || !imlec || !nokta || !ipucu || noktalar.length < 2) continue;
    const goster = (istemciX: number) => {
      const ctm = svg.getScreenCTM();
      if (!ctm) return;
      const p = new DOMPoint(istemciX, 0).matrixTransform(ctm.inverse());
      let i = 0;
      for (let j = 1; j < noktalar.length; j++) if (Math.abs(noktalar[j][0] - p.x) < Math.abs(noktalar[i][0] - p.x)) i = j;
      const [nx, ny, metin] = noktalar[i];
      imlec.setAttribute('x1', String(nx));
      imlec.setAttribute('x2', String(nx));
      nokta.setAttribute('cx', String(nx));
      nokta.setAttribute('cy', String(ny));
      imlec.setAttribute('visibility', 'visible');
      nokta.setAttribute('visibility', 'visible');
      ipucu.textContent = metin;
      ipucu.hidden = false;
      const ekran = new DOMPoint(nx, 0).matrixTransform(ctm);
      const kutu = alan.getBoundingClientRect();
      const px = ekran.x - kutu.left;
      const sag = px > kutu.width / 2;
      ipucu.style.left = sag ? '' : `${px + 8}px`;
      ipucu.style.right = sag ? `${kutu.width - px + 8}px` : '';
    };
    const gizle = () => {
      imlec.setAttribute('visibility', 'hidden');
      nokta.setAttribute('visibility', 'hidden');
      ipucu.hidden = true;
    };
    alan.addEventListener('pointermove', (e) => goster(e.clientX));
    alan.addEventListener('pointerleave', gizle);
    alan.addEventListener('touchmove', (e) => e.touches[0] && goster(e.touches[0].clientX), { passive: true });
    alan.addEventListener('touchend', gizle);
  }
</script>

<style>
  .veri-kart {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--hair);
    padding: 20px 22px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, background-color 0.15s ease;
    position: relative;
  }

  .veri-kart:hover {
    background: var(--paper-2);
    border-color: var(--ink);
  }

  .veri-kart.one-cikan {
    border-top: 3px solid var(--toprak);
  }

  .kart-ust {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 6px;
  }

  .kart-kategori {
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--toprak-text);
  }

  .kart-kaynak {
    font-size: 0.72rem;
    color: var(--muted);
  }

  .kart-baslik {
    margin: 0 0 10px;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .kart-ana-deger {
    display: flex;
    align-items: baseline;
    gap: 5px;
    margin-bottom: 8px;
  }

  .kart-ana-deger .sayi {
    font-family: var(--sans);
    font-size: 1.95rem;
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .kart-ana-deger .birim {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--muted);
  }

  .kart-orta-blok {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 12px;
  }

  .kart-degisim {
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .kart-degisim.yukselis {
    color: var(--yukselis);
  }

  .kart-degisim.dusus {
    color: var(--dusus);
  }

  .kart-degisim.notr {
    color: var(--ink-2);
  }

  .kart-aciklama {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--ink-2);
  }

  .kart-grafik-alani {
    position: relative;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--hair);
    cursor: crosshair;
  }

  .kart-grafik-alani :global(.sp-imlec) {
    stroke: var(--ink);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }

  .kart-grafik-alani :global(.sp-nokta) {
    fill: var(--ink);
    stroke: #fff;
    stroke-width: 1.5;
  }

  .sp-ipucu {
    position: absolute;
    top: -14px;
    padding: 2px 6px;
    background: var(--ink);
    color: #fff;
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    pointer-events: none;
  }

  .kart-sparkline {
    display: block;
    width: 100%;
    height: 40px;
    overflow: visible;
  }

  .kart-alt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px dashed var(--hair);
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--toprak-text);
  }

  .veri-kart:hover .kart-alt {
    color: var(--toprak);
  }

  .kart-ok {
    font-size: 1rem;
    transition: transform 0.15s ease;
  }

  .veri-kart:hover .kart-ok {
    transform: translateX(4px);
  }
</style>
