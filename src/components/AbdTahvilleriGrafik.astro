---
// Türkiye'nin Elindeki ABD Tahvilleri İnteraktif Yığılmış Alan (Stacked Area) Grafiği.
// Finfolis tasarım dili: Kâğıt & mürekkep, Bricolage Grotesque, sıfır harici kütüphane bağımlılığı.
import type { TahvilAnalizi } from '../lib/abd-tahvilleri.d.mts';

interface Props {
  veri: TahvilAnalizi;
}

const { veri } = Astro.props;
const { noktalar, tarihselZirve, sonNokta } = veri;

// Grafik boyutları
const W = 800;
const H = 380;
const PAD_TOP = 40;
const PAD_BOTTOM = 45;
const PAD_LEFT = 55;
const PAD_RIGHT = 35;

const cizimW = W - PAD_LEFT - PAD_RIGHT;
const cizimH = H - PAD_TOP - PAD_BOTTOM;

// Y ekseni ölçeği (0 ile 90.000 milyon USD arası; eksende milyar yazılır)
const maxY = 90000;
const minY = 0;

const xPos = (i: number, len: number = noktalar.length) => PAD_LEFT + (i / Math.max(len - 1, 1)) * cizimW;
const yPos = (val: number, max: number = maxY) => PAD_TOP + (1 - (val - minY) / (max - minY)) * cizimH;
const ySifir = yPos(0, maxY);

// Uzun Vadeli Alanı
const uzunNoktalar = noktalar.map((p, i) => `${xPos(i).toFixed(1)},${yPos(p.uzunUSD).toFixed(1)}`);
const uzunAlanD = `M ${xPos(0).toFixed(1)},${ySifir.toFixed(1)} L ${uzunNoktalar.join(' L ')} L ${xPos(noktalar.length - 1).toFixed(1)},${ySifir.toFixed(1)} Z`;

// Kısa Vadeli Alanı (Toplam - Uzun)
const toplamNoktalar = noktalar.map((p, i) => `${xPos(i).toFixed(1)},${yPos(p.toplamUSD).toFixed(1)}`);
const uzunNoktalarTers = [...uzunNoktalar].reverse();
const kisaAlanD = `M ${toplamNoktalar[0]} L ${toplamNoktalar.join(' L ')} L ${uzunNoktalarTers.join(' L ')} Z`;

// Üst toplam eğrisi konturu
const toplamCizgiD = `M ${toplamNoktalar.join(' L ')}`;

// Y Ekseni Çizgileri (0, 20k, 40k, 60k, 80k)
const yIzgaraSeviyeleri = [0, 20000, 40000, 60000, 80000];

// X Ekseni Yıl Etiketleri (iki yılda bir)
const xEtiketleri: { yil: string; x: number }[] = [];
let sonEtiketYili = 0;
noktalar.forEach((p, i) => {
  const yil = parseInt(p.tarih.slice(0, 4), 10);
  if (yil >= 2011 && yil % 2 !== 0 && yil !== sonEtiketYili) {
    xEtiketleri.push({ yil: `${yil}-${p.tarih.slice(5, 7)}`, x: xPos(i) });
    sonEtiketYili = yil;
  }
});
xEtiketleri.push({ yil: sonNokta.tarih.slice(0, 7), x: xPos(noktalar.length - 1) });

// Zirve Noktası (82.431)
const zirveIndex = noktalar.findIndex((p) => p.toplamUSD === tarihselZirve.toplamUSD);
const zirveX = zirveIndex >= 0 ? xPos(zirveIndex) : 0;
const zirveY = zirveIndex >= 0 ? yPos(tarihselZirve.toplamUSD) : 0;

// Son nokta (5.731)
const sonX = xPos(noktalar.length - 1);
const sonY = yPos(sonNokta.toplamUSD);
---

<div class="abd-tahvilleri-grafik" data-tarihsel-tahvil-grafik data-noktalar={JSON.stringify(noktalar)}>
  <!-- Filtre Butonları ve Dönem Seçici -->
  <div class="grafik-kontrol-cubugu">
    <div class="grafik-baslik-etiketi">
      <span class="vurgulu-etiket">İnteraktif Görünüm</span>
      <span class="aciklama-etiket">İmleci gezdirerek dönemsel dağılımı inceleyebilirsiniz</span>
    </div>

    <div class="zaman-filtre-alani" role="group" aria-label="Zaman Aralığı">
      <button type="button" class="filtre-butonu" data-periyot="2y">Son 2 Yıl</button>
      <button type="button" class="filtre-butonu" data-periyot="5y">Son 5 Yıl</button>
      <button type="button" class="filtre-butonu aktif" data-periyot="tumu">Tümü (2011–2026)</button>
    </div>
  </div>

  <!-- Dinamik Canlı Bilgi Paneli / Lejant -->
  <div class="grafik-lejant" id="tarihsel-canli-lejant">
    <div class="lejant-oge">
      <span class="renk-kutu kisa"></span>
      <span class="ad">Kısa Vadeli (T-Bills, &le;1 yıl)</span>
      <strong class="deger" id="tarihsel-lejant-kisa">${(sonNokta.kisaUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr (%{sonNokta.kisaOran})</strong>
    </div>
    <div class="lejant-oge">
      <span class="renk-kutu uzun"></span>
      <span class="ad">Uzun Vadeli (Tahvil, &gt;1 yıl)</span>
      <strong class="deger" id="tarihsel-lejant-uzun">${(sonNokta.uzunUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr (%{sonNokta.uzunOran})</strong>
    </div>
    <div class="lejant-oge toplam">
      <span class="ad" id="tarihsel-lejant-tarih">Toplam ({sonNokta.tarih.slice(0, 7)}):</span>
      <strong class="deger" id="tarihsel-lejant-toplam">${(sonNokta.toplamUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr</strong>
    </div>
  </div>

  <div class="svg-tasiyici">
    <svg
      id="tarihsel-tahvil-svg"
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="xMidYMid meet"
      class="grafik-svg"
      role="img"
      aria-label="Türkiye'nin elindeki ABD tahvilleri yığılmış alan grafiği"
    >
      <defs>
        <!-- Kırmızı/Kiremit Alan Gradyanı -->
        <linearGradient id="tarihselKisaGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c2502b" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#a33d1c" stop-opacity="0.8" />
        </linearGradient>
        <!-- Antrasit / Füme Alan Gradyanı -->
        <linearGradient id="tarihselUzunGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#5d5b55" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#1b1b1b" stop-opacity="0.85" />
        </linearGradient>
      </defs>

      <!-- Y Izgara Grubu -->
      <g id="tarihsel-izgara-grubu">
        {yIzgaraSeviyeleri.map((seviye) => {
          const y = yPos(seviye);
          return (
            <g class="izgara-seviye">
              <line x1={PAD_LEFT} y1={y} x2={W - PAD_RIGHT} y2={y} stroke="var(--c-izgara, #e2e8f0)" stroke-dasharray="3,3" stroke-width="1" />
              <text x={PAD_LEFT - 8} y={y + 4} text-anchor="end" class="eksen-metin">
                {(seviye / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}
              </text>
            </g>
          );
        })}
      </g>

      <!-- Y Birim Etiketi -->
      <text x={PAD_LEFT} y={PAD_TOP - 15} class="birim-metin">
        milyar $, TIC verisi
      </text>

      <!-- Katman 1: Uzun Vadeli Alan (Füme) -->
      <path id="tarihsel-alan-uzun" d={uzunAlanD} fill="url(#tarihselUzunGrad)" class="alan-uzun" />

      <!-- Katman 2: Kısa Vadeli Alan (Kiremit Kırmızı) -->
      <path id="tarihsel-alan-kisa" d={kisaAlanD} fill="url(#tarihselKisaGrad)" class="alan-kisa" />

      <!-- Katman 3: Toplam Kontur Çizgisi -->
      <path id="tarihsel-cizgi-toplam" d={toplamCizgiD} fill="none" stroke="#1b1b1b" stroke-width="1.2" class="cizgi-toplam" />

      <!-- X ekseni taban çizgisi -->
      <line x1={PAD_LEFT} y1={ySifir} x2={W - PAD_RIGHT} y2={ySifir} stroke="var(--c-kenar, #94a3b8)" stroke-width="1" />

      <!-- X Ekseni Etiket Grubu -->
      <g id="tarihsel-x-ekseni">
        {xEtiketleri.map((etk) => (
          <g class="x-etiket-grup" transform={`translate(${etk.x}, ${ySifir + 16})`}>
            <line x1="0" y1="-16" x2="0" y2="-12" stroke="var(--c-kenar, #94a3b8)" stroke-width="1" />
            <text x="0" y="0" text-anchor="middle" class="eksen-metin x-metin">
              {etk.yil}
            </text>
          </g>
        ))}
      </g>

      <!-- Alan İçi Başlık Vurguları -->
      <g id="tarihsel-alan-metinleri">
        <text x={W * 0.38} y={yPos(40000)} text-anchor="middle" class="alan-etiket kisa-etiket">
          KISA VADELİ
        </text>
        <text x={W * 0.38} y={yPos(12000)} text-anchor="middle" class="alan-etiket uzun-etiket">
          UZUN VADELİ
        </text>
      </g>

      <!-- Tarihsel Zirve Rozeti (82.431) -->
      {zirveIndex >= 0 && (
        <g id="tarihsel-rozet-zirve" class="vurgu-zirve">
          <circle cx={zirveX} cy={zirveY} r="4.5" fill="#7f1d1d" stroke="#ffffff" stroke-width="1.5" />
          <text x={zirveX} y={zirveY - 10} text-anchor="middle" class="vurgu-metin">
            ${(tarihselZirve.toplamUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} Mr
          </text>
        </g>
      )}

      <!-- Son Nokta Rozeti (5.731) -->
      <g id="tarihsel-rozet-son" class="vurgu-son">
        <circle cx={sonX} cy={sonY} r="4.5" fill="#c2502b" stroke="#ffffff" stroke-width="2" />
        <text x={sonX - 5} y={sonY - 10} text-anchor="end" class="vurgu-metin vurgu-son-metin">
          ${(sonNokta.toplamUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} Mr
        </text>
      </g>

      <!-- İnteraktif Takip Çizgisi ve Odak Noktaları (CSP dostu visibility) -->
      <g id="tarihsel-takip-grubu" class="takip-grubu" visibility="hidden">
        <line id="tarihsel-takip-cizgi" x1="0" y1={PAD_TOP} x2="0" y2={ySifir} stroke="#1b1b1b" stroke-width="1.2" stroke-dasharray="3 3" />
        <!-- Toplam portföy noktası -->
        <circle id="tarihsel-takip-nokta-toplam" cx="0" cy="0" r="5" fill="#c2502b" stroke="#ffffff" stroke-width="2" />
        <!-- Uzun vadeli sınır noktası -->
        <circle id="tarihsel-takip-nokta-uzun" cx="0" cy="0" r="4.5" fill="#1b1b1b" stroke="#ffffff" stroke-width="2" />
      </g>

      <!-- SVG İçi Kayan Tooltip (CSP dostu, transform ile taşınır) -->
      <g id="tarihsel-svg-tooltip" class="svg-tooltip" visibility="hidden">
        <rect id="tarihsel-tt-bg" class="tt-kutu" x="0" y="0" width="220" height="114" rx="4" />
        <text id="tarihsel-tt-tarih" class="tt-baslik" x="12" y="22">Ağustos 2026</text>
        <line x1="12" y1="28" x2="208" y2="28" stroke="var(--soluk, #e2e8f0)" stroke-width="1" />
        <!-- Kısa vadeli T-Bills -->
        <circle cx="18" cy="43" r="3.5" fill="#c2502b" />
        <text class="tt-etiket" x="28" y="46">Kısa Vadeli (T-Bills):</text>
        <text id="tarihsel-tt-kisa" class="tt-rakam" x="208" y="46" text-anchor="end">${(sonNokta.kisaUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr</text>
        <!-- Uzun vadeli tahvil -->
        <circle cx="18" cy="63" r="3.5" fill="#1b1b1b" />
        <text class="tt-etiket" x="28" y="66">Uzun Vadeli Tahvil:</text>
        <text id="tarihsel-tt-uzun" class="tt-rakam" x="208" y="66" text-anchor="end">${(sonNokta.uzunUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr</text>
        <!-- Toplam portföy -->
        <line x1="12" y1="74" x2="208" y2="74" stroke="var(--soluk, #e2e8f0)" stroke-width="1" stroke-dasharray="2 2" />
        <circle cx="18" cy="88" r="3.5" fill="#2563eb" />
        <text class="tt-etiket tt-kalin" x="28" y="91">Toplam ABD Tahvili:</text>
        <text id="tarihsel-tt-toplam" class="tt-rakam tt-vurgu" x="208" y="91" text-anchor="end">${(sonNokta.toplamUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr</text>
        <text id="tarihsel-tt-oran" class="tt-alt-oran" x="110" y="106" text-anchor="middle">%71,7 Kısa · %28,3 Uzun</text>
      </g>

      <!-- Şeffaf Etkileşim Yüzeyi (Mouse ve Touch Yakalayıcı) -->
      <rect
        id="tarihsel-etkilesim-yuzeyi"
        class="etkilesim-katmani"
        x={PAD_LEFT}
        y={PAD_TOP}
        width={cizimW}
        height={cizimH}
        fill="transparent"
      />
    </svg>
  </div>
</div>

<script>
  interface TahvilNokta {
    tarih: string;
    uzunUSD: number;
    kisaUSD: number;
    toplamUSD: number;
    kisaOran: number;
    uzunOran: number;
  }

  const kapsayici = document.querySelector('[data-tarihsel-tahvil-grafik]') as HTMLElement | null;
  if (kapsayici) {
    const tumNoktalar: TahvilNokta[] = JSON.parse(kapsayici.dataset.noktalar || '[]');
    let aktifNoktalar = [...tumNoktalar];

    // SVG Elemanları
    const svg = document.getElementById('tarihsel-tahvil-svg') as SVGSVGElement | null;
    const alanUzun = document.getElementById('tarihsel-alan-uzun') as SVGPathElement | null;
    const alanKisa = document.getElementById('tarihsel-alan-kisa') as SVGPathElement | null;
    const cizgiToplam = document.getElementById('tarihsel-cizgi-toplam') as SVGPathElement | null;
    const izgaraGrubu = document.getElementById('tarihsel-izgara-grubu');
    const xEkseni = document.getElementById('tarihsel-x-ekseni');
    const alanMetinleri = document.getElementById('tarihsel-alan-metinleri');
    const rozetZirve = document.getElementById('tarihsel-rozet-zirve');
    const rozetSon = document.getElementById('tarihsel-rozet-son');

    // Takip ve Tooltip
    const takipGrubu = document.getElementById('tarihsel-takip-grubu');
    const takipCizgi = document.getElementById('tarihsel-takip-cizgi') as SVGLineElement | null;
    const takipNoktaToplam = document.getElementById('tarihsel-takip-nokta-toplam') as SVGCircleElement | null;
    const takipNoktaUzun = document.getElementById('tarihsel-takip-nokta-uzun') as SVGCircleElement | null;

    const svgTooltip = document.getElementById('tarihsel-svg-tooltip');
    const ttTarih = document.getElementById('tarihsel-tt-tarih');
    const ttKisa = document.getElementById('tarihsel-tt-kisa');
    const ttUzun = document.getElementById('tarihsel-tt-uzun');
    const ttToplam = document.getElementById('tarihsel-tt-toplam');
    const ttOran = document.getElementById('tarihsel-tt-oran');

    // Lejant elemanları
    const lejantKisa = document.getElementById('tarihsel-lejant-kisa');
    const lejantUzun = document.getElementById('tarihsel-lejant-uzun');
    const lejantTarih = document.getElementById('tarihsel-lejant-tarih');
    const lejantToplam = document.getElementById('tarihsel-lejant-toplam');

    const etkilesim = document.getElementById('tarihsel-etkilesim-yuzeyi') as SVGRectElement | null;
    const filtreButonlari = kapsayici.querySelectorAll('.filtre-butonu');

    // Sabit Koordinat Parametreleri
    const W = 800;
    const H = 380;
    const PAD_TOP = 40;
    const PAD_BOTTOM = 45;
    const PAD_LEFT = 55;
    const PAD_RIGHT = 35;
    const cizimW = W - PAD_LEFT - PAD_RIGHT;
    const cizimH = H - PAD_TOP - PAD_BOTTOM;
    const minY = 0;

    let maxY = 90000;

    const xPos = (i: number, len: number) => PAD_LEFT + (i / Math.max(len - 1, 1)) * cizimW;
    const yPos = (v: number, max: number) => PAD_TOP + (1 - (v - minY) / (max - minY)) * cizimH;

    const aylar = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
    function tarihMetni(isoTarih: string) {
      const [y, m] = isoTarih.split('-');
      const ayIdx = parseInt(m, 10) - 1;
      return `${aylar[ayIdx] || m} ${y}`;
    }

    function guncelleCanli(p: TahvilNokta, px: number, pyToplam: number, pyUzun: number) {
      // Lejant metinleri
      if (lejantKisa) lejantKisa.textContent = `$${(p.kisaUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr (%${p.kisaOran})`;
      if (lejantUzun) lejantUzun.textContent = `$${(p.uzunUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr (%${p.uzunOran})`;
      if (lejantTarih) lejantTarih.textContent = `Toplam (${p.tarih.slice(0, 7)}):`;
      if (lejantToplam) {
        lejantToplam.textContent = `$${(p.toplamUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr`;
      }

      // Takip Çizgisi ve Noktaları
      if (takipGrubu) takipGrubu.setAttribute('visibility', 'visible');
      if (takipCizgi) {
        takipCizgi.setAttribute('x1', px.toFixed(1));
        takipCizgi.setAttribute('x2', px.toFixed(1));
      }
      if (takipNoktaToplam) {
        takipNoktaToplam.setAttribute('cx', px.toFixed(1));
        takipNoktaToplam.setAttribute('cy', pyToplam.toFixed(1));
      }
      if (takipNoktaUzun) {
        takipNoktaUzun.setAttribute('cx', px.toFixed(1));
        takipNoktaUzun.setAttribute('cy', pyUzun.toFixed(1));
      }

      // Tooltip Metinleri
      if (ttTarih) ttTarih.textContent = tarihMetni(p.tarih);
      if (ttKisa) ttKisa.textContent = `$${(p.kisaUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr (%${p.kisaOran})`;
      if (ttUzun) ttUzun.textContent = `$${(p.uzunUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr (%${p.uzunOran})`;
      if (ttToplam) ttToplam.textContent = `$${(p.toplamUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr`;
      if (ttOran) ttOran.textContent = `%${p.kisaOran} Kısa · %${p.uzunOran} Uzun Vadeli`;

      // Tooltip Konumu (Sağ sınır kontrolü)
      if (svgTooltip) {
        svgTooltip.setAttribute('visibility', 'visible');
        const ttW = 220;
        const ttH = 114;
        let ttX = px + 14;
        if (ttX + ttW > W - PAD_RIGHT) {
          ttX = px - ttW - 14; // Sola kaydır
        }
        let ttY = Math.min(Math.max(pyToplam - ttH / 2, PAD_TOP), H - PAD_BOTTOM - ttH);
        svgTooltip.setAttribute('transform', `translate(${ttX.toFixed(1)}, ${ttY.toFixed(1)})`);
      }
    }

    function sifirlaCanli() {
      if (takipGrubu) takipGrubu.setAttribute('visibility', 'hidden');
      if (svgTooltip) svgTooltip.setAttribute('visibility', 'hidden');

      const son = aktifNoktalar.at(-1);
      if (!son) return;
      if (lejantKisa) lejantKisa.textContent = `$${(son.kisaUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr (%${son.kisaOran})`;
      if (lejantUzun) lejantUzun.textContent = `$${(son.uzunUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr (%${son.uzunOran})`;
      if (lejantTarih) lejantTarih.textContent = `Toplam (${son.tarih.slice(0, 7)}):`;
      if (lejantToplam) {
        lejantToplam.textContent = `$${(son.toplamUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} Mr`;
      }
    }

    function ciz(veriler: TahvilNokta[]) {
      if (!veriler.length || !alanUzun || !alanKisa || !cizgiToplam) return;

      const tepeNokta = Math.max(...veriler.map((p) => p.toplamUSD));
      maxY = tepeNokta > 40000 ? 90000 : tepeNokta > 15000 ? 30000 : 10000;
      const ySifir = yPos(0, maxY);

      // Y Izgara çizgilerini yeniden çiz
      if (izgaraGrubu) {
        izgaraGrubu.innerHTML = '';
        const seviyeler = maxY === 90000 ? [0, 20000, 40000, 60000, 80000] : maxY === 30000 ? [0, 5000, 10000, 15000, 20000, 25000] : [0, 2000, 4000, 6000, 8000];
        seviyeler.forEach((seviye) => {
          const y = yPos(seviye, maxY);
          const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
          g.setAttribute('class', 'izgara-seviye');
          g.innerHTML = `
            <line x1="${PAD_LEFT}" y1="${y}" x2="${W - PAD_RIGHT}" y2="${y}" stroke="var(--c-izgara, #e2e8f0)" stroke-dasharray="3,3" stroke-width="1" />
            <text x="${PAD_LEFT - 8}" y="${y + 4}" text-anchor="end" class="eksen-metin">${(seviye / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}</text>
          `;
          izgaraGrubu.appendChild(g);
        });
      }

      // Yollar
      const uzunPts = veriler.map((p, i) => `${xPos(i, veriler.length).toFixed(1)},${yPos(p.uzunUSD, maxY).toFixed(1)}`);
      const toplamPts = veriler.map((p, i) => `${xPos(i, veriler.length).toFixed(1)},${yPos(p.toplamUSD, maxY).toFixed(1)}`);
      const uzunPtsTers = [...uzunPts].reverse();

      alanUzun.setAttribute('d', `M ${xPos(0, veriler.length).toFixed(1)},${ySifir.toFixed(1)} L ${uzunPts.join(' L ')} L ${xPos(veriler.length - 1, veriler.length).toFixed(1)},${ySifir.toFixed(1)} Z`);
      alanKisa.setAttribute('d', `M ${toplamPts[0]} L ${toplamPts.join(' L ')} L ${uzunPtsTers.join(' L ')} Z`);
      cizgiToplam.setAttribute('d', `M ${toplamPts.join(' L ')}`);

      // X Eksenini güncelle
      if (xEkseni) {
        xEkseni.innerHTML = '';
        const xEtk: { yil: string; x: number }[] = [];
        let sonYil = 0;
        const adimYil = veriler.length > 80 ? 2 : 1;
        veriler.forEach((p, i) => {
          const y = parseInt(p.tarih.slice(0, 4), 10);
          if (y % adimYil === 0 && y !== sonYil) {
            xEtk.push({ yil: `${y}-${p.tarih.slice(5, 7)}`, x: xPos(i, veriler.length) });
            sonYil = y;
          }
        });
        const sonP = veriler.at(-1)!;
        xEtk.push({ yil: sonP.tarih.slice(0, 7), x: xPos(veriler.length - 1, veriler.length) });

        xEtk.forEach((etk) => {
          const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
          g.setAttribute('class', 'x-etiket-grup');
          g.setAttribute('transform', `translate(${etk.x}, ${ySifir + 16})`);
          g.innerHTML = `
            <line x1="0" y1="-16" x2="0" y2="-12" stroke="var(--c-kenar, #94a3b8)" stroke-width="1" />
            <text x="0" y="0" text-anchor="middle" class="eksen-metin x-metin">${etk.yil}</text>
          `;
          xEkseni.appendChild(g);
        });
      }

      // Rozetleri ve Alan Metinlerini Aralığa Göre Ayarla
      if (rozetZirve) {
        const zirveVar = veriler.find((p) => p.toplamUSD >= 80000);
        if (zirveVar) {
          const zIdx = veriler.indexOf(zirveVar);
          const zX = xPos(zIdx, veriler.length);
          const zY = yPos(zirveVar.toplamUSD, maxY);
          rozetZirve.innerHTML = `
            <circle cx="${zX}" cy="${zY}" r="4.5" fill="#7f1d1d" stroke="#ffffff" stroke-width="1.5" />
            <text x="${zX}" y="${zY - 10}" text-anchor="middle" class="vurgu-metin">$${(zirveVar.toplamUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} Mr</text>
          `;
          rozetZirve.setAttribute('visibility', 'visible');
        } else {
          rozetZirve.setAttribute('visibility', 'hidden');
        }
      }

      if (rozetSon) {
        const sonP = veriler.at(-1)!;
        const sX = xPos(veriler.length - 1, veriler.length);
        const sY = yPos(sonP.toplamUSD, maxY);
        rozetSon.innerHTML = `
          <circle cx="${sX}" cy="${sY}" r="4.5" fill="#c2502b" stroke="#ffffff" stroke-width="2" />
          <text x="${sX - 5}" y="${sY - 10}" text-anchor="end" class="vurgu-metin vurgu-son-metin">$${(sonP.toplamUSD / 1000).toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} Mr</text>
        `;
      }

      if (alanMetinleri) {
        if (veriler.length > 60) {
          alanMetinleri.setAttribute('visibility', 'visible');
        } else {
          alanMetinleri.setAttribute('visibility', 'hidden');
        }
      }

      sifirlaCanli();
    }

    // İmleç Takip Fonksiyonu
    function fareTakip(clientX: number) {
      if (!svg || !aktifNoktalar.length) return;
      const rect = svg.getBoundingClientRect();
      const svgX = ((clientX - rect.left) / rect.width) * W;

      let enYakinIdx = 0;
      let minMesafe = Infinity;

      aktifNoktalar.forEach((_, i) => {
        const px = xPos(i, aktifNoktalar.length);
        const mesafe = Math.abs(svgX - px);
        if (mesafe < minMesafe) {
          minMesafe = mesafe;
          enYakinIdx = i;
        }
      });

      const nokta = aktifNoktalar[enYakinIdx];
      const px = xPos(enYakinIdx, aktifNoktalar.length);
      const pyToplam = yPos(nokta.toplamUSD, maxY);
      const pyUzun = yPos(nokta.uzunUSD, maxY);

      guncelleCanli(nokta, px, pyToplam, pyUzun);
    }

    if (etkilesim) {
      etkilesim.addEventListener('mousemove', (e) => fareTakip(e.clientX));
      etkilesim.addEventListener('touchmove', (e) => {
        if (e.touches[0]) fareTakip(e.touches[0].clientX);
      }, { passive: true });

      etkilesim.addEventListener('mouseleave', sifirlaCanli);
      etkilesim.addEventListener('touchend', sifirlaCanli);
    }

    // Periyot Butonları Dinleyicisi
    filtreButonlari.forEach((btn) => {
      btn.addEventListener('click', () => {
        filtreButonlari.forEach((b) => b.classList.remove('aktif'));
        btn.classList.add('aktif');

        const periyot = (btn as HTMLElement).dataset.periyot;
        if (periyot === '2y') {
          aktifNoktalar = tumNoktalar.slice(-24);
        } else if (periyot === '5y') {
          aktifNoktalar = tumNoktalar.slice(-60);
        } else {
          aktifNoktalar = [...tumNoktalar];
        }

        ciz(aktifNoktalar);
      });
    });
  }
</script>

