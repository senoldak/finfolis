---
import { Image } from 'astro:assets';
import { category as categoryOf, formatDate } from '../lib/site';
import { newsUrl, type Haber } from '../lib/news';
import { KART_DONUSUM, kartGorseliVar } from '../lib/gorsel.mjs';
import { okumaSuresi, turEtiketi } from '../lib/yazi-bilgisi.mjs';

// Liste satırı: başlık, spot ve künye; kapak resmi varsa sağda küçük.
// Görselsiz haberler varsayılan durumdur, satır onlarsız da eksiksiz görünür.
interface Props {
  haber: Haber;
  showCategory?: boolean;
  showSpot?: boolean;
}

const { haber, showCategory = true, showSpot = true } = Astro.props;
const { title, description, date, category } = haber.data;
// Başlığı tekrar eden metin kapağı (coverSitede: false) listede gösterilmez.
// Küçük resim yalnızca yeni yazılarda (dosya bütçesi: src/lib/gorsel.mjs); eski yazı görselsiz satırdır.
const cover = kartGorseliVar(date) && haber.data.coverSitede ? haber.data.cover : undefined;
const cat = categoryOf(category);
const turEtiket = turEtiketi(haber.data);
// Okuma süresi yalnız uzun yazıda (2 dk ve üstü) gösterilir: kısa haberlerin hepsi 1 dk olur, bilgi vermez.
const okumaDk = okumaSuresi(haber.body);
---

<article class:list={['satir', { 'satir-resimli': cover }]}>
  <div class="satir-metin">
    <h3><a href={newsUrl(haber)}>{title}</a></h3>
    {showSpot && <p>{description}</p>}
    <p class="kunye">
      {
        showCategory && (
          <a href={`/kategori/${cat.slug}/`} class={`kunye-kat ink-${cat.ink}`}>
            {cat.name}
          </a>
        )
      }
      {turEtiket && <span class="kunye-tur">{turEtiket}</span>}
      <time datetime={date.toISOString()}>{formatDate(date, true)}</time>
      {okumaDk >= 2 && <span>{okumaDk} dk</span>}
    </p>
  </div>
  {
    cover && (
      <a href={newsUrl(haber)} class="satir-resim" tabindex="-1" aria-hidden="true">
        {/* Kart 132px (mobilde 96px): 1200px kapak yerine 264×198 kırpılmış küçük resim iner. */}
        <Image src={cover} alt="" {...KART_DONUSUM} loading="lazy" decoding="async" />
      </a>
    )
  }
</article>
