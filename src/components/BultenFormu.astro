---
// Haftalık bülten abonelik formu. Gönderim Worker'a gider (/api/bulten/abone); tuzak alanı bot filtresidir.
interface Props {
  kimlik: string;
}
const { kimlik } = Astro.props;
---

<form class="bulten-form" action="/api/bulten/abone" method="post">
  <p class="bulten-baslik">Haftalık bülten</p>
  <div class="bulten-satir">
    <label for={kimlik}>E-posta adresiniz</label>
    <input id={kimlik} name="eposta" type="email" required autocomplete="email" inputmode="email" maxlength="254" placeholder="ad@ornek.com" />
    <button type="submit">Abone ol</button>
  </div>
  <div class="bulten-tuzak" hidden aria-hidden="true">
    <label>Web sitesi <input name="web" tabindex="-1" autocomplete="off" /></label>
  </div>
  <p class="bulten-not">
    Adresiniz yalnızca bülten göndermek için tutulur. Onay e-postasındaki bağlantıyla onaylarsınız; istediğiniz zaman tek tıkla ayrılabilirsiniz.
    <a href="/gizlilik/">Gizlilik</a>
  </p>
</form>
