---
interface Props {
  varsayilanTutar?: number;
  varsayilanMevduatFaizi?: number;
  varsayilanPpfGetirisi?: number;
  varsayilanGun?: number;
}

const {
  varsayilanTutar = 100_000,
  varsayilanMevduatFaizi = 40.0,
  varsayilanPpfGetirisi = 40.0,
  varsayilanGun = 32,
} = Astro.props;
---

<div class="hesaplayici-kutu" id="mevduat-ppf-araci">
  <div class="girdi-paneli">
    <div class="girdi-grubu">
      <label for="hesap-anapara" class="girdi-etiket">Yatırım Tutarı (TL)</label>
      <div class="girdi-sarma">
        <input
          type="number"
          id="hesap-anapara"
          class="girdi-alan"
          value={varsayilanTutar}
          min="1000"
          step="5000"
          aria-describedby="anapara-ipucu"
        />
        <span class="girdi-birim">₺</span>
      </div>
      <span id="anapara-ipucu" class="girdi-alt-not">Hesaplama için temel anapara tutarı</span>
    </div>

    <div class="girdi-grubu">
      <label for="hesap-gun" class="girdi-etiket">Vade Süresi (Gün)</label>
      <div class="girdi-sarma">
        <input
          type="number"
          id="hesap-gun"
          class="girdi-alan"
          value={varsayilanGun}
          min="1"
          max="1095"
          step="1"
        />
        <span class="girdi-birim">gün</span>
      </div>
      <div class="hizli-gunler" role="group" aria-label="Popüler vade süreleri">
        <button type="button" class="gun-buton aktif" data-gun="32">32 Gün</button>
        <button type="button" class="gun-buton" data-gun="46">46 Gün</button>
        <button type="button" class="gun-buton" data-gun="92">92 Gün</button>
        <button type="button" class="gun-buton" data-gun="180">180 Gün</button>
        <button type="button" class="gun-buton" data-gun="365">1 Yıl</button>
      </div>
    </div>

    <div class="girdi-ikili">
      <div class="girdi-grubu">
        <label for="hesap-mevduat-faiz" class="girdi-etiket">Mevduat Faizi (Brüt %)</label>
        <div class="girdi-sarma">
          <input
            type="number"
            id="hesap-mevduat-faiz"
            class="girdi-alan"
            value={varsayilanMevduatFaizi}
            min="1"
            max="120"
            step="0.5"
          />
          <span class="girdi-birim">%</span>
        </div>
      </div>

      <div class="girdi-grubu">
        <label for="hesap-ppf-getiri" class="girdi-etiket">PPF Yıllık Getiri (Brüt %)</label>
        <div class="girdi-sarma">
          <input
            type="number"
            id="hesap-ppf-getiri"
            class="girdi-alan"
            value={varsayilanPpfGetirisi}
            min="1"
            max="120"
            step="0.5"
          />
          <span class="girdi-birim">%</span>
        </div>
      </div>
    </div>
  </div>

  <div class="sonuc-karsilastirma" id="karsilastirma-ozet">
    <div class="karsilastirma-banner" id="banner-kazanan">
      <div class="banner-ikon" id="banner-ikon" aria-hidden="true">⚖️</div>
      <div class="banner-metinler">
        <strong class="banner-baslik" id="banner-baslik">Getiri Karşılaştırması</strong>
        <p class="banner-aciklama" id="banner-aciklama">Hesaplanıyor...</p>
      </div>
    </div>

    <div class="sonuc-kartlari">
      <!-- Mevduat Kartı -->
      <article class="sonuc-kart" id="kart-mevduat">
        <header class="kart-baslik">
          <span class="kart-tur">Vadeli Mevduat</span>
          <span class="kart-stopaj-rozet" id="mevduat-stopaj-rozet">%17,5 stopaj</span>
        </header>

        <div class="kart-ana-sonuc">
          <span class="sonuc-etiket">Net Kazanç</span>
          <span class="sonuc-deger" id="mevduat-net-kazanc">₺0</span>
        </div>

        <ul class="kart-detaylar">
          <li class="detay-satir">
            <span>Brüt Faiz Geliri</span>
            <strong id="mevduat-brut-kazanc">₺0</strong>
          </li>
          <li class="detay-satir">
            <span>Kesilen Stopaj Vergisi</span>
            <strong class="eksi-deger" id="mevduat-kesilen-stopaj">-₺0</strong>
          </li>
          <li class="detay-satir">
            <span>Vade Sonu Toplam Bakiye</span>
            <strong id="mevduat-toplam-bakiye">₺0</strong>
          </li>
          <li class="detay-satir">
            <span>Yıllıklandırılmış Net Getiri</span>
            <strong id="mevduat-net-oran">%0</strong>
          </li>
        </ul>

        <footer class="kart-dipnot">
          <span>Vadeden önce çekişte faizin ne olacağı bankanın koşullarına bağlıdır.</span>
        </footer>
      </article>

      <!-- PPF Kartı -->
      <article class="sonuc-kart" id="kart-ppf">
        <header class="kart-baslik">
          <span class="kart-tur">Para Piyasası Fonu (PPF)</span>
          <span class="kart-stopaj-rozet">%17,5 stopaj</span>
        </header>

        <div class="kart-ana-sonuc">
          <span class="sonuc-etiket">Net Kazanç (Bileşik)</span>
          <span class="sonuc-deger" id="ppf-net-kazanc">₺0</span>
        </div>

        <ul class="kart-detaylar">
          <li class="detay-satir">
            <span>Brüt Fon Kazancı</span>
            <strong id="ppf-brut-kazanc">₺0</strong>
          </li>
          <li class="detay-satir">
            <span>Kesilen Stopaj Vergisi</span>
            <strong class="eksi-deger" id="ppf-kesilen-stopaj">-₺0</strong>
          </li>
          <li class="detay-satir">
            <span>Vade Sonu Toplam Bakiye</span>
            <strong id="ppf-toplam-bakiye">₺0</strong>
          </li>
          <li class="detay-satir">
            <span>Efektif Bileşik Net Getiri</span>
            <strong id="ppf-net-oran">%0</strong>
          </li>
        </ul>

        <footer class="kart-dipnot">
          <span>TEFAS'ta iş günü 13:30'a kadar verilen emirler aynı gün işlenir (yarım günlerde 11:30).</span>
        </footer>
      </article>
    </div>
  </div>
</div>

<script>
  import { mevduatHesapla, ppfHesapla } from '../lib/hesap/mevduat-ppf.mjs';

  const formatPara = (sayi) => '₺' + sayi.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const formatYuzde = (sayi) => '%' + sayi.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const oranYaz = (o) => '%' + (o * 100).toLocaleString('tr-TR', { maximumFractionDigits: 1 }) + ' stopaj';
  const yaz = (id, metin) => {
    const e = document.getElementById(id);
    if (e) e.textContent = metin;
  };

  function hesapla() {
    const anapara = parseFloat(document.getElementById('hesap-anapara').value) || 0;
    const gun = parseInt(document.getElementById('hesap-gun').value, 10) || 1;
    const mev = mevduatHesapla({ anapara, yillikFaiz: parseFloat(document.getElementById('hesap-mevduat-faiz').value) || 0, gun });
    const ppf = ppfHesapla({ anapara, yillikGetiri: parseFloat(document.getElementById('hesap-ppf-getiri').value) || 0, gun });

    yaz('mevduat-stopaj-rozet', oranYaz(mev.stopajOrani || 0));
    yaz('mevduat-net-kazanc', formatPara(mev.netKazanc));
    yaz('mevduat-brut-kazanc', formatPara(mev.brutKazanc));
    yaz('mevduat-kesilen-stopaj', '-' + formatPara(mev.stopaj));
    yaz('mevduat-toplam-bakiye', formatPara(mev.netBakiye));
    yaz('mevduat-net-oran', formatYuzde(mev.netYillikOran));

    yaz('ppf-net-kazanc', formatPara(ppf.netKazanc));
    yaz('ppf-brut-kazanc', formatPara(ppf.brutKazanc));
    yaz('ppf-kesilen-stopaj', '-' + formatPara(ppf.stopaj));
    yaz('ppf-toplam-bakiye', formatPara(ppf.netBakiye));
    yaz('ppf-net-oran', formatYuzde(ppf.netYillikOran));

    // Özet: yalnız girilen varsayımlarla aritmetik fark; tavsiye değildir.
    const fark = ppf.netKazanc - mev.netKazanc;
    const banner = document.getElementById('banner-kazanan');
    yaz('banner-ikon', '⚖️');
    if (Math.abs(fark) < 1) {
      yaz('banner-baslik', 'Net kazançlar yaklaşık aynı');
      yaz('banner-aciklama', `Girdiğiniz oranlarla ${gun} günün sonunda iki hesabın stopaj sonrası kazancı arasında 1 TL'den az fark var.`);
    } else {
      const ad = fark > 0 ? 'PPF' : 'Mevduat';
      yaz('banner-baslik', `${ad} hesabında net kazanç ${formatPara(Math.abs(fark))} daha yüksek`);
      yaz('banner-aciklama', `Girdiğiniz oranlarla ${gun} günün sonunda stopaj sonrası fark. Fonun gerçek getirisi fon fiyatına göre değişir; sonuç bir örnek hesaptır.`);
    }
    if (banner) banner.className = 'karsilastirma-banner esit';
  }

  ['hesap-anapara', 'hesap-gun', 'hesap-mevduat-faiz', 'hesap-ppf-getiri'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', hesapla);
  });

  document.querySelectorAll('.gun-buton').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.gun-buton').forEach((b) => b.classList.remove('aktif'));
      btn.classList.add('aktif');
      document.getElementById('hesap-gun').value = btn.getAttribute('data-gun');
      hesapla();
    });
  });

  hesapla();
</script>

<style>
  .hesaplayici-kutu {
    margin: 28px 0 36px;
    padding: 24px;
    background: #fffdfa;
    border: 1px solid var(--cizgi, #e5e0d4);
    border-radius: 6px;
    font-family: var(--yazi, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
  }

  .girdi-paneli {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }

  @media (min-width: 640px) {
    .girdi-paneli {
      grid-template-columns: 1fr 1fr;
    }
    .girdi-ikili {
      grid-column: span 2;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }
  }

  .girdi-grubu {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .girdi-etiket {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--murekkep, #1d211e);
  }

  .girdi-sarma {
    position: relative;
    display: flex;
    align-items: center;
  }

  .girdi-alan {
    width: 100%;
    padding: 10px 36px 10px 12px;
    font-size: 1.05rem;
    font-family: var(--yazi-mono, monospace);
    color: var(--murekkep, #1d211e);
    background: #fff;
    border: 1px solid var(--cizgi, #e5e0d4);
    border-radius: 4px;
    outline: none;
    transition: border-color 0.15s ease;
  }

  .girdi-alan:focus {
    border-color: var(--toprak-text, #aa3a18);
    box-shadow: 0 0 0 2px rgba(170, 58, 24, 0.12);
  }

  .girdi-birim {
    position: absolute;
    right: 12px;
    font-size: 0.9rem;
    color: var(--gri, #6c726d);
    font-weight: 600;
    pointer-events: none;
  }

  .girdi-alt-not {
    font-size: 0.75rem;
    color: var(--gri, #6c726d);
  }

  .hizli-gunler {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }

  .gun-buton {
    padding: 4px 10px;
    font-size: 0.78rem;
    font-weight: 600;
    border: 1px solid var(--cizgi, #e5e0d4);
    background: #fbf9f4;
    color: var(--murekkep, #1d211e);
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .gun-buton:hover {
    background: #f3efe6;
  }

  .gun-buton.aktif {
    background: var(--toprak-text, #aa3a18);
    color: #fff;
    border-color: var(--toprak-text, #aa3a18);
  }

  .karsilastirma-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 4px;
    margin-bottom: 24px;
    border: 1px solid var(--cizgi, #e5e0d4);
    background: #fcfbf7;
  }

  .karsilastirma-banner.ppf-onde {
    background: #f4faf6;
    border-color: #cce8d7;
    border-left: 5px solid #2d8a4e;
  }

  .karsilastirma-banner.mevduat-onde {
    background: #fdf8f4;
    border-color: #f3dfd2;
    border-left: 5px solid var(--toprak-text, #aa3a18);
  }

  .banner-ikon {
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .banner-baslik {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--murekkep, #1d211e);
    margin-bottom: 3px;
  }

  .banner-aciklama {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--murekkep-orta, #3c423e);
  }

  .sonuc-kartlari {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  @media (min-width: 640px) {
    .sonuc-kartlari {
      grid-template-columns: 1fr 1fr;
    }
  }

  .sonuc-kart {
    padding: 18px;
    background: #fff;
    border: 1px solid var(--cizgi, #e5e0d4);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
  }

  .kart-baslik {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--cizgi, #e5e0d4);
  }

  .kart-tur {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--murekkep, #1d211e);
  }

  .kart-stopaj-rozet {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 6px;
    background: #f0ede4;
    border-radius: 3px;
    color: var(--murekkep, #1d211e);
  }

  .kart-ana-sonuc {
    margin-bottom: 16px;
  }

  .sonuc-etiket {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--gri, #6c726d);
    margin-bottom: 2px;
  }

  .sonuc-deger {
    font-size: 1.6rem;
    font-weight: 800;
    font-family: var(--yazi-mono, monospace);
    color: var(--murekkep, #1d211e);
  }

  .kart-detaylar {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    flex-grow: 1;
  }

  .detay-satir {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    padding: 6px 0;
    border-bottom: 1px dashed var(--cizgi, #e5e0d4);
    color: var(--murekkep-orta, #3c423e);
  }

  .detay-satir strong {
    font-family: var(--yazi-mono, monospace);
    color: var(--murekkep, #1d211e);
  }

  .eksi-deger {
    color: #b91c1c !important;
  }

  .kart-dipnot {
    margin-top: auto;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--gri, #6c726d);
    padding-top: 10px;
    border-top: 1px solid var(--cizgi, #e5e0d4);
  }
</style>
