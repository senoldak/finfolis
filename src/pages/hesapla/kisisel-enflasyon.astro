---
// Kişisel enflasyon hesaplayıcı: okurun harcama dağılımı × TÜİK ana grup endeksleri (son 12 ay, sabit ağırlıklı Laspeyres).
// Veri src/data/enflasyon-katkilari.json (scripts/veri/enflasyon-katkilari.mjs, TCMB EVDS); hesap src/lib/kisisel-enflasyon.mjs.
// Hesap tarayıcıda yapılır; girdiler sunucuya gitmez, saklanmaz. CSP satır içi betiğe izin vermez: betik aşağıda, derlemede ayrı dosya olur.
import Base from '../../layouts/Base.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import veri from '../../data/enflasyon-katkilari.json';
import { AYLAR, ayAdi, sayiYaz, zamanYaz } from '../../lib/resmi';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi, SITE_URL } from '../../lib/seo';
import { normallestir, kisiselYillik, KOLAY_KURALLAR } from '../../lib/kisisel-enflasyon.mjs';

const gruplar = veri.gruplar;
const endeksler = veri.endeksler;
const son = veri.sonAy;
const tuik = gruplar.map((g) => g.agirlik);
const mansetYillik = veri.satirlar.at(-1)!.manset.yillik;
const tuikIleKisisel = kisiselYillik(endeksler, normallestir(tuik));
const baslangicAy = `${AYLAR[son.ay - 1]} ${son.yil - 1}`;
const bitisAy = ayAdi(son);
const kisa = ['Gıda', 'Alkol, tütün', 'Giyim', 'Konut', 'Ev eşyası', 'Sağlık', 'Ulaştırma', 'İletişim', 'Eğlence', 'Eğitim', 'Lokanta, otel', 'Sigorta, finans', 'Çeşitli'];
const sayfaVeri = JSON.stringify({
  gruplar: gruplar.map((g, i) => ({ kod: g.kod, ad: g.ad, kisa: kisa[i], agirlik: g.agirlik })),
  endeksler,
  sonAy: son,
  kolay: KOLAY_KURALLAR,
});

const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Hesapla', href: '/hesapla/' },
  { ad: 'Kişisel enflasyon hesaplama', href: '/hesapla/kisisel-enflasyon/' },
];
const description = `Kendi harcama dağılımınızla yıllık enflasyonunuzu hesaplayın: TÜİK’in 13 ana harcama grubu endeksiyle ${baslangicAy} – ${bitisAy} arası kişisel enflasyon, resmi TÜFE (%${sayiYaz(mansetYillik, 2)}) ile karşılaştırma ve grup grup katkı.`;
const jsonLd = sayfaSemasi({
  yol,
  ad: 'Kişisel enflasyon hesaplama',
  aciklama: description,
  ekler: [
    {
      '@type': 'WebApplication',
      name: 'Kişisel enflasyon hesaplayıcı',
      url: `${SITE_URL}/hesapla/kisisel-enflasyon/`,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      inLanguage: 'tr',
      description,
    },
  ],
});
---

<Base title="Kişisel enflasyon hesaplama: sizin enflasyonunuz" description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container hesap-sayfa">
    <Breadcrumb yol={yol} />
    <header class="sayfa-bas sayfa-bas-duz">
      <h1>Kişisel enflasyon hesaplama</h1>
      <p>Harcama dağılımınıza göre yıllık enflasyon, TÜİK verisiyle</p>
    </header>

    <div class="hesap-izgara">
      <form class="hesap ke-form" id="ke-form" novalidate>
        <div class="hesap-sonuc ke-ozet" aria-live="polite">
          <p class="hesap-ana">
            <output id="ke-kisisel">%{sayiYaz(tuikIleKisisel, 2)}</output>
            <span>kişisel yıllık enflasyon</span>
          </p>
          <p id="ke-cumle">
            Harcama dağılımınız TÜİK’in {veri.agirlikYili} ağırlıklarıyla aynı olsaydı {baslangicAy} – {bitisAy} arasında fiyatlar
            %{sayiYaz(tuikIleKisisel, 2)} artardı; resmi TÜFE %{sayiYaz(mansetYillik, 2)}. Kendi dağılımınızı girin.
          </p>
          <dl>
            <div>
              <dt>Resmi yıllık TÜFE ({bitisAy})</dt>
              <dd id="ke-manset">%{sayiYaz(mansetYillik, 2)}</dd>
            </div>
            <div>
              <dt>Fark (kişisel − TÜFE)</dt>
              <dd id="ke-fark">{tuikIleKisisel - mansetYillik < 0 ? '−' : '+'}{sayiYaz(Math.abs(tuikIleKisisel - mansetYillik), 2)} puan</dd>
            </div>
          </dl>
        </div>
        <p class="hesap-hata" id="ke-hata" hidden role="alert"></p>

        <fieldset class="ke-mod">
          <legend>Girdi biçimi</legend>
          <label class="ke-secenek"><input type="radio" name="mod" value="y" checked /> Yüzde olarak</label>
          <label class="ke-secenek"><input type="radio" name="mod" value="t" /> Aylık TL tutar olarak</label>
        </fieldset>

        <details class="ke-kolay">
          <summary>Kolay başlangıç: üç soru ile hazır dağılım</summary>
          <p class="ke-not">
            Başlangıç TÜİK’in {veri.agirlikYili} ana grup ağırlıklarıdır. Aşağıdaki kutuyu boşaltırsanız yalnız o grup sıfırlanır,
            kalan gruplar TÜİK ağırlıklarının oranında büyütülerek toplam %100’e tamamlanır. Başka bir değişiklik yapılmaz; sonra
            kaydırıcılarla kendiniz ince ayar yapın.
          </p>
          {
            KOLAY_KURALLAR.map((k) => (
              <label class="ke-secenek">
                <input type="checkbox" name={`kolay-${k.anahtar}`} data-kolay={k.anahtar} checked />
                {k.soru} <small>(boşsa “{gruplar.find((g) => g.kod === k.grup)?.ad}” sıfırlanır)</small>
              </label>
            ))
          }
          <p class="ke-not">
            Kirada oturup oturmadığınız ya da aracınız olup olmadığı sorulmaz: bu sayfa yalnız 13 ana grubun endeksini kullanır ve
            konut ile ulaştırma gruplarının içindeki kira ya da araç payı bu veride yok. Bu iki grup için kendi harcamanızı aşağıdan
            girin.
          </p>
          <button type="button" id="ke-kolay-uygula">Başlangıç dağılımını doldur</button>
        </details>

        <div class="ke-satirlar" id="ke-satirlar">
          {
            gruplar.map((g, i) => (
              <div class="ke-satir" data-i={i}>
                <label for={`ke-g${i}`}>{g.ad}</label>
                <div class="ke-giris">
                  <input
                    id={`ke-g${i}`}
                    class="ke-sayi"
                    type="text"
                    inputmode="decimal"
                    autocomplete="off"
                    value={sayiYaz(g.agirlik, 2)}
                  />
                  <span class="ke-birim" data-birim>%</span>
                </div>
                <input
                  class="ke-kaydir"
                  type="range"
                  min="0"
                  max="60"
                  step="0.5"
                  value={g.agirlik}
                  aria-label={`${g.ad}, ince ayar (yüzde)`}
                />
                <span class="ke-pay" data-pay hidden></span>
              </div>
            ))
          }
        </div>
        <p class="ke-toplam" id="ke-toplam" aria-live="polite"></p>

        <noscript>
          <p class="veri-notu">Hesaplama için tarayıcınızda JavaScript açık olmalı. Formül ve yöntem yandaki açıklamada.</p>
        </noscript>

        <section class="ke-detay" id="ke-detay" aria-labelledby="ke-katki-baslik" hidden>
          <h2 id="ke-katki-baslik">Katkı: hangi grup enflasyonunuzu ne kadar artırdı?</h2>
          <p class="ke-not">
            Yüzde puan. Gruplar toplamı kişisel yıllık enflasyonunuza eşittir. Katkı, harcama payınız ile grubun son 12 aydaki fiyat
            değişiminin çarpımıdır.
          </p>
          <ul class="ke-katki" id="ke-katki" role="list"></ul>

          <h2>Son 12 ayda kişisel enflasyonunuz</h2>
          <p class="ke-not">Her ay için, o ayın bir yıl öncesine göre fiyat değişimi; sabit dağılımınızla.</p>
          <ul class="ke-lejant" aria-hidden="true">
            <li><span class="ke-kare ke-kare-sen"></span> Sizin dağılımınız</li>
            <li><span class="ke-kare ke-kare-tufe"></span> Resmi TÜFE</li>
          </ul>
          <div id="ke-grafik" class="ke-grafik"></div>
          <details class="hesap-plan">
            <summary>Aylık değerler (tablo)</summary>
            <div class="tablo-kaydir">
              <table class="cizelge veri-tablo" id="ke-tablo">
                <thead>
                  <tr>
                    <th scope="col">Ay</th>
                    <th scope="col" class="sag">Kişisel</th>
                    <th scope="col" class="sag">TÜFE</th>
                  </tr>
                </thead>
                <tbody></tbody>
              </table>
            </div>
          </details>

          <button type="button" id="ke-paylas" class="ke-paylas">Sonucu paylaş (bağlantıyı kopyala)</button>
          <p class="ke-not">
            Bağlantıdaki rakamlar adres çubuğunda yer alır; bağlantıyı alan kişi girdiğiniz dağılımı görür. Rakamlar bu siteye
            gönderilmez.
          </p>
        </section>
      </form>

      <section class="prose hesap-aciklama">
        <h2>Nasıl hesaplanır?</h2>
        <p>
          Resmî TÜFE, ortalama bir hanenin sepetine göre hesaplanır. Sizin sepetiniz farklıysa enflasyonunuz da farklıdır: kirası
          yüksek olan konut grubundan, çocuğu okula giden eğitim grubundan daha çok etkilenir. Burada her ana grubun payı sizin
          girdiğiniz harcama payıdır; grupların fiyat değişimi TÜİK’in ana grup endekslerinden alınır.
        </p>
        <p class="formul">Kişisel yıllık = Σ [ pay(g) × Endeks(g, bu ay) / Endeks(g, 12 ay önce) ] − 1</p>
        <p class="formul">Katkı(g) = pay(g) × (grubun 12 aylık değişimi)</p>
        <p>
          Paylar toplamı 1 (yüzde 100) olacak biçimde ayarlanır. Girdiğiniz değerlerin toplamı 100 değilse sayfa otomatik olarak
          oranlar korunarak yeniden ölçekler ve toplamı gösterir. TL tutar girerseniz her grubun payı, tutarın toplam harcamanıza
          oranıdır.
        </p>

        <h2>TÜİK’in hesabından farkı</h2>
        <p>
          TÜİK TÜFE’yi <strong>zincirleme</strong> hesaplar: ağırlıklar her yıl yenilenir ve bir önceki yılın Aralık ayına bağlanır.
          Yıllık değişim yıl sınırını aşarsa iki ayrı ağırlık setiyle hesaplanan iki parçanın birleşimidir. Bu sayfada ise payınız 12
          aylık pencere boyunca sabittir (sabit ağırlıklı Laspeyres). Bu fark küçük bir sapma doğurur.
        </p>
        <p>
          Sapmayı ölçmek için TÜİK’in {veri.agirlikYili} ana grup ağırlıklarını girdim: {bitisAy} için bu hesap
          %{sayiYaz(tuikIleKisisel, 2)} veriyor; TÜİK’in açıkladığı yıllık TÜFE %{sayiYaz(mansetYillik, 2)}. Fark
          {' '}{sayiYaz(Math.abs(tuikIleKisisel - mansetYillik), 2)} puan.
        </p>
        <p>
          Bir ayrıntı daha: yöntem, payları 12 ay önceki fiyatlarla bekler; siz bugünkü harcamanızın payını girdiğinizde sonuç hafif
          sapabilir. Beklenen sapma, yukarıdaki farkla aynı büyüklük sırasındadır.
        </p>

        <h2>Sınırlar</h2>
        <ul>
          <li>Hesap 13 ana grubun ortalama fiyat değişimini kullanır. Gruptaki bir ürünün (örneğin kiranın ya da akaryakıtın) kendi fiyat değişimi grup ortalamasından farklı olabilir.</li>
          <li>TÜFE bölgeden bağımsız tek bir ülke ortalamasıdır; bulunduğunuz şehirdeki fiyatlar farklı seyretmiş olabilir.</li>
          <li>Kolay başlangıçtaki kurallar yalnızca “bu grubu hiç kullanmıyorum” durumunu sıfırlar; başka bir tahmin yapmaz.</li>
          <li>Bu sayfa bilgi amaçlıdır; harcama, yatırım ya da sözleşme (kira artışı, maaş, tazminat) kararı için dayanak değildir.</li>
        </ul>

        <h2>Gizlilik</h2>
        <p>
          Hesap tamamen tarayıcınızda yapılır. Girdiğiniz hiçbir değer sunucuya gönderilmez, çerezde ya da tarayıcı belleğinde
          saklanmaz. Sayfayı kapatınca girdiler silinir; saklamak isterseniz “Sonucu paylaş” bağlantısını kendinize kaydedin.
        </p>

        <h2>Veri</h2>
        <p>
          Endeksler ve ağırlıklar TÜİK’indir, TCMB EVDS’den alınmıştır ({veri.kaynak.ad}). Siteye alındığı zaman:
          {' '}{zamanYaz(veri.guncelleme)}. Son veri: {bitisAy}. Grup bazında seriler için
          {' '}<a href="/veri/enflasyon-katkilari/">enflasyonun kaynakları</a> sayfasına,
          resmi manşet için <a href="/veri/enflasyon/">enflasyon verilerine</a> bakabilirsiniz. Bir tutarın iki ay arasındaki
          değeri için <a href="/hesapla/enflasyon/">enflasyon hesaplama</a>.
        </p>
      </section>
    </div>

    <YasalUyari>Hesaplayıcı bilgi amaçlıdır; sonuç, girdiğiniz harcama dağılımına ve TÜİK’in grup endekslerine dayanır, kişisel mali tavsiye değildir.</YasalUyari>
  </div>
  <script type="application/json" id="ke-veri" set:html={sayfaVeri.replace(/</g, '\\u003c')} />
</Base>

<script>
  import {
    normallestir, kisiselSeri, grupKatkilari, tutarlardanPay, kolayBaslangic, adresCoz, adresYaz,
  } from '../../lib/kisisel-enflasyon.mjs';

  type Grup = { kod: string; ad: string; kisa: string; agirlik: number };
  const veri = JSON.parse(document.getElementById('ke-veri')!.textContent!) as {
    gruplar: Grup[];
    endeksler: { yil: number; ay: number; genel: number; g: number[] }[];
    sonAy: { yil: number; ay: number };
  };
  const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
  const N = veri.gruplar.length;
  const tuik = veri.gruplar.map((g) => g.agirlik);
  const nf = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const nf0 = new Intl.NumberFormat('tr-TR', { maximumFractionDigits: 0 });
  const isaret = (n: number) => (n < 0 ? '−' : '');
  const yuzde = (n: number) => `${isaret(n)}%${nf.format(Math.abs(n))}`;
  const puan = (n: number) => `${isaret(n)}${nf.format(Math.abs(n))}`;
  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const form = el<HTMLFormElement>('ke-form');
  const satirlar = [...document.querySelectorAll<HTMLElement>('.ke-satir')];
  const sayilar = satirlar.map((s) => s.querySelector<HTMLInputElement>('.ke-sayi')!);
  const kaydiricilar = satirlar.map((s) => s.querySelector<HTMLInputElement>('.ke-kaydir')!);
  const paylar = satirlar.map((s) => s.querySelector<HTMLElement>('[data-pay]')!);
  const birimler = satirlar.map((s) => s.querySelector<HTMLElement>('[data-birim]')!);
  const modRadyo = [...form.querySelectorAll<HTMLInputElement>('input[name="mod"]')];

  // Her biçimin kendi değerleri: yüzde ve TL ayrı tutulur (birinden ötekine uydurma dönüşüm yapılmaz).
  const metin: Record<'y' | 't', string[]> = { y: tuik.map((v) => nf.format(v)), t: Array(N).fill('') };
  let mod: 'y' | 't' = 'y';

  // "1.250,5" / "1250.5" / "1250,5" -> 1250.5; boş -> 0; geçersiz -> NaN.
  function sayi(m: string) {
    let s = m.replace(/\s|TL|%/gi, '');
    if (!s) return 0;
    if (s.includes(',')) s = s.replace(/\./g, '').replace(',', '.');
    else if (/^\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, '');
    const n = Number(s);
    return Number.isFinite(n) ? n : NaN;
  }

  function modUygula(yeni: 'y' | 't') {
    mod = yeni;
    modRadyo.forEach((r) => (r.checked = r.value === yeni));
    sayilar.forEach((inp, i) => {
      inp.value = metin[yeni][i];
      inp.placeholder = yeni === 't' ? '0' : '';
    });
    kaydiricilar.forEach((k) => (k.hidden = yeni === 't'));
    birimler.forEach((b) => (b.textContent = yeni === 't' ? 'TL / ay' : '%'));
    paylar.forEach((p) => (p.hidden = yeni !== 't'));
    hesapla();
  }

  function oku(): number[] | string {
    const v: number[] = [];
    for (let i = 0; i < N; i++) {
      const n = sayi(sayilar[i].value);
      if (!Number.isFinite(n)) return `“${veri.gruplar[i].ad}” için geçerli bir sayı girin.`;
      if (n < 0) return `“${veri.gruplar[i].ad}” için sıfırdan küçük değer girilemez.`;
      v.push(n);
    }
    if (!(v.reduce((a, b) => a + b, 0) > 0)) return 'En az bir gruba sıfırdan büyük bir değer girin.';
    return v;
  }

  function katkiCiz(katkilar: { pay: number; degisim: number; katki: number }[]) {
    const liste = el('ke-katki');
    liste.textContent = '';
    const sirali = katkilar.map((k, i) => ({ ...k, i })).sort((a, b) => b.katki - a.katki);
    const en = Math.max(...sirali.map((k) => Math.abs(k.katki)), 1e-9);
    for (const k of sirali) {
      const li = document.createElement('li');
      const ust = document.createElement('div');
      ust.className = 'ke-katki-ust';
      const ad = document.createElement('span');
      ad.textContent = veri.gruplar[k.i].ad;
      const sayiEl = document.createElement('span');
      sayiEl.className = 'ke-katki-sayi';
      sayiEl.textContent = `${puan(k.katki)} puan`;
      ust.append(ad, sayiEl);
      const ray = document.createElement('div');
      ray.className = 'ke-ray';
      ray.setAttribute('aria-hidden', 'true');
      const cubuk = document.createElement('span');
      cubuk.className = 'ke-cubuk';
      cubuk.style.width = `${Math.max((Math.abs(k.katki) / en) * 100, k.katki === 0 ? 0 : 0.5)}%`;
      ray.append(cubuk);
      const alt = document.createElement('div');
      alt.className = 'ke-katki-alt';
      alt.textContent = `Payınız ${nf.format(k.pay)}%; grubun fiyatı son 12 ayda ${yuzde(k.degisim)} değişti.`;
      li.append(ust, ray, alt);
      liste.append(li);
    }
  }

  const SVG = 'http://www.w3.org/2000/svg';
  function svgEl(ad: string, nitelik: Record<string, string | number>, metni?: string) {
    const e = document.createElementNS(SVG, ad);
    for (const [k, v] of Object.entries(nitelik)) e.setAttribute(k, String(v));
    if (metni != null) e.textContent = metni;
    return e;
  }
  const ayEtiket = (s: { yil: number; ay: number }) => `${AYLAR[s.ay - 1].slice(0, 3)} ${String(s.yil).slice(2)}`;

  function grafikCiz(seri: { yil: number; ay: number; kisisel: number; manset: number }[]) {
    const kutu = el('ke-grafik');
    kutu.textContent = '';
    const W = 640, H = 260, SOL = 46, SAG = 14, UST = 14, ALT = 30;
    const tum = seri.flatMap((s) => [s.kisisel, s.manset]);
    let lo = Math.min(...tum), hi = Math.max(...tum);
    const pay = Math.max((hi - lo) * 0.15, 0.5);
    lo = Math.floor(lo - pay);
    hi = Math.ceil(hi + pay);
    const x = (i: number) => SOL + (i / (seri.length - 1)) * (W - SOL - SAG);
    const y = (v: number) => UST + (1 - (v - lo) / (hi - lo)) * (H - UST - ALT);
    const svg = svgEl('svg', { viewBox: `0 0 ${W} ${H}`, role: 'img', class: 'ke-svg' });
    svg.append(svgEl('title', {}, `Son 12 ayda kişisel yıllık enflasyon ve TÜFE; son ay ${yuzde(seri.at(-1)!.kisisel)} ve ${yuzde(seri.at(-1)!.manset)}`));
    const adim = (hi - lo) / 4;
    for (let k = 0; k <= 4; k++) {
      const v = lo + adim * k;
      svg.append(svgEl('line', { x1: SOL, x2: W - SAG, y1: y(v), y2: y(v), class: 'ke-izgara' }));
      svg.append(svgEl('text', { x: SOL - 6, y: y(v) + 4, 'text-anchor': 'end', class: 'ke-eksen' }, `%${nf0.format(v)}`));
    }
    [0, Math.floor((seri.length - 1) / 2), seri.length - 1].forEach((i, n) =>
      svg.append(svgEl('text', { x: x(i), y: H - 8, 'text-anchor': n === 0 ? 'start' : n === 2 ? 'end' : 'middle', class: 'ke-eksen' }, ayEtiket(seri[i]))),
    );
    const cizgi = (alan: 'kisisel' | 'manset', sinif: string) => {
      const nokta = seri.map((s, i) => `${x(i).toFixed(1)},${y(s[alan]).toFixed(1)}`).join(' ');
      svg.append(svgEl('polyline', { points: nokta, class: sinif, fill: 'none' }));
      const son = seri.at(-1)!;
      svg.append(svgEl('circle', { cx: x(seri.length - 1), cy: y(son[alan]), r: 4, class: `${sinif}-nokta` }));
    };
    cizgi('manset', 'ke-c-tufe');
    cizgi('kisisel', 'ke-c-sen');
    kutu.append(svg);

    const govde = document.querySelector('#ke-tablo tbody')!;
    govde.textContent = '';
    for (const s of [...seri].reverse()) {
      const tr = document.createElement('tr');
      const th = document.createElement('th');
      th.scope = 'row';
      th.textContent = `${AYLAR[s.ay - 1]} ${s.yil}`;
      const a = document.createElement('td');
      a.className = 'sag';
      a.textContent = yuzde(s.kisisel);
      const b = document.createElement('td');
      b.className = 'sag';
      b.textContent = yuzde(s.manset);
      tr.append(th, a, b);
      govde.append(tr);
    }
  }

  const hata = (m: string) => {
    const h = el('ke-hata');
    h.textContent = m;
    h.hidden = !m;
    el('ke-detay').hidden = Boolean(m) || el('ke-detay').hidden;
  };

  function hesapla() {
    const v = oku();
    if (typeof v === 'string') {
      hata(v);
      return;
    }
    hata('');
    const w = normallestir(v);
    const e = veri.endeksler;
    const seri = kisiselSeri(e, w, 12);
    const son = seri.at(-1)!;
    const katkilar = grupKatkilari(e, w);
    const bas = `${AYLAR[son.ay - 1]} ${son.yil - 1}`;
    const bit = `${AYLAR[son.ay - 1]} ${son.yil}`;
    const fark = son.kisisel - son.manset;

    el('ke-kisisel').textContent = yuzde(son.kisisel);
    el('ke-manset').textContent = yuzde(son.manset);
    el('ke-fark').textContent = `${fark < 0 ? '−' : '+'}${nf.format(Math.abs(fark))} puan`;
    el('ke-cumle').textContent =
      `Sizin harcama dağılımınızla ${bas} – ${bit} arasında fiyatlar ${yuzde(son.kisisel)} arttı; TÜFE ${yuzde(son.manset)}.` +
      (Math.abs(fark) < 0.05
        ? ' İki oran hemen hemen aynı.'
        : fark > 0
          ? ' Sepetiniz ortalama haneden daha hızlı pahalandı.'
          : ' Sepetiniz ortalama haneden daha yavaş pahalandı.');

    const toplam = v.reduce((a, b) => a + b, 0);
    const t = el('ke-toplam');
    if (mod === 'y') {
      t.textContent = Math.abs(toplam - 100) < 0.05 ? `Toplam: %${nf.format(toplam)}` : `Toplam: %${nf.format(toplam)}; oranlar korunarak %100’e göre yeniden ölçeklendi.`;
      paylar.forEach((p) => (p.textContent = ''));
    } else {
      t.textContent = `Toplam: ${nf0.format(toplam)} TL / ay`;
      const yp = tutarlardanPay(v);
      paylar.forEach((p, i) => (p.textContent = `Pay: %${nf.format(yp[i])}`));
    }

    katkiCiz(katkilar);
    grafikCiz(seri);
    el('ke-detay').hidden = false;

    // Paylaşılabilir adres: yalnız adres çubuğu güncellenir, hiçbir şey gönderilmez.
    try {
      history.replaceState(null, '', location.pathname + adresYaz(mod, v));
    } catch {
      /* adres güncellenemezse sessizce geç */
    }
  }

  // Olaylar
  sayilar.forEach((inp, i) => {
    inp.addEventListener('input', () => {
      metin[mod][i] = inp.value;
      if (mod === 'y') {
        const n = sayi(inp.value);
        if (Number.isFinite(n)) kaydiricilar[i].value = String(Math.min(n, 60));
      }
      hesapla();
    });
  });
  kaydiricilar.forEach((k, i) => {
    k.addEventListener('input', () => {
      const m = nf.format(Number(k.value));
      sayilar[i].value = m;
      metin.y[i] = m;
      hesapla();
    });
  });
  modRadyo.forEach((r) => r.addEventListener('change', () => r.checked && modUygula(r.value as 'y' | 't')));
  form.addEventListener('submit', (ev) => ev.preventDefault());

  el('ke-kolay-uygula').addEventListener('click', () => {
    const cevap: Record<string, boolean> = {};
    document.querySelectorAll<HTMLInputElement>('input[data-kolay]').forEach((c) => (cevap[c.dataset.kolay!] = c.checked));
    const y = kolayBaslangic(tuik, veri.gruplar, cevap);
    metin.y = y.map((n) => nf.format(n));
    kaydiricilar.forEach((k, i) => (k.value = String(Math.min(Math.round(y[i] * 2) / 2, 60))));
    modUygula('y');
  });

  const paylas = el<HTMLButtonElement>('ke-paylas');
  paylas.addEventListener('click', async () => {
    const ilk = 'Sonucu paylaş (bağlantıyı kopyala)';
    try {
      await navigator.clipboard.writeText(location.href);
      paylas.textContent = 'Bağlantı kopyalandı';
    } catch {
      paylas.textContent = 'Kopyalanamadı; adres çubuğundaki bağlantıyı kullanın';
    }
    setTimeout(() => (paylas.textContent = ilk), 2500);
  });

  // Başlangıç: adreste geçerli ?w=… varsa onu, yoksa TÜİK ağırlıklarını kullan.
  const adres = adresCoz(location.search);
  if (adres) {
    metin[adres.mod] = adres.degerler.map((n) => (n === 0 ? '' : nf.format(n)));
    if (adres.mod === 'y') {
      metin.y = adres.degerler.map((n) => nf.format(n));
      kaydiricilar.forEach((k, i) => (k.value = String(Math.min(adres.degerler[i], 60))));
    }
    modUygula(adres.mod);
  } else {
    modUygula('y');
  }
</script>

