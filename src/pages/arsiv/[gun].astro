---
// Günlük arşiv sayfası: günün özeti (o günün son bülteni) ve o gün yayımlanan haberler. Telegram Günün Özeti
// kaydı olan günde (src/data/gunun-ozeti/<gun>.json) üstte günün paragrafı, paylaşım görseli Günün Özeti kapağı ve
// mecmua-saat kuyruğunun okuduğu gunun-ozeti / gunun-ozeti-paragraf meta etiketleri de olur.
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getNews, newsUrl } from '../../lib/news';
import { ARSIV_ESIGI, ayBasligi, bultenMaddeleri, gunBasligi, gunlereAyir, ozetKaydi } from '../../lib/arsiv.mjs';

export async function getStaticPaths() {
  const gunler = gunlereAyir(await getNews());
  return gunler.map((g, i) => ({
    params: { gun: g.gun },
    // gunler yeniden eskiye sıralı: önceki gün bir sonraki eleman.
    props: { g, onceki: gunler[i + 1]?.gun, sonraki: gunler[i - 1]?.gun },
  }));
}

const { g, onceki, sonraki } = Astro.props;
const baslik = gunBasligi(g.gun);
const ay = g.gun.slice(0, 7);
const noindex = g.haberler.length < ARSIV_ESIGI;
// Günün özeti: o günün son bülteninin maddeleri (bölge bölge kalın başlık + tek cümle).
const maddeler = bultenMaddeleri(g.bulten?.body);
const kayit = ozetKaydi(g.gun);
const ozet = maddeler.length ? maddeler.slice(0, 2).map((m) => `${m.baslik}: ${m.metin}`).join(' ') : undefined;
// "Piyasa bülteni · 15 Ekim 2026, öğle" → "öğle"; gece yayımlanan önceki günün kapanışı tarihiyle kalır.
const bultenEtiketi = (t: string) => {
  const ek = t.split(' · ').at(-1) ?? t;
  return ek.startsWith(`${baslik}, `) ? ek.slice(baslik.length + 2) : ek;
};
---

<Base
  title={`${baslik} haberleri`}
  description={kayit?.paragraf ?? ozet ?? `${baslik} tarihinde finfolis'te yayımlanan ${g.haberler.length} haber.`}
  image={kayit ? `/gunun-ozeti/${g.gun}.png` : undefined}
  imageWidth={kayit ? 1200 : undefined}
  imageHeight={kayit ? 675 : undefined}
  imageAlt={kayit ? `Günün Özeti · ${baslik}: günün öne çıkan haber başlıkları` : undefined}
  noindex={noindex}
>
  {
    kayit && (
      <Fragment slot="head">
        <meta name="gunun-ozeti" content={g.gun} />
        <meta name="gunun-ozeti-paragraf" content={kayit.paragraf} />
      </Fragment>
    )
  }
  <div class="container">
    <article class="makale">
      <Breadcrumb yol={[{ ad: 'Anasayfa', href: '/' }, { ad: 'Arşiv', href: `/arsiv/#ay-${ay}` }, { ad: baslik }]} />
      <header class="makale-bas">
        <h1>{baslik}</h1>
        <p class="kunye">
          <span>{g.haberler.length} haber</span>
          <a href={`/arsiv/#ay-${ay}`}>{ayBasligi(ay)} takvimi</a>
        </p>
      </header>

      {kayit && <p class="gun-paragraf">{kayit.paragraf}</p>}
      {kayit?.yazan === 'gemini' && <p class="gun-paragraf-not">Bu paragraf o günün haberlerinden yapay zekâ ile yazıldı.</p>}

      {
        maddeler.length > 0 && (
          <section class="gunun-ozeti" aria-labelledby="ozet-baslik">
            <h2 id="ozet-baslik">Günün özeti</h2>
            <ul>
              {maddeler.map((m) => (
                <li>
                  <strong>{m.baslik}:</strong> {m.metin}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {/* Günün bütün bültenleri: yalnız sonuncusuna bağlantı verilince açılış/öğle bültenleri yetim kalıyordu. */}
      {
        g.bultenler.length > 0 && (
          <p class="gun-bultenleri">
            <span>{g.bultenler.length > 1 ? 'Günün bültenleri:' : 'Günün bülteni:'}</span>{' '}
            {g.bultenler.map((b, i) => (
              <>
                {i > 0 && ' · '}
                <a href={newsUrl(b)}>{bultenEtiketi(b.data.title)}</a>
              </>
            ))}
          </p>
        )
      }

      <div class="liste">
        {g.haberler.map((h) => <NewsCard haber={h} />)}
      </div>

      <nav class="gun-gezinti" aria-label="Günler arasında">
        {onceki ? <a href={`/arsiv/${onceki}/`} rel="prev">← {gunBasligi(onceki)}</a> : <span />}
        {sonraki && <a href={`/arsiv/${sonraki}/`} rel="next">{gunBasligi(sonraki)} →</a>}
      </nav>
    </article>
  </div>
</Base>

<style>
  .gun-paragraf {
    margin: 8px 0 4px;
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.55;
  }
  .gun-paragraf-not {
    margin: 0 0 20px;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .gunun-ozeti {
    margin: 8px 0 24px;
    padding: 16px 0;
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--hair);
    font-family: var(--sans);
  }
  .gunun-ozeti h2 {
    margin: 0 0 8px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .gunun-ozeti ul {
    margin: 0 0 10px;
    padding-left: 1.1em;
    font-family: var(--serif);
    line-height: 1.5;
  }
  .gunun-ozeti li + li {
    margin-top: 6px;
  }
  .gun-bultenleri {
    margin: 0 0 16px;
    font-family: var(--sans);
    font-size: 0.95rem;
  }
  .gun-bultenleri span {
    color: var(--muted);
  }
  .liste {
    margin-top: 8px;
  }
  .gun-gezinti {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 28px;
    font-family: var(--sans);
    font-size: 0.95rem;
  }
</style>
