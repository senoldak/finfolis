---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import { CATEGORIES } from '../../lib/site';
import { getNews, newsUrl } from '../../lib/news';
import { SITE_URL, WEBSITE_ID } from '../../lib/seo';

// Her kategori sayfasının arama sonucunda görünen kendi açıklaması.
const ACIKLAMA: Record<string, string> = {
  piyasalar: 'Küresel ve yerel piyasalarda günün gelişmeleri: faiz, emtia, petrol ve risk iştahı üzerine haber ve analizler.',
  borsa: 'Borsa İstanbul ve dünya borsalarından hisse senedi, endeks ve şirket haberleri, bilanço ve piyasa analizleri.',
  doviz: 'Dolar, euro ve altın fiyatlarındaki hareketler; kur, değerli metal ve merkez bankası kararları üzerine haberler.',
  kripto: 'Bitcoin, Ethereum ve diğer kripto paralardaki gelişmeler; düzenleme, piyasa ve teknoloji haberleri.',
  ekonomi: 'Türkiye ve dünya ekonomisinden enflasyon, büyüme, istihdam, para ve maliye politikası haberleri.',
  'kisisel-finans': 'Bütçe, birikim, kredi, emeklilik ve vergi gibi kişisel finans konularında anlaşılır haber ve rehberler.',
};

export async function getStaticPaths() {
  const news = await getNews({ tur: 'haber' });
  return CATEGORIES.map((c) => ({
    params: { slug: c.slug },
    props: { cat: c, items: news.filter((h) => h.data.category === c.slug) },
  }));
}

const { cat, items } = Astro.props;
const description = ACIKLAMA[cat.slug] ?? `${cat.name} haberleri ve analizleri`;
const pageUrl = `${SITE_URL}/kategori/${cat.slug}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': pageUrl,
      url: pageUrl,
      name: `${cat.name} haberleri`,
      description,
      inLanguage: 'tr',
      isPartOf: { '@id': WEBSITE_ID },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: items.slice(0, 20).map((h, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `${SITE_URL}${newsUrl(h)}`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: cat.name, item: pageUrl },
      ],
    },
  ],
};
---

<Base title={`${cat.name} haberleri`} description={description} noindex={items.length === 0}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <div class="container">
    <header class={`sayfa-bas ink-${cat.ink}`}>
      <svg aria-hidden="true">
        <use href={`#s-${cat.icon}`} />
      </svg>
      <h1>{cat.name}</h1>
      <p>{items.length > 0 ? `${items.length} yazı` : 'Henüz yazı yok'}</p>
    </header>
    {
      items.length > 0 ? (
        <div class="liste liste-iki">
          {items.map((h) => (
            <NewsCard haber={h} showCategory={false} />
          ))}
        </div>
      ) : (
        <p class="bos">Bu kategoride henüz yazı yok. Yeni yazılar yayımlandıkça burada listelenecek.</p>
      )
    }
  </div>
</Base>
