---
// Veriler ana sayfası: arama kutusu, konulara göre bütün veri sayfaları ve öne çıkan gösterge kartları.
// Arama tarayıcıda madde metnine ve data-ek'e bakar; data-ek, eş anlamlılarla seri gezgini kataloğundaki seri adlarıdır.
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VeriKarti from '../../components/VeriKarti.astro';
import { RESMI, ayAdi, gunYaz, oranYaz, sayiYaz, yuzdeYaz } from '../../lib/resmi';
import { ayinFaizi, kiraCarpani, kurHizi, reelFaiz } from '../../lib/turetilmis.mjs';
import bistTufeData from '../../data/bist-tufe.json';
import reelBistData from '../../data/reel-bist.json';
import altinData from '../../data/tcmb-altin-kazanci.json';
import swapData from '../../data/tcmb-swap-orani.json';
import abdTahvilleriData from '../../data/abd-tahvilleri.json';
import dunyaFaizData from '../../data/dunya-faizleri.json';
import kurOynaklikData from '../../data/kur-oynakligi.json';
import { veriKatalogu } from '../../lib/seri-katalogu-veri';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';

const dunyaFaz = (f: string) => dunyaFaizData.satirlar.filter((x: { faz: string }) => x.faz === f).length;
const { kur, faiz, enflasyon, konut, issizlik, rezerv, beklenti, kira, guven, rek, brutRezerv, kapasite } = RESMI;
const kiraSon = kira?.satirlar.at(-1);
const guvenSon = guven?.satirlar.at(-1);
const kapasiteSon = kapasite?.satirlar.at(-1);
const issizlikSon = issizlik?.satirlar.at(-1);
const buyumeSon = RESMI.buyume?.satirlar.at(-1);
const konutSatisSon = RESMI.konutSatis?.satirlar.at(-1);
const ufeSon = RESMI.ufe?.satirlar.at(-1);
const kesimSon = RESMI.kesimBeklenti?.satirlar.at(-1);
const paraSon = RESMI.paraPiyasasi?.son;
const paraArziSon = RESMI.paraArzi?.satirlar.at(-1);
const insaatSatirlari = RESMI.insaatIzin?.satirlar ?? [];
const ruhsatDaire12 = insaatSatirlari.length >= 12 ? insaatSatirlari.slice(-12).reduce((a, s) => a + s.ruhsatDaire, 0) : null;
const rekSon = rek?.satirlar.at(-1);
const brutRezervSon = brutRezerv?.satirlar.at(-1);
// Hesaplanmış göstergeler (finfolis): fihristte son değer.
const { kurHaftalik, makas, birimFiyat } = RESMI;
const usdHizSon = kurHizi(kurHaftalik?.satirlar ?? [], 'usd', 4).at(-1);
const usdOynaklik = kurOynaklikData.seriler?.find((x: { id: string }) => x.id === 'usdtry')?.oynaklik.son30;
const reelSon = (beklenti?.satirlar ?? [])
  .map((b) => {
    const p = ayinFaizi(faiz?.gecmis ?? [], b.yil, b.ay);
    return p == null ? null : { reel: reelFaiz(p, b.ay12) as number };
  })
  .filter((x): x is { reel: number } => x != null)
  .at(-1);
const carpanSon = (birimFiyat?.satirlar ?? []).map((s) => ({ carpan: kiraCarpani(s.iller.Türkiye.fiyat, s.iller.Türkiye.kira) as number })).at(-1);
const makasSon = (makas?.satirlar ?? []).map((s) => ({ fark: s.ihtiyac - s.mevduat })).at(-1);
const beklentiSon = beklenti?.satirlar.at(-1);
const enflasyonSon = enflasyon?.satirlar.at(-1);
const konutSon = konut?.satirlar.at(-1);
const altinSon = altinData?.seri?.at(-1);
const swapSon = swapData?.seri?.at(-1);
const abdTahvilleriSon = abdTahvilleriData?.sonNokta;

const satir = (kod: string) => kur?.liste.find((k) => k.kod === kod);
const kurSayisi = kur?.liste.length ?? 22;

// Öne çıkan kartların kısa serileri
const usdSeri = kur?.gecmis?.map((g) => (g as Record<string, { satis: number }>).USD?.satis).filter((v): v is number => typeof v === 'number').slice(-30) ?? [];
const eurSeri = kur?.gecmis?.map((g) => (g as Record<string, { satis: number }>).EUR?.satis).filter((v): v is number => typeof v === 'number').slice(-30) ?? [];
const faizSeri = faiz?.gecmis?.slice(-16).map((g) => g.oran) ?? [];
const reelBistSeri = reelBistData?.noktalar?.slice(-36).map((n: { reelEndeks: number }) => n.reelEndeks) ?? [];
const tufeSeri = enflasyon?.satirlar?.slice(-24).map((s) => s.yillik) ?? [];
const beklentiSeri = beklenti?.satirlar?.slice(-24).map((s) => s.ay12) ?? [];
const brutRezervSeri = brutRezerv?.satirlar?.slice(-52).map((s) => s.toplam / 1000) ?? [];
const konutSeri = konut?.satirlar?.slice(-24).map((s) => s.bolgeler.TR.yillik) ?? [];

// Aramada sayfa adında geçmeyen ama okurun yazabileceği sözcükler.
const ESANLAM: Record<string, string> = {
  '/veri/enflasyon/': 'tüfe fiyat pahalılık hayat pahalılığı',
  '/veri/enflasyon-hizi/': 'tüfe aylık enflasyon',
  '/veri/beklenti-anketleri/': 'enflasyon beklentisi hanehalkı reel kesim piyasa katılımcıları anket tcmb olasılık dağılımı',
  '/veri/enflasyon-katkilari/': 'tüfe gıda enerji kira harcama grupları',
  '/veri/uretici-fiyatlari/': 'üfe yi-üfe üretici enflasyonu toptan eşya maliyet hizmet tarım girdi gübre',
  '/veri/gida-fiyatlari/': 'hal sebze meyve domates pazar fiyatı gıda enflasyonu toptan izmir',
  '/veri/coban-salatasi/': 'çoban salatası endeksi domates salatalık biber soğan maydanoz limon hal toptan izmir menemen tantuni',
  '/veri/enflasyon-beklentisi/': 'piyasa katılımcıları anketi tüfe',
  '/veri/enflasyon-yolu/': 'baz etkisi tüfe yıl sonu',
  '/hesapla/kisisel-enflasyon/': 'tüfe hesaplama',
  '/veri/politika-faizi/': 'ppk repo merkez bankası faiz kararı',
  '/veri/reel-faiz/': 'faiz enflasyon',
  '/veri/piyasa-faizleri/': 'mevduat faizi kredi faizi konut kredisi taşıt',
  '/veri/para-arzi/': 'm1 m2 m3 para arzı parasal büyüklükler dolaşımdaki para vadeli vadesiz mevduat likidite',
  '/veri/para-piyasasi/': 'aofm fonlama maliyeti faiz koridoru gecelik borç verme alma repo net fonlama sterilizasyon likidite',
  '/veri/kredi-mevduat-makasi/': 'banka faiz',
  '/veri/taylor-kurali/': 'politika faizi',
  '/veri/tcmb-karnesi/': 'enflasyon raporu ara hedef merkez bankası',
  '/veri/dolar-kuru/': 'usd döviz kur',
  '/veri/euro-kuru/': 'eur avro döviz kur',
  '/veri/sterlin-kuru/': 'gbp pound döviz kur',
  '/veri/doviz-kurlari/': 'döviz kur frank yen riyal ruble',
  '/veri/kur-degisim-hizi/': 'dolar euro döviz',
  '/veri/kur-oynakligi/': 'dolar euro döviz volatilite dağılım mevsimsellik dolar endeksi',
  '/veri/reel-efektif-kur/': 'tl değeri döviz kur',
  '/veri/doviz-mevduatlari/': 'dth döviz hesabı yp mevduat',
  '/veri/tcmb-rezervleri/': 'rezerv altın döviz merkez bankası',
  '/veri/net-doviz-pozisyonu/': 'net rezerv merkez bankası',
  '/veri/swap-payi/': 'rezerv merkez bankası',
  '/veri/altin-kazanci/': 'altın rezerv ons',
  '/veri/cari-denge/': 'cari açık ödemeler dengesi',
  '/veri/dis-ticaret/': 'ihracat ithalat dış ticaret açığı',
  '/veri/dis-borc/': 'borç',
  '/veri/yabanci-portfoy-akimlari/': 'yabancı hisse tahvil sıcak para',
  '/veri/abd-tahvilleri/': 'hazine tahvil',
  '/veri/abd-tahvil-akimlari/': 'hazine tahvil',
  '/veri/butce-dengesi/': 'bütçe açığı vergi harcama maliye',
  '/veri/buyume/': 'gsyh gsyih milli gelir ekonomi büyüme hızı',
  '/veri/sanayi-uretimi/': 'üretim büyüme imalat',
  '/veri/kapasite-kullanimi/': 'sanayi üretim',
  '/veri/issizlik-orani/': 'istihdam iş işgücü',
  '/veri/kartli-harcamalar/': 'kredi kartı tüketim harcama',
  '/veri/tuketici-guveni/': 'tüketim güven',
  '/veri/kredi-hacmi/': 'banka kredi',
  '/veri/konut-fiyat-endeksi/': 'ev fiyat emlak konut',
  '/veri/kira-endeksi/': 'ev kira',
  '/veri/kira-carpani/': 'ev kira amortisman',
  '/veri/konut-satislari/': 'ev satış emlak tapu ipotek ilk el ikinci el',
  '/veri/insaat-izinleri/': 'yapı ruhsatı iskân inşaat izni konut arzı daire metrekare bina',
  '/veri/reel-bist-30/': 'borsa hisse bist',
  '/veri/bist-100-tufe/': 'borsa hisse bist',
  '/veri/sektorler/': 'borsa hisse bist banka',
  '/veri/makro-soklar/': 'borsa kriz',
  '/veri/dunya-politika-faizleri/': 'faiz merkez bankası',
  '/veri/emsal-ulkeler/': 'ülke karşılaştırma büyüme enflasyon',
  '/veri/dunyada-turkiye/': 'ülke sıralama',
  '/veri/fed-projeksiyonlari/': 'abd faiz nokta grafiği',
  '/veri/fomc-aciklama-metni/': 'fed abd',
  '/veri/fomc-tonu/': 'fed abd',
  '/veri/ecb-aciklama-metni/': 'avrupa merkez bankası euro bölgesi',
  '/veri/ecb-tonu/': 'avrupa merkez bankası euro bölgesi',
  '/veri/tahmin/': 'model',
  '/veri/seri-gezgini/': 'grafik karşılaştır csv indir',
  '/veri/takvim/': 'açıklanma tarihi ne zaman',
  '/veri/guncellik/': 'son veri',
  '/veri/revizyonlar/': 'düzeltme',
};
const SERI_ADLARI = new Map<string, Set<string>>();
for (const s of veriKatalogu() as { ad: string; sayfa: string }[]) {
  if (!SERI_ADLARI.has(s.sayfa)) SERI_ADLARI.set(s.sayfa, new Set());
  SERI_ADLARI.get(s.sayfa)!.add(s.ad);
}
const aramaEki = (href: string) => [ESANLAM[href] ?? '', ...(SERI_ADLARI.get(href) ?? [])].join(' ').trim();

const description =
  'Enflasyon, faiz, döviz, rezerv, dış denge, konut, borsa ve dünya merkez bankaları: finfolis veri sayfalarının konulara göre tam listesi ve öne çıkan göstergelerin son değerleri.';
const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
];
const jsonLd = sayfaSemasi({ yol, ad: 'Veriler', aciklama: description, tur: 'CollectionPage' });

const araclar = [
  { href: '/hesapla/enflasyon/', ad: 'Enflasyon hesaplama', not: 'Paranın alım gücü TÜFE ile nasıl değişti?' },
  { href: '/hesapla/mevduat-getirisi/', ad: 'Mevduat getirisi hesaplama', not: 'Faiz, stopaj ve enflasyondan arındırılmış net getiri' },
  { href: '/hesapla/kredi-taksit/', ad: 'Kredi taksit hesaplama', not: 'Aylık taksit ve toplam geri ödeme tutarı' },
];
---

<Base title="Piyasa Göstergeleri ve Zaman Serileri" description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-dizin-sayfa">
    <Breadcrumb yol={yol} />

    <header class="sayfa-bas sayfa-bas-duz">
      <h1>Piyasa Göstergeleri ve Veriler</h1>
      <p>Borsa, enflasyon, faiz, rezerv ve kurların resmi serileri ve finfolis analizleri</p>
    </header>

    <nav class="dizin-ara" aria-label="Veri sayfalarında ara">
      <label for="dizin-ara-kutu" class="dizin-ara-etiket">Gösterge ara</label>
      <input
        id="dizin-ara-kutu"
        class="dizin-ara-kutu"
        type="search"
        placeholder="Örneğin: kira, dolar, işsizlik"
        autocomplete="off"
        spellcheck="false"
      />
      <p class="dizin-ara-durum" id="dizin-ara-durum" aria-live="polite" hidden></p>
      <ul class="dizin-atla">
        <li><a href="#enflasyon">Enflasyon &amp; Fiyatlar</a></li>
        <li><a href="#faiz">Faiz &amp; TCMB</a></li>
        <li><a href="#doviz">Döviz &amp; Rezervler</a></li>
        <li><a href="#dis-denge">Dış Denge &amp; Bütçe</a></li>
        <li><a href="#buyume">Büyüme, İş &amp; Tüketim</a></li>
        <li><a href="#konut">Konut &amp; Kira</a></li>
        <li><a href="#borsa">Borsa</a></li>
        <li><a href="#dunya">Dünya &amp; Merkez Bankaları</a></li>
        <li><a href="#araclar">Tahmin &amp; Araçlar</a></li>
      </ul>
    </nav>

    <p class="sayfa-giris">
      Rakamlar doğrudan TCMB, TÜİK, Borsa İstanbul ve ABD Hazine Bakanlığı bültenlerinden derlenir. Veriler yalnızca nominal değerleriyle değil,
      enflasyondan arındırılmış satın alma gücü, tarihsel standart sapmaları ve zaman serisi eğrileriyle analiz edilir.
    </p>

    <section class="bolum" aria-labelledby="fihrist-baslik">
      <div class="bolum-baslik-sarici">
        <h2 id="fihrist-baslik" class="bolum-baslik">Bütün Veri Sayfaları</h2>
        <span class="bolum-ipucu">Konularına göre, son değerleriyle</span>
      </div>

      <div class="fihrist-izgara">
        <div class="fihrist-kutu" id="enflasyon">
          <div class="fihrist-kutu-baslik">
            <h3>Enflasyon &amp; Fiyatlar</h3>
          </div>
          <ul class="fihrist-liste">
            <li data-ek={aramaEki('/veri/enflasyon/')}>
              <a href="/veri/enflasyon/" class="fihrist-baslik-link">Tüketici Enflasyonu (TÜFE)</a>
              <span class="fihrist-ozet">TÜİK resmi yıllık ({enflasyonSon ? `%${sayiYaz(enflasyonSon.yillik, 2)}` : '–'}) ve aylık fiyat artışları</span>
            </li>
            <li data-ek={aramaEki('/veri/enflasyon-hizi/')}>
              <a href="/veri/enflasyon-hizi/" class="fihrist-baslik-link">Enflasyon Hızı</a>
              <span class="fihrist-ozet">Aylık ve üç aylık fiyat artışının yıllık karşılığı</span>
            </li>
            <li data-ek={aramaEki('/veri/enflasyon-katkilari/')}>
              <a href="/veri/enflasyon-katkilari/" class="fihrist-baslik-link">Enflasyonun Kaynakları</a>
              <span class="fihrist-ozet">13 ana harcama grubunun yıllık ve aylık enflasyona katkısı</span>
            </li>
            <li data-ek={aramaEki('/veri/uretici-fiyatlari/')}>
              <a href="/veri/uretici-fiyatlari/" class="fihrist-baslik-link">Üretici Fiyatları (ÜFE)</a>
              <span class="fihrist-ozet">TÜİK yurt içi ÜFE ({ufeSon ? `%${sayiYaz(ufeSon.yillik, 2)}` : '–'}), sektörler, hizmet ve tarım ÜFE, tarımsal girdi</span>
            </li>
            <li data-ek={aramaEki('/veri/gida-fiyatlari/')}>
              <a href="/veri/gida-fiyatlari/" class="fihrist-baslik-link">Gıda Fiyatları Göstergesi</a>
              <span class="fihrist-ozet">İzmir hal fiyatlarından taze meyve ve sebzenin aylık ve yıllık değişimi, ürün ürün</span>
            </li>
            <li data-ek={aramaEki('/veri/coban-salatasi/')}>
              <a href="/veri/coban-salatasi/" class="fihrist-baslik-link">Çoban Salatası Endeksi</a>
              <span class="fihrist-ozet">Dört kişilik bir çoban salatasının sebzesi İzmir halinde kaça mal oluyor, 2019’dan beri her ay</span>
            </li>
            <li data-ek={aramaEki('/veri/enflasyon-beklentisi/')}>
              <a href="/veri/enflasyon-beklentisi/" class="fihrist-baslik-link">Enflasyon Beklentisi</a>
              <span class="fihrist-ozet">TCMB anketinde 12 ay ({beklentiSon ? `%${sayiYaz(beklentiSon.ay12, 2)}` : '–'}) ve 24 ay sonrası beklenti, gerçekleşenle birlikte</span>
            </li>
            <li data-ek={aramaEki('/veri/beklenti-anketleri/')}>
              <a href="/veri/beklenti-anketleri/" class="fihrist-baslik-link">Beklenti Anketleri</a>
              <span class="fihrist-ozet">Piyasa, reel kesim ve hanehalkının 12 ay sonrası enflasyon beklentisi ({kesimSon ? `hanehalkı %${sayiYaz(kesimSon.hanehalki, 1)}` : '–'}), beklenti dağılımı</span>
            </li>
            <li data-ek={aramaEki('/hesapla/kisisel-enflasyon/')}>
              <a href="/hesapla/kisisel-enflasyon/" class="fihrist-baslik-link">Kişisel Enflasyon Hesaplama</a>
              <span class="fihrist-ozet">Kendi harcama dağılımınızla yıllık enflasyon</span>
            </li>
          </ul>
        </div>

        <div class="fihrist-kutu" id="faiz">
          <div class="fihrist-kutu-baslik">
            <h3>Faiz &amp; TCMB</h3>
          </div>
          <ul class="fihrist-liste">
            <li data-ek={aramaEki('/veri/politika-faizi/')}>
              <a href="/veri/politika-faizi/" class="fihrist-baslik-link">TCMB Politika Faizi (PPK)</a>
              <span class="fihrist-ozet">1 hafta vadeli repo ihale faiz oranı ve toplantı kararları ({faiz ? `%${oranYaz(faiz.oran)}` : '–'})</span>
            </li>
            <li data-ek={aramaEki('/veri/reel-faiz/')}>
              <a href="/veri/reel-faiz/" class="fihrist-baslik-link">Reel Faiz</a>
              <span class="fihrist-ozet">Politika faizinin beklenen ve gerçekleşen enflasyona göre reel karşılığı ({reelSon ? `%${sayiYaz(reelSon.reel, 1)}` : '–'})</span>
            </li>
            <li data-ek={aramaEki('/veri/piyasa-faizleri/')}>
              <a href="/veri/piyasa-faizleri/" class="fihrist-baslik-link">Piyasa Faizleri (Kredi &amp; Mevduat)</a>
              <span class="fihrist-ozet">1-3 ay TL mevduat, ihtiyaç, taşıt ve konut kredisi haftalık akım faizleri</span>
            </li>
            <li data-ek={aramaEki('/veri/para-piyasasi/')}>
              <a href="/veri/para-piyasasi/" class="fihrist-baslik-link">Para Piyasası</a>
              <span class="fihrist-ozet">Faiz koridoru, fonlama maliyeti (AOFM) ve TCMB net fonlaması ({paraSon ? `AOFM %${sayiYaz(paraSon.aofm, 2)}` : '–'})</span>
            </li>
            <li data-ek={aramaEki('/veri/kredi-mevduat-makasi/')}>
              <a href="/veri/kredi-mevduat-makasi/" class="fihrist-baslik-link">Kredi-Mevduat Makası</a>
              <span class="fihrist-ozet">Kredi ve mevduat faizi arasındaki fark, 2018’den ({makasSon ? `${sayiYaz(makasSon.fark, 1)} puan` : '–'})</span>
            </li>
            <li data-ek={aramaEki('/veri/tcmb-karnesi/')}>
              <a href="/veri/tcmb-karnesi/" class="fihrist-baslik-link">TCMB Karnesi</a>
              <span class="fihrist-ozet">Enflasyon Raporu tahminleri, ara hedefler, anket beklentileri ve metin tonu gerçekleşenle karşılaştırmalı</span>
            </li>
            <li data-ek={aramaEki('/veri/ppk-karar-metni/')}>
              <a href="/veri/ppk-karar-metni/" class="fihrist-baslik-link">PPK Karar Metni Farkı</a>
              <span class="fihrist-ozet">Her faiz kararı metni bir öncekiyle cümle cümle: eklenen, silinen ve değişen cümleler</span>
            </li>
            <li data-ek={aramaEki('/veri/ppk-tonu/')}>
              <a href="/veri/ppk-tonu/" class="fihrist-baslik-link">PPK Metin Tonu</a>
              <span class="fihrist-ozet">PPK metinlerinin yapay zekâyla okunan yönü, −3 güvercin ile +3 şahin arası</span>
            </li>
            <li data-ek={aramaEki('/veri/ppk-ifade-izi/')}>
              <a href="/veri/ppk-ifade-izi/" class="fihrist-baslik-link">PPK İfade İzi</a>
              <span class="fihrist-ozet">PPK metinlerinde bir ifadenin hangi toplantıda ilk göründüğü, hangisinde kaybolduğu</span>
            </li>
          </ul>
        </div>

        <div class="fihrist-kutu" id="doviz">
          <div class="fihrist-kutu-baslik">
            <h3>Döviz &amp; Rezervler</h3>
          </div>
          <ul class="fihrist-liste">
            <li data-ek={aramaEki('/veri/dolar-kuru/')}>
              <a href="/veri/dolar-kuru/" class="fihrist-baslik-link">Dolar / TL (TCMB)</a>
              <span class="fihrist-ozet">Gösterge döviz ve efektif satış kuru ({satir('USD') ? `₺${sayiYaz(satir('USD')!.dovizSatis, 2)}` : '–'})</span>
            </li>
            <li data-ek={aramaEki('/veri/euro-kuru/')}>
