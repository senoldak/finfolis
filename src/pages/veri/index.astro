</Base>

<style>
  .veri-dizin-sayfa {
    padding-bottom: 48px;
  }

  .bolum-baslik-sarici {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 8px;
    gap: 12px;
    flex-wrap: wrap;
  }

  .bolum-ipucu {
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* 3 Kolonlu Kart Izgarası */
  .kartlar-izgara {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 40px;
  }

  /* Tematik Veri Fihristi Izgarası */
  .fihrist-izgara {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  .fihrist-kutu {
    background: var(--paper);
    border: 1px solid var(--hair);
    padding: 20px 22px;
  }

  .fihrist-kutu-baslik {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--hair);
  }

  .fihrist-kutu-baslik h3 {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--toprak-text);
  }

  .fihrist-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fihrist-liste li {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fihrist-baslik-link {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .fihrist-baslik-link:hover {
    color: var(--toprak);
  }

  .fihrist-ozet {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.35;
  }

  .fihrist-liste li[hidden],
  .fihrist-kutu[hidden],
  .dizin-atla[hidden],
  .sayfa-giris[hidden] {
    display: none;
  }

  /* Arama kutusu ve konu atlama şeridi */
  .dizin-ara {
    margin: 8px 0 32px;
  }

  .dizin-ara-etiket {
    display: block;
    margin-bottom: 6px;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--toprak-text);
  }

  .dizin-ara-kutu {
    box-sizing: border-box;
    width: 100%;
    max-width: 560px;
    padding: 12px 14px;
    font-family: var(--sans);
    font-size: 1rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--ink-2);
    border-radius: 0;
  }

  .dizin-ara-kutu:focus {
    outline: 2px solid var(--toprak);
    outline-offset: 1px;
  }

  .dizin-ara-durum {
    margin: 8px 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .dizin-atla {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .dizin-atla a {
    font-family: var(--sans);
    font-size: 0.88rem;
