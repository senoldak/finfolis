    text-decoration: underline;
    text-decoration-color: var(--hair);
    text-underline-offset: 3px;
  }

  .dizin-atla a:hover {
    color: var(--toprak);
    text-decoration-color: currentColor;
  }

  .fihrist-kutu {
    scroll-margin-top: 16px;
  }

  .dizin-ara-yok {
    margin: -24px 0 40px;
    font-size: 0.92rem;
    color: var(--ink-2);
  }

  .dizin-ara-yok a {
    color: var(--toprak-text);
  }

  @media (max-width: 900px) {
    .kartlar-izgara {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .fihrist-izgara {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .kartlar-izgara {
      grid-template-columns: 1fr;
    }
    .fihrist-kutu {
      padding: 16px;
    }
  }
</style>

<script>
  // Sayfa içi arama: madde metni + data-ek (eş anlamlılar ve seri adları) içinde, büyük/küçük harf ve
  // Türkçe harf farkı gözetmeden her sözcüğü arar. Betik çalışmazsa liste olduğu gibi tam kalır.
  const norm = (s: string) =>
    s
      .toLocaleLowerCase('tr')
      .replace(/[ıİ]/g, 'i')
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '');
  const kutu = document.getElementById('dizin-ara-kutu') as HTMLInputElement | null;
  const durum = document.getElementById('dizin-ara-durum');
  const yok = document.getElementById('dizin-ara-yok');
  const maddeler = [...document.querySelectorAll<HTMLLIElement>('.fihrist-liste li')].map((li) => ({
    li,
    metin: norm(`${li.textContent ?? ''} ${li.dataset.ek ?? ''}`),
  }));
  const gruplar = [...document.querySelectorAll<HTMLElement>('.fihrist-kutu')];
  // Arama sürerken giriş metni ve atlama şeridi sonuçları aşağı itmesin diye gizlenir.
  const aramadaGizle = [...document.querySelectorAll<HTMLElement>('.dizin-atla, .sayfa-giris')];

  function suz() {
    const kelimeler = norm(kutu?.value ?? '').split(/\s+/).filter(Boolean);
    let n = 0;
    for (const m of maddeler) {
      const goster = kelimeler.every((k) => m.metin.includes(k));
      m.li.hidden = !goster;
      if (goster) n++;
    }
    for (const g of gruplar) g.hidden = !g.querySelector('li:not([hidden])');
    if (durum) {
      durum.hidden = kelimeler.length === 0;
      durum.textContent = n ? `${n} sayfa bulundu` : '';
    }
    if (yok) yok.hidden = kelimeler.length === 0 || n > 0;
    for (const e of aramadaGizle) e.hidden = kelimeler.length > 0;
  }

  kutu?.addEventListener('input', suz);
  if (kutu?.value) suz();
</script>
