---
// Veriler Ana Sayfası: finfolis Göstergeleri, Görsel Kartlar ve Resmi Seriler
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VeriKarti from '../../components/VeriKarti.astro';
import { KUR_SAYFALARI, RESMI, ayAdi, gunYaz, oranYaz, sayiYaz } from '../../lib/resmi';
import bistTufeData from '../../data/bist-tufe.json';
import reelBistData from '../../data/reel-bist.json';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';

const { kur, faiz, enflasyon, konut, issizlik } = RESMI;
const son = enflasyon?.satirlar.at(-1);
const konutSon = konut?.satirlar.at(-1);
const issizlikSon = issizlik?.satirlar.at(-1);
const satir = (kod: string) => kur?.liste.find((k) => k.kod === kod);

// Görsel Kart Serileri
const reelBistSeri = reelBistData?.noktalar?.slice(-36).map((n: { reelEndeks: number }) => n.reelEndeks) ?? [];
const tufeSeri = enflasyon?.satirlar?.slice(-24).map((s) => s.yillik) ?? [];
const bistTufeSeri = bistTufeData?.noktalar?.slice(-24).map((n: { deger: number }) => n.deger) ?? [];
const konutSeri = konut?.satirlar?.slice(-24).map((s) => s.bolgeler.TR.yillik) ?? [];
const faizSeri = faiz?.gecmis?.slice(-12).map((g) => g.oran) ?? [];
const usdSeri = kur?.gecmis?.map((g) => (g as Record<string, { satis: number }>).USD?.satis).filter((v): v is number => typeof v === 'number') ?? [];

const description =
  'TÜFE’den arındırılmış BİST 30, BİST 100 değerleme rasyoları, döviz kurları, politika faizi ve enflasyon: TCMB ve TÜİK resmi verileriyle görsel gösterge kartları.';
const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
];
const jsonLd = sayfaSemasi({ yol, ad: 'Veriler', aciklama: description, tur: 'CollectionPage' });

const araclar = [
  { href: '/hesapla/enflasyon/', ad: 'Enflasyon hesaplama', not: 'Paranın alım gücü TÜFE ile nasıl değişti?' },
  { href: '/hesapla/mevduat-getirisi/', ad: 'Mevduat getirisi hesaplama', not: 'Faiz, stopaj ve enflasyondan arındırılmış net getiri' },
  { href: '/hesapla/kredi-taksit/', ad: 'Kredi taksit hesaplama', not: 'Aylık taksit ve toplam geri ödeme tutarı' },
];
---

<Base title="Piyasa Göstergeleri ve Resmi Veriler" description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-dizin-sayfa">
    <Breadcrumb yol={yol} />

    <header class="sayfa-bas sayfa-bas-duz">
      <h1>Piyasa Göstergeleri ve Veriler</h1>
      <p>Borsa, enflasyon, faiz ve kurların resmi serileri ve finfolis analizleri</p>
    </header>

    <p class="sayfa-giris">
      Rakamlar doğrudan TCMB, TÜİK ve Borsa İstanbul bültenlerinden derlenir. Veriler yalnızca nominal değerleriyle değil,
      enflasyondan arındırılmış satın alma gücü ve tarihsel standart sapmalarıyla analiz edilir.
    </p>

    <!-- Öne Çıkan Görsel Gösterge Kartları Izgarası -->
    <section class="bolum" aria-labelledby="gostergeler-baslik">
      <div class="bolum-baslik-sarici">
        <h2 id="gostergeler-baslik" class="bolum-baslik">Öne Çıkan Göstergeler</h2>
        <span class="bolum-ipucu">Aylık trendler ve grafikler</span>
      </div>

      <div class="kartlar-izgara">
        <!-- 1. TÜFE'den Temizlenmiş BİST 30 (Reel Getiri) -->
        {
          reelBistData && (
            <VeriKarti
              href="/veri/reel-bist-30/"
              kategori="Borsa & Enflasyon"
              baslik="TÜFE’den Temizlenmiş BİST 30"
              deger={sayiYaz(reelBistData.istatistik.sonNokta.reelEndeks, 1)}
              birim="puan"
              degisim={reelBistData.istatistik.reelDegisimToplam >= 0 ? `▲ %${sayiYaz(reelBistData.istatistik.reelDegisimToplam, 1)}` : `▼ %${sayiYaz(Math.abs(reelBistData.istatistik.reelDegisimToplam), 1)}`}
              degisimYon={reelBistData.istatistik.reelDegisimToplam >= 0 ? 'yukselis' : 'dusus'}
              aciklama="Eylül 2014=100 alım gücü eşiğine göre reel getiri"
              kaynak={`BİST & TÜİK · ${ayAdi(reelBistData.istatistik.sonNokta)}`}
              seri={reelBistSeri}
              oneCikan={true}
            />
          )
        }

        <!-- 2. Yıllık Enflasyon (TÜFE) -->
        {
          son && (
            <VeriKarti
              href="/veri/enflasyon/"
              kategori="Fiyatlar Genel Düzeyi"
              baslik="Tüketici Enflasyonu (TÜFE)"
              deger={`%${sayiYaz(son.yillik, 2)}`}
              degisim={`Aylık artış: ▲ %${sayiYaz(son.aylik, 2)}`}
              degisimYon="dusus"
              aciklama={`Resmi tüketici fiyat endeksi yıllık değişim oranı (${ayAdi(son)})`}
              kaynak="TÜİK & TCMB"
              seri={tufeSeri}
              oneCikan={true}
            />
          )
        }

        <!-- 3. BİST 100 / TÜFE Standart Sapma Analizi -->
        {
          bistTufeData && (
            <VeriKarti
              href="/veri/bist-100-tufe/"
              kategori="Değerleme & Sapma"
              baslik="BİST 100 / TÜFE Oranı"
              deger={sayiYaz(bistTufeData.guncelDeger, 1)}
              birim="rasyo"
              degisim={`${bistTufeData.zSkoru >= 0 ? '+' : ''}${bistTufeData.zSkoru}σ (${bistTufeData.durum})`}
              degisimYon={bistTufeData.zSkoru >= 0 ? 'yukselis' : 'dusus'}
              aciklama="2 yıllık hareketli ortalama ve standart sapma bantları"
              kaynak="finfolis analizi"
              seri={bistTufeSeri}
            />
          )
        }

        <!-- 4. TCMB Politika Faizi -->
        {
          faiz && (
            <VeriKarti
              href="/veri/politika-faizi/"
              kategori="Para Politikası"
              baslik="TCMB Politika Faizi"
              deger={`%${oranYaz(faiz.oran)}`}
              aciklama="Bir hafta vadeli repo ihale faiz oranı (en son PPK kararı)"
              kaynak="TCMB PPK"
              seri={faizSeri}
            />
          )
        }

        <!-- 5. Dolar / TL Kuru -->
        {
          satir('USD') && (
            <VeriKarti
              href="/veri/dolar-kuru/"
              kategori="Döviz Piyasası"
              baslik="Dolar / TL"
              deger={`₺${sayiYaz(satir('USD')!.dovizSatis, 2)}`}
              degisim={`Efektif Satış: ₺${sayiYaz(satir('USD')!.efektifSatis ?? satir('USD')!.dovizSatis, 2)}`}
              degisimYon="notr"
              aciklama="TCMB gösterge niteliğindeki döviz satış kuru"
              kaynak={kur ? `TCMB · ${gunYaz(kur.tarih)}` : 'TCMB'}
              seri={usdSeri}
            />
          )
        }

        <!-- 6. Konut Fiyat Endeksi -->
        {
          konutSon && (
            <VeriKarti
              href="/veri/konut-fiyat-endeksi/"
              kategori="Gayrimenkul"
              baslik="Konut Fiyatları (KFE)"
              deger={`%${sayiYaz(konutSon.bolgeler.TR.yillik, 1)}`}
              birim="yıllık"
              aciklama={`Türkiye geneli konut fiyat endeksi yıllık nominal artış (${ayAdi(konutSon)})`}
              kaynak="TCMB EVDS"
              seri={konutSeri}
            />
          )
        }
      </div>
    </section>

    <!-- Hesaplayıcılar ve Araçlar -->
    <section class="bolum">
      <h2 class="bolum-baslik">Finansal Hesaplayıcılar</h2>
      <div class="araclar-izgara">
        {
          araclar.map((o) => (
            <a href={o.href} class="arac-karti">
              <span class="arac-baslik">{o.ad}</span>
              <p class="arac-not">{o.not}</p>
              <span class="arac-ok">Hesapla →</span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Tüm Veri Sayfaları Dizini -->
    <section class="bolum">
      <h2 class="bolum-baslik">Tüm Veri Sayfaları</h2>
      <ul class="dizin-liste">
        {
          KUR_SAYFALARI.map((s) => ({
            href: `/veri/${s.slug}/`,
            ad: `${s.ad} kuru`,
            deger: satir(s.kod) ? `${sayiYaz(satir(s.kod)!.dovizSatis)} TL` : undefined,
            not: kur ? `TCMB, ${gunYaz(kur.tarih)}` : undefined,
          })).map((o) => (
            <li>
              <a href={o.href}>{o.ad}</a>
              {o.deger && (
                <span>
                  {o.deger}
                  {o.not && ` · ${o.not}`}
                </span>
              )}
            </li>
          ))
        }
        <li>
          <a href="/veri/doviz-kurlari/">Tüm döviz kurları</a>
          <span>{kur ? `${kur.liste.length} para birimi · TCMB` : 'TCMB'}</span>
        </li>
        <li>
          <a href="/veri/politika-faizi/">Politika faizi</a>
          <span>{faiz ? `%${oranYaz(faiz.oran)} · TCMB` : 'TCMB'}</span>
        </li>
        <li>
          <a href="/veri/enflasyon/">Yıllık enflasyon (TÜFE)</a>
          <span>{son ? `%${sayiYaz(son.yillik, 2)} · TÜİK, ${ayAdi(son)}` : 'TÜİK'}</span>
        </li>
        <li>
          <a href="/veri/reel-bist-30/">TÜFE’den Temizlenmiş BİST 30</a>
          <span>{reelBistData ? `${sayiYaz(reelBistData.istatistik.sonNokta.reelEndeks, 1)} puan · Reel Alım Gücü` : 'finfolis'}</span>
        </li>
        <li>
          <a href="/veri/bist-100-tufe/">BİST 100 / TÜFE Değerleme Rasyosu</a>
          <span>{bistTufeData ? `${sayiYaz(bistTufeData.guncelDeger, 1)} (${bistTufeData.zSkoru}σ)` : 'finfolis'}</span>
        </li>
        <li>
          <a href="/veri/konut-fiyat-endeksi/">Konut fiyat endeksi</a>
          <span>{konutSon ? `%${sayiYaz(konutSon.bolgeler.TR.yillik, 1)} · TCMB, ${ayAdi(konutSon)}` : 'TCMB'}</span>
        </li>
        <li>
          <a href="/veri/issizlik-orani/">İşsizlik oranı</a>
          <span>{issizlikSon ? `%${sayiYaz(issizlikSon.oran, 1)} · TÜİK, ${ayAdi(issizlikSon)}` : 'TÜİK'}</span>
        </li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .veri-dizin-sayfa {
    padding-bottom: 48px;
  }

  .bolum-baslik-sarici {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--hair);
    padding-bottom: 8px;
  }

  .bolum-ipucu {
    font-size: 0.8rem;
    color: var(--muted);
  }

  /* 3 Kolonlu Kart Izgarası */
  .kartlar-izgara {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }

  /* Hesaplayıcı Araç Kartları */
  .araclar-izgara {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }

  .arac-karti {
    display: flex;
    flex-direction: column;
    background: var(--paper-2);
    border: 1px solid var(--hair);
    padding: 16px 18px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .arac-karti:hover {
    border-color: var(--toprak);
  }

  .arac-baslik {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 6px;
  }

  .arac-not {
    margin: 0 0 12px;
    font-size: 0.82rem;
    color: var(--ink-2);
    line-height: 1.4;
  }

  .arac-ok {
    margin-top: auto;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--toprak-text);
  }

  .arac-karti:hover .arac-ok {
    color: var(--toprak);
  }

  @media (max-width: 900px) {
    .kartlar-izgara {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .araclar-izgara {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .kartlar-izgara {
      grid-template-columns: 1fr;
    }
    .araclar-izgara {
      grid-template-columns: 1fr;
    }
  }
</style>
