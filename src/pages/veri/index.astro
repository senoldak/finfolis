---
// Veriler Ana Sayfası: Tüm Göstergeler, Zaman Serileri, Kur Tahtası ve Tematik Fihrist
// Son güncellenen serilerden başlayarak kronolojik olarak sıralanmış kartlar.
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VeriKarti from '../../components/VeriKarti.astro';
import { RESMI, ayAdi, gunYaz, oranYaz, sayiYaz } from '../../lib/resmi';
import { ayinFaizi, enflasyonHizi, kayanToplam, kiraCarpani, kurHizi, reelFaiz } from '../../lib/turetilmis.mjs';
import bistTufeData from '../../data/bist-tufe.json';
import reelBistData from '../../data/reel-bist.json';
import altinData from '../../data/tcmb-altin-kazanci.json';
import swapData from '../../data/tcmb-swap-orani.json';
import abdTahvilleriData from '../../data/abd-tahvilleri.json';
import abdTahvilData from '../../data/abd-tahvil.json';
import makroData from '../../data/makro-soklar.json';
import sektorData from '../../data/sektorler.json';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';

const { kur, faiz, enflasyon, konut, issizlik, rezerv, piyasaFaizleri, mevduat, beklenti, kira, kart, guven, rek, brutRezerv, kapasite } = RESMI;
const kiraSon = kira?.satirlar.at(-1);
const kartSon = kart?.satirlar.at(-1);
const guvenSon = guven?.satirlar.at(-1);
const rekSon = rek?.satirlar.at(-1);
const brutRezervSon = brutRezerv?.satirlar.at(-1);
const kapasiteSon = kapasite?.satirlar.at(-1);
// Yabancı portföy ve cari denge kartları (finfolis hesaplaması: yılbaşından toplam, 12 aylık birikimli).
const portfoySatir = RESMI.portfoyHaftalik?.satirlar ?? [];
const portfoySon = portfoySatir.at(-1);
const portfoyYil = portfoySon ? portfoySatir.filter((s) => s.tarih.startsWith(portfoySon.tarih.slice(0, 4))).reduce((t, s) => t + s.hisse, 0) : 0;
const portfoySeri = (kayanToplam(portfoySatir, 'hisse', 52) as (number | null)[]).slice(-104).filter((v): v is number => v != null).map((v) => v / 1000);
const cariSatir = RESMI.cari?.satirlar ?? [];
const cariSon = cariSatir.at(-1);
const cari12 = kayanToplam(cariSatir, 'cari', 12) as (number | null)[];
// Hesaplanmış göstergeler (finfolis): kartlarda son değer ve kısa seri.
const { kurHaftalik, makas, birimFiyat } = RESMI;
const usdHiz = kurHizi(kurHaftalik?.satirlar ?? [], 'usd', 4);
const enfHiz = enflasyonHizi(enflasyon?.satirlar ?? [], RESMI.tufeArindirilmis?.satirlar ?? []).filter(
  (x: { ucAylikHiz: number | null }) => x.ucAylikHiz != null,
);
const reelSatirlar = (beklenti?.satirlar ?? [])
  .map((b) => {
    const p = ayinFaizi(faiz?.gecmis ?? [], b.yil, b.ay);
    return p == null ? null : { yil: b.yil, ay: b.ay, reel: reelFaiz(p, b.ay12) as number };
  })
  .filter((x): x is { yil: number; ay: number; reel: number } => x != null);
const carpanSatirlar = (birimFiyat?.satirlar ?? []).map((s) => ({ ...s, carpan: kiraCarpani(s.iller.Türkiye.fiyat, s.iller.Türkiye.kira) as number }));
const makasSatirlar = (makas?.satirlar ?? []).map((s) => ({ tarih: s.tarih, fark: s.ihtiyac - s.mevduat }));
const usdHizSon = usdHiz.at(-1);
const enfHizSon = enfHiz.at(-1);
const reelSon = reelSatirlar.at(-1);
const carpanSon = carpanSatirlar.at(-1);
const makasSon = makasSatirlar.at(-1);
const beklentiSon = beklenti?.satirlar.at(-1);

// Resmi tekil göstergelerin son değerleri
const enflasyonSon = enflasyon?.satirlar.at(-1);
const konutSon = konut?.satirlar.at(-1);
const issizlikSon = issizlik?.satirlar.at(-1);
const piyasaFaizleriSon = piyasaFaizleri?.satirlar.at(-1);
const mevduatSon = mevduat?.satirlar.at(-1);
const mevduatOnceki = mevduat?.satirlar.at(-2);
const farkMevduat = mevduatSon && mevduatOnceki ? mevduatSon.toplam - mevduatOnceki.toplam : 0;

// Bağımsız veri setlerinin son değerleri
const altinSon = altinData?.seri?.at(-1);
const swapSon = swapData?.seri?.at(-1);
const abdTahvilleriSon = abdTahvilleriData?.sonNokta;
const abdTahvilSon = abdTahvilData?.seri?.at(-1);

const satir = (kod: string) => kur?.liste.find((k) => k.kod === kod);
const kurSayisi = kur?.liste.length ?? 22;

// Hızlı Kur Tahtası için Başlıca Kurlar
const seciliKurlar = ['USD', 'EUR', 'GBP', 'CHF', 'JPY', 'CAD', 'AUD', 'SAR']
  .map((kod) => satir(kod))
  .filter((k): k is NonNullable<typeof k> => Boolean(k));

const kurSayfaHaritasi: Record<string, string> = {
  USD: '/veri/dolar-kuru/',
  EUR: '/veri/euro-kuru/',
  GBP: '/veri/sterlin-kuru/',
};

// Görsel Sparkline Trend Serileri
const usdSeri = kur?.gecmis?.map((g) => (g as Record<string, { satis: number }>).USD?.satis).filter((v): v is number => typeof v === 'number').slice(-30) ?? [];
const eurSeri = kur?.gecmis?.map((g) => (g as Record<string, { satis: number }>).EUR?.satis).filter((v): v is number => typeof v === 'number').slice(-30) ?? [];
const altinSeri = altinData?.seri?.slice(-30).map((s) => s.kazanc_milyar_usd) ?? [];
const faizSeri = faiz?.gecmis?.slice(-16).map((g) => g.oran) ?? [];
const sektorSeri = sektorData?.sektorler?.slice(0, 14).map((s) => s.aylik) ?? [];
const sektorMetin = sektorData?.sektorler?.slice(0, 14).map((s) => `${s.ad.replace(/^BIST /, '')}: ${s.aylik < 0 ? '−' : ''}%${sayiYaz(Math.abs(s.aylik), 1)}`) ?? [];
const netPozSeri = rezerv?.gecmis?.slice(-30).map((g) => g.deger) ?? [];
const bistTufeSeri = bistTufeData?.noktalar?.slice(-30).map((n: { deger: number }) => n.deger) ?? [];
const piyasaFaizSeri = piyasaFaizleri?.satirlar?.slice(-24).map((s) => s.mevduat) ?? [];
const mevduatSeri = mevduat?.satirlar?.slice(-24).map((s) => s.toplam / 1000) ?? [];
const reelBistSeri = reelBistData?.noktalar?.slice(-36).map((n: { reelEndeks: number }) => n.reelEndeks) ?? [];
const tufeSeri = enflasyon?.satirlar?.slice(-24).map((s) => s.yillik) ?? [];
const beklentiSeri = beklenti?.satirlar?.slice(-24).map((s) => s.ay12) ?? [];
const kiraSeri = kira?.satirlar?.slice(-24).map((s) => s.bolgeler.TR.yillik) ?? [];
const kartSeri = kart?.satirlar?.slice(-52).map((s) => s.sektorler.KT1.yillik ?? 0) ?? [];
const guvenSeri = guven?.satirlar?.slice(-24).map((s) => s.endeks) ?? [];
const rekSeri = rek?.satirlar?.slice(-36).map((s) => s.genel) ?? [];
const brutRezervSeri = brutRezerv?.satirlar?.slice(-52).map((s) => s.toplam / 1000) ?? [];
const kapasiteSeri = kapasite?.satirlar?.slice(-24).map((s) => s.arindirilmis) ?? [];
const swapSeri = swapData?.seri?.slice(-24).map((s) => s.swap_payi_toplam_yuzde) ?? [];
const konutSeri = konut?.satirlar?.slice(-24).map((s) => s.bolgeler.TR.yillik) ?? [];
const abdTahvilAkimSeri = abdTahvilData?.seri?.slice(-24).map((s) => s.netAkim / 1000) ?? [];
const abdTahvilleriSeri = abdTahvilleriData?.noktalar?.slice(-24).map((n) => n.toplamUSD / 1000) ?? [];
const issizlikSeri = issizlik?.satirlar?.slice(-24).map((s) => s.oran) ?? [];
const makroSokListe = (makroData?.gostergeler?.tge?.top10 ?? []).slice(0, 10).reverse();
const makroSokSeri = makroSokListe.map((s) => s.diff);
const makroSokMetin = makroSokListe.map((s) => `${s.label}: ${s.diff < 0 ? '−' : '+'}${sayiYaz(Math.abs(s.diff), 1)} puan`);

const description =
  'TCMB net döviz pozisyonu, döviz kurları, politika faizi, TÜFE’den arındırılmış BİST 30, BİST 100 rasyoları, ABD tahvil akımları ve konut fiyatları: Son güncellenen resmi verilerle interaktif gösterge kartları.';
const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
];
const jsonLd = sayfaSemasi({ yol, ad: 'Veriler', aciklama: description, tur: 'CollectionPage' });

const araclar = [
  { href: '/hesapla/enflasyon/', ad: 'Enflasyon hesaplama', not: 'Paranın alım gücü TÜFE ile nasıl değişti?' },
  { href: '/hesapla/mevduat-getirisi/', ad: 'Mevduat getirisi hesaplama', not: 'Faiz, stopaj ve enflasyondan arındırılmış net getiri' },
  { href: '/hesapla/kredi-taksit/', ad: 'Kredi taksit hesaplama', not: 'Aylık taksit ve toplam geri ödeme tutarı' },
];
---

<Base title="Piyasa Göstergeleri ve Zaman Serileri" description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-dizin-sayfa">
    <Breadcrumb yol={yol} />

    <header class="sayfa-bas sayfa-bas-duz">
      <h1>Piyasa Göstergeleri ve Veriler</h1>
      <p>Borsa, enflasyon, faiz, rezerv ve kurların resmi serileri ve finfolis analizleri</p>
    </header>

    <p class="sayfa-giris">
      Rakamlar doğrudan TCMB, TÜİK, Borsa İstanbul ve ABD Hazine Bakanlığı bültenlerinden derlenir. Veriler yalnızca nominal değerleriyle değil,
      enflasyondan arındırılmış satın alma gücü, tarihsel standart sapmaları ve zaman serisi eğrileriyle analiz edilir.
    </p>

    <!-- Tüm Gösterge Kartları Izgarası (Son Güncellenenden Başlayarak Sıralı) -->
    <section class="bolum" aria-labelledby="gostergeler-baslik">
      <div class="bolum-baslik-sarici">
        <h2 id="gostergeler-baslik" class="bolum-baslik">Tüm Göstergeler ve Zaman Serileri</h2>
        <span class="bolum-ipucu">Son güncellenen veriden geriye doğru kronolojik sıralama (17 Gösterge)</span>
      </div>

      <div class="kartlar-izgara">
        <!-- 1. Dolar / TL (23 Ekim 2026) -->
        {
          satir('USD') && (
            <VeriKarti
              href="/veri/dolar-kuru/"
              kategori="Döviz Piyasası"
              baslik="Dolar / TL"
              deger={`₺${sayiYaz(satir('USD')!.dovizSatis, 2)}`}
              degisim={`Efektif Satış: ₺${sayiYaz(satir('USD')!.efektifSatis ?? satir('USD')!.dovizSatis, 2)}`}
              degisimYon="notr"
              aciklama="TCMB gösterge niteliğindeki resmi döviz satış kuru"
              kaynak={kur ? `TCMB · ${gunYaz(kur.tarih)}` : 'TCMB'}
              seri={usdSeri}
              seriBicim="kur"
            />
          )
        }

        <!-- 2. Euro / TL (23 Ekim 2026) -->
        {
          satir('EUR') && (
            <VeriKarti
              href="/veri/euro-kuru/"
              kategori="Döviz Piyasası"
              baslik="Euro / TL"
              deger={`₺${sayiYaz(satir('EUR')!.dovizSatis, 2)}`}
              degisim={`Efektif Satış: ₺${sayiYaz(satir('EUR')!.efektifSatis ?? satir('EUR')!.dovizSatis, 2)}`}
              degisimYon="notr"
              aciklama="TCMB gösterge niteliğindeki resmi Euro satış kuru"
              kaynak={kur ? `TCMB · ${gunYaz(kur.tarih)}` : 'TCMB'}
              seri={eurSeri}
              seriBicim="kur"
            />
          )
        }

        <!-- 3. TCMB Altın Rezervi Kazancı (23 Ekim 2026) -->
        {
          altinSon && (
            <VeriKarti
              href="/veri/altin-kazanci/"
              kategori="Rezerv & Emtia"
              baslik="TCMB Altın Portföyü Kazancı"
              deger={`+$${sayiYaz(altinSon.kazanc_milyar_usd, 1)}`}
              birim="milyar $"
              degisim={`Ons Altın: $${sayiYaz(altinSon.ons_fiyat_usd, 0)} · Rekor kâr`}
              degisimYon="yukselis"
              aciklama="Küresel ons rallisiyle TCMB altın rezervinde biriken değerleme kazancı"
              kaynak="TCMB & LBMA · 23 Ekim 2026"
              seri={altinSeri}
              seriBicim="milyarUsd"
            />
          )
        }

        <!-- 4. TCMB Politika Faizi (23 Ekim 2026) -->
        {
          faiz && (
            <VeriKarti
              href="/veri/politika-faizi/"
              kategori="Para Politikası"
              baslik="TCMB Politika Faizi"
              deger={`%${oranYaz(faiz.oran)}`}
              degisim="1 hafta vadeli repo ihale faizi"
              degisimYon="notr"
              aciklama="Para Politikası Kurulu (PPK) resmi politika faizi kararı"
              kaynak="TCMB PPK · 23 Ekim 2026"
              seri={faizSeri}
              seriBicim="yuzde"
            />
          )
        }

        <!-- 5. BIST Sektör Endeksleri (23 Ekim 2026) -->
        {
          sektorData && (
            <VeriKarti
              href="/veri/sektorler/"
              kategori="Borsa İstanbul"
              baslik="BIST Sektör Endeksleri"
              deger="26"
              birim="endeks"
              degisim="Mali, Sınai, Hizmet ve Tematik"
              degisimYon="notr"
              aciklama="Sektör endekslerinin aylık getiri karnesi ve piyasa değerleri sıralaması"
              kaynak="BİST · 23 Ekim 2026"
              seri={sektorSeri}
              seriMetinleri={sektorMetin}
              seriBicim="yuzde"
            />
          )
        }

        <!-- 6. TCMB Net Döviz Pozisyonu (22 Ekim 2026) -->
        {
          rezerv && (
            <VeriKarti
              href="/veri/net-doviz-pozisyonu/"
              kategori="Merkez Bankası"
              baslik="TCMB Net Döviz Pozisyonu"
              deger={`+$${sayiYaz(rezerv.netDovizPozisyonu, 1)}`}
              birim="milyar $"
              degisim={`Günlük: ${rezerv.degisimGunluk >= 0 ? '+' : ''}${sayiYaz(rezerv.degisimGunluk, 2)} milyar $`}
              degisimYon={rezerv.degisimGunluk >= 0 ? 'yukselis' : 'dusus'}
              aciklama="Swaplar ve Hazine dövizi hariç net çekirdek rezerv pozisyonu"
              kaynak={`TCMB · ${gunYaz(rezerv.tarih)}`}
              seri={netPozSeri}
              seriBicim="milyarUsd"
            />
          )
        }

        <!-- 7. BİST 100 / TÜFE Standart Sapma Analizi (22 Ekim 2026) -->
        {
          bistTufeData && (
            <VeriKarti
              href="/veri/bist-100-tufe/"
              kategori="Değerleme & Sapma"
              baslik="BİST 100 / TÜFE Oranı"
              deger={sayiYaz(bistTufeData.guncelDeger, 1)}
              birim="rasyo"
              degisim={`${bistTufeData.zSkoru >= 0 ? '+' : ''}${sayiYaz(bistTufeData.zSkoru, 1)}σ (${bistTufeData.durum})`}
              degisimYon={bistTufeData.zSkoru >= 0 ? 'yukselis' : 'dusus'}
              aciklama="2 yıllık hareketli ortalama ve standart sapma bantları"
              kaynak="finfolis · 22 Ekim 2026"
              seri={bistTufeSeri}
              seriBicim="endeks"
            />
          )
        }

        <!-- 8. Piyasa Faizleri (16 Ekim 2026) -->
        {
          piyasaFaizleriSon && (
            <VeriKarti
              href="/veri/piyasa-faizleri/"
              kategori="Bankacılık & Kredi"
              baslik="Piyasa Faizleri"
              deger={`%${sayiYaz(piyasaFaizleriSon.mevduat, 1)}`}
              birim="mevduat"
              degisim={`İhtiyaç: %${sayiYaz(piyasaFaizleriSon.ihtiyac, 1)} · Konut: %${sayiYaz(piyasaFaizleriSon.konut, 1)}`}
              degisimYon="notr"
              aciklama="TCMB haftalık akım verileriyle 1-3 ay vadeli TL mevduat ve kredi faizleri"
              kaynak={`TCMB EVDS · ${gunYaz(piyasaFaizleriSon.tarih)}`}
              seri={piyasaFaizSeri}
              seriBicim="yuzde"
            />
          )
        }

        <!-- 9. Döviz Mevduatları (YP) (16 Ekim 2026) -->
        {
          mevduatSon && (
            <VeriKarti
              href="/veri/doviz-mevduatlari/"
              kategori="Dolarlaşma & Likidite"
              baslik="Döviz Mevduatları (YP)"
              deger={`$${sayiYaz(mevduatSon.toplam / 1000, 1)}`}
              birim="milyar $"
              degisim={`Haftalık: ${farkMevduat >= 0 ? '+' : ''}$${sayiYaz(farkMevduat / 1000, 2)} mlr`}
              degisimYon={farkMevduat >= 0 ? 'yukselis' : 'dusus'}
              aciklama="Bankacılık sektörü yurtiçi yerleşiklerin döviz ve altın mevduat toplamı"
              kaynak={`TCMB EVDS · ${gunYaz(mevduatSon.tarih)}`}
              seri={mevduatSeri}
              seriBicim="milyarUsd"
            />
          )
        }

        <!-- 10. TÜFE'den Temizlenmiş BİST 30 (Eylül 2026) -->
        {
          reelBistData && (
            <VeriKarti
              href="/veri/reel-bist-30/"
              kategori="Borsa & Reel Getiri"
              baslik="TÜFE’den Temizlenmiş BİST 30"
              deger={sayiYaz(reelBistData.istatistik.sonNokta.reelEndeks, 1)}
              birim="puan"
              degisim={reelBistData.istatistik.reelDegisimToplam >= 0 ? `▲ %${sayiYaz(reelBistData.istatistik.reelDegisimToplam, 1)}` : `▼ %${sayiYaz(Math.abs(reelBistData.istatistik.reelDegisimToplam), 1)}`}
              degisimYon={reelBistData.istatistik.reelDegisimToplam >= 0 ? 'yukselis' : 'dusus'}
              aciklama="Eylül 2014=100 alım gücü eşiğine göre reel alım gücü endeksi"
              kaynak={`BİST & TÜİK · ${ayAdi(reelBistData.istatistik.sonNokta)}`}
              seri={reelBistSeri}
              seriBicim="endeks"
            />
          )
        }

        <!-- 11. Yıllık Enflasyon (TÜFE) (Eylül 2026) -->
        {
          enflasyonSon && (
            <VeriKarti
              href="/veri/enflasyon/"
              kategori="Fiyatlar Genel Düzeyi"
              baslik="Tüketici Enflasyonu (TÜFE)"
              deger={`%${sayiYaz(enflasyonSon.yillik, 2)}`}
              birim="yıllık"
              degisim={`Aylık artış: ▲ %${sayiYaz(enflasyonSon.aylik, 2)}`}
              degisimYon="dusus"
              aciklama={`Resmi tüketici fiyat endeksi yıllık ve aylık değişim oranları (${ayAdi(enflasyonSon)})`}
              kaynak="TÜİK · Eylül 2026"
              seri={tufeSeri}
              seriBicim="yuzde"
            />
          )
        }

        <!-- Enflasyon beklentisi (TCMB Piyasa Katılımcıları Anketi) -->
        {
          beklentiSon && (
            <VeriKarti
              href="/veri/enflasyon-beklentisi/"
              kategori="Fiyatlar Genel Düzeyi"
              baslik="Enflasyon Beklentisi"
              deger={`%${sayiYaz(beklentiSon.ay12, 2)}`}
              birim="12 ay sonrası"
              degisim={`24 ay sonrası: %${sayiYaz(beklentiSon.ay24, 2)}`}
              aciklama={`TCMB Piyasa Katılımcıları Anketi, gerçekleşen enflasyonla birlikte (${ayAdi(beklentiSon)})`}
              kaynak={`TCMB · ${ayAdi(beklentiSon)}`}
              seri={beklentiSeri}
              seriBicim="yuzde"
            />
          )
        }

        {
          portfoySon && (
            <VeriKarti
              href="/veri/yabanci-portfoy-akimlari/"
              kategori="Dış Denge"
              baslik="Yabancıların Portföy Akımları"
              deger={`${portfoyYil >= 0 ? '+' : '−'}${sayiYaz(Math.abs(portfoyYil) / 1000, 2)} mlr $`}
              birim="hisse, yılbaşından"
              degisim={`Son hafta: ${portfoySon.hisse >= 0 ? '+' : '−'}${sayiYaz(Math.abs(portfoySon.hisse), 1)} mn $`}
              aciklama={`Yurt dışı yerleşiklerin hisse ve DİBS net alım-satımı (${gunYaz(portfoySon.tarih)} haftası)`}
              kaynak={`TCMB · ${gunYaz(portfoySon.tarih)}`}
              seri={portfoySeri}
              seriBicim="milyarUsd"
            />
          )
        }

        {
          cariSon && (
            <VeriKarti
              href="/veri/cari-denge/"
              kategori="Dış Denge"
              baslik="Cari Denge"
              deger={`${cari12.at(-1)! >= 0 ? '+' : '−'}${sayiYaz(Math.abs(cari12.at(-1)!) / 1000, 1)} mlr $`}
              birim="12 aylık"
              degisim={`${ayAdi(cariSon)}: ${cariSon.cari >= 0 ? '+' : '−'}${sayiYaz(Math.abs(cariSon.cari) / 1000, 2)} mlr $`}
              aciklama="Ödemeler dengesi cari işlemler hesabı, 12 aylık birikimli; altın ve enerji hariç kırılımlar"
              kaynak={`TCMB · ${ayAdi(cariSon)}`}
              seri={cari12.slice(-36).map((v) => v! / 1000)}
              seriBicim="milyarUsd"
            />
          )
        }

        {
          kiraSon && (
