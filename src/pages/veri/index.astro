              birim="12 ay sonrası"
              degisim={`24 ay sonrası: %${sayiYaz(beklentiSon.ay24, 2)}`}
              aciklama={`TCMB Piyasa Katılımcıları Anketi, gerçekleşen enflasyonla birlikte (${ayAdi(beklentiSon)})`}
