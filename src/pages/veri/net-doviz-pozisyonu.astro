---
// TCMB Net Döviz Pozisyonu (Swaplar ve Hazine Dövizi Hariç)
// Türkiye Cumhuriyet Merkez Bankası Analitik Bilançosu ve Swap verilerinden hesaplanan çekirdek rezerv göstergesi.
import Base from '../../layouts/Base.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import TcmbRezervGrafik from '../../components/TcmbRezervGrafik.astro';
import { RESMI, gunYaz, sayiYaz, zamanYaz } from '../../lib/resmi';
import netPozisyonVerisi from '../../data/tcmb-net-pozisyon-degisimi.json';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';

const rezerv = RESMI.rezerv;
const baslik = 'TCMB net döviz pozisyonu';
const altBaslik = 'Swaplar ve Hazine dövizi hariç net rezerv';

const milyar = (n: number) => `${n > 0 ? '+' : ''}${sayiYaz(n, 1)} milyar $`;

const description = rezerv
  ? `TCMB net döviz pozisyonu (swaplar ve Hazine dövizi hariç) ${gunYaz(rezerv.tarih)} itibarıyla ${milyar(rezerv.netDovizPozisyonu)}. Altın etkisi dışlanmış günlük değişim grafiği, analitik bilanço kalemleri ve geçmiş seyir tablosu.`
  : 'TCMB net döviz pozisyonu, swap ve Hazine hariç rezerv verileri ve günlük değişim grafiği.';

const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: 'TCMB net döviz pozisyonu', href: '/veri/net-doviz-pozisyonu/' },
];

const jsonLd = sayfaSemasi({
  yol,
  ad: `${baslik} (TCMB)`,
  aciklama: description,
  ...(rezerv
    ? {
        sayfaEk: { dateModified: rezerv.alinma },
        ekler: [
          {
            '@type': 'Dataset',
            name: 'TCMB Swaplar ve Hazine Dövizi Hariç Net Döviz Pozisyonu',
            description:
              'Türkiye Cumhuriyet Merkez Bankası’nın Analitik Bilançosu ve swap yükümlülüklerinden hesaplanan net döviz pozisyonu ve günlük değişimleri.',
            url: 'https://finfolis.com/veri/net-doviz-pozisyonu/',
            isAccessibleForFree: true,
            creator: {
              '@type': 'GovernmentOrganization',
              name: 'Türkiye Cumhuriyet Merkez Bankası',
              url: 'https://www.tcmb.gov.tr/',
            },
            temporalCoverage: `${rezerv.gecmis[0]?.tarih}/${rezerv.gecmis.at(-1)?.tarih}`,
            dateModified: rezerv.alinma,
            variableMeasured: 'Net Döviz Pozisyonu (Milyar USD)',
          },
        ],
      }
    : {}),
});

// Veri Noktaları
const noktalar = rezerv?.gecmis ?? [];

// 1. Günlük Değişim Çubuk Grafiği (Altın Etkisi Dışlanmış) Parametreleri
interface GunlukDegisim {
  tarih: string;
  tarihKisa: string;
  deger: number;
  hamDegisim?: number;
  altinEtkisi?: number;
  usdKuru?: number;
}

let barNoktalar: GunlukDegisim[] = [];

if (netPozisyonVerisi?.seri && Array.isArray(netPozisyonVerisi.seri) && netPozisyonVerisi.seri.length > 0) {
  barNoktalar = (netPozisyonVerisi.seri as Array<{
    tarih: string;
    etiket: string;
    usd_kuru: number;
    ham_degisim_milyar_usd: number;
    altin_degerleme_etkisi_milyar_usd: number;
    degisim_altin_arindirilmis_milyar_usd: number;
  }>)
    .slice(-22)
    .map((item) => ({
      tarih: item.tarih,
      tarihKisa: item.etiket,
      deger: item.degisim_altin_arindirilmis_milyar_usd,
      hamDegisim: item.ham_degisim_milyar_usd,
      altinEtkisi: item.altin_degerleme_etkisi_milyar_usd,
      usdKuru: item.usd_kuru,
    }));
} else {
  // Yedek hesaplama: resmi.json'daki kümülatif seriden türet
  const yedek: GunlukDegisim[] = [];
  for (let i = 1; i < noktalar.length; i++) {
    const onceki = noktalar[i - 1].deger;
    const suanki = noktalar[i].deger;
    const fark = Math.round((suanki - onceki) * 10) / 10;
    const d = noktalar[i].tarih;
    const tarihKisa = `${d.slice(8, 10)}.${d.slice(5, 7)}`;
    yedek.push({
      tarih: d,
      tarihKisa,
      deger: fark,
    });
  }
  barNoktalar = yedek.slice(-20);
}

const barSvgW = 760;
const barSvgH = 320;
const barPadL = 48;
const barPadR = 25;
const barPadT = 32;
const barPadB = 55;

const barDegerler = barNoktalar.map((b) => b.deger);
const maxAbs = Math.max(5, ...barDegerler.map((v) => Math.ceil(Math.abs(v))));
const barMaxY = maxAbs;
const barMinY = -maxAbs;
const barAralikY = barMaxY - barMinY;

const barYCoord = (val: number) =>
  barPadT + (1 - (val - barMinY) / barAralikY) * (barSvgH - barPadT - barPadB);

const barYZero = barYCoord(0);

const barColWidth = (barSvgW - barPadL - barPadR) / Math.max(barNoktalar.length, 1);
const barWidth = Math.max(Math.floor(barColWidth * 0.65), 14);

const barYCizgileri: number[] = [];
const adim = maxAbs > 6 ? 2 : 1;
for (let v = barMinY; v <= barMaxY; v += adim) {
  barYCizgileri.push(v);
}

// Son günün altın arındırılmış değişimi
const sonGunDegisim = barNoktalar.at(-1)?.deger ?? rezerv?.degisimGunluk ?? 0;
---

<Base title={`${baslik}: TCMB güncel ve geçmiş veriler`} description={description} noindex={!rezerv}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-sayfa">
    <Breadcrumb yol={yol} />
    <header class="sayfa-bas sayfa-bas-duz">
      <h1>{baslik}</h1>
      <p>{altBaslik}</p>
    </header>

    {
      rezerv ? (
        <>
          <dl class="veri-rakamlar">
            <div>
              <dt>Net Döviz Pozisyonu</dt>
              <dd class="vurgulu-sayi">{milyar(rezerv.netDovizPozisyonu)}</dd>
              <dd class="veri-degisim">
                {sonGunDegisim !== 0 && (
                  <span class={sonGunDegisim > 0 ? 'pozitif-yazi' : 'negatif-yazi'}>
                    Son gün {sonGunDegisim > 0 ? '+' : ''}
                    {sayiYaz(sonGunDegisim, 1)} milyar $ (altın arındırılmış)
                  </span>
                )}
              </dd>
            </div>
            <div>
              <dt>Net Uluslararası Rezerv (Swap dahil)</dt>
              <dd>{milyar(rezerv.kalemler.netUluslararasiRezervUSD)}</dd>
              <dd class="veri-tarih">{gunYaz(rezerv.tarih)}</dd>
            </div>
            <div>
              <dt>Brüt Dış Varlıklar</dt>
              <dd>{sayiYaz(rezerv.kalemler.disVarliklarUSD, 1)} milyar $</dd>
              <dd class="veri-tarih">{gunYaz(rezerv.tarih)}</dd>
            </div>
          </dl>

          <p class="veri-notu veri-kaynak">
            <strong>Kaynak:</strong>{' '}
            <a href={rezerv.kaynak.url} rel="noopener" target="_blank">
              {rezerv.kaynak.ad}
            </a>
            . Bilanço verileri o günkü TCMB gösterge dolar kuru ile USD cinsine çevrilmiştir. Siteye alındığı zaman:{' '}
            {zamanYaz(rezerv.alinma)}.
          </p>

          <!-- 1. BÖLÜM: GÜNLÜK DEĞİŞİM ÇUBUK GRAFİĞİ -->
          <section class="bolum grafik-alani">
            <div class="grafik-baslik-kutusu">
              <h2 class="bolum-baslik">TCMB net pozisyonu günlük değişimi</h2>
              <span class="grafik-altbaslik">(Altın etkisi dışlanmış, milyar $)</span>
            </div>

            <div class="grafik-kapsayici">
              <svg viewBox={`0 0 ${barSvgW} ${barSvgH}`} class="rezerv-grafik" role="img" aria-label="TCMB net pozisyonu günlük değişimi çubuk grafiği">
                <!-- Yatay Kılavuz Çizgileri -->
                {barYCizgileri.map((yVal) => (
                  <g class="kilavuz-grup">
                    <line
                      x1={barPadL}
                      y1={barYCoord(yVal)}
                      x2={barSvgW - barPadR}
                      y2={barYCoord(yVal)}
                      stroke={yVal === 0 ? 'var(--ink, #1b1b1b)' : 'var(--hair, #cfccc2)'}
                      stroke-width={yVal === 0 ? '1.5' : '1'}
                      stroke-dasharray={yVal === 0 ? 'none' : '2 2'}
                    />
                    <text
                      x={barPadL - 8}
                      y={barYCoord(yVal) + 4}
                      text-anchor="end"
                      class={`grafik-eksen-metin ${yVal === 0 ? 'eksen-sifir' : ''}`}
                    >
                      {yVal > 0 ? `+${yVal}` : yVal}
                    </text>
                  </g>
                ))}

                <!-- Çubuklar ve Değerler -->
                {barNoktalar.map((b, i) => {
                  const xCenter = barPadL + (i + 0.5) * barColWidth;
                  const xLeft = xCenter - barWidth / 2;
                  const isPositive = b.deger >= 0;
                  const yVal = barYCoord(b.deger);
                  const yTop = isPositive ? yVal : barYZero;
                  const height = Math.max(Math.abs(yVal - barYZero), 2);
                  const barColor = isPositive ? 'var(--yukselis, #3f7350)' : 'var(--dusus, #a3243b)';
                  const labelY = isPositive ? yVal - 7 : yVal + 14;
                  const labelColor = isPositive ? 'var(--yukselis, #3f7350)' : 'var(--dusus, #a3243b)';
                  const labelText = `${isPositive && b.deger > 0 ? '+' : ''}${sayiYaz(b.deger, 1)}`;

                  return (
                    <g class="bar-grup" tabindex="0">
                      <title>{`${b.tarih}: ${labelText} milyar $ (Altın arındırılmış net değişim)`}</title>
                      <!-- Çubuk -->
                      <rect
                        x={xLeft}
                        y={yTop}
                        width={barWidth}
                        height={height}
                        fill={barColor}
                      />
                      <!-- Değer Etiketi -->
                      <text
                        x={xCenter}
                        y={labelY}
                        text-anchor="middle"
                        class={`bar-deger-metin ${isPositive ? 'pozitif' : 'negatif'}`}
                        fill={labelColor}
                      >
                        {labelText}
                      </text>
                      <!-- Tarih Etiketi (Eğik) -->
                      <text
                        x={xCenter}
                        y={barSvgH - 12}
                        text-anchor="middle"
                        class="grafik-tarih-metin"
                        transform={`rotate(-40, ${xCenter}, ${barSvgH - 12})`}
                      >
                        {b.tarihKisa}
                      </text>
                    </g>
                  );
                })}
              </svg>
            </div>
            <p class="veri-notu">
              * Çubuklar, TCMB Analitik Bilançosu döviz varlık ve yükümlülüklerinden hesaplanan net pozisyonun günlük farkını gösterir. Küresel ons altın dalgalanmalarının yarattığı muhasebesel değerleme etkisi dışlanmıştır; pozitif barlar TCMB'nin piyasadan döviz çektiğini, negatif barlar ise piyasaya döviz verdiğini ifade eder.
            </p>
          </section>

          <!-- 2. BÖLÜM: İNTERAKTİF KÜMÜLATİF SEYİR GRAFİĞİ -->
          <TcmbRezervGrafik
            noktalar={noktalar}
            guncelDeger={rezerv.netDovizPozisyonu}
            guncelTarih={rezerv.tarih}
          />

          <div class="veri-izgara">
            <section class="bolum">
              <h2 class="bolum-baslik">Rezerv Hesaplama Tablosu</h2>
              <table class="cizelge veri-tablo">
                <thead>
                  <tr>
                    <th scope="col">Bilanço Kalemi</th>
                    <th scope="col" class="sag">Tutar (Milyar $)</th>
                    <th scope="col">Açıklama</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Dış Varlıklar (A.1)</td>
                    <td class="sag">{sayiYaz(rezerv.kalemler.disVarliklarUSD, 1)}</td>
                    <td>Merkez Bankası kasasındaki toplam brüt döviz ve altın</td>
                  </tr>
                  <tr>
                    <td>Döviz Yükümlülükleri (P.1)</td>
                    <td class="sag">-{sayiYaz(rezerv.kalemler.dovizYukumlulukleriUSD, 1)}</td>
                    <td>Bankalara ve dış dünyaya olan toplam döviz borçları</td>
                  </tr>
                  <tr class="ara-toplam">
                    <td><strong>= Net Uluslararası Rezerv</strong></td>
                    <td class="sag"><strong>+{sayiYaz(rezerv.kalemler.netUluslararasiRezervUSD, 1)}</strong></td>
                    <td>IMF tanımlı manşet net rezerv (Swaplar dahil)</td>
                  </tr>
                  <tr>
                    <td>TCMB Toplam Swap Stoku</td>
                    <td class="sag">-{sayiYaz(rezerv.kalemler.swapStokuUSD, 1)}</td>
                    <td>Bankalarla ve yabancı MB'lerle yapılan emanet döviz takası</td>
                  </tr>
                  <tr>
                    <td>Hazine / Kamu Döviz Mevduatı</td>
                    <td class="sag">-{sayiYaz(rezerv.kalemler.hazineDoviziUSD, 1)}</td>
                    <td>Merkezi yönetimin TCMB nezdinde tuttuğu kendi dövizi</td>
                  </tr>
                  <tr class="vurgulu-sonuc">
                    <td><strong>= Net Döviz Pozisyonu</strong></td>
                    <td class="sag"><strong>{milyar(rezerv.kalemler.netPozisyonUSD)}</strong></td>
                    <td><strong>Swaplar ve Hazine hariç çekirdek net rezerv</strong></td>
                  </tr>
                </tbody>
              </table>
            </section>

            <section class="bolum prose veri-aciklama">
              <h2 class="bolum-baslik">Bu Rakamlar Ne Anlama Geliyor?</h2>
              <p>
                Merkez Bankası'nın brüt rezervi kasadaki toplam döviz ve altın miktarını gösterir. Ancak bu paranın önemli bir
                kısmı bankaların zorunlu karşılıklarından, Hazine'ye ait hesaplardan ve swap (para takası) yoluyla emanet alınan
                borçlardan oluşur.
              </p>
              <p>
                <strong>Neden Altın Etkisi Dışlanır?</strong><br />
                Merkez Bankası kasasındaki yüzlerce ton altının piyasa değeri, küresel piyasalarda ons altın fiyatı değiştikçe her gün dalgalanır. TCMB piyasada tek bir dolar alıp satmasa dahi, ons altının yükseldiği bir gün bilançodaki net rezerv kağıt üzerinde 1 milyar dolar artabilir. Piyasaya yapılan doğrudan döviz müdahalesini veya piyasadan çekilen nakit likiditeyi net görebilmek için ons altın kaynaklı muhasebesel değerleme farkları formülden dışlanır.
              </p>
              <p>
                <strong>Günlük Grafikteki Artı ve Eksi Barların Anlamı:</strong><br />
                Yeşil (pozitif) çubuklar, TCMB'nin piyasadan doğrudan döviz toplayarak rezerv biriktirdiğini (ihracatçı döviz devirleri, reeskont kredisi geri dönüşleri vb.) gösterir. Kırmızı (negatif) çubuklar ise Merkez Bankası'nın piyasanın döviz talebini karşılamak veya kuru dengelemek amacıyla piyasaya döviz sattığını ifade eder.
              </p>
              <p>
                <strong>Neden Swaplar Düşülür?</strong><br />
                TCMB yerel bankalarla veya yabancı merkez bankalarıyla swap yaptığında bilançoya döviz girer; fakat vade bitiminde
                bu döviz geri ödeneceği için gerçek bir rezerv varlığı değil, bir yükümlülüktür.
              </p>
              <p>
                <strong>Neden Hazine Dövizi Düşülür?</strong><br />
                Hazine'nin Merkez Bankası'nda tuttuğu mevduat doğrudan devlete aittir; Merkez Bankası'nın kendi para politikası
                veya döviz likiditesi için serbestçe tasarruf edebileceği bir rezerv değildir.
              </p>
            </section>
          </div>
        </>
      ) : (
        <p class="bos">TCMB net döviz pozisyonu verisi şu anda bulunamadı.</p>
      )
    }

    <nav class="veri-baglantilar" aria-label="İlgili sayfalar">
      <a href="/veri/doviz-kurlari/">Döviz kurları</a>
      <a href="/veri/politika-faizi/">Politika faizi</a>
      <a href="/veri/enflasyon/">Enflasyon</a>
      <a href="/veri/bist-100-tufe/">BİST 100 / TÜFE</a>
    </nav>
    <YasalUyari>
      Bu sayfadaki veriler bilgi amaçlıdır ve TCMB Analitik Bilançosu verilerine dayanır; yatırım tavsiyesi niteliği taşımaz.
    </YasalUyari>
  </div>
</Base>

<style>
  .vurgulu-sayi {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--toprak, #c2502b);
  }

  .pozitif-yazi {
    color: var(--yukselis, #3f7350);
    font-weight: 700;
  }

  .negatif-yazi {
    color: var(--dusus, #a3243b);
    font-weight: 700;
  }

  .grafik-baslik-kutusu {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 8px;
  }

  .grafik-altbaslik {
    font-size: 0.95rem;
    color: var(--muted, #5d5b55);
    font-weight: 500;
  }

  .grafik-kapsayici {
    width: 100%;
    overflow-x: auto;
    background: var(--paper, #f4f3ee);
    border: 1px solid var(--hair, #cfccc2);
    border-radius: 0px;
    padding: 16px;
    margin: 16px 0 8px;
  }

  .rezerv-grafik {
    width: 100%;
    height: auto;
    min-width: 520px;
    display: block;
  }

  .grafik-eksen-metin {
    font-size: 11px;
    fill: var(--muted, #5d5b55);
    font-family: var(--sans, sans-serif);
  }

  .eksen-sifir {
    font-weight: 700;
    fill: var(--ink, #1b1b1b);
  }

  .bar-deger-metin {
    font-size: 11px;
    font-family: var(--sans, sans-serif);
    font-weight: 700;
  }

  .bar-deger-metin.negatif {
    font-weight: 800;
  }

  .grafik-tarih-metin {
    font-size: 10px;
    fill: var(--muted, #5d5b55);
    font-family: var(--sans, sans-serif);
  }

  .bar-grup:hover rect {
    opacity: 0.82;
  }

  .ara-toplam {
    background: var(--paper-2, #e9e7df);
    border-top: 1px solid var(--hair, #cfccc2);
    border-bottom: 1px solid var(--hair, #cfccc2);
  }

  .vurgulu-sonuc {
    background: var(--soluk, #e4e1d7);
    border-top: 2px solid var(--toprak, #c2502b);
    border-bottom: 2px solid var(--toprak, #c2502b);
    font-size: 1.05rem;
  }
</style>
