---
// Şok duyarlılığı: petrol, asgari ücret ve kur şoklarının TÜFE ve cari dengeye etkisi, TCMB katsayılarıyla.
// Katsayılar ve kaynaklar: src/lib/hesap/stres-testi.mjs.
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DogrudanYanit from '../../components/DogrudanYanit.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import { RESMI, ayAdi, sayiYaz } from '../../lib/resmi';
import { sayfaSemasi } from '../../lib/seo';
import { KAYNAKLAR, cariOnIkiAy } from '../../lib/hesap/stres-testi.mjs';

const baslik = 'Şok duyarlılığı: Petrol, asgari ücret ve kur';
const aciklama =
  "Brent petrol, asgari ücret ve döviz kuru değişiminin TÜFE'ye ve cari dengeye etkisini TCMB'nin yayımladığı katsayılarla hesaplayın.";

const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: 'Şok duyarlılığı', href: '/veri/senaryolar/' },
];

const sonTufe = RESMI.enflasyon?.satirlar?.at(-1);
const cari = cariOnIkiAy(RESMI.cari?.satirlar ?? []);
const isaretli = (n: number, ondalik = 1) => `${n < 0 ? '−' : ''}${sayiYaz(Math.abs(n), ondalik)}`;

const jsonLd = sayfaSemasi({ yol, ad: baslik, aciklama });
---

<Base baslik={baslik} aciklama={aciklama} jsonLd={jsonLd}>
  <div class="senaryo-sayfasi">
    <Breadcrumb yol={yol} />

    <header class="sayfa-baslik">
      <div class="etiket-satir">
        <span class="etiket">Hesaplayıcı</span>
        <span class="etiket vurgu">TCMB katsayıları</span>
      </div>
      <h1>Şok duyarlılığı: Petrol, asgari ücret ve kur</h1>
      <p class="ozet">
        Brent petrol fiyatı, asgari ücret ya da döviz kuru değişirse enflasyon kaç puan oynar? Kaydırıcılar şoku
        belirler; hesaplayıcı TCMB'nin kendi çalışmalarında yayımladığı katsayıları uygular. Her katsayının kaynağı
        sayfanın sonunda.
      </p>
    </header>

    <DogrudanYanit
      baslik="Kısaca"
      ozet="TCMB'ye göre Brent'teki %10'luk artış TÜFE'yi sonunda 1 puan artırıyor; her 10 dolarlık artış 12 ayda cari açığı yaklaşık 2,6 milyar dolar büyütüyor. Asgari ücretteki %1'lik artışın bir yıldaki etkisi 0,08 ile 0,12 puan arasında. TL'deki %1'lik değer kaybı bir yılda yaklaşık 0,15 puan, uzun dönemde 0,38 ile 0,40 puan enflasyon getiriyor."
      kaynak="TCMB Merkezin Güncesi (2017, 2025); TCMB Enflasyon Raporu 2023-III; TCMB Çalışma Tebliği 25/05"
    />

    <section class="laboratuvar-alani">
      <div class="lab-grid">
        <div class="kontrol-paneli">
          <h2>Şoklar</h2>

          <div class="kaydirici-grup">
            <div class="ayar-baslik">
              <label for="in-brent">Brent fiyatı (varil başına $)</label>
            </div>
            <input type="number" id="in-brent" class="sayi-girdi" min="10" max="200" step="1" value="65" inputmode="decimal" />
            <p class="girdi-not">Örnek değer. Petrol etkisi yüzde değişimle hesaplandığı için güncel fiyatı yazın.</p>
          </div>

          <div class="kaydirici-grup">
            <div class="ayar-baslik">
              <label for="sl-petrol">Brent değişimi</label>
              <strong id="val-petrol">0 $</strong>
            </div>
            <input type="range" id="sl-petrol" min="-30" max="40" step="5" value="0" />
            <div class="aralik-etiketler"><span>−30 $</span><span>0</span><span>+40 $</span></div>
          </div>

          <div class="kaydirici-grup">
            <div class="ayar-baslik">
              <label for="sl-ucret">Asgari ücret artışı</label>
              <strong id="val-ucret">%0</strong>
            </div>
            <input type="range" id="sl-ucret" min="0" max="60" step="1" value="0" />
            <div class="aralik-etiketler"><span>%0</span><span>%30</span><span>%60</span></div>
          </div>

          <div class="kaydirici-grup">
            <div class="ayar-baslik">
              <label for="sl-kur">TL'nin dolar karşısında değer kaybı</label>
              <strong id="val-kur">%0</strong>
            </div>
            <input type="range" id="sl-kur" min="0" max="40" step="1" value="0" />
            <div class="aralik-etiketler"><span>%0</span><span>%20</span><span>%40</span></div>
          </div>

          <button type="button" class="sifirla-btn" id="btn-sifirla">Sıfırla</button>
        </div>

        <div class="sonuc-paneli">
          <h2>Etkiler</h2>

          <div class="makro-kart">
            <span class="kart-etiket">Bir yılda TÜFE'ye toplam etki</span>
            <div class="kart-deger" id="sonuc-toplam">0 puan</div>
            <p class="kart-alt">Üç şokun ayrı etkilerinin toplamı. Mevcut enflasyona eklenen bir tahmin değildir.</p>
          </div>

          <div class="ayristirma-kutusu">
            <div class="ayristirma-satir">
              <span>Petrol <span class="satir-not" id="not-petrol"></span></span>
              <strong id="katki-petrol">0 puan</strong>
            </div>
            <div class="ayristirma-satir">
              <span>Asgari ücret</span>
              <strong id="katki-ucret">0 puan</strong>
            </div>
            <div class="ayristirma-satir">
              <span>Kur, bir yıl</span>
              <strong id="katki-kur">0 puan</strong>
            </div>
          </div>

          <div class="makro-kart">
            <span class="kart-etiket">Kurun uzun dönem etkisi</span>
            <div class="kart-deger" id="sonuc-kur-uzun">0 puan</div>
            <p class="kart-alt">TCMB'nin 2025 çalışmasında ılımlı kur şokları için bulunan geçişkenlik.</p>
          </div>

          <div class="makro-kart">
            <span class="kart-etiket">Petrolün cari açığa etkisi, 12 ay</span>
            <div class="kart-deger" id="sonuc-cari">0 milyar $</div>
            <p class="kart-alt" id="metin-cari">Brent değişmezse etki yok.</p>
          </div>
        </div>
      </div>

      {(sonTufe || cari) && (
        <div class="guncel-kutu">
          <h3>Karşılaştırma için güncel değerler</h3>
          <ul>
            {sonTufe && (
              <li>
                Yıllık TÜFE ({ayAdi(sonTufe)}): %{sayiYaz(sonTufe.yillik, 2)} (TÜİK)
              </li>
            )}
            {cari && (
              <li>
                Son 12 ay cari denge ({ayAdi(cari.bas)} - {ayAdi(cari.bit)}): {isaretli(cari.toplam)} milyar $ (TCMB
                ödemeler dengesi)
              </li>
            )}
          </ul>
        </div>
      )}
    </section>

    <section class="metodoloji-notu">
      <h2>Hesap nasıl yapılıyor</h2>
      <p>
        Her şokun etkisi ayrı hesaplanır ve toplanır. Katsayılar ortalama etkidir: şokun büyüklüğü, ekonominin o
        anki durumu ve vergi ayarlamaları gerçek sonucu değiştirir. TCMB'nin 2025 çalışması, büyük kur şoklarında
        geçişkenliğin yükseldiğini buluyor.
      </p>
      <p>
        Asgari ücret katsayısı TCMB'nin 2023 değerlendirmesinden; rapor etkiyi çekirdek enflasyon (D endeksi) için
        tahmin ediyor. Kurun bir yıllık katsayısı 2017 tarihli bir çalışmadan; daha yeni tek bir yıllık değer
        bulunamadı. Faiz değişiminin enflasyona etkisi için yayımlanmış bir TCMB katsayısı bulunamadığından
        hesaplayıcıda faiz yok.
      </p>
      <p>Sonuç bir tahmin değildir; TÜFE'nin ya da cari dengenin nereye gideceğini söylemez.</p>
      <h3>Kaynaklar</h3>
      <ul class="kaynak-liste">
        {Object.values(KAYNAKLAR).map((k) => (
          <li>
            <a href={k.url} rel="noopener">{k.ad}</a>
          </li>
        ))}
      </ul>
      <p class="kontrol-tarihi">Katsayılar 26 Kasım 2026'da kontrol edildi.</p>
    </section>

    <YasalUyari />
  </div>
</Base>

<script>
  import { sokEtkileri } from '../../lib/hesap/stres-testi.mjs';

  const sayi = (n: number) => Math.abs(n).toLocaleString('tr-TR', { maximumFractionDigits: 1 });
  const isaret = (n: number) => (n > 0 ? '+' : n < 0 ? '−' : '');
  const puan = (n: number) => `${isaret(n)}${sayi(n)} puan`;
  const aralik = ([a, b]: number[]) => (a === b ? puan(a) : `${isaret(a)}${sayi(a)} ile ${isaret(b)}${sayi(b)} puan`);
  const yaz = (id: string, metin: string) => {
    const e = document.getElementById(id);
    if (e) e.textContent = metin;
  };
  const deger = (id: string) => Number((document.getElementById(id) as HTMLInputElement | null)?.value ?? 0);

  function guncelle() {
    const dBrent = deger('sl-petrol');
    const ucret = deger('sl-ucret');
    const kur = deger('sl-kur');
    const r = sokEtkileri({ brentFiyati: deger('in-brent'), brentDegisimUsd: dBrent, asgariUcretArtisiYuzde: ucret, kurDegerKaybiYuzde: kur });

    yaz('val-petrol', `${isaret(dBrent)}${Math.abs(dBrent)} $`);
    yaz('val-ucret', `%${ucret}`);
    yaz('val-kur', `%${kur}`);

    yaz('sonuc-toplam', aralik(r.birYilToplam));
    yaz('katki-petrol', puan(r.petrolTufe));
    yaz('not-petrol', dBrent ? `(Brent ${isaret(r.brentYuzde)}%${sayi(r.brentYuzde)})` : '');
    yaz('katki-ucret', aralik(r.ucretTufe));
    yaz('katki-kur', puan(r.kurBirYil));
    yaz('sonuc-kur-uzun', aralik(r.kurUzun));
    yaz('sonuc-cari', `${isaret(r.petrolCari)}${sayi(r.petrolCari)} milyar $`);
    yaz(
      'metin-cari',
      r.petrolCari > 0 ? 'Cari açık bu kadar büyür.' : r.petrolCari < 0 ? 'Cari açık bu kadar küçülür.' : 'Brent değişmezse etki yok.',
    );
  }

  function baslat() {
    ['in-brent', 'sl-petrol', 'sl-ucret', 'sl-kur'].forEach((id) => document.getElementById(id)?.addEventListener('input', guncelle));
    document.getElementById('btn-sifirla')?.addEventListener('click', () => {
      for (const id of ['sl-petrol', 'sl-ucret', 'sl-kur']) {
        const e = document.getElementById(id) as HTMLInputElement | null;
        if (e) e.value = '0';
      }
      guncelle();
    });
    guncelle();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', baslat);
  else baslat();
</script>

<style>
  .senaryo-sayfasi {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .sayfa-baslik {
    margin: 1.5rem 0 2rem;
  }
  .etiket-satir {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .etiket {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: #f1f5f9;
    color: #475569;
  }
  .etiket.vurgu {
    background: #eff6ff;
    color: #1d4ed8;
  }
  .sayfa-baslik h1 {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.25;
    color: #0f172a;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }
  .sayfa-baslik .ozet {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }
  .laboratuvar-alani {
    margin: 2.5rem 0;
  }
  .lab-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .kontrol-paneli,
  .sonuc-paneli {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
  }
  .kontrol-paneli h2,
  .sonuc-paneli h2 {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 1.25rem;
    color: #0f172a;
  }
  .kaydirici-grup {
    margin-bottom: 1.5rem;
  }
  .ayar-baslik {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
  }
  .ayar-baslik label {
    font-weight: 600;
    color: #334155;
  }
  .ayar-baslik strong {
    color: #0f172a;
    white-space: nowrap;
  }
  .kaydirici-grup input[type='range'] {
    width: 100%;
    accent-color: #2563eb;
  }
  .sayi-girdi {
    width: 100%;
    max-width: 10rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 1rem;
  }
  .girdi-not {
    font-size: 0.75rem;
    color: #64748b;
    margin: 0.375rem 0 0;
  }
  .aralik-etiketler {
    display: flex;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: #94a3b8;
    margin-top: 0.25rem;
  }
  .sifirla-btn {
    width: 100%;
    padding: 0.625rem;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
  }
  .sifirla-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
  }
  .makro-kart {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
  }
  .kart-etiket {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: #64748b;
  }
  .kart-deger {
    font-size: 1.5rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0.25rem 0;
    font-variant-numeric: tabular-nums;
  }
  .kart-alt {
    font-size: 0.75rem;
    color: #64748b;
    margin: 0;
  }
  .ayristirma-kutusu {
    margin: 0 0 1rem;
    padding: 0 0.25rem;
  }
  .ayristirma-satir {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: #475569;
    padding: 0.25rem 0;
  }
  .ayristirma-satir strong {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .satir-not {
    color: #94a3b8;
  }
  .guncel-kutu {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: #475569;
  }
  .guncel-kutu h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #334155;
    margin: 0 0 0.5rem;
  }
  .guncel-kutu ul {
    margin: 0;
    padding-left: 1.1rem;
    line-height: 1.6;
  }
  .metodoloji-notu {
    margin-top: 3rem;
    border-top: 1px solid #e2e8f0;
    padding-top: 2rem;
  }
  .metodoloji-notu h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1rem;
  }
  .metodoloji-notu h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: #0f172a;
    margin: 1.5rem 0 0.5rem;
  }
  .metodoloji-notu p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #475569;
  }
  .kaynak-liste {
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #475569;
  }
  .kontrol-tarihi {
    font-size: 0.8125rem;
  }
  @media (max-width: 768px) {
    .lab-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .sayfa-baslik h1 {
      font-size: 1.5rem;
    }
    .senaryo-sayfasi {
      padding: 1.25rem 0.75rem 3rem;
    }
  }
</style>
