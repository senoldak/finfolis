---
// Türkiye dünyada kaçıncı?: temel göstergelerde Türkiye'nin 22 ekonomi arasındaki sırası ve paylaşılabilir kare kartlar.
// Sıra hesabı src/lib/dunyada-turkiye.mjs'tedir; veri src/data/emsal-ulkeler.json (OECD, BIS) ve dunya-faizleri.json (BIS).
// Kartların PNG'leri scripts/veri/dunyada-turkiye-kartlari.mjs ile üretilir. Yön dili yalnız "en yüksek" ve "en düşük"tür.
import Base from '../../layouts/Base.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { zamanYaz } from '../../lib/resmi';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';
import { donemEtiket } from '../../lib/emsal-ulkeler.mjs';
import { GOSTERGELER, hesapla, sonucCumlesi, degerYaz, donemNotu, trDonemNotu, slug, KAYNAK_AD } from '../../lib/dunyada-turkiye.mjs';
import emsal from '../../data/emsal-ulkeler.json';
import faizVeri from '../../data/dunya-faizleri.json';

const sonuclar = hesapla(emsal, faizVeri);
const kartlar = sonuclar.map((s) => {
  const g = GOSTERGELER.find((x) => x.k === s.k)!;
  const enBuyuk = Math.max(0, ...s.dizi.map((d) => d.deger));
  const enKucuk = Math.min(0, ...s.dizi.map((d) => d.deger));
  const aralik = enBuyuk - enKucuk || 1;
  const n = s.dizi.length;
  const cubuklar = s.dizi.map((d, i) => ({
    ...d,
    sol: (i / n) * 100,
    gen: 100 / n,
    ust: ((enBuyuk - Math.max(d.deger, 0)) / aralik) * 100,
    yuk: Math.max((Math.abs(d.deger) / aralik) * 100, 1.2),
    ipucu: `${d.ad}: ${degerYaz(d.deger, g)}`,
    solYarim: i < n / 2,
    sira: 1 + s.dizi.filter((x) => x.deger > d.deger).length,
  }));
  const sifir = (enBuyuk / aralik) * 100;
  const notlar = [
    s.eksik.length ? `${s.eksik.join(', ')} için bu gösterge kaynakta yok; sayılmadı.` : '',
    donemNotu(s),
    trDonemNotu(s),
  ].filter(Boolean);
  return { s, g, cubuklar, sifir, notlar, indir: `/kartlar/dunyada-turkiye/${slug(s.k)}.png` };
});

const baslik = 'Türkiye dünyada kaçıncı?';
const trTufe = sonuclar.find((x) => x.k === 'tufe');
const description = `Türkiye'nin büyüme, enflasyon, işsizlik, faiz ve reel faizde 22 ekonomi arasındaki sırası${trTufe?.uygun ? `; yıllık enflasyonda ${trTufe.n} ekonomi arasında ${trTufe.yon} ${trTufe.yonSira}.` : '.'} Kaynak OECD ve BIS; paylaşılabilir kartlarla.`;
const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: baslik, href: '/veri/dunyada-turkiye/' },
];
const jsonLd = sayfaSemasi({
  yol,
  ad: baslik,
  aciklama: description,
  sayfaEk: { dateModified: emsal.alinma },
  ekler: [
    {
      '@type': 'Dataset',
      name: 'Türkiye’nin 22 ekonomi arasındaki sırası',
      description: 'OECD ve BIS verilerinden hesaplanan sıralama: GSYH büyümesi, TÜFE, çekirdek TÜFE, işsizlik, politika faizi, reel faiz ve faizin 12 aylık değişiminde Türkiye’nin yeri.',
      url: 'https://finfolis.com/veri/dunyada-turkiye/',
      isAccessibleForFree: true,
      creator: [
        { '@type': 'Organization', name: 'Organisation for Economic Co-operation and Development', url: 'https://www.oecd.org/' },
        { '@type': 'Organization', name: 'Bank for International Settlements', url: 'https://www.bis.org/' },
      ],
      dateModified: emsal.alinma,
      variableMeasured: kartlar.map((k) => k.g.ad),
    },
  ],
});
---

<Base title={`${baslik} Büyüme, enflasyon ve faizde sıralama`} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-sayfa">
    <Breadcrumb yol={yol} />
    <header class="sayfa-bas sayfa-bas-duz">
      <h1>{baslik}</h1>
      <p>Temel göstergelerde Türkiye’nin 22 ekonomi arasındaki sırası · OECD ve BIS verisi</p>
    </header>
    <p class="veri-notu veri-kaynak">
      <strong>Kaynak:</strong>
      {emsal.kaynaklar.map((k, i) => (
        <>
          <a href={k.url} rel="noopener">{k.ad}</a>{i < emsal.kaynaklar.length - 1 ? '; ' : ''}
        </>
      ))}. Siteye alındığı zaman: {zamanYaz(emsal.alinma)}. Değerler için <a href="/veri/emsal-ulkeler/">emsal ülkeler</a>,
      <a href="/veri/politika-faizi/">politika faizi</a> ve <a href="/veri/dunya-politika-faizleri/">dünya politika faizleri</a> sayfalarına bakılabilir.
    </p>
    <p class="veri-notu dt-yontem">
      Sıra, göstergede verisi olan ekonomiler arasında büyük değerden küçüğe doğru verilir: 1. en yüksek değerdir. Türkiye’ye daha yakın uç
      seçilir; “en düşük 1.” en küçük değer demektir. Verisi olmayan ekonomi o göstergede sayılmaz. Eşit değerler aynı sırayı alır.
    </p>

    <div class="dt-izgara">
      {kartlar.map(({ s, g, cubuklar, sifir, notlar, indir }) => (
        <article class="dt-kart" id={slug(s.k)}>
          {s.uygun ? (
            <>
              <div class="dt-ust">
                <p class="dt-sira" aria-hidden="true">{s.yonSira}.</p>
                <div>
                  <h2>{s.ad}</h2>
                  <p class="dt-cumle">{sonucCumlesi(s)}</p>
                  <p class="dt-deger">
                    Türkiye {degerYaz(s.deger, g)}{s.donem && <small> · {donemEtiket(s.donem)}</small>}
                  </p>
                </div>
              </div>
              <div class="dt-alan" role="img" aria-label={`${s.n} ekonominin sıralı çubuk grafiği; Türkiye ${s.yon} ${s.yonSira}.`}>
                {cubuklar.map((c) => (
                  <span
                    class:list={['dt-c', { 'dt-tr': c.tr, 'dt-sol': c.solYarim }]}
                    style={`left:${c.sol.toFixed(3)}%;width:calc(${c.gen.toFixed(3)}% - 3px);top:${c.ust.toFixed(2)}%;height:${c.yuk.toFixed(2)}%`}
                    data-ipucu={c.ipucu}
                    tabindex="0"
                  />
                ))}
                {sifir < 99 && sifir > 1 && <span class="dt-sifir" style={`top:${sifir.toFixed(2)}%`} />}
              </div>
              <p class="dt-komsu">
                {s.ustte && <>Bir üstte: {s.ustte.ad} {degerYaz(s.ustte.deger, g)}. </>}
                {s.altta && <>Bir altta: {s.altta.ad} {degerYaz(s.altta.deger, g)}. </>}
                {s.medyan != null && <>Diğer ekonomilerin medyanı: {degerYaz(s.medyan, g)}.</>}
              </p>
            </>
          ) : (
            <div class="dt-ust">
              <div>
                <h2>{s.ad}</h2>
                <p class="dt-cumle">Türkiye için bu gösterge kaynakta yok; sıralama yapılmadı.</p>
              </div>
            </div>
          )}
          {notlar.length > 0 && <p class="veri-notu dt-not">{notlar.join(' ')}</p>}
          <details class="dt-detay">
            <summary>Tam sıralama</summary>
            <table class="cizelge veri-tablo">
              <thead>
                <tr>
                  <th scope="col">Sıra</th>
                  <th scope="col">Ülke</th>
                  <th scope="col" class="sag">Değer</th>
                  <th scope="col" class="sag">Dönem</th>
                </tr>
              </thead>
              <tbody>
                {cubuklar.map((c) => (
                  <tr class:list={{ 'dt-satir-tr': c.tr }}>
                    <td>{c.sira}</td>
                    <th scope="row">{c.ad}</th>
                    <td class="sag">{degerYaz(c.deger, g)}</td>
                    <td class="sag">{c.donem ? donemEtiket(c.donem) : '–'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </details>
          <p class="dt-alt">
            <span class="veri-notu">Kaynak: {KAYNAK_AD[s.k as keyof typeof KAYNAK_AD]}</span>
            {s.uygun && <a class="dt-indir" href={indir} download={`finfolis-dunyada-turkiye-${slug(s.k)}.png`}>Kartı indir (PNG)</a>}
          </p>
        </article>
      ))}
    </div>
    <YasalUyari>Bu sayfadaki sıralamalar OECD ve BIS’in yayımladığı resmi rakamlardan hesaplanır ve bilgi amaçlıdır.</YasalUyari>
  </div>
</Base>

<style>
  .dt-yontem {
    max-width: 80ch;
  }

  .dt-izgara {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 24px;
    margin-top: 24px;
  }

  .dt-kart {
    border: 1px solid var(--hair);
    background: var(--paper);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .dt-ust {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }

  .dt-sira {
    margin: 0;
    font-size: clamp(4rem, 14vw, 6rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .dt-kart h2 {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .dt-cumle {
    margin: 6px 0 0;
    color: var(--ink-2);
  }

  .dt-deger {
    margin: 6px 0 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .dt-deger small {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85em;
  }

  /* Mini sıralı çubuk: çubuklar kutuya göre yüzdeyle konumlanır; sıfır çizgisi varsa eksi değerler altına iner. */
  .dt-alan {
    position: relative;
    height: 132px;
    margin-top: 28px;
  }

  .dt-c {
    position: absolute;
    background: var(--boncuk);
    border-radius: 2px;
  }

  .dt-tr {
    background: var(--ink);
    z-index: 1;
  }

  .dt-sifir {
    position: absolute;
    left: 0;
    right: 0;
    height: 0;
    border-top: 1px solid var(--muted);
    pointer-events: none;
  }

  .dt-c:hover,
  .dt-c:focus-visible {
    background: var(--ink-2);
    outline: none;
    z-index: 2;
  }

  .dt-c::after {
    content: attr(data-ipucu);
    position: absolute;
    bottom: calc(100% + 6px);
    right: 0;
    z-index: 3;
    white-space: nowrap;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8rem;
    padding: 4px 8px;
    border-radius: 3px;
    opacity: 0;
    pointer-events: none;
  }

  .dt-c.dt-sol::after {
    right: auto;
    left: 0;
  }

  .dt-c:hover::after,
  .dt-c:focus-visible::after {
    opacity: 1;
  }

  .dt-komsu {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .dt-not {
    margin: 0;
  }

  .dt-detay summary {
    cursor: pointer;
    font-weight: 600;
  }

  .dt-detay table {
    margin-top: 10px;
    font-variant-numeric: tabular-nums;
  }

  .dt-satir-tr th,
  .dt-satir-tr td {
    background: var(--paper-2, #f4f0e8);
    font-weight: 700;
  }

  .dt-alt {
    margin: auto 0 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .dt-indir {
    font-weight: 600;
  }
</style>
