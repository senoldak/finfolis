---
// TÜFE'den Arındırılmış BİST 30 Endeksi (Reel Satın Alma Gücü)
import Base from '../../layouts/Base.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ReelBistGrafik from '../../components/ReelBistGrafik.astro';
import data from '../../data/reel-bist.json';
import { ayAdi, sayiYaz, zamanYaz } from '../../lib/resmi';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';

const { istatistik, noktalar, donemler, kaynaklar, guncelleme } = data;
const son = istatistik.sonNokta;
const baslik = 'TÜFE’den Temizlenmiş BİST 30 Endeksi';
const description = `Borsa İstanbul BİST 30 endeksinin resmi tüketici enflasyonundan (TÜFE) arındırılmış reel seyri (2014–2026). Eylül 2014=100 bazına göre borsanın alım gücü ve dönem rejimleri.`;

const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: 'Reel BİST 30 Endeksi', href: '/veri/reel-bist-30/' },
];

const son24Ay = noktalar.slice(-24).reverse();

const jsonLd = sayfaSemasi({
  yol,
  ad: baslik,
  aciklama: description,
  sayfaEk: { dateModified: guncelleme },
  ekler: [
    {
      '@type': 'Dataset',
      name: 'TÜFE’den Arındırılmış BİST 30 Reel Getiri Endeksi',
      description: 'Borsa İstanbul BİST 30 endeksi aylık kapanışlarının TÜİK TÜFE katsayısıyla defle edilmiş reel getiri serisi.',
      url: 'https://finfolis.com/veri/reel-bist-30/',
      isAccessibleForFree: true,
      creator: { '@type': 'Organization', name: 'finfolis', url: 'https://finfolis.com/' },
      temporalCoverage: `${noktalar[0].tarih}/${son.tarih}`,
      dateModified: guncelleme,
      variableMeasured: ['Reel BİST 30 Endeksi', 'BİST 30 Kapanış (TL)', 'TÜFE Kümülatif Çarpanı'],
    },
  ],
});
---

<Base title={`${baslik} (Reel Getiri)`} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-sayfa">
    <Breadcrumb yol={yol} />

    <header class="sayfa-bas sayfa-bas-duz">
      <h1>{baslik}</h1>
      <p>Borsa İstanbul · Enflasyondan arındırılmış satın alma gücü seyri (Eylül 2014 = 100)</p>
    </header>

    <!-- Özet Rakamlar (DESIGN.md uyumlu: yön okla, tabular-nums) -->
    <dl class="veri-rakamlar">
      <div>
        <dt>Güncel Reel Değer</dt>
        <dd>
          {sayiYaz(son.reelEndeks, 1)}
          <small>puan</small>
        </dd>
        <dd class="veri-degisim">
          {ayAdi(son)} · {istatistik.reelDegisimToplam >= 0 ? `▲ %${sayiYaz(istatistik.reelDegisimToplam, 1)}` : `▼ %${sayiYaz(Math.abs(istatistik.reelDegisimToplam), 1)}`}
        </dd>
      </div>

      <div>
        <dt>Nominal Kapanış</dt>
        <dd>
          ₺{sayiYaz(son.bistKapanis, 0)}
        </dd>
        <dd class="veri-degisim">
          ▲ %{sayiYaz(istatistik.nominalDegisimToplam, 0)} (Eylül 2014'ten bu yana)
        </dd>
      </div>

      <div>
        <dt>Fiyatlar Genel Düzeyi</dt>
        <dd>
          {sayiYaz(son.tufeCarpani, 2)}
          <small>kat</small>
        </dd>
        <dd class="veri-degisim">Kümülatif resmi TÜFE artışı</dd>
      </div>

      <div>
        <dt>Tarihsel Zirve (Reel)</dt>
        <dd>
          {sayiYaz(istatistik.zirve.reelEndeks, 1)}
          <small>puan</small>
        </dd>
        <dd class="veri-degisim">{istatistik.zirve.tarih} (Haziran 2023)</dd>
      </div>
    </dl>

    <!-- finfolis Kimliğine Özel Grafik Bileşeni -->
    <ReelBistGrafik
      noktalar={noktalar}
      donemler={donemler}
      zirve={istatistik.zirve}
      dip={istatistik.dip}
    />

    <p class="veri-notu veri-kaynak">
      <strong>Kaynaklar:</strong>{' '}
      {
        kaynaklar.map((k, i) => (
          <>
            {i > 0 && ' · '}
            <a href={k.url} rel="noopener" target="_blank">{k.ad}</a>
          </>
        ))
      }
      . Son güncelleme: {zamanYaz(guncelleme)}.
    </p>

    <!-- İki Sütunlu Açıklama ve Tablo Alanı -->
    <div class="veri-izgara">
      <section class="bolum">
        <h2 class="bolum-baslik">Son 24 Ayın Değerleri</h2>
        <div class="tablo-sarici">
          <table class="cizelge veri-tablo">
            <thead>
              <tr>
                <th scope="col">Dönem</th>
                <th scope="col" class="sag">Nominal Kapanış</th>
                <th scope="col" class="sag">TÜFE Çarpanı</th>
                <th scope="col" class="sag">Reel Endeks</th>
              </tr>
            </thead>
            <tbody>
              {
                son24Ay.map((s) => (
                  <tr>
                    <td>{ayAdi(s)}</td>
                    <td class="sag">{sayiYaz(s.bistKapanis, 0)} TL</td>
                    <td class="sag">{sayiYaz(s.tufeCarpani, 2)} kat</td>
                    <td class="sag">
                      <strong>{sayiYaz(s.reelEndeks, 1)}</strong>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="bolum prose veri-aciklama">
        <h2 class="bolum-baslik">Bu Grafik Bize Ne Anlatıyor?</h2>
        <p>
          Nominal borsa endeksleri (ekranda gördüğümüz günlük BİST 30 puanı), Türk lirası bazında tarihi zirveler kırabilir.
          Ancak yüksek enflasyon ortamında bir varlığın nominal değerinin artması, yatırımcısının <strong>satın alma gücünün</strong> arttığı
          anlamına gelmez.
        </p>

        <h3>Reel Endeks Nasıl Hesaplanır?</h3>
        <p>
          Grafikte Eylül 2014 tarihi <strong>100 baz puan</strong> kabul edilmiştir. Her ayın BİST 30 kapanışı, TÜİK’in resmi tüketici
          fiyat endeksi (TÜFE) katsayısına bölünerek enflasyondan temizlenir:
        </p>
        <p>
          <code>Reel Değer = (BİST 30 Kapanışı / Baz BİST) ÷ Kümülatif Enflasyon Çarpanı × 100</code>
        </p>

        <h3>Borsadaki Dört Tarihsel Rejim</h3>
        <p>
          Grafiğin 12 yıllık geçmişine bakıldığında borsa dört belirgin rejimden geçmiştir:
        </p>
        <ul>
          <li>
            <strong>1. Dengeli Aralık (2014 – 2018):</strong> Borsa, resmi enflasyonla genel olarak başa baş seyretmiş,
            endeks 85 ile 120 puan arasında dalgalanmıştır.
          </li>
          <li>
            <strong>2. Reel Değer Kaybı (2018 – 2022):</strong> Kur şokları ve hızlanan enflasyon sürecinde borsa
            nominal olarak yükselse bile enflasyonun gerisinde kalmış; reel endeks 60–70 seviyelerine gerileyerek
            tarihsel dip bölgelerine inmiştir.
          </li>
          <li>
            <strong>3. Enflasyon Rallisi (2022 – 2024):</strong> Negatif reel faiz ortamında yatırımcıların tasarruflarını
            koruma arayışı borsaya yönelmiş; endeks 140–155 puan bandına çıkarak tarihi bir reel getiri zirvesi yapmıştır.
          </li>
          <li>
            <strong>4. Konsolidasyon (2024 – 2026):</strong> Sıkı para politikası ve pozitif reel mevduat faizleriyle birlikte
            borsa reel olarak ortalamasına (100 baz çizgisi çevresine) dönme sürecine girmiştir.
          </li>
        </ul>

        <p>
          <strong>Özet Çıkarım:</strong> Reel endeks 100'ün altındaysa, Eylül 2014'te borsaya yatırılan 100 TL'lik satın alma gücü
          enflasyona karşı erimiş; 100'ün üzerindeyse borsa yatırımcısına enflasyonun üzerinde net reel refah kazandırmıştır.
        </p>
      </section>
    </div>

    <nav class="veri-baglantilar" aria-label="İlgili sayfalar">
      <a href="/veri/enflasyon/">Yıllık Enflasyon (TÜFE)</a>
      <a href="/veri/politika-faizi/">Politika Faizi</a>
      <a href="/veri/konut-fiyat-endeksi/">Konut Fiyat Endeksi</a>
      <a href="/hesapla/enflasyon/">Enflasyon Hesaplama</a>
    </nav>

    <YasalUyari>
      Bu sayfadaki veriler bilgilendirme amaçlıdır. BİST verileri Yahoo Finance'tan, TÜFE oranları TÜİK ve TCMB'den derlenmiştir.
      Yatırım tavsiyesi değildir.
    </YasalUyari>
  </div>
</Base>

<style>
  .tablo-sarici {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
</style>
