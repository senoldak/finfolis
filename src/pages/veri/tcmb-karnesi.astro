---
// TCMB karnesi: tahminler ne kadar tuttu? Üç bölüm, hepsi resmi veriden hesaplanır; sayfada elle yazılmış rakam yoktur.
//  1) Enflasyon Raporu yıl sonu tahminleri ve ara hedefleri: src/data/tcmb-er-tahminleri.json (scripts/veri/tcmb-karnesi.mjs) ve resmi.json yıllık TÜFE.
//  2) Piyasa Katılımcıları Anketi 12 ay sonrası beklentisi ve 12 ay sonra gerçekleşen yıllık TÜFE: resmi.json (beklenti, enflasyon).
//  3) PPK metin tonu (yapay zekâ okuması) ve bir sonraki PPK kararı: ppk-ton.json, ppk-metinler.json.
// Hesaplar src/lib/tcmb-karnesi.mjs'te.
import Base from '../../layouts/Base.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ZamanGrafik from '../../components/ZamanGrafik.astro';
import erVerisi from '../../data/tcmb-er-tahminleri.json';
import metinVerisi from '../../data/ppk-metinler.json';
import tonVerisi from '../../data/ppk-ton.json';
import { RESMI, AYLAR, gunYaz, zamanYaz } from '../../lib/resmi';
import { belgeListesi, donguler, tonAdi } from '../../lib/ppk-ton.mjs';
import { erKarne, pkaEsle, hataOzeti, yilaGore, kararlariCikar, tonKarnesi, TON_ESIGI } from '../../lib/tcmb-karnesi.mjs';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';

const enflasyon = RESMI.enflasyon?.satirlar ?? [];
const beklenti = RESMI.beklenti?.satirlar ?? [];

// Biçimler: ondalık virgül, gereksiz sıfır yok; işaretli farklar gerçek eksi işaretiyle.
const yz = (n: number | null | undefined, k = 2) => (n == null ? '–' : n.toLocaleString('tr-TR', { maximumFractionDigits: k }));
const yuzde = (n: number | null | undefined, k = 2) => (n == null ? '–' : `%${yz(n, k)}`);
const isaretli = (n: number | null | undefined) => (n == null ? '–' : `${n > 0 ? '+' : n < 0 ? '−' : ''}${yz(Math.abs(n))}`);
const ayYaz = (yil: number, ay: number) => `${AYLAR[ay - 1]} ${yil}`;
const tAy = (yil: number, ay: number) => yil * 12 + ay - 1;

// ---- 1) Enflasyon Raporu ------------------------------------------------------------------------------------
const raporlar = erVerisi.raporlar ?? [];
const basarisiz = (erVerisi as { basarisiz?: { id: string; donem: string; neden: string }[] }).basarisiz ?? [];
const karne = erKarne(raporlar, enflasyon) as {
  yil: number;
  gerceklesen: number | null;
  sonVeri: { yil: number; ay: number; yillik: number } | null;
  satirlar: {
    id: string; donem: string; tarih: string; url: string; ufuk: number;
    nokta: number | null; alt: number | null; ust: number | null; araHedef: number | null;
    orta: number | null; ortaTuru: string | null; fark: number | null; aralikta: string | null; farkAraHedef: number | null;
  }[];
}[];
const UFUK = ['yıl içinde', '1 yıl önce', '2 yıl önce', '3 yıl önce'];
const ARALIKTA: Record<string, string> = { icinde: 'aralığın içinde', ust: 'aralığın üstünde', alt: 'aralığın altında' };
const gerceklesenYillar = karne.filter((y) => y.gerceklesen != null);
const ozetSatirlari = gerceklesenYillar.map((y) => {
  const ayni = y.satirlar.filter((s) => s.ufuk === 0 && s.orta != null);
  return { yil: y.yil, gerceklesen: y.gerceklesen as number, ilk: ayni[0], son: ayni.at(-1) };
});

// Her hedef yıl için küçük grafik: x = rapor sırası, nokta = orta tahmin, çubuk = %70 aralığı, kare = ara hedef, çizgi = gerçekleşen.
const G = { w: 360, h: 250, sol: 40, sag: 12, ust: 18, alt: 46 };
function grafikKur(y: (typeof karne)[number]) {
  const nk = y.satirlar.filter((s) => s.orta != null || s.araHedef != null);
  const degerler = nk.flatMap((s) => [s.alt, s.ust, s.orta, s.araHedef]).concat([y.gerceklesen]).filter((v): v is number => v != null);
  if (nk.length < 2 || !degerler.length) return null;
  const lo = Math.min(...degerler);
  const hi = Math.max(...degerler);
  const adim = [2, 5, 10, 20, 25].find((a) => (hi - lo) / a <= 5) ?? 25;
  const y0 = Math.floor(lo / adim) * adim;
  const y1 = Math.ceil(hi / adim) * adim || adim;
  const iw = G.w - G.sol - G.sag;
  const ih = G.h - G.ust - G.alt;
  const px = (i: number) => G.sol + (nk.length === 1 ? iw / 2 : (i * iw) / (nk.length - 1));
  const py = (v: number) => G.ust + ih - ((v - y0) / (y1 - y0)) * ih;
  const izgara: { y: number; etiket: string }[] = [];
  for (let v = y0; v <= y1 + 1e-9; v += adim) izgara.push({ y: py(v), etiket: String(v) });
  const noktalar = nk.map((s, i) => ({
    x: px(i),
    roma: s.donem.split('-')[1],
    yil: s.donem.slice(0, 4),
    yilBasi: i === 0 || nk[i - 1].donem.slice(0, 4) !== s.donem.slice(0, 4),
    orta: s.orta != null ? py(s.orta) : null,
    ortaIsaret: s.ortaTuru === 'aralik-ortasi',
    alt: s.alt != null ? py(s.alt) : null,
    ust: s.ust != null ? py(s.ust) : null,
    ara: s.araHedef != null ? py(s.araHedef) : null,
  }));
  const ozet = nk.map((s) => `${s.donem}: ${s.orta != null ? yuzde(s.orta) : 'tahmin yok'}${s.alt != null ? ` (aralık ${yuzde(s.alt)}–${yuzde(s.ust)})` : ''}`).join('; ');
  return {
    yil: y.yil,
    gerceklesen: y.gerceklesen,
    gy: y.gerceklesen != null ? py(y.gerceklesen) : null,
    izgara,
    noktalar,
    araVar: nk.some((s) => s.araHedef != null),
    aralikVar: nk.some((s) => s.alt != null),
    isaretVar: nk.some((s) => s.ortaTuru === 'aralik-ortasi'),
    etiket: `${y.yil} yıl sonu enflasyonu için Enflasyon Raporu tahminleri. ${ozet}.${y.gerceklesen != null ? ` Gerçekleşen: ${yuzde(y.gerceklesen)}.` : ' Gerçekleşme bekleniyor.'}`,
  };
}
const grafikler = karne.map(grafikKur).filter((g): g is NonNullable<ReturnType<typeof grafikKur>> => g != null);
const erUrl = (erVerisi as { kaynak?: { url: string } }).kaynak?.url ?? 'https://www.tcmb.gov.tr';

// ---- 2) Piyasa Katılımcıları Anketi -----------------------------------------------------------------------------
const esler = pkaEsle(beklenti, enflasyon) as {
  anketYil: number; anketAy: number; hedefYil: number; hedefAy: number; beklenti: number; gerceklesen: number; sapma: number;
}[];
const pka = hataOzeti(esler, 24);
const pkaYil = yilaGore(esler) as { yil: number; n: number; ortSapma: number; ortMutlak: number }[];
const sonEs = esler.at(-1);
const anketSayisi = beklenti.filter((b) => Number.isFinite(b.ay12)).length;
const gercekHarita = new Map<number, number>(enflasyon.map((s) => [tAy(s.yil, s.ay), s.yillik]));
const beklentiHarita = new Map<number, number>();
for (const b of beklenti) if (Number.isFinite(b.ay12)) beklentiHarita.set(tAy(b.yil, b.ay) + 12, b.ay12);
const ilkT = Math.min(...beklentiHarita.keys());
const sonT = Math.max(...beklentiHarita.keys());
const pkaNoktalari: (number | null)[][] = [];
for (let t = ilkT; t <= sonT; t++) pkaNoktalari.push([t, beklentiHarita.get(t) ?? null, gercekHarita.get(t) ?? null]);

// ---- 3) İletişim karnesi ---------------------------------------------------------------------------------------
type Puan = { ileriYon: number; durus: number };
const belgeler = belgeListesi(metinVerisi).belgeler as { id: string; tur: string; tarih: string }[];
const puanlar = ((tonVerisi as { puanlar?: Record<string, Puan> }).puanlar ?? {}) as Record<string, Puan>;
const dongu = donguler(belgeler, puanlar);
const kararlar = kararlariCikar(belgeler) as Map<string, string>;
const ton = tonKarnesi(dongu, kararlar) as {
  satirlar: {
    toplanti: string; ton: number | null; sinif: string | null; bugun: string | null; sonrakiToplanti: string | null;
    sonraki: string | null; olculur: boolean; tonIsabet: boolean | null; tabanIsabet: boolean | null;
  }[];
  n: number; tonIsabet: number; tabanIsabet: number;
  degisim: { n: number; tonIsabet: number };
  siniflar: Record<string, { n: number; isabet: number }>;
  sonrakiYok: string[];
};
const KARAR: Record<string, string> = { artis: 'Artırım', sabit: 'Sabit', indirim: 'İndirim' };
const SINIF: Record<string, string> = { guvercin: 'güvercin (≤ −0,75)', dengeli: 'dengeli', sahin: 'şahin (≥ +0,75)' };
const evetHayir = (b: boolean | null) => (b == null ? '–' : b ? 'Evet' : 'Hayır');
const tonSatirlari = [...ton.satirlar].filter((s) => s.ton != null).reverse();
const tonIlk = ton.satirlar[0]?.toplanti;
const tonSonOlculen = [...ton.satirlar].filter((s) => s.olculur).at(-1);
const yuzdeOran = (a: number, b: number) => (b ? `%${Math.round((a / b) * 100)}` : '–');
const kararSayilari = { artis: 0, sabit: 0, indirim: 0 } as Record<string, number>;
for (const s of ton.satirlar) if (s.olculur && s.sonraki) kararSayilari[s.sonraki]++;

// ---- Sayfa -------------------------------------------------------------------------------------------------------
const baslik = 'TCMB karnesi';
const guncelleme = [(erVerisi as { alinma?: string }).alinma, (tonVerisi as { guncelleme?: string }).guncelleme, RESMI.enflasyon?.alinma].filter(Boolean).sort().at(-1) as string | undefined;
const description = `TCMB tahminleri ne kadar tuttu? Enflasyon Raporu tahminleri ve ara hedefleri, Piyasa Katılımcıları Anketi’ndeki 12 ay sonrası beklenti ve PPK metin tonu, sonradan gerçekleşenle yan yana.`;
const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: baslik, href: '/veri/tcmb-karnesi/' },
];
const jsonLd = sayfaSemasi({
  yol,
  ad: `${baslik}: tahminler ne kadar tuttu?`,
  aciklama: description,
  ...(guncelleme ? { sayfaEk: { dateModified: guncelleme } } : {}),
  ekler: [
    {
      '@type': 'Dataset',
      name: 'TCMB Enflasyon Raporu tahminleri, Piyasa Katılımcıları Anketi beklentileri ve PPK metin tonu: gerçekleşenle karşılaştırma',
      description:
        'TCMB Enflasyon Raporları’ndaki yıl sonu enflasyon tahminleri, tahmin aralıkları ve ara hedefler; Piyasa Katılımcıları Anketi’nde 12 ay sonrası enflasyon beklentisi ve 12 ay sonra gerçekleşen yıllık TÜFE; PPK metinlerinin yapay zekâyla okunan tonu ve bir sonraki PPK kararı.',
      url: 'https://finfolis.com/veri/tcmb-karnesi/',
      isAccessibleForFree: true,
      creator: { '@type': 'GovernmentOrganization', name: 'Türkiye Cumhuriyet Merkez Bankası', url: 'https://www.tcmb.gov.tr/' },
      ...(raporlar.length ? { temporalCoverage: `${raporlar[0].tarih}/${raporlar.at(-1)?.tarih}` } : {}),
      ...(guncelleme ? { dateModified: guncelleme } : {}),
      variableMeasured: ['Yıl sonu enflasyon tahmini (%)', 'Tahmin aralığı (%)', 'Ara hedef (%)', '12 ay sonrası yıllık TÜFE beklentisi (%)', 'Gerçekleşen yıllık TÜFE (%)', 'PPK metin tonu (−3 ile +3)'],
    },
  ],
});
---

<Base title={`${baslik}: TCMB tahminleri ne kadar tuttu?`} description={description} noindex={!raporlar.length && !esler.length}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-sayfa karne">
    <Breadcrumb yol={yol} />
    <header class="sayfa-bas sayfa-bas-duz">
      <h1>{baslik}</h1>
      <p>TCMB tahminleri ne kadar tuttu?</p>
    </header>

    <p class="veri-notu karne-giris">
      Bu sayfa TCMB’nin Enflasyon Raporu tahminlerini, Piyasa Katılımcıları Anketi’ndeki beklentileri ve PPK metinlerinin tonunu sonradan
      gerçekleşenle karşılaştırır. Tahmin bir taahhüt değildir; tahmin aralıkları da belirsizliği göstermek için yayımlanır. Fark ve sapma her
      yerde <strong>gerçekleşen − tahmin</strong> olarak alınır: artı değer, gerçekleşenin tahminden yüksek çıktığı anlamına gelir. Rakamlar
      TCMB ve TÜİK verisinden hesaplanır; sayfada elle yazılmış rakam yoktur.
    </p>

    <nav class="karne-ici" aria-label="Bu sayfada">
      <a href="#er">1. Enflasyon Raporu</a>
      <a href="#pka">2. Piyasa Katılımcıları Anketi</a>
      <a href="#ton">3. PPK metin tonu</a>
    </nav>

    <!-- 1) Enflasyon Raporu ------------------------------------------------------------------------------------ -->
    <section class="bolum" id="er">
      <h2 class="bolum-baslik">1. Enflasyon Raporu: tahminler, ara hedefler ve gerçekleşen</h2>
      {
        raporlar.length ? (
          <>
            <p class="karne-aciklama">
              TCMB her Enflasyon Raporu’nda yıl sonu enflasyon tahminini yayımlar. Aşağıda {raporlar[0].donem} ile {raporlar.at(-1)?.donem} arasındaki {raporlar.length} rapor var.
              Her raporun “Orta Vadeli Öngörüler” bölümündeki yıl sonu tahmini, yüzde 70 olasılıklı tahmin aralığı ve (2025-III’ten itibaren) ara hedefler, o yılın Aralık
              ayı yıllık TÜFE’siyle karşılaştırılır.
            </p>

            {ozetSatirlari.length > 0 && (
              <dl class="veri-rakamlar">
                {ozetSatirlari.map((o) => (
                  <div>
                    <dt>{o.yil} yıl sonu</dt>
                    <dd>{yuzde(o.gerceklesen)}</dd>
                    <dd class="veri-degisim">
                      {o.ilk && <>Yıl içindeki ilk rapor ({o.ilk.donem}): orta tahmin {yuzde(o.ilk.orta)}, fark {isaretli(o.ilk.fark)} puan.<br /></>}
                      {o.son && o.son !== o.ilk && <>Yılın son raporu ({o.son.donem}): {yuzde(o.son.orta)}, fark {isaretli(o.son.fark)} puan.</>}
                    </dd>
                  </div>
                ))}
              </dl>
            )}

            <div class="karne-grafikler">
              {grafikler.map((g) => (
                <figure class="karne-sekil">
                  <figcaption class="karne-sekil-bas">
                    {g.yil} yıl sonu
                    <span>{g.gerceklesen != null ? `gerçekleşen ${yuzde(g.gerceklesen)}` : 'gerçekleşme bekleniyor'}</span>
                  </figcaption>
                  <svg viewBox={`0 0 ${G.w} ${G.h}`} role="img" aria-label={g.etiket}>
                    {g.izgara.map((t) => (
                      <>
                        <line class="izgara" x1={G.sol} x2={G.w - G.sag} y1={t.y} y2={t.y} />
                        <text class="eksen" x={G.sol - 6} y={t.y + 4} text-anchor="end">{t.etiket}</text>
                      </>
                    ))}
                    {g.gy != null && <line class="gercek" x1={G.sol} x2={G.w - G.sag} y1={g.gy} y2={g.gy} />}
                    {g.noktalar.map((n) => (
                      <>
                        {n.alt != null && n.ust != null && (
                          <>
                            <line class="aralik" x1={n.x} x2={n.x} y1={n.ust} y2={n.alt} />
                            <line class="aralik" x1={n.x - 4} x2={n.x + 4} y1={n.ust} y2={n.ust} />
                            <line class="aralik" x1={n.x - 4} x2={n.x + 4} y1={n.alt} y2={n.alt} />
                          </>
                        )}
                        {n.ara != null && <rect class="ara" x={n.x - 4.5} y={n.ara - 4.5} width="9" height="9" />}
                        {n.orta != null && <circle class={n.ortaIsaret ? 'orta bos' : 'orta'} cx={n.x} cy={n.orta} r="4.5" />}
                        <text class="eksen" x={n.x} y={G.h - G.alt + 18} text-anchor="middle">{n.roma}</text>
                        {n.yilBasi && <text class="eksen yil" x={n.x} y={G.h - G.alt + 34} text-anchor="middle">{n.yil}</text>}
                      </>
                    ))}
                  </svg>
                  <p class="karne-lejant">
                    <span class="lj orta-lj">●</span> orta tahmin
                    {g.aralikVar && <><span class="lj aralik-lj">┃</span> %70 aralığı</>}
                    {g.araVar && <><span class="lj ara-lj">■</span> ara hedef</>}
                    {g.gerceklesen != null && <><span class="lj gercek-lj">━</span> gerçekleşen</>}
                    <br />Yatay eksen: raporun yayım dönemi.{g.isaretVar && ' Boş daire: raporda orta nokta yazılmamış, aralığın ortasıdır.'}
                  </p>
                </figure>
              ))}
            </div>

            {karne.map((y) => (
              <div class="karne-yil" id={`er-${y.yil}`}>
                <h3>
                  {y.yil} yıl sonu{' '}
                  <small>
                    {y.gerceklesen != null
                      ? `gerçekleşen ${yuzde(y.gerceklesen)}`
                      : y.sonVeri
                        ? `gerçekleşme bekleniyor (son veri: ${ayYaz(y.sonVeri.yil, y.sonVeri.ay)} yıllık ${yuzde(y.sonVeri.yillik)})`
                        : 'gerçekleşme bekleniyor'}
                  </small>
                </h3>
                <div class="tablo-kaydir">
                  <table class="cizelge veri-tablo karne-tablo">
                    <thead>
                      <tr>
                        <th scope="col">Rapor</th>
                        <th scope="col">Ne kadar önce</th>
                        <th scope="col" class="sag">Tahmin (orta)</th>
                        <th scope="col" class="sag">Aralık (%70)</th>
                        <th scope="col" class="sag">Ara hedef</th>
                        <th scope="col" class="sag">Fark (puan)</th>
                        <th scope="col">Aralığa göre</th>
                      </tr>
                    </thead>
                    <tbody>
                      {y.satirlar.map((s) => (
                        <tr>
                          <th scope="row">
                            <a href={s.url} rel="noopener">{s.donem}</a> <small>{gunYaz(s.tarih)}</small>
                          </th>
                          <td>{UFUK[s.ufuk] ?? `${s.ufuk} yıl önce`}</td>
                          <td class="sag">
                            {s.orta != null ? yuzde(s.orta) : '–'}
                            {s.ortaTuru === 'aralik-ortasi' && <sup title="Rapor yalnız aralığı yazmış; orta değer aralığın ortasıdır"> †</sup>}
                          </td>
                          <td class="sag">{s.alt != null ? `${yuzde(s.alt)} – ${yuzde(s.ust)}` : '–'}</td>
                          <td class="sag">{s.araHedef != null ? yuzde(s.araHedef) : '–'}</td>
                          <td class="sag">{y.gerceklesen != null ? isaretli(s.fark) : 'bekleniyor'}</td>
                          <td>{s.aralikta ? ARALIKTA[s.aralikta] : y.gerceklesen != null ? '–' : 'bekleniyor'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}

            <p class="veri-notu">
              <strong>Yöntem.</strong> Tahminler her Enflasyon Raporu’nun 3.2 “Orta Vadeli Görünüm” paragrafından metin olarak okunur; kaynak rapor sayfası tablodaki rapor adından açılır.
              Gerçekleşen, o yılın Aralık ayı yıllık TÜFE’sidir (TÜİK, TCMB tablosundan). † işaretli satırlarda rapor yalnız aralığı yazmıştır (2025-III, 2025-IV, 2026-I);
              orta değer aralığın ortası olarak hesaplanır, raporda yazılı bir orta nokta değildir. Ara hedefler TCMB’nin 2025-III’te tanımladığı, yıl sonu odaklı hedeflerdir;
              “Fark” sütunu orta tahmine göredir. TCMB, 2026-II Raporu’ndan itibaren belirsizlik nedeniyle tahmin aralığı paylaşımına ara verdiğini yazmıştır; bu raporlarda aralık sütunu boştur.
              2023-I ve 2023-II raporlarında 2025 için yazılan %5, orta vadeli enflasyon hedefidir. Aralığı olmayan sonraki yıl rakamları (ör. “tek haneli seviye”) yalnız metinde sayı verilmişse alınır.
              {basarisiz.length
                ? ` Tahmini çıkarılamayan raporlar: ${basarisiz.map((b) => b.donem).join(', ')}.`
                : ` ${raporlar.length} rapordan tahmin çıkarıldı; çıkarılamayan rapor yok.`}
            </p>
            <p class="veri-notu veri-kaynak">
              <strong>Kaynak:</strong> <a href={erUrl} rel="noopener">TCMB Enflasyon Raporları</a>; gerçekleşen için <a href={RESMI.enflasyon?.kaynak.url} rel="noopener">{RESMI.enflasyon?.kaynak.ad}</a>.
              Rapor verisi siteye alındığı zaman: {(erVerisi as { alinma?: string }).alinma ? zamanYaz((erVerisi as { alinma: string }).alinma) : '–'}.
            </p>
          </>
        ) : (
          <p class="bos">Enflasyon Raporu tahmin verisi şu anda yok.</p>
        )
      }
    </section>

    <!-- 2) Piyasa Katılımcıları Anketi -------------------------------------------------------------------------- -->
    <section class="bolum" id="pka">
      <h2 class="bolum-baslik">2. Piyasa Katılımcıları Anketi: 12 ay sonrası beklenti ve gerçekleşen</h2>
      {
        esler.length ? (
          <>
            <p class="karne-aciklama">
              TCMB her ay Piyasa Katılımcıları Anketi’nde 12 ay sonrası yıllık enflasyon beklentisini yayımlar. Aşağıda her anketin beklentisi, 12 ay sonrasına,
              yani beklentinin hedeflediği aya kaydırılmıştır; böylece beklenti çizgisi ile gerçekleşen yıllık TÜFE aynı ayda karşılaşır. Beklenti çizgisinin son 12 ayı,
              henüz gerçekleşmemiş güncel beklentilerdir.
            </p>

            <ZamanGrafik
              baslik="12 ay önce beklenen ve gerçekleşen yıllık enflasyon"
              ipucu="Yüzde, yıllık TÜFE; beklenti 12 ay ileri kaydırılmış"
              kaynak="Kaynak: TCMB Piyasa Katılımcıları Anketi, TÜİK yıllık TÜFE."
              siklik="ay"
              birim="yuzde"
              seriIdleri={['beklenti', 'gercek']}
              noktalar={pkaNoktalari}
              gruplar={[
                {
                  id: 'hepsi',
                  ad: 'Hepsi',
                  seriler: [
                    { id: 'beklenti', ad: '12 ay önceki anketin beklentisi', renk: 'toprak', kesik: true },
                    { id: 'gercek', ad: 'Gerçekleşen yıllık TÜFE', renk: 'murekkep' },
                  ],
                },
              ]}
              sifirdan
            />

            <dl class="veri-rakamlar">
              <div>
                <dt>Tüm eşleşmeler</dt>
                <dd>{isaretli(pka.tumu.ortSapma)}<small> puan</small></dd>
                <dd class="veri-degisim">
                  Ortalama sapma; ortalama mutlak sapma {yz(pka.tumu.ortMutlak)} puan. {pka.tumu.n} anket,
                  {pka.tumu.ilk && pka.tumu.son && <> {ayYaz(pka.tumu.ilk.yil, pka.tumu.ilk.ay)} – {ayYaz(pka.tumu.son.yil, pka.tumu.son.ay)}</>}.
                </dd>
              </div>
              <div>
                <dt>Son 24 ay</dt>
                <dd>{isaretli(pka.son.ortSapma)}<small> puan</small></dd>
                <dd class="veri-degisim">
                  Ortalama sapma; ortalama mutlak sapma {yz(pka.son.ortMutlak)} puan. {pka.son.n} anket,
                  {pka.son.ilk && pka.son.son && <> {ayYaz(pka.son.ilk.yil, pka.son.ilk.ay)} – {ayYaz(pka.son.son.yil, pka.son.son.ay)}</>}.
                </dd>
              </div>
              {sonEs && (
                <div>
                  <dt>En son eşleşen anket</dt>
                  <dd class="veri-tarih">{ayYaz(sonEs.anketYil, sonEs.anketAy)}</dd>
                  <dd class="veri-degisim">
                    Beklenti {yuzde(sonEs.beklenti)}, {ayYaz(sonEs.hedefYil, sonEs.hedefAy)} yıllık enflasyonu {yuzde(sonEs.gerceklesen)}; sapma {isaretli(sonEs.sapma)} puan.
                  </dd>
                </div>
              )}
            </dl>

            <h3 class="karne-alt-baslik">Anketin yapıldığı yıla göre</h3>
            <div class="tablo-kaydir">
              <table class="cizelge veri-tablo karne-tablo">
                <thead>
                  <tr>
                    <th scope="col">Anket yılı</th>
                    <th scope="col" class="sag">Eşleşen anket</th>
                    <th scope="col" class="sag">Ortalama sapma (puan)</th>
                    <th scope="col" class="sag">Ortalama mutlak sapma (puan)</th>
                  </tr>
                </thead>
                <tbody>
                  {pkaYil.map((y) => (
                    <tr>
                      <th scope="row">{y.yil}</th>
                      <td class="sag">{y.n}</td>
                      <td class="sag">{isaretli(y.ortSapma)}</td>
                      <td class="sag">{yz(y.ortMutlak)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="veri-notu">
              <strong>Yöntem.</strong> Anket ayı t’deki “12 ay sonrası yıllık TÜFE beklentisi”, t+12 ayında açıklanan yıllık TÜFE ile eşlenir (örneğin Ekim 2024 anketi, Ekim 2025 yıllık
              enflasyonuyla). Sapma = gerçekleşen − beklenti; artı değer, gerçekleşenin beklentiden yüksek çıktığını gösterir. Ortalama sapma işaretlidir, yüksek ve düşük sapmalar birbirini götürür;
              ortalama mutlak sapma yönü yok sayar. “Son 24 ay”, t+12 verisi açıklanmış son 24 ankettir. t+12 verisi henüz açıklanmamış {anketSayisi - esler.length} anket hesaba girmez.
              Ortalamalar enflasyonun sert hızlandığı ya da yavaşladığı dönemlerden güçlü etkilenir; bu yüzden yıla göre tablo da verilmiştir.
            </p>
            <p class="veri-notu veri-kaynak">
              <strong>Kaynak:</strong> <a href={RESMI.beklenti?.kaynak.url} rel="noopener">{RESMI.beklenti?.kaynak.ad}</a>; gerçekleşen için <a href={RESMI.enflasyon?.kaynak.url} rel="noopener">{RESMI.enflasyon?.kaynak.ad}</a>.
              Ayrıntılı seri: <a href="/veri/enflasyon-beklentisi/">Enflasyon beklentisi</a>.
            </p>
          </>
        ) : (
          <p class="bos">Piyasa Katılımcıları Anketi karşılaştırması için yeterli veri yok.</p>
        )
      }
    </section>

    <!-- 3) İletişim karnesi ---------------------------------------------------------------------------------------- -->
    <section class="bolum" id="ton">
      <h2 class="bolum-baslik">3. İletişim karnesi: PPK metin tonu sonraki kararı ne kadar gösterdi?</h2>
      {
        ton.n > 0 ? (
          <>
            <p class="karne-aciklama">
              Her PPK toplantısının karar metni ve toplantı özeti <a href="/veri/ppk-tonu/">yapay zekâyla okunur</a>; “ileri yön” puanı −3 (güvercin, gevşeme işareti) ile +3 (şahin, sıkılaştırma işareti)
              arasındadır. Aşağıda bu puan, <strong>bir sonraki PPK toplantısında</strong> alınan faiz kararıyla karşılaştırılır. Puanlar bir yapay zekâ okumasıdır; TCMB’nin ya da bir
              uzmanın değerlendirmesi değildir.
            </p>

            <dl class="veri-rakamlar">
              <div>
                <dt>Ton kuralı isabeti</dt>
                <dd>{ton.tonIsabet}<small> / {ton.n} ({yuzdeOran(ton.tonIsabet, ton.n)})</small></dd>
                <dd class="veri-degisim">Ton ≤ −0,75 iken sonraki karar indirim, ≥ +0,75 iken artırım ya da sabit, arada sabit.</dd>
              </div>
              <div>
                <dt>Taban kural isabeti</dt>
                <dd>{ton.tabanIsabet}<small> / {ton.n} ({yuzdeOran(ton.tabanIsabet, ton.n)})</small></dd>
                <dd class="veri-degisim">“Bir sonraki karar, bu toplantının kararıyla aynı yönde olur.” Metin okumaz.</dd>
              </div>
              <div>
                <dt>Yön değişen geçişler</dt>
                <dd>{ton.degisim.tonIsabet}<small> / {ton.degisim.n}</small></dd>
                <dd class="veri-degisim">Sonraki kararın bu toplantıdan farklı olduğu geçişlerde ton kuralının doğru çıktığı sayı. Taban kural bu geçişlerin hiçbirini yakalamaz.</dd>
              </div>
            </dl>

            <div class="tablo-kaydir">
              <table class="cizelge veri-tablo karne-tablo karne-sinif">
                <thead>
                  <tr>
                    <th scope="col">Ton sınıfı</th>
                    <th scope="col" class="sag">Döngü</th>
                    <th scope="col" class="sag">Ton kuralı isabeti</th>
                  </tr>
                </thead>
                <tbody>
                  {(['guvercin', 'dengeli', 'sahin'] as const).map((k) => (
                    <tr>
                      <th scope="row">{SINIF[k]}</th>
                      <td class="sag">{ton.siniflar[k].n}</td>
                      <td class="sag">{ton.siniflar[k].isabet} / {ton.siniflar[k].n}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <h3 class="karne-alt-baslik">Toplantı toplantı</h3>
            <div class="tablo-kaydir">
              <table class="cizelge veri-tablo veri-tablo-genis karne-tablo">
                <thead>
                  <tr>
                    <th scope="col">Toplantı</th>
                    <th scope="col" class="sag">İleri yön puanı</th>
                    <th scope="col">Ton</th>
                    <th scope="col">Bu toplantının kararı</th>
                    <th scope="col">Sonraki karar</th>
                    <th scope="col">Ton kuralı</th>
                    <th scope="col">Taban kural</th>
                  </tr>
                </thead>
                <tbody>
                  {tonSatirlari.map((s) => (
                    <tr>
                      <th scope="row">{gunYaz(s.toplanti)}</th>
                      <td class="sag">{isaretli(s.ton)}</td>
                      <td>{tonAdi(s.ton)}</td>
                      <td>{s.bugun ? KARAR[s.bugun] : '–'}</td>
                      <td>
                        {s.sonraki ? KARAR[s.sonraki] : 'bekleniyor'}
                        {s.sonrakiToplanti && <small> ({gunYaz(s.sonrakiToplanti)})</small>}
                      </td>
                      <td>{s.olculur ? evetHayir(s.tonIsabet) : '–'}</td>
                      <td>{s.olculur ? evetHayir(s.tabanIsabet) : '–'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <p class="veri-notu">
              <strong>Nasıl okunmalı.</strong> Ölçülen {ton.n} geçiş {tonIlk && gunYaz(tonIlk)} ile {tonSonOlculen && gunYaz(tonSonOlculen.sonrakiToplanti as string)} arasındaki dönemi kapsar; bu az gözlemdir ve
              oranlar birkaç toplantıyla değişir. Dönem tek bir para politikası rejimi değildir: art arda artırımlar ({kararSayilari.artis} sonraki karar artırım), uzun sabit dönemler ({kararSayilari.sabit} sabit) ve indirimler
              ({kararSayilari.indirim} indirim) dönem dönem birbirini izlemiştir. Karar yönü çoğu zaman bir öncekini tekrar ettiği için taban kural yüksek çıkar. Ton kuralının “şahin” sınıfında artırım ve sabit
              birlikte isabet sayıldığından bu sınıf geniştir; yön değişen geçişlerdeki sonuç bu yüzden ayrıca verilmiştir. Puanlar karar metnini de içeren metinlerden üretilir, yani ton kısmen bugünkü kararı da yansıtır.
              İki kuralın isabeti arasındaki fark {ton.tonIsabet - ton.tabanIsabet} toplantıdır; bu kadar az gözlemle bir üstünlük sonucu çıkarılamaz. Bu tablo bir tahmin yöntemi önermez, yalnız metinlerin sonraki karara göre nasıl durduğunu gösterir.
              {ton.sonrakiYok.length > 0 && ` ${ton.sonrakiYok.map((t) => gunYaz(t)).join(', ')} toplantısının sonraki kararı henüz yok, ölçüme girmez.`}
              {' '}Karar yönü, PPK karar metnindeki politika faizi cümlesinden okunur.
            </p>
            <p class="veri-notu veri-kaynak">
              <strong>Kaynak:</strong> <a href="https://www.tcmb.gov.tr/wps/wcm/connect/TR/TCMB+TR/Main+Menu/Duyurular/Basin" rel="noopener">TCMB basın duyuruları</a> (PPK karar metni ve toplantı özeti); puanlar finfolis’in yapay zekâ okumasıdır. Ayrıntı: <a href="/veri/ppk-tonu/">PPK metin tonu</a>,
              <a href="/veri/politika-faizi/">Politika faizi</a>.
            </p>
          </>
        ) : (
          <p class="bos">PPK ton karnesi için yeterli veri yok.</p>
        )
      }
    </section>

    <YasalUyari>Bu sayfadaki karşılaştırmalar bilgi amaçlıdır; geçmiş tahminlerin tutma durumu gelecek için bir gösterge değildir ve yatırım tavsiyesi değildir.</YasalUyari>
  </div>
</Base>

