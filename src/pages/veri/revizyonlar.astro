---
// Veri revizyonları: resmi kurumların daha önce yayımladığı bir dönemin rakamını sonradan değiştirdiği durumlar.
// Kayıtlar scripts/veri/revizyon.mjs ile önceki alınan veriyle karşılaştırılarak çıkarılır (src/data/revizyonlar.json).
import Base from '../../layouts/Base.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { gunYaz } from '../../lib/resmi';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';
import { alanAdi, degerMetni, donemMetni, farkMetni } from '../../lib/revizyon.mjs';
import veri from '../../data/revizyonlar.json';

const kayitlar = (veri.revizyonlar ?? []) as Array<{
  bolum: string;
  alan: string;
  donem: string;
  eski: number;
  yeni: number;
  fark: number;
  tespit: string;
  kaynak: { ad: string; url: string } | null;
}>;
const baslik = 'Veri revizyonları';
const description =
  'TÜİK ve TCMB’nin daha önce yayımladığı bir dönemin rakamını sonradan değiştirdiği durumlar: tespit tarihi, gösterge, dönem, eski ve yeni değer.';
const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: 'Veri revizyonları', href: '/veri/revizyonlar/' },
];
const jsonLd = sayfaSemasi({ yol, ad: `${baslik} (TÜİK ve TCMB)`, aciklama: description });
const tespitGunu = (iso: string) => iso.slice(0, 10);
---

<Base title={`${baslik}: TÜİK ve TCMB rakam düzeltmeleri`} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-sayfa">
    <Breadcrumb yol={yol} />
    <header class="sayfa-bas sayfa-bas-duz">
      <h1>{baslik}</h1>
      <p>TÜİK ve TCMB verilerinde sonradan değişen rakamlar</p>
    </header>

    <div class="veri-izgara">
      <section class="bolum">
        <h2 class="bolum-baslik">Son revizyonlar</h2>
        {
          kayitlar.length > 0 ? (
            <>
              <table class="cizelge veri-tablo">
                <thead>
                  <tr>
                    <th scope="col">Tespit</th>
                    <th scope="col">Gösterge</th>
                    <th scope="col">Dönem</th>
                    <th scope="col" class="sag">Eski</th>
                    <th scope="col" class="sag">Yeni</th>
                    <th scope="col" class="sag">Fark</th>
                  </tr>
                </thead>
                <tbody>
                  {kayitlar.map((r) => (
                    <tr>
                      <td>{gunYaz(tespitGunu(r.tespit))}</td>
                      <td>
                        {r.kaynak?.url ? (
                          <a href={r.kaynak.url} rel="noopener">{alanAdi(r.bolum, r.alan)}</a>
                        ) : (
                          alanAdi(r.bolum, r.alan)
                        )}
                      </td>
                      <td>{donemMetni(r.donem)}</td>
                      <td class="sag">{degerMetni(r.bolum, r.alan, r.eski)}</td>
                      <td class="sag">{degerMetni(r.bolum, r.alan, r.yeni)}</td>
                      <td class="sag">{farkMetni(r.bolum, r.alan, r.fark)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="veri-notu">
                Liste, sitenin kurumlardan aldığı verilerin bir öncekiyle karşılaştırılmasından çıkar. Tespit tarihi, değişikliğin siteye
                alındığı gündür; kurumun değişikliği yayımladığı gün farklı olabilir. Yuvarlama düzeyindeki küçük farklar listeye alınmaz;
                bir serinin tüm geçmişinin birden yeniden hesaplandığı durumlar (taban yılı değişikliği gibi) tek tek listelenmez.
              </p>
            </>
          ) : (
            <p class="bos">
              Şu ana kadar izlenen göstergelerde bir revizyon tespit edilmedi. Bir kurum geçmiş bir dönemin rakamını değiştirirse bu
              sayfada görünür.
            </p>
          )
        }
      </section>

      <section class="bolum prose veri-aciklama">
        <h2 class="bolum-baslik">Revizyon nedir, neden olur?</h2>
        <p>
          Revizyon, bir kurumun daha önce yayımladığı bir dönemin rakamını sonradan değiştirmesidir. Resmi istatistik kurumlarının
          olağan uygulamasıdır ve kimsenin bir hata yaptığı anlamına gelmez.
        </p>
        <p>
          Nedenleri genellikle şunlardır: ilk yayında eksik olan anket ve idari kayıtların sonradan tamamlanması, mevsimsellikten
          arındırma yöntemiyle her yeni gözlemde geçmiş değerlerin yeniden hesaplanması, kaynak verinin güncellenmesi ve yöntem ya da
          taban yılı değişiklikleri. Ödemeler dengesi, dış ticaret ve büyüme gibi serilerde revizyon daha sık görülür.
        </p>
        <p>
          Bu sayfa yalnızca iki yayın arasında rakamın ne olduğunu gösterir; nedenini açıklamaz. Gerekçe için kurumların kendi
          yöntem notlarına bakmak gerekir.
        </p>
        <p>
          <a href="/veri/takvim/">Veri yayın takvimi</a> · <a href="/veri/enflasyon/">Enflasyon verileri</a> ·
          <a href="/veri/cari-denge/">Cari denge</a> · <a href="/veri/issizlik-orani/">İşsizlik oranı</a>
        </p>
      </section>
    </div>
    <YasalUyari>Bu sayfadaki veriler bilgi amaçlıdır ve TÜİK ile TCMB’nin yayımladığı resmi rakamlardır.</YasalUyari>
  </div>
</Base>
