---
// Söylem vs. Gerçeklik Radarı (Resmi Metin / Veri Çapraz Denetimi)
// Resmi kurum beyanatları ve OVP hedefleri ile fiili ham EVDS/TÜİK verilerini satır satır karşılaştırır
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DogrudanYanit from '../../components/DogrudanYanit.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import { RESMI } from '../../lib/resmi';
import { soylemKarsilastir } from '../../lib/soylem-gerceklik.mjs';
import { sayfaSemasi } from '../../lib/seo';

const baslik = 'Söylem vs. Gerçeklik Radarı';
const aciklama = 'TCMB sunumları, OVP hedefleri ve bakanlık taahhütlerinin fiili TÜİK ve EVDS verileriyle satır satır çapraz karşılaştırması.';

const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: 'Söylem vs. Gerçeklik', href: '/veri/soylem-gerceklik/' },
];

const sonuclar = soylemKarsilastir(RESMI);

const jsonLd = sayfaSemasi({
  yol,
  ad: baslik,
  aciklama
});
---

<Base baslik={baslik} aciklama={aciklama} jsonLd={jsonLd}>
  <div class="soylem-sayfasi">
    <Breadcrumb yol={yol} />

    <header class="sayfa-baslik">
      <div class="etiket-satir">
        <span class="etiket">Çapraz Denetim</span>
        <span class="etiket vurgu">Veri Kanıtı</span>
      </div>
      <h1>Söylem vs. Gerçeklik Radarı</h1>
      <p class="ozet">
        Ekonomi yönetiminin resmi programlarında (OVP), TCMB Enflasyon Raporu sunumlarında ve bakanlık açıklamalarında
        yer alan somut hedeflerin gerçekleşen resmi istatistiklerle (TÜİK, EVDS, Hazine) birebir karşılaştırması.
      </p>
    </header>

    <DogrudanYanit
      baslik="Söylem vs. Gerçeklik Radarı Nasıl Çalışır?"
      ozet="Ekonomi kamuoyundaki sübjektif yorumları ve manipülatif söylemleri ayıklamak amacıyla birincil resmi belgelerden somut sayısal taahhütler taranır. Bu taahhütler, dönemi kapandığında TÜİK ve TCMB resmi veri serileriyle satır satır eşleştirilir."
      maddeler={[
        'Birincil Belge Zorunluluğu: Yalnızca Resmî Gazete\'de yayımlanan OVP, TCMB Enflasyon Raporu ve Bütçe Kanunu metinleri taranır.',
        'Nesnel Karşılaştırma: Yorum yapılmaz; hedeflenen rakam, gerçekleşen rakam ve aradaki net sapma puanı gösterilir.',
        'Kanıt Takibi: Her maddenin altında EVDS seri kodu ve resmi belge referansı yer alır.'
      ]}
    />

    <section class="karsilastirma-alani">
      <h2>Resmi Taahhütler ve Gerçekleşme Karnesi</h2>

      <div class="kart-listesi">
        {sonuclar.map((s) => (
          <article class={`soylem-kart ${s.durum}`}>
            <div class="kart-ust">
              <div class="kurum-bilgi">
                <span class="kurum-adi">{s.kurum}</span>
                <span class="belge-adi">{s.belge} ({s.tarih})</span>
              </div>
              <div class="durum-rozet-sarmal">
                {s.durum === 'dogrulandi' && <span class="rozet dogrulandi">Hedef Tutarlı</span>}
                {s.durum === 'sapma_var' && <span class="rozet sapma">Sapma Var</span>}
                {s.durum === 'ciddi_sapma' && <span class="rozet ciddi">Ciddi Uyumsuzluk</span>}
                {s.durum === 'bekleniyor' && <span class="rozet beklemede">Dönem Devam Ediyor</span>}
              </div>
            </div>

            <blockquote class="alinti-metni">
              &ldquo;{s.soylemMetni}&rdquo;
            </blockquote>

            <div class="kiyas-tablosu">
              <div class="kiyas-hucre">
                <span class="k-etiket">Resmi Hedef / Söylem</span>
                <strong class="k-deger">{s.soylemHedef > 0 ? '%' : ''}{s.soylemHedef}{s.soylemHedef <= 0 ? ' %' : ''}</strong>
              </div>
              <div class="kiyas-hucre">
                <span class="k-etiket">Fiili Gerçekleşme ({s.gosterge})</span>
                <strong class="k-deger gercek">{s.gerceklesen !== null ? (s.gerceklesen > 0 ? '%' : '') + s.gerceklesen + (s.gerceklesen <= 0 ? ' %' : '') : 'Açıklanmadı'}</strong>
              </div>
              <div class="kiyas-hucre">
                <span class="k-etiket">Net Hedef Sapması</span>
                <strong class={`k-deger ${s.sapma && s.sapma > 0 ? 'eksi-sapma' : 'arti-sapma'}`}>
                  {s.sapma !== null ? (s.sapma > 0 ? '+' : '') + s.sapma + ' puan' : '–'}
                </strong>
              </div>
            </div>

            <div class="kart-alt">
              <span class="seri-kod">Resmi Seri: <code>{s.evdsSeri}</code></span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="metodoloji-notu">
      <h2>İlkeler ve Tarafsızlık Güvencesi</h2>
      <p>
        Söylem vs. Gerçeklik Radarı herhangi bir siyasi görüş ya da piyasa pozisyonu gütmez. 
        Amacımız, ekonomi politikasında kurumsal hesap verebilirliği ve tahmin tutarlılığını 
        kamusal veriler aracılığıyla okurun doğrudan denetlemesine sunmaktır.
      </p>
    </section>

    <YasalUyari />
  </div>
</Base>

<style>
  .soylem-sayfasi {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .sayfa-baslik {
    margin: 1.5rem 0 2rem;
  }

  .etiket-satir {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .etiket {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: #f1f5f9;
    color: #475569;
  }

  .etiket.vurgu {
    background: #eff6ff;
    color: #1d4ed8;
  }

  .sayfa-baslik h1 {
    font-size: 2rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .sayfa-baslik .ozet {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }

  .karsilastirma-alani {
    margin: 2.5rem 0;
  }

  .karsilastirma-alani h2 {
    font-size: 1.375rem;
    font-weight: 700;
    margin: 0 0 1.25rem;
    color: #0f172a;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 0.5rem;
  }

  .kart-listesi {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .soylem-kart {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
  }

  .soylem-kart.dogrulandi {
    border-left: 4px solid #10b981;
  }

  .soylem-kart.sapma_var {
    border-left: 4px solid #f59e0b;
  }

  .soylem-kart.ciddi_sapma {
    border-left: 4px solid #ef4444;
    background: #fffcfc;
  }

  .kart-ust {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }

  .kurum-bilgi {
    display: flex;
    flex-direction: column;
  }

  .kurum-adi {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #2563eb;
  }

  .belge-adi {
    font-size: 0.75rem;
    color: #64748b;
    margin-top: 0.125rem;
  }

  .rozet {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .rozet.dogrulandi {
    background: #dcfce7;
    color: #15803d;
  }

  .rozet.sapma {
    background: #fef3c7;
    color: #b45309;
  }

  .rozet.ciddi {
    background: #fee2e2;
    color: #b91c1c;
  }

  .rozet.beklemede {
    background: #f1f5f9;
    color: #475569;
  }

  .alinti-metni {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    background: #f8fafc;
    border-left: 3px solid #cbd5e1;
    font-style: italic;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: #334155;
  }

  .kiyas-tablosu {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 0.875rem 1rem;
  }

  .kiyas-hucre {
    display: flex;
    flex-direction: column;
  }

  .k-etiket {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    color: #64748b;
  }

  .k-deger {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin-top: 0.25rem;
  }

  .k-deger.gercek {
    color: #2563eb;
  }

  .k-deger.eksi-sapma {
    color: #b91c1c;
  }

  .k-deger.arti-sapma {
    color: #15803d;
  }

  .kart-alt {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: #64748b;
  }

  .seri-kod code {
    background: #f1f5f9;
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.75rem;
  }

  .metodoloji-notu {
    margin-top: 3.5rem;
    border-top: 1px solid #e2e8f0;
    padding-top: 1.5rem;
  }

  .metodoloji-notu h2 {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }

  .metodoloji-notu p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }
</style>
