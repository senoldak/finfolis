---
// Resmî yıl sonu enflasyon tahminleri (OVP, TCMB Enflasyon Raporu) ile gerçekleşen TÜFE. Veriler: src/lib/soylem-gerceklik.mjs.
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DogrudanYanit from '../../components/DogrudanYanit.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import { RESMI, ayAdi, sayiYaz } from '../../lib/resmi';
import { TAHMINLER, TUR_ADLARI, belgeler, tahminKarsilastir } from '../../lib/soylem-gerceklik.mjs';
import { sayfaSemasi } from '../../lib/seo';

const baslik = 'Resmî enflasyon tahminleri ve gerçekleşen TÜFE';
const aciklama =
  "Orta Vadeli Program ve TCMB Enflasyon Raporu'ndaki yıl sonu enflasyon tahminleri, TÜİK'in açıkladığı Aralık ayı yıllık TÜFE ile yan yana.";

const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: 'Enflasyon tahminleri', href: '/veri/soylem-gerceklik/' },
];

const yillar = tahminKarsilastir(RESMI);
const sonTufe = RESMI.enflasyon?.satirlar?.at(-1);
const yuzde = (n: number) => `%${sayiYaz(n, Number.isInteger(n) ? 0 : Number.isInteger(n * 10) ? 1 : 2)}`;
const farkYaz = (f: number) => `${f > 0 ? '+' : f < 0 ? '−' : ''}${sayiYaz(Math.abs(f), 2)} puan`;

const jsonLd = sayfaSemasi({ yol, ad: baslik, aciklama });
---

<Base baslik={baslik} aciklama={aciklama} jsonLd={jsonLd}>
  <div class="soylem-sayfasi">
    <Breadcrumb yol={yol} />

    <header class="sayfa-baslik">
      <div class="etiket-satir">
        <span class="etiket">Karşılaştırma</span>
        <span class="etiket vurgu">TÜİK ve resmî belgeler</span>
      </div>
      <h1>Resmî enflasyon tahminleri ve gerçekleşen TÜFE</h1>
      <p class="ozet">
        Orta Vadeli Program'da ve TCMB Enflasyon Raporu'nda yazan yıl sonu enflasyon tahminleri, TÜİK'in o yıl için
        açıkladığı Aralık ayı yıllık TÜFE ile aynı tabloda. Her satırda belgenin bağlantısı var.
      </p>
    </header>

    <DogrudanYanit
      baslik="Kısaca"
      ozet={`Tabloda ${TAHMINLER.length} tahmin var. Fark, gerçekleşen TÜFE'den tahminin çıkarılmasıyla bulunur ve yüzde puan olarak yazılır; artı işaret, enflasyonun tahminden yüksek çıktığını gösterir. Gerçekleşme tahmini, yıl bitmeden birkaç ay önce yapılan güncel tahmindir.`}
      kaynak="TÜİK (TCMB EVDS üzerinden); Strateji ve Bütçe Başkanlığı; TCMB"
    />

    <section class="karsilastirma-alani">
      <h2>Yıl yıl tahminler</h2>

      {yillar.map((y) => (
        <article class="yil-kart">
          <div class="yil-ust">
            <h3>{y.yil} yıl sonu</h3>
            {y.gerceklesen !== null ? (
              <p class="gerceklesen">
                Gerçekleşen TÜFE (TÜİK, Aralık {y.yil}): <strong>{yuzde(y.gerceklesen)}</strong>
              </p>
            ) : (
              <p class="gerceklesen">
                Aralık {y.yil} verisi henüz açıklanmadı.
                {sonTufe && sonTufe.yil === y.yil && <> Son açıklanan: {ayAdi(sonTufe)}, {yuzde(sonTufe.yillik)}.</>}
              </p>
            )}
          </div>
          <div class="tablo-sarmal">
            <table class="tahmin-tablo">
              <thead>
                <tr>
                  <th>Belge</th>
                  <th>Tür</th>
                  <th class="sayi">Değer</th>
                  <th class="sayi">Fark</th>
                </tr>
              </thead>
              <tbody>
                {y.tahminler.map((t) => (
                  <tr>
                    <td>
                      <a href={t.url} rel="noopener">{t.belge}</a>
                      <span class="donem">{t.donem}</span>
                    </td>
                    <td>{TUR_ADLARI[t.tur]}</td>
                    <td class="sayi">{yuzde(t.deger)}</td>
                    <td class="sayi">{t.fark === null ? '–' : farkYaz(t.fark)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </article>
      ))}
    </section>

    <section class="metodoloji-notu">
      <h2>Yöntem ve kaynaklar</h2>
      <p>
        Gerçekleşen değer, TÜİK'in Aralık ayı için açıkladığı yıllık TÜFE değişimidir; site bu seriyi TCMB EVDS'den
        (TP.FG.J0) alır. Tahminler belgelerden elle alındı. OVP 2026-2028'deki değerler programın Grafik 10'undan,
        TCMB'nin değeri raporun 2024 sonu tahmin aralığının orta noktasıdır. Değerler 26 Kasım 2026'da kontrol edildi.
      </p>
      <ul class="kaynak-liste">
        {belgeler().map((b) => (
          <li>
            {b.kurum}: <a href={b.url} rel="noopener">{b.belge}</a> ({b.donem})
          </li>
        ))}
      </ul>
    </section>

    <YasalUyari />
  </div>
</Base>

<style>
  .soylem-sayfasi {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  .sayfa-baslik {
    margin: 1.5rem 0 2rem;
  }
  .etiket-satir {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .etiket {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: #f1f5f9;
    color: #475569;
  }
  .etiket.vurgu {
    background: #eff6ff;
    color: #1d4ed8;
  }
  .sayfa-baslik h1 {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.25;
    color: #0f172a;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }
  .sayfa-baslik .ozet {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }
  .karsilastirma-alani {
    margin-top: 2.5rem;
  }
  .karsilastirma-alani h2,
  .metodoloji-notu h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1.25rem;
  }
  .yil-kart {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }
  .yil-ust h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.25rem;
  }
  .gerceklesen {
    font-size: 0.9375rem;
    color: #475569;
    margin: 0 0 1rem;
  }
  .gerceklesen strong {
    color: #0f172a;
    font-variant-numeric: tabular-nums;
  }
  .tablo-sarmal {
    overflow-x: auto;
  }
  .tahmin-tablo {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .tahmin-tablo th,
  .tahmin-tablo td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid #f1f5f9;
    text-align: left;
    vertical-align: top;
  }
  .tahmin-tablo th {
    background: #f8fafc;
    font-weight: 600;
    color: #334155;
    border-bottom: 2px solid #e2e8f0;
  }
  .tahmin-tablo .sayi {
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .tahmin-tablo tbody tr:last-child td {
    border-bottom: none;
  }
  .donem {
    display: block;
    font-size: 0.8125rem;
    color: #64748b;
  }
  .metodoloji-notu {
    margin-top: 3rem;
    border-top: 1px solid #e2e8f0;
    padding-top: 2rem;
  }
  .metodoloji-notu p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #475569;
  }
  .kaynak-liste {
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: #475569;
  }
  @media (max-width: 640px) {
    .sayfa-baslik h1 {
      font-size: 1.5rem;
    }
    .soylem-sayfasi {
      padding: 1.25rem 0.75rem 3rem;
    }
    .tahmin-tablo th,
    .tahmin-tablo td {
      padding: 0.5rem;
    }
  }
</style>
