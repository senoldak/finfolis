---
// PPK metin tonu: TCMB'nin PPK karar metinleri ve toplantı özetleri yapay zekâyla okunur; her metne "ileri yön" ve
// "mevcut duruş" puanı verilir (−3 güvercin … +3 şahin). Metinler src/data/ppk-metinler.json (TCMB'den), puanlar
// src/data/ppk-ton.json (scripts/veri/ppk-ton.mjs). Hesap ve istem src/lib/ppk-ton.mjs'te.
import Base from '../../layouts/Base.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ZamanGrafik from '../../components/ZamanGrafik.astro';
import metinVerisi from '../../data/ppk-metinler.json';
import tonVerisi from '../../data/ppk-ton.json';
import { belgeListesi, donguler, tonAdi } from '../../lib/ppk-ton.mjs';
import { gunYaz, zamanYaz } from '../../lib/resmi';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';

type Puan = { ileriYon: number; durus: number; gerekce: string; alintilar: string[]; okundu: string };
type Belge = { id: string; tur: string; tarih: string; baslik: string; url: string };
const belgeler = belgeListesi(metinVerisi).belgeler as Belge[];
const puanlar = ((tonVerisi as { puanlar?: Record<string, Puan> }).puanlar ?? {}) as Record<string, Puan>;
const dongu = donguler(belgeler, puanlar).filter((d) => d.ileriYon != null);
const son = dongu.at(-1);
const onceki = dongu.at(-2);
const ivme = son && onceki ? Math.round(((son.ileriYon as number) - (onceki.ileriYon as number)) * 100) / 100 : null;
const okunan = belgeler
  .filter((b) => puanlar[b.id])
  .sort((a, b) => b.tarih.localeCompare(a.tarih));
const bekleyen = belgeler.filter((b) => (b.tur === 'karar' || b.tur === 'ozet') && !puanlar[b.id]).length;
const isaret = (n: number | null | undefined) =>
  n == null ? '–' : `${n > 0 ? '+' : n < 0 ? '−' : ''}${Math.abs(n).toLocaleString('tr-TR', { maximumFractionDigits: 2 })}`;
const TUR: Record<string, string> = { karar: 'PPK kararı', ozet: 'Toplantı özeti' };
const gun = (iso: string) => Math.floor(Date.parse(`${iso}T00:00:00Z`) / 86_400_000);
const grafikNoktalari = dongu.map((d) => [gun(d.toplanti), d.ileriYon, d.durus]);
const guncelleme = (tonVerisi as { guncelleme?: string }).guncelleme ?? null;

const baslik = 'PPK metin tonu';
const description = son
  ? `TCMB PPK metinlerinin yapay zekâyla okunan tonu. ${gunYaz(son.toplanti)} toplantısının döngüsünde ileri yön ${isaret(son.ileriYon)} (${tonAdi(son.ileriYon)}), mevcut duruş ${isaret(son.durus)}.`
  : 'TCMB PPK karar metinleri ve toplantı özetlerinin yapay zekâyla okunan tonu.';
const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: baslik, href: '/veri/ppk-tonu/' },
];
const jsonLd = sayfaSemasi({ yol, ad: baslik, aciklama: description, ...(guncelleme ? { sayfaEk: { dateModified: guncelleme } } : {}) });
---

<Base title={`${baslik}: TCMB metinleri şahin mi güvercin mi?`} description={description} noindex={!son}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-sayfa">
    <Breadcrumb yol={yol} />
    <header class="sayfa-bas sayfa-bas-duz">
      <h1>{baslik}</h1>
      <p>TCMB Para Politikası Kurulu metinlerinin yapay zekâyla okunan yönü · −3 güvercin, +3 şahin</p>
    </header>
    {
      son ? (
        <>
          <dl class="veri-rakamlar">
            <div>
              <dt>İleri yön ({gunYaz(son.toplanti)} döngüsü)</dt>
              <dd>
                {isaret(son.ileriYon)} <span class="ton-adi">{tonAdi(son.ileriYon)}</span>
              </dd>
            </div>
            <div>
              <dt>Mevcut duruş</dt>
              <dd>{isaret(son.durus)}</dd>
            </div>
            <div>
              <dt>Önceki döngüye göre</dt>
              <dd>{ivme == null ? '–' : isaret(ivme)}</dd>
            </div>
          </dl>
          <p class="veri-notu veri-kaynak">
            <strong>Kaynak:</strong> metinler <a href="https://www.tcmb.gov.tr/" rel="noopener">TCMB</a>; puanlar finfolis'in
            yapay zekâ okumasıdır, TCMB'nin değildir.{guncelleme && <> Son okuma: {zamanYaz(guncelleme)}.</>}
            {bekleyen > 0 && <> Henüz okunmamış {bekleyen} metin sonraki güncellemelerde eklenecek.</>}
          </p>

          <ZamanGrafik
            baslik="PPK döngülerine göre ton"
            ipucu="Puan; her nokta bir PPK toplantısı ile sonraki toplantıya kadarki özet"
            kaynak="Metinler: TCMB. Puanlar: finfolis, yapay zekâ okuması."
            siklik="hafta"
            birim="puan"
            seriIdleri={['ileri', 'durus']}
            noktalar={grafikNoktalari}
            gruplar={[
              {
                id: 'hepsi',
                ad: 'Hepsi',
                seriler: [
                  { id: 'ileri', ad: 'İleri yön', renk: 'toprak' },
                  { id: 'durus', ad: 'Mevcut duruş', renk: 'murekkep', kesik: true },
                ],
              },
            ]}
            referans={{ deger: 0, ad: 'Dengeli' }}
          />

          <section class="bolum">
            <h2 class="bolum-baslik">Okunan metinler</h2>
            <p class="veri-notu">Satır açıldığında okumanın gerekçesi ve metinden birebir alıntılar görünür.</p>
            <div class="tablo-kaydir">
              <table class="cizelge veri-tablo ton-tablo">
                <thead>
                  <tr>
                    <th scope="col">Tarih</th>
                    <th scope="col">Metin</th>
                    <th scope="col" class="sag">İleri yön</th>
                    <th scope="col" class="sag">Duruş</th>
                  </tr>
                </thead>
                <tbody>
                  {okunan.map((b) => {
                    const p = puanlar[b.id];
                    return (
                      <tr>
                        <td class="tarih-hucre">{gunYaz(b.tarih)}</td>
                        <td>
                          <details>
                            <summary>
                              {TUR[b.tur] ?? b.tur}
                            </summary>
                            <p>{p.gerekce}</p>
                            <ul class="alintilar">
                              {p.alintilar.map((a) => (
                                <li>“{a}”</li>
                              ))}
                            </ul>
                            <p>
                              <a href={b.url} rel="noopener">
                                {b.baslik}
                              </a>
                            </p>
                          </details>
                        </td>
                        <td class="sag">{isaret(p.ileriYon)}</td>
                        <td class="sag">{isaret(p.durus)}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        </>
      ) : (
        <p class="bos">Puanlanmış metin henüz yok. Okumalar tamamlandıkça bu sayfada gösterilecek.</p>
      )
    }

    <section class="bolum prose veri-aciklama">
      <h2 class="bolum-baslik">Bu puanlar nasıl hazırlanıyor?</h2>
      <p>
        TCMB'nin yayımladığı PPK karar metinleri ve PPK toplantı özetleri, Google'ın Gemini yapay zekâ modeline okutulur.
        Model yalnız metne bakar ve iki puan verir. <strong>İleri yön</strong>, metnin para politikasının sonraki adımları
        için verdiği işarettir: −3 belirgin gevşeme (güvercin), 0 dengeli, +3 belirgin sıkılaştırma (şahin).
        <strong>Mevcut duruş</strong>, metnin bugünkü politikayı ne kadar sıkı tanımladığıdır.
      </p>
      <p>
        Model her puan için kısa bir gerekçe ve metinden birebir alıntı vermek zorundadır. Alıntılar program tarafından TCMB
        metninde aranır; metinde birebir geçmeyen alıntı atılır, geçerli alıntısı kalmayan okuma kullanılmaz. Bir PPK
        döngüsünün tonu, o toplantının karar metni ile toplantı özetinin eşit ağırlıklı ortalamasıdır.
      </p>
      <p>
        Puanlar bir yorumdur, ölçüm değildir. Aynı metni başka bir model ya da insan farklı puanlayabilir. Puanlar faiz
        kararı tahmini değildir, TCMB'nin kendi değerlendirmesi değildir ve yatırım kararına dayanak olarak kullanılmamalıdır.
        Puanlar yayımlandıktan sonra elle değiştirilmez.
      </p>
      <p>
        <a href="/veri/ppk-karar-metni/">PPK karar metninde neler değişti?</a> · <a href="/veri/politika-faizi/">Politika faizi</a> · <a href="/yapay-zeka-kullanimi/">Yapay zekâ kullanımı</a>
      </p>
    </section>
    <YasalUyari>Bu sayfadaki puanlar yapay zekânın metin okumasıdır; TCMB'nin açıklaması ya da yatırım tavsiyesi değildir.</YasalUyari>
  </div>
</Base>

<style>
  .ton-adi {
    font-size: 0.55em;
    font-weight: 400;
    color: var(--muted);
    margin-left: 0.3em;
  }
  .tablo-kaydir {
    overflow-x: auto;
  }
  .tarih-hucre {
    white-space: nowrap;
  }
  .ton-tablo summary {
    cursor: pointer;
  }
  .ton-tablo details p {
    margin: 0.5rem 0;
  }
  .alintilar {
    margin: 0.4rem 0;
    padding-left: 1.1rem;
    color: var(--ink-2);
    font-style: italic;
  }
</style>
