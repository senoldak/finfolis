---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import SektorKarnesi from '../../components/SektorKarnesi.astro';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';
import { SEKTOR_VERISI, sektorler } from '../../lib/sektorler';

const baslik = 'BIST Sektör Endeksleri';
const description =
  'Borsa İstanbul sektör ve tematik endekslerinin (BIST Banka, Sınai, Teknoloji, Halka Arz vb.) son puanları, günlük değişimleri ve kapsadıkları şirketler.';

const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: 'BIST Sektörleri', href: '/veri/sektorler/' },
];

const jsonLd = sayfaSemasi({
  yol,
  ad: baslik,
  aciklama: description,
  sayfaEk: { dateModified: SEKTOR_VERISI.guncelleme },
  ekler: [
    {
      '@type': 'Dataset',
      name: 'Borsa İstanbul sektör endeksleri, son puan ve günlük değişim',
      description,
      url: 'https://finfolis.com/veri/sektorler/',
      isAccessibleForFree: true,
      creator: { '@type': 'Organization', name: 'Borsa İstanbul', url: 'https://www.borsaistanbul.com/' },
      dateModified: SEKTOR_VERISI.guncelleme,
    },
  ],
});
---

<Base title={baslik} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container">
    <Breadcrumb yol={yol} />

    <header class="sayfa-bas sayfa-bas-duz">
      <h1>BIST Sektör Endeksleri</h1>
      <p>Sektör ve tematik endekslerin son puanı ve günlük değişimi</p>
    </header>

    <p class="sayfa-giris">
      Borsa İstanbul'da yalnızca BIST 100 değil; bankacılıktan sanayiye, teknolojiden halka arzlara kadar onlarca farklı sektör
      ve tematik endeks işlem görür. Bu sayfa, endekslerin son puanını ve bir önceki kapanışa göre günlük değişimini yan yana gösterir.
    </p>

    <!-- Sektör Karnesi Tablosu ve Özetler -->
    <SektorKarnesi baslikGoster={false} />

    <!-- Öğretici Rehber Bölümü (finfolis felsefesi) -->
    <section class="aciklama-alani" aria-labelledby="rehber-baslik">
      <h2 id="rehber-baslik" class="rehber-baslik">Bu Rakamlar Neyi Gösterir ve Nasıl Hesaplanır?</h2>

      <div class="rehber-grid">
        <article class="rehber-kutu">
          <h3>1. Günlük değişim (%)</h3>
          <p>
            Endeksin son puanının bir önceki kapanış puanına göre yüzde değişimidir:
          </p>
          <div class="formül-blok">
            Günlük değişim (%) = [(Son puan − Önceki kapanış) ÷ Önceki kapanış] × 100
          </div>
        </article>

        <article class="rehber-kutu">
          <h3>2. Alt endeksler ne işe yarar?</h3>
          <p>
            Örneğin BIST 100 genel olarak yatay kalırken, <strong>XBANK (Banka)</strong> yükselip <strong>XFINK (Faktoring)</strong>
            sert düşebilir. Alt endeksler, genel endeksin gizlediği sektör farklarını gösterir.
          </p>
        </article>
      </div>
    </section>

    <YasalUyari />
  </div>
</Base>

<style>
  .aciklama-alani {
    margin-top: 48px;
    margin-bottom: 40px;
    border-top: 2px solid var(--hair, #cfccc2);
    padding-top: 28px;
  }

  .rehber-baslik {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink, #1b1b1b);
    margin-bottom: 20px;
  }

  .rehber-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .rehber-kutu {
    background: var(--paper-2, #e9e7df);
    border: 1px solid var(--hair, #cfccc2);
    padding: 20px;
  }

  .rehber-kutu h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink, #1b1b1b);
    margin-bottom: 8px;
  }

  .rehber-kutu p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--ink-2, #3d3c38);
    margin: 0;
  }

  .formül-blok {
    margin-top: 12px;
    padding: 8px 12px;
    background: var(--paper, #f4f3ee);
    border-left: 3px solid var(--toprak, #c2502b);
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--ink, #1b1b1b);
  }
</style>
