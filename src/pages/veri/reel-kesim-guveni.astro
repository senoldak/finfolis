---
// Reel kesim güveni: TCMB İktisadi Yönelim Anketi'nden reel kesim güven endeksi ve alt endeksleri (mevsimsellikten
// arındırılmış) ile Finansal Hizmetler Anketi'nden finansal hizmetler güven endeksi, EVDS'den. 100 iyimser ile kötümser
// arasındaki eşiktir. Sayfa hesabı yoktur; anket sonucudur, tahmin değildir.
import Base from '../../layouts/Base.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ZamanGrafik from '../../components/ZamanGrafik.astro';
import { RESMI, ayAdi, ayAnahtari, sayiYaz, zamanYaz } from '../../lib/resmi';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';

const reelGuven = RESMI.reelGuven;
const satirlar = reelGuven?.satirlar ?? [];
const finans = reelGuven?.finans ?? [];
const son = satirlar.at(-1);
const once = satirlar.at(-2);
const sonFinans = finans.at(-1);

const fark = (a: number, b?: number) => (b == null ? '' : `${a - b > 0 ? '+' : a - b < 0 ? '−' : ''}${sayiYaz(Math.abs(a - b), 1)} puan`);

const ALT = [
  { alan: 'siparis', ad: 'Toplam sipariş, mevcut durum' },
  { alan: 'siparisSon3', ad: 'Toplam sipariş, son üç ay' },
  { alan: 'ihracat', ad: 'İhracat siparişi, gelecek üç ay' },
  { alan: 'uretim', ad: 'Üretim hacmi, gelecek üç ay' },
  { alan: 'istihdam', ad: 'İstihdam, gelecek üç ay' },
  { alan: 'yatirim', ad: 'Yatırım harcaması' },
  { alan: 'stok', ad: 'Mamul mal stoku' },
  { alan: 'gidisat', ad: 'Genel gidişat' },
] as const;

const gruplar1 = [
  {
    id: 'endeks',
    ad: 'Endeks',
    seriler: [
      { id: 'endeks', ad: 'Reel kesim güven endeksi', renk: 'murekkep' as const },
      { id: 'ham', ad: 'Arındırılmamış', renk: 'toprak' as const, kesik: true },
    ],
  },
  {
    id: 'siparis',
    ad: 'Sipariş',
    seriler: [
      { id: 'siparis', ad: 'Mevcut sipariş', renk: 'murekkep' as const },
      { id: 'siparisSon3', ad: 'Son üç ay sipariş', renk: 'toprak' as const },
      { id: 'ihracat', ad: 'İhracat siparişi', renk: 'mavi' as const },
    ],
  },
  {
    id: 'beklenti',
    ad: 'Üretim ve yatırım',
    seriler: [
      { id: 'uretim', ad: 'Üretim hacmi', renk: 'murekkep' as const },
      { id: 'istihdam', ad: 'İstihdam', renk: 'toprak' as const },
      { id: 'yatirim', ad: 'Yatırım harcaması', renk: 'mavi' as const },
      { id: 'gidisat', ad: 'Genel gidişat', renk: 'yesil' as const },
    ],
  },
];
const IDLER = ['endeks', 'ham', 'siparis', 'siparisSon3', 'ihracat', 'uretim', 'istihdam', 'yatirim', 'gidisat'] as const;
const noktalar1 = satirlar.map((s) => [ayAnahtari(s), ...IDLER.map((a) => s[a])]);
const gruplar2 = [
  {
    id: 'hepsi',
    ad: 'Hepsi',
    seriler: [
      { id: 'endeks', ad: 'Finansal hizmetler güven endeksi', renk: 'murekkep' as const },
      { id: 'talepGelecek3', ad: 'Talep, gelecek üç ay', renk: 'toprak' as const },
      { id: 'isDurumu', ad: 'İş durumu, son üç ay', renk: 'mavi' as const },
    ],
  },
];
const noktalar2 = finans.map((s) => [ayAnahtari(s), s.endeks, s.talepGelecek3, s.isDurumu]);

const baslik = 'Reel kesim güveni';
const description = son
  ? `${ayAdi(son)} ayında reel kesim güven endeksi (mevsimsellikten arındırılmış) ${sayiYaz(son.endeks, 1)}${once ? `, bir önceki aya göre ${fark(son.endeks, once.endeks)}` : ''}. Alt endeksler ve finansal hizmetler güveni. TCMB verisi.`
  : 'Reel kesim güven endeksi, alt endeksleri ve finansal hizmetler güven endeksi, TCMB verisi.';
const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: baslik, href: '/veri/reel-kesim-guveni/' },
];
const ayKodu = (s: { yil: number; ay: number }) => `${s.yil}-${String(s.ay).padStart(2, '0')}`;
const jsonLd = sayfaSemasi({
  yol,
  ad: baslik,
  aciklama: description,
  ...(reelGuven && son
    ? {
        sayfaEk: { dateModified: reelGuven.alinma },
        ekler: [
          {
            '@type': 'Dataset',
            name: 'Reel kesim güven endeksi',
            description:
              'Reel kesim güven endeksi ve alt endeksleri (mevsimsellikten arındırılmış ve arındırılmamış), finansal hizmetler güven endeksi; TCMB İktisadi Yönelim Anketi ve Finansal Hizmetler Anketi, TCMB EVDS’den.',
            url: 'https://finfolis.com/veri/reel-kesim-guveni/',
            isAccessibleForFree: true,
            creator: { '@type': 'GovernmentOrganization', name: 'Türkiye Cumhuriyet Merkez Bankası', url: 'https://www.tcmb.gov.tr/' },
            temporalCoverage: `${ayKodu(satirlar[0])}/${ayKodu(son)}`,
            dateModified: reelGuven.alinma,
            variableMeasured: ['Reel kesim güven endeksi', 'Reel kesim güven endeksi alt endeksleri', 'Finansal hizmetler güven endeksi'],
          },
        ],
      }
    : {}),
});
---

<Base title={`Reel kesim güveni: ${son ? ayAdi(son) : 'aylık veri'}`} description={description} noindex={!son}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-sayfa">
    <Breadcrumb yol={yol} />
    <header class="sayfa-bas sayfa-bas-duz">
      <h1>{baslik}</h1>
      <p>İmalat sanayi firmalarının güveni ve finansal hizmetler güveni · TCMB, aylık</p>
    </header>
    {
      reelGuven && son ? (
        <>
          <dl class="veri-rakamlar">
            <div>
              <dt>Reel kesim güven endeksi</dt>
              <dd>{sayiYaz(son.endeks, 1)}</dd>
              <dd class="veri-degisim">{`${ayAdi(son)}${once ? `, önceki aya göre ${fark(son.endeks, once.endeks)}` : ''}`}</dd>
            </div>
            <div>
              <dt>İhracat siparişi beklentisi</dt>
              <dd>{sayiYaz(son.ihracat, 1)}</dd>
              <dd class="veri-degisim">Gelecek üç ay</dd>
            </div>
            <div>
              <dt>Mevcut sipariş</dt>
              <dd>{sayiYaz(son.siparis, 1)}</dd>
              <dd class="veri-degisim">Toplam sipariş, mevcut durum</dd>
            </div>
            {sonFinans && (
              <div>
                <dt>Finansal hizmetler güveni</dt>
                <dd>{sayiYaz(sonFinans.endeks, 1)}</dd>
                <dd class="veri-degisim">{ayAdi(sonFinans)}</dd>
              </div>
            )}
          </dl>
          <p class="veri-notu veri-kaynak">
            <strong>Kaynak:</strong> <a href={reelGuven.kaynak.url} rel="noopener">{reelGuven.kaynak.ad}</a>. Rakamlar anket
            sonucudur. Siteye alındığı zaman: {zamanYaz(reelGuven.alinma)}.
          </p>

          <ZamanGrafik
            baslik="Reel kesim güven endeksi"
            ipucu="Endeks, mevsimsellikten arındırılmış · 100’ün üstü iyimser, altı kötümser · Grup düğmesiyle alt endekslere geçilir"
            kaynak="Kaynak: TCMB, İktisadi Yönelim Anketi (TCMB EVDS)."
            siklik="ay"
            birim="endeks"
            ondalik={1}
            seriIdleri={[...IDLER]}
            noktalar={noktalar1}
            gruplar={gruplar1}
            grupEtiketi="Seri grubu"
            referans={{ deger: 100, ad: 'Eşik (100)' }}
          />

          <div class="veri-izgara">
            <section class="bolum">
              <h2 class="bolum-baslik">Alt endeksler, {ayAdi(son)}</h2>
              <div class="tablo-sarma">
                <table class="cizelge veri-tablo">
                  <thead>
                    <tr>
                      <th scope="col">Alt endeks</th>
                      <th scope="col" class="sag">Değer</th>
                      <th scope="col" class="sag">Önceki aya göre</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ALT.map((a) => (
                      <tr>
                        <td>{a.ad}</td>
                        <td class="sag">{sayiYaz(son[a.alan], 1)}</td>
                        <td class="sag">{fark(son[a.alan], once?.[a.alan])}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="veri-notu">Mevsimsellikten arındırılmış değerler. Fark, endeks puanı olarak sayfada hesaplanır.</p>
            </section>

            <section class="bolum prose veri-aciklama">
              <h2 class="bolum-baslik">Bu rakamlar ne anlama geliyor?</h2>
              <p>
                Reel kesim güven endeksi, TCMB’nin her ay imalat sanayi firmalarına yaptığı İktisadi Yönelim Anketi’nden
                hesaplanır. Firmalar sipariş, üretim, istihdam ve yatırım konusundaki durumlarını ve beklentilerini bildirir.
              </p>
              <p>
                Endeksin 100’ün üstünde olması iyimser yanıtların ağır bastığını, altında olması kötümser yanıtların ağır
                bastığını gösterir. Finansal hizmetler güven endeksi aynı mantıkla kurulmuş ayrı bir ankettir; finansal hizmet,
                sigorta ve emeklilik ile bunlara yardımcı faaliyetlerdeki firmaları kapsar.
              </p>
            </section>
          </div>

          {finans.length > 0 && (
            <ZamanGrafik
              baslik="Finansal hizmetler güven endeksi"
              ipucu="Endeks · 100’ün üstü iyimser, altı kötümser · Mayıs 2012’den"
              kaynak="Kaynak: TCMB, Finansal Hizmetler Anketi (TCMB EVDS)."
              siklik="ay"
              birim="endeks"
              ondalik={1}
              seriIdleri={['endeks', 'talepGelecek3', 'isDurumu']}
              noktalar={noktalar2}
              gruplar={gruplar2}
              referans={{ deger: 100, ad: 'Eşik (100)' }}
            />
          )}
        </>
      ) : (
        <p class="bos">Reel kesim güveni verisi şu anda yok. Veri alınabildiğinde bu sayfada gösterilecek.</p>
      )
    }
    <nav class="veri-baglantilar" aria-label="İlgili sayfalar">
      <a href="/veri/tuketici-guveni/">Tüketici güveni</a>
      <a href="/veri/kapasite-kullanimi/">Kapasite kullanımı</a>
      <a href="/veri/beklenti-anketleri/">Beklenti anketleri</a>
    </nav>
    <YasalUyari>Bu sayfadaki veriler bilgi amaçlıdır ve TCMB’nin yayımladığı anket sonuçlarıdır. Yatırım tavsiyesi değildir.</YasalUyari>
  </div>
</Base>

<style>
  .tablo-sarma {
    overflow-x: auto;
  }
</style>
