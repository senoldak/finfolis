---
// Tahminler: finfolis'in kendi modelleri, örneklem dışı karneleriyle. Hesap scripts/veri/tahmin.mjs'te (bot zinciri),
// sonuç src/data/tahmin.json'da. Yayın kapısı: tabanını örneklem dışında geçemeyen modelin rakamı bu sayfaya hiç
// gelmez; yalnız karnesi görünür. Kur, borsa, altın ve tahvil tahmini yapılmaz.
import Base from '../../layouts/Base.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ZamanGrafik from '../../components/ZamanGrafik.astro';
import { RESMI, AYLAR, sayiYaz, yuzdeYaz, oranYaz, zamanYaz, gunYaz } from '../../lib/resmi';
import { jsonLdMetni } from '../../lib/json-ld.mjs';
import { sayfaSemasi } from '../../lib/seo';
import { canliKarne } from '../../lib/tahmin/arsiv.mjs';
import tahmin from '../../data/tahmin.json';
import arsiv from '../../data/tahmin-arsivi.json';

const T = tahmin as any;
const M = T.modeller;
const ayYaz = (a: string) => `${AYLAR[Number(a.slice(5, 7)) - 1]} ${a.slice(0, 4)}`;
const ayT = (a: string) => Number(a.slice(0, 4)) * 12 + Number(a.slice(5, 7)) - 1;
const puan = (n: number, o = 2) => `${sayiYaz(n, o)} puan`;
const isaretli = (n: number, o = 2) => `${n > 0 ? '+' : n < 0 ? '−' : ''}${sayiYaz(Math.abs(n), o)}`;
const milyar = (n: number) => `${isaretli(n / 1000)} milyar $`;
const oran = (n: number | null) => (n == null ? '–' : yuzdeYaz(100 * n, 0));
const pYaz = (p: number) => (p < 0.001 ? '< 0,001' : sayiYaz(p, 3));

const MODEL_AD: Record<string, string> = {
  tufe: 'Aylık enflasyon (TÜFE)',
  cari: 'Cari denge',
  sanayi: 'Sanayi üretimi',
  ppk: 'PPK karar yönü',
};
const BAZ_AD: Record<string, string> = {
  pka: 'PKA’nın cari ay beklentisi',
  ito: 'İTO’nun aylık değişimi',
  gecenYil: 'Geçen yılın aynı ayı',
  disTicaret: 'Dış ticaret dengesi',
  ar1: 'AR(1) modeli',
  gecenAy: 'Geçen ayın yıllık değişimi',
};
const hataYaz = (ad: string, n: number) => (ad === 'cari' ? `${sayiYaz(n, 0)} milyon $` : puan(n));

// Canlı karne: arşivdeki yayımlanmış tahminlerden gerçekleşmesi gelenler.
const gercekBul = (k: any) => {
  const t = ayT(k.hedef);
  const bul = (s: any[]) => s.find((x) => x.yil * 12 + x.ay - 1 === t);
  if (k.model === 'cari') return bul(RESMI.cari?.satirlar ?? [])?.cari ?? null;
  if (k.model === 'tufe') return bul(RESMI.enflasyon?.satirlar ?? [])?.aylik ?? null;
  if (k.model === 'sanayi') return bul(RESMI.sanayi?.satirlar ?? [])?.yillik ?? null;
  return null;
};
const canli = (ad: string) => canliKarne((arsiv as any).kayitlar.filter((k: any) => k.model === ad && k.surum === M[ad].surum), gercekBul);
const dustu = (ad: string) => !M[ad].gecti && (arsiv as any).kayitlar.some((k: any) => k.model === ad);

// Cari denge grafiği: son 24 ayın örneklem dışı tahmini, %80 aralığı ve gerçekleşen (milyar $).
const cari = M.cari;
const cariGruplar = [
  {
    id: 'hepsi',
    ad: 'Hepsi',
    seriler: [
      { id: 'gercek', ad: 'Gerçekleşen', renk: 'murekkep' as const },
      { id: 'tahmin', ad: 'Model tahmini', renk: 'mavi' as const },
      { id: 'alt', ad: '%80 aralık alt sınırı', renk: 'yesil' as const, kesik: true },
      { id: 'ust', ad: '%80 aralık üst sınırı', renk: 'yesil' as const, kesik: true },
    ],
  },
];
const cariNoktalar = [
  ...cari.seri.map((s: any) => [ayT(s.ay), s.gercek / 1000, s.tahmin / 1000, s.a80[0] / 1000, s.a80[1] / 1000]),
  ...(cari.simdi ? [[ayT(cari.simdi.ay), null, cari.simdi.tahmin / 1000, cari.simdi.a80[0] / 1000, cari.simdi.a80[1] / 1000]] : []),
];

// Yıllık enflasyon yolu.
const yol = T.yol;
const yolGruplar = [
  {
    id: 'hepsi',
    ad: 'Hepsi',
    seriler: [
      { id: 'gercek', ad: 'Gerçekleşen yıllık TÜFE', renk: 'murekkep' as const },
      { id: 'beklenti', ad: '12 ay önceki PKA beklentisi', renk: 'mavi' as const, kesik: true },
    ],
  },
];
const yolNoktalar = yol.seri.filter((s: any) => s.gercek != null).map((s: any) => [ayT(s.ay), s.gercek, s.beklenti]);
const ppkAylik = (1 + yol.pka.ay12 / 100) ** (1 / 12) * 100 - 100;

// Taylor bandı.
const taylor = T.taylor;
const taylorGruplar = [
  {
    id: 'hepsi',
    ad: 'Hepsi',
    seriler: [
      { id: 'faiz', ad: 'Politika faizi', renk: 'murekkep' as const },
      { id: 'alt', ad: 'Kural bandının alt ucu', renk: 'mavi' as const, kesik: true },
      { id: 'ust', ad: 'Kural bandının üst ucu', renk: 'yesil' as const, kesik: true },
    ],
  },
];
const taylorNoktalar = taylor.seri.map((s: any) => [ayT(s.ay), s.faiz, s.alt, s.ust]);
const varyantlar = [...taylor.son.varyantlar].sort((a: any, b: any) => a.faiz - b.faiz);

const ppk = M.ppk;
const ekkModeller = ['tufe', 'cari', 'sanayi'];
const baslik = 'Tahminler ve karneleri';
const description =
  'finfolis’in enflasyon, cari denge, sanayi üretimi ve PPK kararı için kurduğu modeller, örneklem dışı karneleriyle. Tabanını geçemeyen model rakam vermez. Model tahminidir, yatırım tavsiyesi değildir.';
const yol2 = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: baslik, href: '/veri/tahmin/' },
];
const jsonLd = sayfaSemasi({ yol: yol2, ad: baslik, aciklama: description, sayfaEk: { dateModified: T.guncelleme } });
---

<Base title="Tahminler ve karneleri" description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container veri-sayfa">
    <Breadcrumb yol={yol2} />
    <header class="sayfa-bas sayfa-bas-duz">
      <h1>{baslik}</h1>
      <p>finfolis modelleri · model tahminidir, yatırım tavsiyesi değildir</p>
    </header>

    <section class="bolum prose veri-aciklama">
      <p>
        Bu sayfadaki dört model, resmi verinin açıklanmasından önce o veriyi tahmin eder. Her model, aynı işi gören basit
        bir yöntemle (taban) yarışır. Geçmişte hiç görmediği aylarda tabanından daha az hata yapmayan model rakam
        vermez; sayfada yalnız karnesi kalır. Kur, borsa, altın ve tahvil faizi tahmini yapılmaz.
      </p>
    </section>

    <section class="bolum" aria-labelledby="karne-ozet">
      <h2 id="karne-ozet" class="bolum-baslik">Karne</h2>
      <div class="tablo-sarma">
        <table class="cizelge veri-tablo">
          <thead>
            <tr>
              <th scope="col">Model</th>
              <th scope="col">Durum</th>
              <th scope="col" class="sag">Model hatası</th>
              <th scope="col" class="sag">En iyi taban</th>
              <th scope="col" class="sag">Son 24 ay: model / taban</th>
            </tr>
          </thead>
          <tbody>
            {ekkModeller.map((ad) => {
              const k = M[ad].karne;
              const b = k.enIyiBaz;
              return (
                <tr>
                  <td><a href={`#${ad}`}>{MODEL_AD[ad]}</a></td>
                  <td>{M[ad].gecti ? 'Yayında' : 'Rakam vermiyor'}</td>
                  <td class="sag">{hataYaz(ad, k.tum.model)}</td>
                  <td class="sag">{hataYaz(ad, k.tum.bazlar[b])}<br /><small>{BAZ_AD[b]}</small></td>
                  <td class="sag">{hataYaz(ad, k.son.model)} / {hataYaz(ad, k.son.bazlar[b])}</td>
                </tr>
              );
            })}
            <tr>
              <td><a href="#ppk">{MODEL_AD.ppk}</a></td>
              <td>{ppk.gecti ? 'Yayında' : 'Rakam vermiyor'}</td>
              <td class="sag">Brier {sayiYaz(ppk.karne.brierModel, 3)}</td>
              <td class="sag">Brier {sayiYaz(ppk.karne.brierBaz, 3)}<br /><small>Son kararın yönüne göre sıklık</small></td>
              <td class="sag">–</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="veri-notu">
        Hata: kök ortalama kare hata (RMSE), örneklem dışı. Her ayın tahmini yalnız o aydan önceki verilerle kurulan
        modelden gelir. PPK için Brier puanı kullanılır; düşük puan daha iyidir. Bir modelin yayına çıkması için üç
        koşulun üçü de gerekir: bütün sınama döneminde her tabandan az hata, son 24 ayda da her tabandan az hata ve
        aradaki farkın Diebold-Mariano testinde anlamlı çıkması (p {sayiYaz(T.kapiP, 2)} altında). Sınamada
        verilerin bugünkü, düzeltilmiş hâli kullanılır; ilk açıklanan rakamlarla yapılsaydı karne biraz daha kötü
        çıkabilirdi. Bu yüzden yayımlanan her tahmin ayrıca <a href="#arsiv">arşive</a> yazılır ve canlı karneye girer.
        Hesap: {zamanYaz(T.guncelleme)}.
      </p>
    </section>

    {
      ekkModeller.map((ad) => {
        const m = M[ad];
        const k = m.karne;
        const c = canli(ad);
        return (
          <section class="bolum tahmin-model" id={ad} aria-labelledby={`${ad}-baslik`}>
            <h2 id={`${ad}-baslik`} class="bolum-baslik">
              {MODEL_AD[ad]} {ad === 'sanayi' ? 'anlık tahmini (yıllık değişim)' : 'anlık tahmini'}
            </h2>
            {m.gecti && m.simdi ? (
              <dl class="veri-rakamlar">
                <div>
                  <dt>{ayYaz(m.simdi.ay)} tahmini</dt>
                  <dd>{ad === 'cari' ? milyar(m.simdi.tahmin) : yuzdeYaz(m.simdi.tahmin, 2)}</dd>
                  <dd class="veri-degisim">Model tahmini, {m.surum}</dd>
                </div>
                <div>
                  <dt>%80 aralık</dt>
                  <dd class="tahmin-aralik">
                    {ad === 'cari' ? `${milyar(m.simdi.a80[0])} / ${milyar(m.simdi.a80[1])}` : `${yuzdeYaz(m.simdi.a80[0], 2)} / ${yuzdeYaz(m.simdi.a80[1], 2)}`}
                  </dd>
                  <dd class="veri-degisim">%95 aralık: {ad === 'cari' ? `${milyar(m.simdi.a95[0])} / ${milyar(m.simdi.a95[1])}` : `${yuzdeYaz(m.simdi.a95[0], 2)} / ${yuzdeYaz(m.simdi.a95[1], 2)}`}</dd>
                </div>
              </dl>
            ) : m.gecti ? (
              <p class="tahmin-durum">Model yayında. Şu an tahmin edilecek ay yok: son açıklanan ayın sonraki ayı için girdi verisi henüz gelmedi.</p>
            ) : (
              <p class="tahmin-durum">
                <strong>Taban model daha iyi.</strong> Model sınamada kapıdan geçemediği için rakam vermiyor. En güçlü
                taban: {BAZ_AD[k.enIyiBaz]}.
                {dustu(ad) && ' Model daha önce yayındaydı; son sınamada kapıdan geçemediği için tahmin vermeyi bıraktı.'}
              </p>
            )}

            <div class="tablo-sarma">
              <table class="cizelge veri-tablo">
                <thead>
                  <tr>
                    <th scope="col">Yöntem</th>
                    <th scope="col" class="sag">Hata, tüm dönem</th>
                    <th scope="col" class="sag">Hata, son 24 ay</th>
                    <th scope="col" class="sag">Fark testi (p)</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Model ({m.surum})</strong></td>
                    <td class="sag">{hataYaz(ad, k.tum.model)}</td>
                    <td class="sag">{hataYaz(ad, k.son.model)}</td>
                    <td class="sag">–</td>
                  </tr>
                  {m.bazlar.map((b: string) => (
                    <tr>
                      <td>{BAZ_AD[b]}</td>
                      <td class="sag">{hataYaz(ad, k.tum.bazlar[b])}</td>
                      <td class="sag">{hataYaz(ad, k.son.bazlar[b])}</td>
                      <td class="sag">{pYaz(k.dm[b].p)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="veri-notu">
              Sınama dönemi: {ayYaz(k.tum.ilk)} – {ayYaz(k.tum.son)}, {k.tum.n} ay. Gerçekleşen değerin aralığın içinde
              kaldığı ayların payı: %80 aralıkta {oran(k.tum.kapsama80)}, %95 aralıkta {oran(k.tum.kapsama95)}; son 24 ayda{' '}
              {oran(k.son.kapsama80)} ve {oran(k.son.kapsama95)}. Fark testindeki p değeri küçüldükçe, model ile taban
              arasındaki farkın şans eseri çıkmış olma ihtimali azalır. Kapı için p, {sayiYaz(T.kapiP, 2)} altında olmalı.
              {c.n > 0 &&
                ` Canlı karne: yayımlanan ${c.n} tahminin hatası ${hataYaz(ad, c.rmse)}. Gerçekleşenin %80 aralıkta kaldığı tahminlerin payı ${oran(c.kapsama80)}.`}
            </p>

            {ad === 'cari' && m.gecti && (
              <ZamanGrafik
                baslik="Cari denge: tahmin ve gerçekleşen"
                ipucu="Milyar dolar, aylık · Son 24 ayın tahmini, o aydan önceki verilerle kurulan modelden"
                kaynak="Kaynak: TCMB ödemeler dengesi ve TÜİK dış ticaret verisi (EVDS); tahmin finfolis modeli."
                siklik="ay"
                birim="milyarUsd"
                ondalik={2}
                seriIdleri={['gercek', 'tahmin', 'alt', 'ust']}
                noktalar={cariNoktalar}
                gruplar={cariGruplar}
                referans={{ deger: 0, ad: 'Sıfır' }}
                araliksiz
              />
            )}

            <div class="prose veri-aciklama tahmin-yontem">
              <h3>Yöntem</h3>
              {ad === 'tufe' && (
                <p>
                  TÜİK’in aylık TÜFE değişimi; İstanbul Ticaret Odası’nın (İTO) aynı ay için iki gün önce açıkladığı
                  İstanbul ücretliler geçinme endeksi değişimi, doların o ayki ortalama kurunun bir önceki aya göre değişimi
                  ve ay etkileri (her ay için ayrı sabit) ile en küçük kareler yöntemiyle ilişkilendirilir. Model 2005’ten
                  bu yana veriyle kurulur, 2015’ten itibaren her ay yeniden kurularak sınanır. Tabanlar: TCMB Piyasa
                  Katılımcıları Anketi’nin (PKA) o ay için aylık TÜFE beklentisi, İTO’nun açıkladığı değişimin aynısı ve
                  geçen yılın aynı ayı.
                </p>
              )}
              {ad === 'cari' && (
                <p>
                  TCMB’nin cari işlemler dengesi, TÜİK’in bir ay önce açıkladığı dış ticaret dengesi (ihracat eksi
                  ithalat) ve ay etkileriyle ilişkilendirilir. Ay etkileri turizm gelirinin yaz aylarındaki yükselişini
                  yakalar. Tahmin, dış ticaret verisi açıklanınca yapılır; cari denge yaklaşık iki hafta sonra gelir.
                  Model 2013’ten bu yana veriyle kurulur, 2016’dan itibaren her ay yeniden kurularak sınanır. Tabanlar:
                  geçen yılın aynı ayı ve dış ticaret dengesinin kendisi. Aralıklar, modelin geçmişteki örneklem dışı
                  hatalarından kurulur. Hatalar bazı yıllarda aynı yöne yığıldı (2020, 2022–2024); bu yüzden %80 aralığı
                  gerçekleşmelerin %80’inden azını kapsadı.
                </p>
              )}
              {ad === 'sanayi' && (
                <p>
                  Sanayi üretiminin takvim etkisinden arındırılmış yıllık değişimi; bir önceki ayın yıllık değişimi, imalat
                  sanayi kapasite kullanım oranının bir yıl öncesine göre farkı ve ara malı ithalatının dolar cinsinden
                  yıllık değişimi ile ilişkilendirilir. Kapasite kullanım oranı TCMB’den aynı ay, ara malı ithalatı
                  TÜİK’ten bir ay sonra, sanayi üretimi yaklaşık iki ay sonra gelir. 2017’den itibaren her ay yeniden
                  kurularak sınanır. Tabanlar: aynı veriyle kurulan AR(1) modeli ve geçen ayın yıllık değişimi.
                </p>
              )}
            </div>
          </section>
        );
      })
    }

    <section class="bolum tahmin-model" id="ppk" aria-labelledby="ppk-baslik">
      <h2 id="ppk-baslik" class="bolum-baslik">PPK karar yönü olasılığı</h2>
      {
        ppk.gecti && ppk.simdi ? (
          <dl class="veri-rakamlar">
            <div>
              <dt>İndirim</dt>
              <dd>{yuzdeYaz(100 * ppk.simdi.olasilik[0], 0)}</dd>
              <dd class="veri-degisim">{gunYaz(ppk.simdi.tarih)} toplantısı</dd>
            </div>
            <div>
              <dt>Sabit</dt>
              <dd>{yuzdeYaz(100 * ppk.simdi.olasilik[1], 0)}</dd>
              <dd class="veri-degisim">Model olasılığı, tavsiye değildir</dd>
            </div>
            <div>
              <dt>Artırım</dt>
              <dd>{yuzdeYaz(100 * ppk.simdi.olasilik[2], 0)}</dd>
              <dd class="veri-degisim">Adım büyüklüğü tahmin edilmez</dd>
            </div>
          </dl>
        ) : (
          <p class="tahmin-durum">
            <strong>Taban model daha iyi.</strong> Model, son kararın yönüne dayanan tabanı anlamlı bir farkla
            geçemedi, bu yüzden {ppk.sonrakiToplanti ? `${gunYaz(ppk.sonrakiToplanti)} toplantısı için ` : ''}olasılık vermiyor.
          </p>
        )
      }
      <p class="tahmin-uyari">
        <strong>Az gözlem uyarısı:</strong> Modelin dayandığı karar metni tonu {gunYaz(ppk.ilk)} kararından bu yana
        ölçülüyor. Sınamada {ppk.gozlem} karar var, örneklem dışı ölçülen {ppk.karne.n} karar. Bu kadar az gözlemle
        olasılıkların güvenilirliği sınırlıdır.
      </p>
      <div class="tablo-sarma">
        <table class="cizelge veri-tablo">
          <thead>
            <tr>
              <th scope="col">Ölçü ({ppk.karne.n} karar)</th>
              <th scope="col" class="sag">Model ({ppk.surum})</th>
              <th scope="col" class="sag">Taban</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Brier puanı (düşük daha iyi)</td>
              <td class="sag">{sayiYaz(ppk.karne.brierModel, 3)}</td>
              <td class="sag">{sayiYaz(ppk.karne.brierBaz, 3)}</td>
            </tr>
            <tr>
              <td>En olası sınıfı bilme oranı</td>
              <td class="sag">{oran(ppk.karne.modelIsabet)}</td>
              <td class="sag">{oran(ppk.karne.tekrarIsabet)}</td>
            </tr>
            <tr>
              <td>Fark testi (p)</td>
              <td class="sag" colspan="2">{pYaz(ppk.karne.dm.p)}</td>
            </tr>
          </tbody>
        </table>
      </div>
      <h3 class="tahmin-alt-baslik">Kalibrasyon</h3>
      <div class="tablo-sarma">
        <table class="cizelge veri-tablo">
          <thead>
            <tr>
              <th scope="col">Modelin verdiği olasılık</th>
              <th scope="col" class="sag">Tahmin sayısı</th>
              <th scope="col" class="sag">Ortalama olasılık</th>
              <th scope="col" class="sag">Gerçekleşme sıklığı</th>
            </tr>
          </thead>
          <tbody>
            {ppk.karne.kalibrasyon.map((k: any) => (
              <tr>
                <td>%{sayiYaz(100 * k.aralik[0], 0)} – %{sayiYaz(100 * k.aralik[1], 0)}</td>
                <td class="sag">{k.n}</td>
                <td class="sag">{oran(k.ortP)}</td>
                <td class="sag">{oran(k.siklik)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="prose veri-aciklama tahmin-yontem">
        <h3>Yöntem</h3>
        <p>
          Sıralı probit modeli üç sınıf arasında olasılık dağıtır: indirim, sabit, artırım. Girdiler: bir önceki karar
          metninin ileriye dönük tonu (<a href="/veri/ppk-tonu/">PPK metin tonu</a> sayfasındaki puan), bir önceki kararın
          yönü ve toplantı öncesindeki reel faiz (politika faizi eksi bir önceki ayın PKA 12 ay sonrası enflasyon
          beklentisi). Küçük örneklemde aşırı uç olasılıklar çıkmasın diye katsayılara sabit bir ceza uygulanır. Model
          her karardan önce yalnız o güne kadarki kararlarla yeniden kurulur. Taban, geçmişte son kararın yönünü hangi
