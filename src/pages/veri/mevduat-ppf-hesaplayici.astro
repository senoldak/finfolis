---
// Vadeli mevduat ile para piyasası fonunun (PPF) stopaj sonrası getirisi. Oranlar src/lib/hesap/mevduat-ppf.mjs'te.
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DogrudanYanit from '../../components/DogrudanYanit.astro';
import MevduatPpfHesaplayici from '../../components/MevduatPpfHesaplayici.astro';
import YasalUyari from '../../components/YasalUyari.astro';
import { RESMI, gunYaz, sayiYaz } from '../../lib/resmi';
import { sayfaSemasi } from '../../lib/seo';
import { faqPageSemasi } from '../../lib/json-ld.mjs';

const baslik = 'Mevduat ve para piyasası fonu: Net getiri hesaplayıcı';
const aciklama =
  "TL vadeli mevduat ile para piyasası fonunun stopaj sonrası getirisini aynı tutar ve süre için hesaplayın. Stopaj oranları Cumhurbaşkanı Kararı 10041'e göre.";

// Kutulara konan ilk değer: TCMB'nin son haftalık 1-3 ay vadeli TL mevduat ortalaması (örnek).
const sonFaiz = RESMI.piyasaFaizleri?.satirlar?.at(-1);
const ornekFaiz = sonFaiz?.mevduat ? Math.round(sonFaiz.mevduat * 100) / 100 : 40;

const yol = [
  { ad: 'Anasayfa', href: '/' },
  { ad: 'Veriler', href: '/veri/' },
  { ad: 'Mevduat ve PPF hesaplayıcı', href: '/veri/mevduat-ppf-hesaplayici/' },
];

const kaynaklar = [
  { ad: 'Cumhurbaşkanı Kararı 10041, Resmî Gazete, 9 Temmuz 2025', url: 'https://www.resmigazete.gov.tr/eskiler/2025/07/20250709.htm' },
  {
    ad: 'GİB, 2026 GVK Geçici 67. Madde Rehberi',
    url: 'https://cdn.gib.gov.tr/api/gibportal-file/file/getFileResources?objectKey=arsiv%2Ffileadmin%2Fbeyannamerehberi%2F2026%2F2026_Gecici67.pdf',
  },
  {
    ad: 'Takasbank, TEFAS işlem saatleri',
    url: 'https://www.takasbank.com.tr/tr/hizmetler/isletilen-piyasalar/turkiye-elektronik-fon-alim-satim-platformu-tefas/islem-saatleri',
  },
];

const sssSorulari = [
  {
    soru: 'Mevduatta ve para piyasası fonunda stopaj oranı ne kadar?',
    cevap:
      "Gerçek kişilerde 9 Temmuz 2025'ten beri TL mevduat faizinden 6 aya kadar vadede %17,5, 1 yıla kadar vadede %15, daha uzun vadede %10 stopaj kesiliyor. Bu tarihten sonra alınan para piyasası fonu paylarının kazancından %17,5 kesiliyor. Daha önce açılan mevduata ve daha önce alınan fon paylarına o tarihte geçerli oran uygulanır.",
  },
  {
    soru: 'Hesaplayıcı 6 ayı kaç gün sayıyor?',
    cevap:
      'Karar vadeyi ay olarak yazıyor. Hesaplayıcı 182 güne kadarını 6 ay, 365 güne kadarını 1 yıl sayar. Vadeniz bu sınırlara yakınsa bankanın uyguladığı oranı sözleşmeden kontrol edin.',
  },
  {
    soru: 'Fon getirisi neden günlük bileşik hesaplanıyor?',
    cevap:
      "Fonun kazancı pay fiyatının içinde kalır ve fiyat her iş günü yeniden hesaplanır. Hesaplayıcı bunu yıllık getiriyi güne bölüp her gün üstüne ekleyerek yaklaşık hesaplar. Fonun gerçek getirisi pay fiyatının değişimine göre olur; sonuç örnek bir hesaptır.",
  },
  {
    soru: 'Fon emri ne zaman işlenir?',
    cevap:
      "TEFAS'ta iş günü 09:00 ile 13:30 arasında verilen emirler aynı gün işleme girer; yarım günlerde son saat 11:30. Paranın hesaba geçeceği gün fonun izahnamesinde yazar. Aracı kurumunuz daha erken bir son saat koyabilir.",
  },
  {
    soru: 'Vadeyi bozarsam ne olur?',
    cevap:
      'Vadeden önce çekilen mevduatın faizi bankanın sözleşme koşullarına bağlıdır. Hesaplayıcı paranın vade sonuna kadar beklediğini varsayar.',
  },
];

const faqSemasi = faqPageSemasi(sssSorulari);
const jsonLd = sayfaSemasi({
  yol,
  ad: baslik,
  aciklama,
  ekler: faqSemasi ? [faqSemasi] : [],
});
---

<Base baslik={baslik} aciklama={aciklama} jsonLd={jsonLd}>
  <div class="hesap-sayfasi">
    <Breadcrumb yol={yol} />

    <header class="sayfa-baslik">
      <div class="etiket-satir">
        <span class="etiket">Hesaplayıcı</span>
        <span class="etiket vurgu">Stopaj: CK 10041</span>
      </div>
      <h1>Mevduat ve para piyasası fonu: Net getiri hesaplayıcı</h1>
      <p class="ozet">
        Aynı tutarı aynı süre için vadeli mevduatta ve para piyasası fonunda (PPF) tutsaydınız, stopaj kesildikten sonra
        elinize ne geçerdi? Faizi ve fon getirisini siz yazarsınız; hesaplayıcı stopajı vadeye göre uygular.
      </p>
    </header>

    <DogrudanYanit
      baslik="Kısaca"
      ozet="Gerçek kişilerde TL mevduat faizinden 6 aya kadar vadede %17,5, 1 yıla kadar %15, daha uzun vadede %10 stopaj kesiliyor. Para piyasası fonu kazancından kesilen oran her vadede %17,5. Altı aya kadar iki oran aynı; 6 aydan uzun vadelerde mevduatta kesinti daha düşük."
      kaynak="Cumhurbaşkanı Kararı 10041 (Resmî Gazete, 9 Temmuz 2025); GİB, GVK Geçici 67. Madde Rehberi"
      sorular={sssSorulari}
    />

    <section class="hesaplayici-alani">
      <MevduatPpfHesaplayici varsayilanMevduatFaizi={ornekFaiz} varsayilanPpfGetirisi={ornekFaiz} />
      {sonFaiz && (
        <p class="ornek-not">
          Kutulardaki ilk faiz, TCMB'nin {gunYaz(sonFaiz.tarih)} haftası için yayımladığı 1-3 ay vadeli TL mevduat
          ortalaması (%{sayiYaz(ornekFaiz, 2)}). Fon getirisine de aynı değer örnek olarak kondu; kendi fonunuzun
          getirisini yazın. Haftalık seri: <a href="/veri/piyasa-faizleri/">Piyasa faizleri</a>.
        </p>
      )}
    </section>

    <section class="bilgi-bolumu">
      <h2>Mevduat ile para piyasası fonu arasındaki farklar</h2>

      <div class="karsilastirma-tablo-sarmal">
        <table class="karsilastirma-tablo">
          <thead>
            <tr>
              <th>Özellik</th>
              <th>Vadeli mevduat (TL)</th>
              <th>Para piyasası fonu</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Getiri</strong></td>
              <td>Vade boyunca sözleşmedeki faiz</td>
              <td>Pay fiyatının değişimi; her gün farklı olabilir</td>
            </tr>
            <tr>
              <td><strong>Vadeden önce çıkış</strong></td>
              <td>Faizi bankanın koşulları belirler</td>
              <td>TEFAS'ta 13:30'a kadar verilen emir aynı gün işlenir</td>
            </tr>
            <tr>
              <td><strong>Kazancın ana paraya eklenmesi</strong></td>
              <td>Vade sonunda yeni vade açılırsa</td>
              <td>Pay fiyatına her gün yansır</td>
            </tr>
            <tr>
              <td><strong>Stopaj (6 aya kadar)</strong></td>
              <td>%17,5</td>
              <td>%17,5</td>
            </tr>
            <tr>
              <td><strong>Stopaj (6 ay - 1 yıl)</strong></td>
              <td>%15</td>
              <td>%17,5</td>
            </tr>
            <tr>
              <td><strong>Stopaj (1 yıldan uzun)</strong></td>
              <td>%10</td>
              <td>%17,5</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="bilgi-kutulari">
        <article class="bilgi-kutu">
          <h3>Hesap yöntemi</h3>
          <p>Mevduatta faiz basit hesaplanır; yıllık faiz oranı <em>r</em>, gün sayısı <em>N</em>:</p>
          <code>Ana para &times; r &times; N / 365</code>
          <p>Fonda yıllık getiri güne bölünür ve her gün üstüne eklenir:</p>
          <code>Ana para &times; (1 + r / 365)<sup>N</sup> &minus; Ana para</code>
          <p>İki sonuçtan vadeye uyan stopaj düşülür. Banka ve fonun kendi hesabı küçük farklar gösterebilir.</p>
        </article>
        <article class="bilgi-kutu">
          <h3>Kaynaklar</h3>
          <ul class="kaynak-liste">
            {kaynaklar.map((k) => (
              <li>
                <a href={k.url} rel="noopener">{k.ad}</a>
              </li>
            ))}
          </ul>
          <p>Oranlar 26 Kasım 2026'da kontrol edildi.</p>
        </article>
      </div>
    </section>

    <YasalUyari />
  </div>
</Base>

<style>
  .ornek-not {
    font-size: 0.875rem;
    line-height: 1.55;
    color: #475569;
    margin: 0.75rem 0 0;
  }
  .kaynak-liste {
    margin: 0 0 0.75rem;
    padding-left: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .hesap-sayfasi {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  .sayfa-baslik {
    margin: 1.5rem 0 2rem;
  }

  .etiket-satir {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .etiket {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: #f1f5f9;
    color: #475569;
  }

  .etiket.vurgu {
    background: #eff6ff;
    color: #1d4ed8;
  }

  .sayfa-baslik h1 {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.25;
    color: #0f172a;
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .sayfa-baslik .ozet {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }

  .hesaplayici-alani {
    margin: 2.5rem 0;
  }

  .bilgi-bolumu {
    margin-top: 3.5rem;
    border-top: 1px solid #e2e8f0;
    padding-top: 2.5rem;
  }

  .bilgi-bolumu h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1.5rem;
  }

  .karsilastirma-tablo-sarmal {
    overflow-x: auto;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  .karsilastirma-tablo {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    text-align: left;
  }

  .karsilastirma-tablo th,
  .karsilastirma-tablo td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid #f1f5f9;
  }

  .karsilastirma-tablo th {
    background: #f8fafc;
    font-weight: 600;
    color: #334155;
    border-bottom: 2px solid #e2e8f0;
  }

  .karsilastirma-tablo tbody tr:last-child td {
    border-bottom: none;
  }

  .karsilastirma-tablo tbody tr:hover {
    background: #f8fafc;
  }

  .bilgi-kutulari {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .bilgi-kutu {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1.5rem;
  }

  .bilgi-kutu h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: #0f172a;
    margin-top: 0;
    margin-bottom: 0.75rem;
  }

  .bilgi-kutu p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #475569;
    margin-bottom: 0.75rem;
  }

  .bilgi-kutu code {
    display: block;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    color: #0f172a;
    margin: 0.75rem 0;
    text-align: center;
  }

  @media (max-width: 640px) {
    .sayfa-baslik h1 {
      font-size: 1.5rem;
    }
    .hesap-sayfasi {
      padding: 1.25rem 0.75rem 3rem;
    }
  }
</style>
