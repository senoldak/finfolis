  .sag-panel .marka { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 58%; max-width: 340px; height: auto; opacity: 0.07; filter: blur(1.5px); pointer-events: none; z-index: 0; }
  .ipucu { margin: 8px 0 0; font-size: 13px; color: var(--ikincil); }
  .ikonlar { display: flex; gap: 6px; flex-shrink: 0; }
  .ikon { width: 36px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--cizgi); border-radius: 3px; background: transparent; color: var(--murekkep); cursor: pointer; padding: 0; }
  .ikon svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ikon:hover, .ikon.acik { background: var(--murekkep); color: var(--kagit); }
  .ikon:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }
  @media (max-width: 1024px) {
    .grafik { height: 260px; }
  }
  .kontroller { display: flex; flex-direction: column; gap: 10px; margin: 0 0 12px; }
  .ust-cubuk { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .hisse-sec { position: relative; }
  .sec-liste { position: absolute; top: 100%; left: 0; z-index: 30; width: 280px; max-height: 300px; overflow-y: auto; margin: 4px 0 0; padding: 4px 0; list-style: none; background: var(--beyaz); border: 1px solid var(--cizgi); border-radius: 3px; }
  .sec-liste li { display: flex; justify-content: space-between; gap: 12px; padding: 7px 12px; font-size: 13px; cursor: pointer; color: var(--murekkep); }
  .sec-liste li:hover, .sec-liste li.aktif { background: #efeee7; }
  .sec-liste .kod { color: var(--ikincil); }
  .hisse-sec input { width: 220px; height: 34px; padding: 0 10px; font: inherit; font-size: 13px; border: 1px solid var(--cizgi); border-radius: 3px; background: var(--beyaz); color: var(--murekkep); }
  .hisse-sec input:focus-visible { outline: 2px solid var(--mavi); outline-offset: 1px; }
  .tf { display: inline-flex; border: 1px solid var(--cizgi); border-radius: 3px; overflow: hidden; }
  .tf button { font: inherit; font-size: 13px; font-weight: 600; height: 32px; padding: 0 12px; border: 0; background: transparent; color: var(--murekkep); cursor: pointer; }
  .tf button[aria-pressed="true"] { background: var(--murekkep); color: var(--kagit); }
  .tf button:focus-visible { outline: 2px solid var(--mavi); outline-offset: -2px; }
  .gosterge-satiri { display: flex; flex: 1 1 320px; flex-wrap: wrap; gap: 6px; font-size: 12px; color: var(--ikincil); }
  .gosterge-satiri label { display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px; border: 1px solid var(--cizgi); border-radius: 999px; cursor: pointer; color: var(--murekkep); white-space: nowrap; }
  .gosterge-satiri i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; }
  @media (max-width: 700px) {
