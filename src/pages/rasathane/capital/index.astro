---
import RasathaneKabuk from '../../../layouts/RasathaneKabuk.astro';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { GOSTERGE } from '../../../lib/rasathane/gostergeler.mjs';

// Veri derlemede okunur. Fiyat dosyaları (seri/hisse-KOD.json) seçilen hisseye göre tarayıcıdan istenir.
const KOK = join(process.cwd(), 'public/rasathane/veri/capital');
const oku = (yol) => (existsSync(yol) ? JSON.parse(readFileSync(yol, 'utf8')) : null);
const veri = oku(join(KOK, 'beyanlar.json'));
const satirlar = veri?.satirlar ?? [];
const sutunlar = veri?.sutunlar ?? [];
const haftalik = oku(join(KOK, 'seri', 'ozet-haftalik.json'));

const sayi = new Intl.NumberFormat('tr-TR');
const AYAD = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const gunAdi = (iso) => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${AYAD[m - 1]} ${y}`;
};
const yuzdeTr = (v) => `${v >= 0 ? '+' : '−'}%${Math.abs(v).toFixed(1).replace('.', ',')}`;
const puanTr = (v) => `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(1).replace('.', ',')}`;
const hucre = (s, v) => (v === null || v === undefined || v === '' ? '–' : s.tur === 'sayi' ? sayi.format(v) : String(v));

// Hisse kodu biçimli varlıklar: her biri için beyan satırları (tarayıcıya gider).
const HISSE_KODU = /^[A-Z][A-Z.]{0,5}$/;
const hisseVeri = {};
for (const r of satirlar) {
  if (!HISSE_KODU.test(r.varlik)) continue;
  (hisseVeri[r.varlik] ??= []).push({
    bildirim: r.bildirim, islem_tarihi: r.islem_tarihi, uye: r.uye, parti: r.parti,
    islem: r.islem, tutar: r.tutar, uyum: r.uyum, belge: r.belge,
  });
}
const kodlar = Object.entries(hisseVeri)
  .map(([kod, l]) => ({ kod, adet: l.length }))
  .sort((a, b) => b.adet - a.adet || a.kod.localeCompare(b.kod));
const hisseVeriJson = JSON.stringify(hisseVeri).replace(/</g, '\\u003c');

// Son 90 gün: hisse bazında alış ve satış sayısı, üye sayısı.
const sonBildirim = satirlar.map((r) => r.bildirim).sort().at(-1) ?? '';
const pencere = sonBildirim
  ? new Date(new Date(`${sonBildirim}T00:00:00Z`).getTime() - 90 * 86400000).toISOString().slice(0, 10)
  : '';
const sayim = new Map();
for (const r of satirlar) {
  if (!HISSE_KODU.test(r.varlik) || r.bildirim < pencere) continue;
  const k = sayim.get(r.varlik) ?? { kod: r.varlik, alis: 0, satis: 0, uyeler: new Set() };
  if (r.islem === 'Alış') k.alis += 1;
  if (r.islem === 'Satış') k.satis += 1;
  k.uyeler.add(r.uye);
  sayim.set(r.varlik, k);
}
const liste = [...sayim.values()].map((k) => ({ kod: k.kod, alis: k.alis, satis: k.satis, uye: k.uyeler.size }));
const enCokAlinan = liste.filter((k) => k.alis > 0).sort((a, b) => b.alis - a.alis || b.uye - a.uye || a.kod.localeCompare(b.kod)).slice(0, 10);
const enCokSatilan = liste.filter((k) => k.satis > 0).sort((a, b) => b.satis - a.satis || b.uye - a.uye || a.kod.localeCompare(b.kod)).slice(0, 10);
// Bant: son 90 günün en çok alınan ve en çok satılan hisseleri, sırayla (arama bölümüyle aynı liste).
const bantOgeleri = [];
for (let i = 0; i < 10; i++) {
  if (enCokAlinan[i]) bantOgeleri.push({ kod: enCokAlinan[i].kod, tur: 'alis', adet: enCokAlinan[i].alis });
  if (enCokSatilan[i]) bantOgeleri.push({ kod: enCokSatilan[i].kod, tur: 'satis', adet: enCokSatilan[i].satis });
}
const enBuyukAlis = Math.max(1, ...enCokAlinan.map((k) => k.alis));
const enBuyukSatis = Math.max(1, ...enCokSatilan.map((k) => k.satis));
const uyeSayisi = new Set(satirlar.map((r) => r.uye)).size;
const sonBeyanlar = satirlar
  .filter((r) => HISSE_KODU.test(r.varlik))
  .sort((a, b) => b.bildirim.localeCompare(a.bildirim) || b.islem_tarihi.localeCompare(a.islem_tarihi))
  .slice(0, 25);
// Açılışta seçili hisse: son 90 günde en çok alınan; yoksa en çok beyan edilen.
const seciliKod = enCokAlinan[0]?.kod ?? kodlar[0]?.kod ?? '';

const suzgecler = (veri?.suzgecler ?? []).map((k) => ({
  anahtar: k,
  baslik: sutunlar.find((s) => s.anahtar === k)?.baslik ?? k,
  secenekler: [...new Set(satirlar.map((r) => r[k]).filter((v) => v !== null && v !== undefined && v !== ''))].sort((a, b) =>
    String(a).localeCompare(String(b), 'tr'),
  ),
}));
---
<RasathaneKabuk baslik={veri?.baslik ?? 'Kongre işlemleri'} aktif="capital" aciklama="Kongre üyelerinin bildirdiği hisse işlemleri: hisse seçin, son beyanları ve fiyat seyrini görün. Veriler gecikmelidir.">
  {!veri || satirlar.length === 0 ? (
    <p class="bos">Henüz veri yok.</p>
  ) : (
    <div class="kongre-bant" aria-label="Son 90 günün en çok alınan ve satılan hisseleri">
      <div class="kb-iz">
        {[...bantOgeleri, ...bantOgeleri].map((r, i) => (
          <span class="kb-oge" aria-hidden={i >= bantOgeleri.length ? 'true' : undefined}>
            <b>{r.kod}</b>{' '}
            <span class={r.tur === 'alis' ? 'alis-yazi' : 'satis-yazi'}>{r.tur === 'alis' ? 'Alış' : 'Satış'} {sayi.format(r.adet)}</span>
          </span>
        ))}
      </div>
    </div>
    <div class="sayfa">
      <section class="blok" aria-labelledby="giris-baslik">
        <h2 id="giris-baslik" class="sr-only">Sayfa bilgisi</h2>
        <details class="takvim-ac">
          <summary>
            <span class="takvim-ozet">
              <span>Son beyan {gunAdi(sonBildirim)}</span><span class="ayrac">|</span>
              <span>{sayi.format(satirlar.length)} beyan</span><span class="ayrac">|</span>
              <span>{sayi.format(kodlar.length)} hisse</span><span class="ayrac">|</span>
              <span>Gecikmeli veri</span>
            </span>
          </summary>
          <div class="takvim takvim-4">
            <div class="takvim-gun"><span class="gun-ad">Beyan</span><span class="gun-tarih">{sayi.format(satirlar.length)}</span></div>
            <div class="takvim-gun"><span class="gun-ad">Hisse</span><span class="gun-tarih">{sayi.format(kodlar.length)}</span></div>
            <div class="takvim-gun"><span class="gun-ad">Üye</span><span class="gun-tarih">{sayi.format(uyeSayisi)}</span></div>
            <div class="takvim-gun"><span class="gun-ad">Son bildirim</span><span class="gun-tarih">{gunAdi(sonBildirim)}</span></div>
          </div>
          <p class="takvim-detay">
            Kongre üyelerinin bildirdiği hisse ve tahvil işlemleri. Bir beyan tek başına hukuki ihlal ya da yatırım kararı anlamına gelmez. Yatırım tavsiyesi değildir.
          </p>
        </details>
      </section>

      <section class="hisse" aria-labelledby="hisse-baslik">
        <h2 id="hisse-baslik" class="sr-only">Hisse seç</h2>

        <div class="sag-panel" id="hisse-panel" data-panel aria-live="polite">
          <p class="panel-ust">Kongre işlemleri · Hisse</p>
          <h2 data-hisse-baslik>{seciliKod}</h2>
          <div class="kontroller">
            <div class="ust-cubuk">
              <div class="hisse-sec">
                <span class="sr-only">Hisse seç</span>
                <input type="text" data-hisse-giris value={seciliKod} placeholder="Hisse ara ve seç" autocomplete="off" role="combobox" aria-controls="sec-liste" aria-autocomplete="list" />
                <ul class="sec-liste" id="sec-liste" data-sec-liste role="listbox" hidden>
                  {kodlar.map((k) => (
                    <li role="option" data-kod={k.kod} data-ad={`${k.kod} · ${sayi.format(k.adet)} beyan`}>
                      <span>{k.kod}</span><span class="kod">{sayi.format(k.adet)} beyan</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="tf" role="group" aria-label="Zaman aralığı">
                <button type="button" data-tf="gunluk" aria-pressed="true">Günlük</button>
                <button type="button" data-tf="hafta" aria-pressed="false">Haftalık</button>
              </div>
              <div class="gosterge-satiri" data-gostergeler></div>
              <div class="ikonlar">
                <button type="button" class="ikon" data-tam-ekran aria-label="Grafiği tam ekran aç" title="Tam ekran">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
                </button>
                <button type="button" class="ikon" data-png aria-label="Grafiği PNG olarak indir" title="PNG indir">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
                </button>
              </div>
            </div>
          </div>
          <dl class="olcu" data-olcu></dl>
          <div class="grafik-kap">
            <div data-grafik class="grafik"><p class="not">Fiyat yükleniyor…</p></div>
            <img class="marka" src="/rasathane/isaret.svg" alt="" />
          </div>
          <p class="ipucu">Yakınlaştırmak için fare tekerleği ya da iki parmak. Üzerine gelince değer görünür.</p>
        </div>

        <div class="hisse-tablo">
          <h3 class="alt-baslik">Bu hissenin beyanları</h3>
          <div class="tablo-kutu">
            <table class="cizgi-tablo">
              <thead><tr><th>Bildirim</th><th>İşlem tarihi</th><th>Üye</th><th>Parti</th><th>İşlem</th><th>Tutar aralığı</th><th>Süre uyumu</th><th>Belge</th></tr></thead>
              <tbody data-hisse-tablo></tbody>
            </table>
          </div>
        </div>
      </section>

      <div class="sira">
        <section class="siralama" aria-labelledby="alinan-baslik">
          <h2 id="alinan-baslik">Son 90 günde en çok alınan</h2>
          <p class="alt">Alış beyanı sayısına göre. Hisse koduna tıklayınca yukarıda açılır.</p>
          <ol class="cubuklar">
            {enCokAlinan.map((k) => (
              <li>
                <button type="button" class="kod" data-kod-sec={k.kod}>{k.kod}</button>
                <span class="cubuk alis-cubuk" style={`width:${(k.alis / enBuyukAlis) * 100}%`} aria-hidden="true" />
                <span class="sayi-hucre">{sayi.format(k.alis)}<span class="altyazi"> · {sayi.format(k.uye)} üye</span></span>
              </li>
            ))}
          </ol>
        </section>

        <section class="siralama" aria-labelledby="satilan-baslik">
          <h2 id="satilan-baslik">Son 90 günde en çok satılan</h2>
          <p class="alt">Satış beyanı sayısına göre. Hisse koduna tıklayınca yukarıda açılır.</p>
          <ol class="cubuklar">
            {enCokSatilan.map((k) => (
              <li>
                <button type="button" class="kod" data-kod-sec={k.kod}>{k.kod}</button>
                <span class="cubuk satis-cubuk" style={`width:${(k.satis / enBuyukSatis) * 100}%`} aria-hidden="true" />
                <span class="sayi-hucre">{sayi.format(k.satis)}<span class="altyazi"> · {sayi.format(k.uye)} üye</span></span>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <section class="bolum" aria-labelledby="son-baslik">
        <h2 id="son-baslik">Son beyanlar</h2>
        <p class="alt">En yeni bildirimler üstte. Hisse kodu, işlem türü ve tutar aralığı önde; üye ikinci planda.</p>
        <div class="tablo-kutu">
          <table class="cizgi-tablo">
            <thead><tr><th>Hisse</th><th>İşlem</th><th>Bildirim</th><th>Üye</th><th>Parti</th><th>Tutar aralığı</th></tr></thead>
            <tbody>
              {sonBeyanlar.map((r) => (
                <tr>
                  <td><button type="button" class="kod" data-kod-sec={r.varlik}>{r.varlik}</button></td>
                  <td>{r.islem}</td>
                  <td>{gunAdi(r.bildirim)}</td>
                  <td>{r.uye}</td>
                  <td>{r.parti}</td>
                  <td>{r.tutar}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {haftalik && (
        <section class="bolum" aria-labelledby="hafta-baslik">
          <h2 id="hafta-baslik">Bu hafta: {gunAdi(haftalik.baslangic)} – {gunAdi(haftalik.bitis)}</h2>
          <p class="alt">Üyelerin en çok işlem yaptığı hisseler. Alan ve satan, işlem yapan üye sayısıdır.</p>
          <div class="tablo-kutu">
            <table class="cizgi-tablo">
              <thead><tr><th>Hisse</th><th>Partiler</th><th class="sag">Alan</th><th class="sag">Satan</th><th>Tutar aralığı</th></tr></thead>
              <tbody>
                {haftalik.satirlar.map((r) => (
                  <tr>
                    <td><button type="button" class="kod" data-kod-sec={r.ticker}>{r.ticker}</button> <span class="altyazi">{r.varlik}</span></td>
                    <td>{r.partiler}{r.iki_parti ? ' · iki parti' : ''}</td>
                    <td class="sag">{r.alan}</td>
                    <td class="sag">{r.satan}</td>
                    <td>{r.tutar}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="bolum" aria-labelledby="tum-baslik">
        <h2 id="tum-baslik">Tüm beyanlar</h2>
        <p class="alt">Parti, işlem ve süre uyumuna göre süzün; arama her sütunda çalışır. Başlığa tıklayarak sıralayın.</p>
        <form class="suz" role="search" onsubmit="return false">
          {suzgecler.map((f) => (
            <label class="alan">
              <span class="etiket">{f.baslik}</span>
              <select data-suz={f.anahtar}>
                <option value="">Tümü</option>
                {f.secenekler.map((o) => <option value={o}>{o}</option>)}
              </select>
            </label>
          ))}
          <label class="alan ara">
            <span class="etiket">Ara</span>
            <input type="search" data-ara placeholder="Hisse, üye ya da tutar" autocomplete="off" />
          </label>
          <button type="button" class="sifirla" data-sifirla>Temizle</button>
        </form>
        <p class="sayac" aria-live="polite" data-sayac>{sayi.format(satirlar.length)} satır gösteriliyor</p>
        <div class="tablo-kutu">
          <table class="cizgi-tablo tum" data-tablo>
            <thead>
              <tr>
                {sutunlar.map((s) => (
                  <th scope="col" data-sirala={s.anahtar} class={s.tur === 'sayi' ? 'sag' : 'sol'} aria-sort="none">
                    <button type="button" class="baslik-dugme">{s.baslik}</button>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {satirlar.map((r) => (
                <tr data-filtre={JSON.stringify(Object.fromEntries(suzgecler.map((f) => [f.anahtar, r[f.anahtar] ?? ''])))}>
                  {sutunlar.map((s) => (
                    <td data-v={r[s.anahtar] ?? ''} class={s.tur === 'sayi' ? 'sag' : 'sol'}>
                      {s.anahtar === 'belge' && r.belge ? <a href={r.belge} rel="noopener noreferrer">Belge</a> : hucre(s, r[s.anahtar])}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="bos-satir" data-bos hidden>Eşleşen satır yok.</p>
      </section>

      <p class="kaynak">Kaynaklar: {veri.kaynaklar.map((k, i) => <>{i > 0 && ' · '}<a href={k.url} rel="noopener noreferrer">{k.ad}</a></>)}</p>
    </div>
  )}
</RasathaneKabuk>

<style is:global>
  .bos { color: var(--ikincil); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .sayfa { display: grid; gap: 40px; padding-top: 4px; }
  #hisse-panel { padding-top: 0; }

  /* Giriş: tek bir okuma bloğu, büyük ama sakin. */
  .giris { display: grid; gap: 10px; max-width: 58ch; }
  .giris-metin { margin: 0; font-size: 19px; line-height: 1.5; color: var(--murekkep); }
  .meta { margin: 0; font-size: 13px; color: var(--ikincil); font-variant-numeric: tabular-nums; }

  /* Hisse seçici: sayfanın ana eylemi, büyük giriş alanı. */
  .hisse { display: grid; gap: 28px; }
  .arama { display: grid; gap: 8px; }
  .arama-etiket { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ikincil); }
  .arama-kutu input {
    width: 100%; font: inherit; font-size: 26px; font-weight: 600; letter-spacing: 0.02em; height: 64px; padding: 0 18px;
    border: 1px solid var(--cizgi); border-radius: 0; background: var(--beyaz); color: var(--murekkep);
  }
  .arama-kutu input::placeholder { color: #a6a296; font-weight: 400; }
  .arama-kutu input:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }



  .alt-baslik { margin: 0 0 10px; font-size: 16px; font-weight: 650; }
  .hisse-tablo { display: grid; gap: 0; }

  /* Sıralamalar: yan yana iki çubuk listesi. */
  .sira { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; }
  .siralama { min-width: 0; }
  .sayfa h2 { margin: 0 0 6px; font-size: 20px; font-weight: 650; letter-spacing: -0.01em; }
  .alt { margin: 0 0 16px; font-size: 14px; line-height: 1.55; color: var(--ikincil); max-width: 62ch; }
  .cubuklar { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--cizgi); }
  .cubuklar li { display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--cizgi); }
  .cubuk { display: block; height: 14px; min-width: 2px; }
  .alis-cubuk { background: var(--mavi); }
  .satis-cubuk { background: #8c887d; }
  .sayi-hucre { font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .altyazi { font-size: 12px; font-weight: 400; color: var(--ikincil); }

  .kod { all: unset; cursor: pointer; font-weight: 700; font-size: 15px; color: var(--murekkep); font-variant-numeric: tabular-nums; }
  .kod:hover { color: var(--mavi); text-decoration: underline; text-underline-offset: 3px; }
  .kod:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }

  .sayfa .bolum { display: grid; gap: 0; }
  .sayfa .bolum > h2 { margin-bottom: 6px; }
  .tablo-kutu { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table.cizgi-tablo { width: 100%; min-width: 680px; border-collapse: collapse; font-size: 14px; font-variant-numeric: tabular-nums; }
  table.cizgi-tablo th, table.cizgi-tablo td { padding: 11px 14px 11px 0; border-bottom: 1px solid var(--cizgi); text-align: left; white-space: nowrap; vertical-align: top; }
  table.cizgi-tablo thead th { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ikincil); }
  table.cizgi-tablo tbody tr:hover { background: #efeee7; }
  .sag { text-align: right !important; }

  /* Tüm beyanlar: süzgeç bandı ve sıralanabilir başlıklar. */
  .suz { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px 12px; align-items: end; margin: 0 0 14px; }
  .suz > * { grid-column: span 2; min-width: 0; }
  .suz .alan { display: flex; flex-direction: column; }
  .suz .alan.ara { grid-column: span 4; }
  .suz .sifirla { grid-column: span 2; width: 100%; }
  .etiket { display: block; margin: 0 0 6px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ikincil); }
  .suz select, .suz input[type="search"] {
    font: inherit; font-size: 15px; height: 42px; padding: 0 12px; width: 100%;
    border: 1px solid var(--cizgi); border-radius: 0; background: var(--beyaz); color: var(--murekkep);
  }
  .sifirla {
    font: inherit; font-size: 14px; font-weight: 600; height: 42px; padding: 0 16px;
    border: 1px solid var(--cizgi); border-radius: 0; background: var(--beyaz); color: var(--murekkep); cursor: pointer; white-space: nowrap;
  }
  .sifirla:hover { background: var(--murekkep); color: var(--kagit); }
  .sayac { margin: 0 0 10px; font-size: 13px; color: var(--ikincil); font-variant-numeric: tabular-nums; }
  .bos-satir { margin: 16px 0 0; color: var(--ikincil); }
  table.tum th { position: sticky; top: 0; background: var(--kagit); }
  .baslik-dugme {
    all: unset; box-sizing: border-box; cursor: pointer; display: block; width: 100%;
    font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ikincil);
  }
  .baslik-dugme:hover { color: var(--murekkep); }
