---
import RasathaneKabuk from '../../../layouts/RasathaneKabuk.astro';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';

const KOK = join(process.cwd(), 'public/rasathane/veri/capital');
const oku = (yol) => (existsSync(yol) ? JSON.parse(readFileSync(yol, 'utf8')) : null);
const veri = oku(join(KOK, 'beyanlar.json'));
const satirlar = veri?.satirlar ?? [];
const sutunlar = veri?.sutunlar ?? [];
const haftalik = oku(join(KOK, 'seri', 'ozet-haftalik.json'));

const sayi = new Intl.NumberFormat('tr-TR');
const AYAD = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const gunAdi = (iso) => {
  if (!iso) return '–';
  const [y, m, d] = iso.split('-').map(Number);
  return `${d} ${AYAD[m - 1]} ${y}`;
};

const HISSE_KODU = /^[A-Z][A-Z.]{0,5}$/;
const hisseVeri = {};
for (const r of satirlar) {
  if (!HISSE_KODU.test(r.varlik)) continue;
  (hisseVeri[r.varlik] ??= []).push({
    bildirim: r.bildirim, islem_tarihi: r.islem_tarihi, uye: r.uye, parti: r.parti,
    islem: r.islem, tutar: r.tutar, uyum: r.uyum, belge: r.belge,
  });
}
const kodlar = Object.entries(hisseVeri)
  .map(([kod, l]) => ({ kod, adet: l.length }))
  .sort((a, b) => b.adet - a.adet || a.kod.localeCompare(b.kod));
const hisseVeriJson = JSON.stringify(hisseVeri).replace(/</g, '\\u003c');

const sonBildirim = satirlar.map((r) => r.bildirim).sort().at(-1) ?? '';
const pencere = sonBildirim
  ? new Date(new Date(`${sonBildirim}T00:00:00Z`).getTime() - 90 * 86400000).toISOString().slice(0, 10)
  : '';
const sayim = new Map();
for (const r of satirlar) {
  if (!HISSE_KODU.test(r.varlik) || r.bildirim < pencere) continue;
  const k = sayim.get(r.varlik) ?? { kod: r.varlik, alis: 0, satis: 0, uyeler: new Set() };
  if (r.islem === 'Alış') k.alis += 1;
  if (r.islem === 'Satış') k.satis += 1;
  k.uyeler.add(r.uye);
  sayim.set(r.varlik, k);
}
const liste = [...sayim.values()].map((k) => ({ kod: k.kod, alis: k.alis, satis: k.satis, uye: k.uyeler.size }));
const enCokAlinan = liste.filter((k) => k.alis > 0).sort((a, b) => b.alis - a.alis || b.uye - a.uye || a.kod.localeCompare(b.kod)).slice(0, 8);
const enCokSatilan = liste.filter((k) => k.satis > 0).sort((a, b) => b.satis - a.satis || b.uye - a.uye || a.kod.localeCompare(b.kod)).slice(0, 8);

const enBuyukAlis = Math.max(1, ...enCokAlinan.map((k) => k.alis));
const enBuyukSatis = Math.max(1, ...enCokSatilan.map((k) => k.satis));
const uyeSayisi = new Set(satirlar.map((r) => r.uye)).size;

const sonBeyanlar = satirlar
  .filter((r) => HISSE_KODU.test(r.varlik))
  .sort((a, b) => b.bildirim.localeCompare(a.bildirim) || b.islem_tarihi.localeCompare(a.islem_tarihi))
  .slice(0, 120);

const seciliKod = enCokAlinan[0]?.kod ?? kodlar[0]?.kod ?? '';
---
<RasathaneKabuk
  baslik={veri?.baslik ?? 'Kongre İşlemleri'}
  aktif="capital"
  aciklama="ABD Kongre üyelerinin bildirdiği hisse senedi işlemleri: hisse seçin, alım/satım noktalarını ve fiyat seyrini görün. Veriler gecikmelidir."
  bilgi={sonBildirim ? `Son bildirim: ${gunAdi(sonBildirim)} · Gecikmeli veri` : undefined}
>
  {!veri || satirlar.length === 0 ? (
    <p class="bos-tum">Kongre işlemleri verisi henüz yok.</p>
  ) : (
    <>
      <!-- Özet Bant -->
      <section class="ozet-kartlar" aria-label="Genel özet">
        <div class="ozet-kutu">
          <span class="ozet-etiket">Toplam Beyan</span>
          <span class="ozet-deger">{sayi.format(satirlar.length)}</span>
          <span class="ozet-alt">İncelenen işlem kaydı</span>
        </div>
        <div class="ozet-kutu">
          <span class="ozet-etiket">İşlem Gören Hisse</span>
          <span class="ozet-deger">{sayi.format(kodlar.length)}</span>
          <span class="ozet-alt">Farklı şirket hissesi</span>
        </div>
        <div class="ozet-kutu">
          <span class="ozet-etiket">Aktif Kongre Üyesi</span>
          <span class="ozet-deger">{sayi.format(uyeSayisi)}</span>
          <span class="ozet-alt">Senato ve Temsilciler Meclisi</span>
        </div>
        <div class="ozet-kutu">
          <span class="ozet-etiket">Son Bildirim</span>
          <span class="ozet-deger">{gunAdi(sonBildirim)}</span>
          <span class="ozet-alt">En güncel bildirim tarihi</span>
        </div>
      </section>

      <header class="ust-satir">
        <h1 class="gizli-baslik">Kongre İşlemleri</h1>
      </header>

      <!-- Grafik ve Hisse Paneli -->
      <aside class="sag-panel" id="hisse-panel" data-panel aria-live="polite">
        <p class="panel-ust">Kongre İşlemleri · Fiyat ve İşlem Noktaları</p>
        <h2 data-hisse-baslik>{seciliKod}</h2>
        <div class="kontroller">
          <div class="ust-cubuk">
            <div class="hisse-sec">
              <span class="sr-only">Hisse seç</span>
              <input type="text" data-hisse-giris value={seciliKod} placeholder="Hisse ara ve seç" autocomplete="off" role="combobox" aria-controls="sec-liste" aria-autocomplete="list" />
              <ul class="sec-liste" id="sec-liste" data-sec-liste role="listbox" hidden>
                {kodlar.map((k) => (
                  <li role="option" data-kod={k.kod} data-ad={`${k.kod} · ${sayi.format(k.adet)} beyan`}>
                    <span>{k.kod}</span><span class="kod">{sayi.format(k.adet)} beyan</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="tf" role="group" aria-label="Zaman aralığı">
              <button type="button" data-tf="gunluk" aria-pressed="true">Günlük</button>
              <button type="button" data-tf="hafta" aria-pressed="false">Haftalık</button>
            </div>
            <div class="isaret-aciklama">
              <span class="nokta-aciklama mavi">● Alış İşlemi</span>
              <span class="nokta-aciklama gri">● Satış İşlemi</span>
            </div>
            <div class="ikonlar">
              <button type="button" class="ikon" data-tam-ekran aria-label="Grafiği tam ekran aç" title="Tam ekran">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
              </button>
              <button type="button" class="ikon" data-png aria-label="Grafiği PNG olarak indir" title="PNG indir">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
              </button>
            </div>
          </div>
        </div>
        <dl class="olcu" data-olcu></dl>
        <div class="grafik-kap">
          <div data-grafik class="grafik"><p class="not">Fiyat yükleniyor…</p></div>
          <img class="marka" src="/rasathane/isaret.svg" alt="" />
        </div>
        <p class="ipucu">Yakınlaştırmak için fare tekerleği ya da iki parmak. Çizgideki noktalar Kongre üyelerinin alım/satım tarihleridir.</p>
        <p class="atif">Grafikler <a href="https://www.tradingview.com/" target="_blank" rel="noopener">TradingView Lightweight Charts</a> ile çizilir.</p>

        <!-- Bu Hissenin Beyanları -->
        <div class="hisse-tablo-kapsayici">
          <h3 class="alt-baslik">Bu Hissenin Bildirilen İşlemleri</h3>
          <div class="tablo-kutu">
            <table>
              <thead><tr>
                <th class="sol">Bildirim</th>
                <th class="sol">İşlem Tarihi</th>
                <th class="sol">Üye</th>
                <th class="sol">Parti</th>
                <th class="sol">İşlem</th>
                <th class="sol">Tutar Aralığı</th>
                <th class="sol">Süre Uyumu</th>
                <th class="sol">Belge</th>
              </tr></thead>
              <tbody data-hisse-tablo></tbody>
            </table>
          </div>
        </div>
      </aside>

      <!-- Sıralamalar: Son 90 Günde En Çok Alınan & Satılan -->
      <div class="sira">
        <section class="siralama" aria-labelledby="alinan-baslik">
          <h2 id="alinan-baslik" class="blok-baslik">Son 90 Günde En Çok Alınanlar</h2>
          <p class="alt-aciklama">Alış beyanı sayısına göre. Hisse koduna tıklayarak grafiğini açabilirsiniz.</p>
          <ol class="cubuklar">
            {enCokAlinan.map((k) => (
              <li>
                <button type="button" class="kod-link" data-kod-sec={k.kod}>{k.kod}</button>
                <span class="cubuk alis-cubuk" style={`width:${(k.alis / enBuyukAlis) * 100}%`} aria-hidden="true" />
                <span class="sayi-hucre">{sayi.format(k.alis)} alış <span class="altyazi">· {sayi.format(k.uye)} üye</span></span>
              </li>
            ))}
          </ol>
        </section>

        <section class="siralama" aria-labelledby="satilan-baslik">
          <h2 id="satilan-baslik" class="blok-baslik">Son 90 Günde En Çok Satılanlar</h2>
          <p class="alt-aciklama">Satış beyanı sayısına göre. Hisse koduna tıklayarak grafiğini açabilirsiniz.</p>
          <ol class="cubuklar">
            {enCokSatilan.map((k) => (
              <li>
                <button type="button" class="kod-link" data-kod-sec={k.kod}>{k.kod}</button>
                <span class="cubuk satis-cubuk" style={`width:${(k.satis / enBuyukSatis) * 100}%`} aria-hidden="true" />
                <span class="sayi-hucre">{sayi.format(k.satis)} satış <span class="altyazi">· {sayi.format(k.uye)} üye</span></span>
              </li>
            ))}
          </ol>
        </section>
      </div>

      <!-- Haftalık Öne Çıkanlar (İki Partili İşlemler) -->
      {haftalik && (
        <section class="blok" aria-labelledby="hafta-baslik">
          <h2 id="hafta-baslik" class="blok-baslik">Bu Hafta Öne Çıkanlar ({gunAdi(haftalik.baslangic)} – {gunAdi(haftalik.bitis)})</h2>
          <p class="alt-aciklama">Kongre üyelerinin bu hafta en yoğun işlem yaptığı hisseler.</p>
          <div class="tablo-kutu">
            <table>
              <thead><tr>
                <th class="sol">Hisse</th>
                <th class="sol">Parti Dağılımı</th>
                <th class="sag">Alım Yapan</th>
                <th class="sag">Satım Yapan</th>
                <th class="sol">Tutar Aralığı</th>
              </tr></thead>
              <tbody>
                {haftalik.satirlar.map((r) => (
                  <tr>
                    <td class="sol">
                      <button type="button" class="kod-link" data-kod-sec={r.ticker}><b>{r.ticker}</b></button>
                      <span class="altyazi"> · {r.varlik}</span>
                    </td>
                    <td class="sol">{r.partiler}{r.iki_parti ? ' · İki parti birlikte' : ''}</td>
                    <td class="sag">{r.alan} üye</td>
                    <td class="sag">{r.satan} üye</td>
                    <td class="sol">{r.tutar}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- Son Beyanlar Tablosu -->
      <section class="blok" aria-labelledby="son-baslik">
        <h2 id="son-baslik" class="blok-baslik">Son Bildirilen Beyanlar</h2>
        <div class="denetim">
          <label class="alan">
            <span class="etiket">Parti</span>
            <select data-suz-parti>
              <option value="">Tümü</option>
              <option value="D">Demokrat (D)</option>
              <option value="R">Cumhuriyetçi (R)</option>
            </select>
          </label>
          <label class="alan">
            <span class="etiket">İşlem</span>
            <select data-suz-islem>
              <option value="">Tümü</option>
              <option value="Alış">Alış</option>
              <option value="Satış">Satış</option>
            </select>
          </label>
          <label class="alan ara">
            <span class="etiket">Ara</span>
            <input type="search" data-ara placeholder="Hisse, üye adı veya tutar ara" />
          </label>
          <button type="button" class="sifirla" data-sifirla>Sıfırla</button>
        </div>

        <div class="tablo-kutu">
          <table data-tablo>
            <thead>
              <tr>
                <th class="sol" data-sirala="varlik">Hisse</th>
                <th class="sol" data-sirala="islem">İşlem</th>
                <th class="sol" data-sirala="bildirim">Bildirim Tarihi</th>
                <th class="sol" data-sirala="uye">Kongre Üyesi</th>
                <th class="sol" data-sirala="parti">Parti</th>
                <th class="sol" data-sirala="tutar">Tutar Aralığı</th>
              </tr>
            </thead>
            <tbody>
              {sonBeyanlar.map((r) => (
                <tr data-parti={r.parti} data-islem={r.islem}>
                  <td class="sol" data-v={r.varlik}><button type="button" class="kod-link" data-kod-sec={r.varlik}><b>{r.varlik}</b></button></td>
                  <td class="sol" data-v={r.islem}><span class={`tur-rozet ${r.islem === 'Alış' ? 'alim' : 'satim'}`}>{r.islem}</span></td>
                  <td class="sol" data-v={r.bildirim}>{gunAdi(r.bildirim)}</td>
                  <td class="sol" data-v={r.uye}>
                    {['Rohit Khanna', 'Nancy Pelosi', 'Michael T. McCaul', 'Richard Blumenthal', 'Josh Gottheimer', 'Thomas H Tuberville'].includes(r.uye) ? (
                      <a href={`/rasathane/capital/uye/${r.uye.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`} class="uye-link">{r.uye}</a>
                    ) : (
                      r.uye
                    )}
                  </td>
                  <td class="sol" data-v={r.parti}>{r.parti === 'D' ? 'Demokrat' : r.parti === 'R' ? 'Cumhuriyetçi' : r.parti}</td>
                  <td class="sol" data-v={r.tutar}>{r.tutar}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}
</RasathaneKabuk>

<style>
  .ust-satir { margin: 14px 0 20px; }
  .gizli-baslik { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .yukari { color: var(--yesil); }
  .asagi { color: var(--kirmizi); }

  /* Özet Kartlar */
  .ozet-kartlar { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 0 0 24px; }
  .ozet-kutu { padding: 14px 16px; background: var(--beyaz); border: 1px solid var(--cizgi); border-radius: 4px; display: flex; flex-direction: column; gap: 4px; }
  .ozet-etiket { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ikincil); }
  .ozet-deger { font-size: 22px; font-weight: 700; color: var(--murekkep); font-variant-numeric: tabular-nums; line-height: 1.2; }
  .ozet-alt { font-size: 12px; color: var(--ikincil); }
  @media (max-width: 800px) { .ozet-kartlar { grid-template-columns: 1fr 1fr; } }

  .blok-baslik { margin: 0 0 6px; font-size: 19px; letter-spacing: -0.01em; font-weight: 700; }
  .alt-aciklama { margin: 0 0 14px; font-size: 13px; color: var(--ikincil); }
  .alt-baslik { margin: 20px 0 10px; font-size: 16px; font-weight: 700; }

  /* Panel */
  .sag-panel { margin: 0 0 28px; padding-top: 14px; }
  .panel-ust { margin: 0 0 4px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ikincil); }
  .sag-panel h2 { margin: 0 0 10px; font-size: 24px; font-weight: 700; letter-spacing: -0.01em; }
  .olcu { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px 18px; margin: 0 0 14px; padding: 12px 0; border-top: 1px solid var(--cizgi); border-bottom: 1px solid var(--cizgi); font-size: 14px; }
  .olcu :global(div) { display: flex; flex-direction: column; gap: 2px; }
  .olcu :global(dt) { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ikincil); }
  .olcu :global(dd) { margin: 0; font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .grafik { height: 400px; width: 100%; }
  .grafik-kap { position: relative; }
  .grafik { position: relative; z-index: 1; }
  .marka { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 58%; max-width: 340px; height: auto; opacity: 0.07; filter: blur(1.5px); pointer-events: none; z-index: 0; }
  .ipucu { margin: 8px 0 0; font-size: 13px; color: var(--ikincil); }
  .atif { margin: 8px 0 0; font-size: 12px; color: var(--ikincil); }
  .atif a { color: var(--ikincil); text-decoration: underline; text-underline-offset: 2px; }

  .kontroller { display: flex; flex-direction: column; gap: 10px; margin: 0 0 12px; }
  .ust-cubuk { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .hisse-sec { position: relative; }
  .sec-liste { position: absolute; top: 100%; left: 0; z-index: 30; width: 280px; max-height: 300px; overflow-y: auto; margin: 4px 0 0; padding: 4px 0; list-style: none; background: var(--beyaz); border: 1px solid var(--cizgi); border-radius: 3px; }
  .sec-liste li { display: flex; justify-content: space-between; gap: 12px; padding: 7px 12px; font-size: 13px; cursor: pointer; color: var(--murekkep); }
  .sec-liste li:hover, .sec-liste li.aktif { background: #efeee7; }
  .sec-liste .kod { color: var(--ikincil); }
  .hisse-sec input { width: 220px; height: 36px; padding: 0 12px; font: inherit; font-size: 14px; font-weight: 600; border: 1px solid var(--cizgi); border-radius: 3px; background: var(--beyaz); color: var(--murekkep); }
  .hisse-sec input:focus-visible { outline: 2px solid var(--mavi); outline-offset: 1px; }

  .isaret-aciklama { display: flex; gap: 14px; font-size: 13px; font-weight: 600; }
  .nokta-aciklama.mavi { color: var(--mavi); }
  .nokta-aciklama.gri { color: #6f6b62; }

  .ikonlar { display: flex; gap: 6px; flex-shrink: 0; margin-left: auto; }
  .ikon { width: 36px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--murekkep); border-radius: 3px; background: transparent; color: var(--murekkep); cursor: pointer; padding: 0; }
  .ikon svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ikon:hover, .ikon.acik { background: var(--murekkep); color: var(--kagit); }
  .ikon:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }
  .tf { display: inline-flex; border: 1px solid var(--murekkep); border-radius: 3px; overflow: hidden; }
  .tf button { font: inherit; font-size: 13px; font-weight: 600; height: 32px; padding: 0 12px; border: 0; background: transparent; color: var(--murekkep); cursor: pointer; }
  .tf button[aria-pressed="true"] { background: var(--murekkep); color: var(--kagit); }
  .tf button:focus-visible { outline: 2px solid var(--mavi); outline-offset: -2px; }

  /* Sıralama Çubukları */
  .sira { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; margin: 34px 0; }
  .siralama { min-width: 0; }
  .cubuklar { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--cizgi); }
  .cubuklar li { display: grid; grid-template-columns: 72px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--cizgi); }
  .cubuk { display: block; height: 12px; min-width: 2px; border-radius: 2px; }
  .alis-cubuk { background: var(--mavi); }
  .satis-cubuk { background: #8c887d; }
  .sayi-hucre { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .altyazi { font-size: 12px; font-weight: 400; color: var(--ikincil); }
  @media (max-width: 800px) { .sira { grid-template-columns: 1fr; gap: 24px; } }

  .kod-link { all: unset; cursor: pointer; font-weight: 700; font-size: 14px; color: var(--murekkep); }
  .kod-link:hover { color: var(--mavi); text-decoration: underline; text-underline-offset: 2px; }
  .uye-link { color: var(--murekkep); text-decoration: underline; text-underline-offset: 2px; }
  .uye-link:hover { color: var(--mavi); }

  .tur-rozet { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 12px; font-weight: 600; }
  .tur-rozet.alim { background: #e6f4ea; color: var(--yesil); }
  .tur-rozet.satim { background: #fce8e6; color: var(--kirmizi); }

  .etiket { display: block; margin: 0 0 6px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ikincil); }
  .denetim { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 12px; margin: 0 0 14px; }
  .alan { display: flex; flex-direction: column; min-width: 140px; }
  .alan.ara { flex: 1 1 200px; }
  select, input[type="search"] { font: inherit; font-size: 14px; height: 38px; padding: 0 10px; border: 1px solid var(--cizgi); border-radius: 3px; background: var(--beyaz); color: var(--murekkep); }
  input[type="search"] { width: 100%; }
  select:focus-visible, input:focus-visible, button:focus-visible, th:focus-visible, tr:focus-visible, a:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }
  .sifirla { font: inherit; font-size: 13px; font-weight: 600; height: 38px; padding: 0 14px; border: 1px solid var(--murekkep); border-radius: 3px; background: transparent; color: var(--murekkep); cursor: pointer; }
  .sifirla:hover { background: var(--murekkep); color: var(--kagit); }

  .tablo-kutu { overflow-x: auto; -webkit-overflow-scrolling: touch; border-top: 0; }
  table { border-collapse: collapse; width: 100%; min-width: 600px; font-size: 14px; font-variant-numeric: tabular-nums; }
  th, td { padding: 10px 12px; white-space: nowrap; border-bottom: 1px solid var(--cizgi); }
  th { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ikincil); cursor: pointer; user-select: none; background: var(--kagit); position: sticky; top: 0; }
  .sol { text-align: left; }
  .sag { text-align: right; }
  tbody tr:hover { background: #efeee7; }

  .sag-panel:fullscreen, .sag-panel.tam-ekran { background: var(--kagit); padding: 20px; overflow: auto; }
  .sag-panel.tam-ekran { position: fixed; inset: 0; z-index: 60; width: auto; }
  .sag-panel:fullscreen .grafik, .sag-panel.tam-ekran .grafik { height: calc(100vh - 230px); min-height: 320px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 1024px) { .grafik { height: 260px; } }
</style>

<script type="application/json" id="hisse-veri" set:html={hisseVeriJson}></script>

<script>
  import { createChart, LineSeries, createSeriesMarkers } from 'lightweight-charts';

  const veri = JSON.parse(document.getElementById('hisse-veri')?.textContent || '{}');
  const giris = document.querySelector('[data-hisse-giris]');
  const secListe = document.querySelector('[data-sec-liste]');
  const secSecenekler = [...secListe.querySelectorAll('li')];
  const panel = document.getElementById('hisse-panel');
  const baslik = document.querySelector('[data-hisse-baslik]');
  const olcu = document.querySelector('[data-olcu]');
  const grafikKap = document.querySelector('[data-grafik]');
  const govde = document.querySelector('[data-hisse-tablo]');
  const sayiTr = new Intl.NumberFormat('tr-TR');
  const gunAd = (iso) => {
    if (!iso) return '–';
    return new Date(`${iso}T00:00:00`).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
  };
  const kacis = (m) => String(m ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const yuzdeTr = (v) => `${v >= 0 ? '+' : '−'}%${Math.abs(v).toFixed(1).replace('.', ',')}`;

  let grafik = null;
  let aktifKod = '';
  let aktifFiyat = null;
  let aktifSatirlar = [];
  let tf = 'gunluk';
  const fiyatOnbellek = new Map();

  async function fiyatAl(kod) {
    if (!fiyatOnbellek.has(kod)) {
      const yanit = await fetch(`/rasathane/veri/capital/seri/hisse-${encodeURIComponent(kod)}.json`);
      if (!yanit.ok) throw new Error(String(yanit.status));
      const f = await yanit.json();
      if (f.kapanis.length < 2) throw new Error('kısa');
      fiyatOnbellek.set(kod, f);
    }
    return fiyatOnbellek.get(kod);
  }

  function haftaAnahtari(iso) {
    const d = new Date(`${iso}T00:00:00Z`);
    d.setUTCDate(d.getUTCDate() - ((d.getUTCDay() + 6) % 7));
    return d.toISOString().slice(0, 10);
  }

  function haftalikHesapla(f) {
    const son = new Map();
    f.tarihler.forEach((t, i) => son.set(haftaAnahtari(t), { t, v: f.kapanis[i] }));
    const hafta = [...son.values()];
    return { tarihler: hafta.map((x) => x.t), kapanis: hafta.map((x) => x.v) };
  }

  function isaretler(s, satirlar) {
    const liste = [];
    for (const r of satirlar) {
      const t = s.tarihler.find((d) => d >= r.islem_tarihi);
      if (!t) continue;
      const alis = r.islem === 'Alış';
      liste.push({
        time: t,
        position: alis ? 'belowBar' : 'aboveBar',
        shape: 'circle',
        color: alis ? '#2d4fd6' : '#8c887d',
        text: `${r.islem} (${r.uye})`
      });
    }
    return liste.sort((x, y) => (x.time < y.time ? -1 : x.time > y.time ? 1 : 0));
  }

  function grafikCiz() {
    if (grafik) { grafik.remove(); grafik = null; }
    grafikKap.textContent = '';
    if (!aktifFiyat) return;

    const s = tf === 'hafta' ? haftalikHesapla(aktifFiyat) : aktifFiyat;
    grafik = createChart(grafikKap, {
      autoSize: true,
      layout: { background: { color: 'rgba(0, 0, 0, 0)' }, textColor: '#5d5b55', fontFamily: 'Inter, system-ui, sans-serif', fontSize: 12 },
      grid: { vertLines: { color: '#e9e7df' }, horzLines: { color: '#e9e7df' } },
      rightPriceScale: { borderColor: '#cfccc2' },
      timeScale: { borderColor: '#cfccc2', timeVisible: false },
    });
    const kapanis = grafik.addSeries(LineSeries, { color: '#151515', lineWidth: 2, title: 'Kapanış' });
    kapanis.setData(s.tarihler.map((t, i) => ({ time: t, value: s.kapanis[i] })));

    const isaret = isaretler(s, aktifSatirlar);
    if (isaret.length) createSeriesMarkers(kapanis, isaret);
    grafik.timeScale().fitContent();
  }

  function olcuYaz(satirlar, f) {
    const alis = satirlar.filter((r) => r.islem === 'Alış').length;
    const satis = satirlar.filter((r) => r.islem === 'Satış').length;
    const uyeler = new Set(satirlar.map((r) => r.uye)).size;
    const son = satirlar.map((r) => r.bildirim).sort().at(-1);
    let degisim = '–';
    let sinif = '';
    if (f) {
      const d = (f.kapanis.at(-1) / f.kapanis[0] - 1) * 100;
      degisim = yuzdeTr(d);
      sinif = d >= 0 ? 'yukari' : 'asagi';
    }
    const satirlarO = [
      ['Toplam Beyan', sayiTr.format(satirlar.length)],
      ['Alış İşlemi', sayiTr.format(alis)],
      ['Satış İşlemi', sayiTr.format(satis)],
      ['İşlem Yapan Üye', sayiTr.format(uyeler)],
      ['Son Bildirim', gunAd(son)],
      ['Fiyat Değişimi', degisim, sinif],
    ];
    olcu.innerHTML = satirlarO
      .map(([etiket, deger, s]) => `<div><dt>${kacis(etiket)}</dt><dd class="${s ?? ''}">${kacis(deger)}</dd></div>`)
      .join('');
  }

  async function goster(kod) {
    const satirlar = veri[kod] ?? [];
    aktifKod = kod;
    aktifSatirlar = satirlar;
    if (!kod || satirlar.length === 0) {
      baslik.textContent = kod ? `${kod} için beyan yok` : '';
      aktifFiyat = null;
      if (grafik) { grafik.remove(); grafik = null; }
      grafikKap.innerHTML = '<p class="not">Bir hisse kodu seçin.</p>';
      olcu.innerHTML = '';
      govde.innerHTML = '';
      return;
    }
    baslik.textContent = kod;
    const sirali = [...satirlar].sort((a, b) => b.islem_tarihi.localeCompare(a.islem_tarihi));
    govde.innerHTML = sirali
      .map((r) => `<tr><td class="sol">${kacis(gunAd(r.bildirim))}</td><td class="sol">${kacis(gunAd(r.islem_tarihi))}</td><td class="sol"><b>${kacis(r.uye)}</b></td><td class="sol">${kacis(r.parti === 'D' ? 'Demokrat' : r.parti === 'R' ? 'Cumhuriyetçi' : r.parti)}</td><td class="sol"><span class="tur-rozet ${r.islem === 'Alış' ? 'alim' : 'satim'}">${kacis(r.islem)}</span></td><td class="sol">${kacis(r.tutar)}</td><td class="sol">${kacis(r.uyum)}</td><td class="sol">${r.belge ? `<a href="${kacis(r.belge)}" rel="noopener noreferrer" target="_blank">Belge</a>` : '–'}</td></tr>`)
      .join('');
    try {
      aktifFiyat = await fiyatAl(kod);
      grafikCiz();
    } catch {
      aktifFiyat = null;
      if (grafik) { grafik.remove(); grafik = null; }
      grafikKap.innerHTML = '<p class="not">Bu hisse için fiyat geçmişi yok; grafik gösterilmiyor.</p>';
    }
    olcuYaz(satirlar, aktifFiyat);
  }

  function hisseSec(kod) {
    const aday = (kod || '').trim().toUpperCase();
    if (giris) giris.value = aday;
    goster(aday);
  }

  const secAc = (acik) => { secListe.hidden = !acik; };
  const secSec = (li) => {
    secAc(false);
    hisseSec(li.dataset.kod);
    panel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  const secFiltre = () => {
    const aranan = (giris.value || '').trim().toLocaleLowerCase('tr');
    let gorunen = 0;
    for (const li of secSecenekler) {
      li.classList.remove('aktif');
      const goster = !aranan || li.dataset.ad.toLocaleLowerCase('tr').includes(aranan);
      li.hidden = !goster;
      if (goster) gorunen++;
    }
    secAc(gorunen > 0);
  };
  giris?.addEventListener('focus', secFiltre);
  giris?.addEventListener('input', secFiltre);
  giris?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const aday = (giris.value || '').trim().toUpperCase();
      const ilkGorunen = secSecenekler.find((li) => !li.hidden);
      if (aday) {
        e.preventDefault();
        hisseSec(aday);
      } else if (ilkGorunen) {
        e.preventDefault();
        secSec(ilkGorunen);
      }
    }
  });
  secListe?.addEventListener('mousedown', (e) => {
    const li = e.target.closest('li');
    if (li) { e.preventDefault(); secSec(li); }
  });
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.hisse-sec')) secAc(false);
  });

  document.querySelectorAll('[data-kod-sec]').forEach((b) =>
    b.addEventListener('click', () => {
      hisseSec(b.dataset.kodSec);
      panel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );

  document.querySelectorAll('[data-tf]').forEach((dugme) => {
    dugme.addEventListener('click', () => {
      tf = dugme.dataset.tf;
      document.querySelectorAll('[data-tf]').forEach((d) => d.setAttribute('aria-pressed', String(d === dugme)));
      grafikCiz();
    });
  });

  const tamDugme = document.querySelector('[data-tam-ekran]');
  const tamMetni = () => {
    const acik = panel.classList.contains('tam-ekran') || document.fullscreenElement === panel;
    tamDugme.setAttribute('aria-label', acik ? 'Tam ekrandan çık' : 'Grafiği tam ekran aç');
    tamDugme.title = acik ? 'Kapat' : 'Tam ekran';
    tamDugme.classList.toggle('acik', acik);
  };
  tamDugme?.addEventListener('click', async () => {
    if (panel.classList.contains('tam-ekran')) {
      panel.classList.remove('tam-ekran');
    } else if (document.fullscreenElement === panel) {
      await document.exitFullscreen();
    } else {
      let tamamlandi = false;
      if (document.fullscreenEnabled) {
        try { await panel.requestFullscreen(); tamamlandi = true; } catch {}
      }
      if (!tamamlandi) panel.classList.add('tam-ekran');
    }
    tamMetni();
  });
  document.addEventListener('fullscreenchange', tamMetni);

  document.querySelector('[data-png]')?.addEventListener('click', async () => {
    if (!grafik) return;
    const ekran = grafik.takeScreenshot();
    const ust = 64;
    const tuval = document.createElement('canvas');
    tuval.width = ekran.width;
    tuval.height = ekran.height + ust;
    const g = tuval.getContext('2d');
    g.fillStyle = '#f4f3ee';
    g.fillRect(0, 0, tuval.width, tuval.height);
    g.fillStyle = '#151515';
    g.font = '600 20px Inter, system-ui, sans-serif';
    g.fillText(`${aktifKod} · ${tf === 'hafta' ? 'Haftalık' : 'Günlük'}`, 20, 32);
    g.fillStyle = '#6f6b62';
    g.font = '13px Inter, system-ui, sans-serif';
    g.fillText(['Kongre İşlemleri', 'finfolis'].join(' · '), 20, 52);
    try {
      const isaret = new Image();
      isaret.src = '/rasathane/isaret.svg';
      await isaret.decode();
      g.drawImage(isaret, tuval.width - 46, 14, 30, 30);
    } catch {}
    g.drawImage(ekran, 0, ust);
    tuval.toBlob((blob) => {
      if (!blob) return;
      const ad = aktifKod.toLowerCase().replace(/\s+/g, '-');
      const baglanti = document.createElement('a');
      baglanti.download = `rasathane-kongre-${ad}-${tf}.png`;
      baglanti.href = URL.createObjectURL(blob);
      baglanti.click();
      setTimeout(() => URL.revokeObjectURL(baglanti.href), 1000);
    }, 'image/png');
  });

  // Tablo sıralama
  const tumTablo = document.querySelector('[data-tablo]');
  const tumGovde = tumTablo?.querySelector('tbody');

  function tabloSirala(th) {
    if (!tumTablo || !tumGovde) return;
    const ths = [...tumTablo.querySelectorAll('thead th')];
    const idx = ths.indexOf(th);
    const oncekiYon = th.getAttribute('aria-sort');
    const yeniYon = oncekiYon === 'ascending' ? 'descending' : 'ascending';
    ths.forEach((h) => h.setAttribute('aria-sort', 'none'));
    th.setAttribute('aria-sort', yeniYon);
    const yonSayisi = yeniYon === 'ascending' ? 1 : -1;
    const trler = [...tumGovde.querySelectorAll('tr')];
    trler.sort((a, b) => {
      const cA = a.children[idx];
      const cB = b.children[idx];
      const vA = cA?.dataset?.v ?? cA?.textContent.trim() ?? '';
      const vB = cB?.dataset?.v ?? cB?.textContent.trim() ?? '';
      const numA = vA === '' ? null : Number(vA);
      const numB = vB === '' ? null : Number(vB);
      if (numA === null && numB === null) return 0;
      if (numA === null) return 1;
      if (numB === null) return -1;
      if (Number.isNaN(numA) || Number.isNaN(numB)) {
        return yonSayisi * String(vA).localeCompare(String(vB), 'tr');
      }
      return yonSayisi * (numA - numB);
    });
    trler.forEach((tr) => tumGovde.appendChild(tr));
  }

  document.querySelectorAll('[data-tablo] th[data-sirala]').forEach((th) => {
    th.setAttribute('tabindex', '0');
    if (!th.hasAttribute('aria-sort')) th.setAttribute('aria-sort', 'none');
    th.addEventListener('click', () => tabloSirala(th));
    th.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        tabloSirala(th);
      }
    });
  });

  // Tablo filtreleri
  const araKutusu = document.querySelector('[data-ara]');
  const suzParti = document.querySelector('[data-suz-parti]');
  const suzIslem = document.querySelector('[data-suz-islem]');
  const satirlar = [...document.querySelectorAll('[data-tablo] tbody tr')];

  function tabloFiltrele() {
    const q = araKutusu.value.trim().toLocaleLowerCase('tr');
    const parti = suzParti.value;
    const islem = suzIslem.value;

    satirlar.forEach((tr) => {
      const qOk = !q || tr.textContent.toLocaleLowerCase('tr').includes(q);
      const partiOk = !parti || tr.dataset.parti === parti;
      const islemOk = !islem || tr.dataset.islem === islem;
      tr.hidden = !(qOk && partiOk && islemOk);
    });
  }

  araKutusu?.addEventListener('input', tabloFiltrele);
  suzParti?.addEventListener('change', tabloFiltrele);
  suzIslem?.addEventListener('change', tabloFiltrele);
  document.querySelector('[data-sifirla]')?.addEventListener('click', () => {
    if (araKutusu) araKutusu.value = '';
    if (suzParti) suzParti.value = '';
    if (suzIslem) suzIslem.value = '';
    satirlar.forEach((tr) => (tr.hidden = false));
  });

  // Açılış hissesini yükle
  if (giris?.value) goster(giris.value);
</script>
