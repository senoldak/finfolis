    .sec-liste { width: 100%; }
  }
  .takvim-ac > summary { list-style: none; display: flex; align-items: center; gap: 8px; padding: 8px 0; font-size: 13px; color: var(--murekkep); cursor: pointer; border-bottom: 1px solid var(--cizgi); }
  .takvim-ac > summary::-webkit-details-marker { display: none; }
  .takvim-ac > summary::before { content: '▸'; color: var(--ikincil); }
  .takvim-ac[open] > summary::before { content: '▾'; }
  .takvim-ozet { display: flex; flex-wrap: wrap; gap: 4px 10px; }
  .ayrac { color: var(--ikincil); }
  .takvim-ac .takvim { margin-top: 10px; }
  .takvim { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .takvim.takvim-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .takvim-gun { display: flex; flex-direction: column; gap: 3px; min-height: 58px; padding: 7px 9px; border: 1px solid var(--cizgi); border-radius: 0; background: var(--beyaz); }
  .gun-ad { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ikincil); }
  .gun-tarih { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--murekkep); }
  .takvim-detay { margin: 10px 0 0; font-size: 14px; line-height: 1.6; color: var(--murekkep); max-width: 62ch; }
  @media (max-width: 700px) { .takvim, .takvim.takvim-4 { grid-template-columns: 1fr 1fr; } }

  .kongre-bant { overflow: hidden; height: 34px; display: flex; align-items: center; background: var(--beyaz); border-top: 1px solid var(--cizgi); border-bottom: 1px solid var(--cizgi); font-size: 13px; margin: 0 0 28px; }
  .kb-iz { display: flex; gap: 40px; white-space: nowrap; padding-left: 16px; animation: kongre-kay 60s linear infinite; }
  .kongre-bant:hover .kb-iz { animation-play-state: paused; }
  .kb-oge b { font-weight: 600; }
  .kb-oge .alis-yazi { color: var(--mavi); }
  .kb-oge .satis-yazi { color: var(--ikincil); }
  @keyframes kongre-kay { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .kb-iz { animation: none; } }
  ::selection { background: #d6dcf6; color: var(--murekkep); }
  a:focus-visible, select:focus-visible, input:focus-visible, button:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }

  @media (max-width: 960px) {
    }
  @media (max-width: 600px) {
    .giris-metin { font-size: 17px; }
    .arama-kutu input { font-size: 22px; height: 56px; }
    .suz { grid-template-columns: minmax(0, 1fr); }
    .suz > *, .suz .alan.ara, .suz .sifirla { grid-column: auto; }
    .cubuklar li { grid-template-columns: 60px minmax(0, 1fr) auto; }
  }
</style>

<script type="application/json" id="hisse-veri" set:html={hisseVeriJson}></script>

<script>
  import { createChart, LineSeries, createSeriesMarkers } from 'lightweight-charts';
  import { GOSTERGE } from '../../../lib/rasathane/gostergeler.mjs';

  const veri = JSON.parse(document.getElementById('hisse-veri')?.textContent || '{}');
  const giris = document.querySelector('[data-hisse-giris]');
  const secListe = document.querySelector('[data-sec-liste]');
  const secSecenekler = [...secListe.querySelectorAll('li')];
  const gostergeKap = document.querySelector('[data-gostergeler]');
  const panel = document.getElementById('hisse-panel');
  const baslik = document.querySelector('[data-hisse-baslik]');
  const olcu = document.querySelector('[data-olcu]');
  const grafikKap = document.querySelector('[data-grafik]');
  const govde = document.querySelector('[data-hisse-tablo]');
  const sayiTr = new Intl.NumberFormat('tr-TR');
  const usd = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'USD' });
  const gunAd = (iso) => new Date(`${iso}T00:00:00`).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
  const kacis = (metin) => String(metin ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const yuzdeTr = (v) => `${v >= 0 ? '+' : '−'}%${Math.abs(v).toFixed(1).replace('.', ',')}`;

  let grafik = null;
  let aktifKod = '';
  let aktifFiyat = null;
  let aktifSatirlar = [];
  let tf = 'gunluk';
  const secilenGosterge = new Set();
  const fiyatOnbellek = new Map();
  const seriOnbellek = new Map();

  async function fiyatAl(kod) {
    if (!fiyatOnbellek.has(kod)) {
      const yanit = await fetch(`/rasathane/veri/capital/seri/hisse-${encodeURIComponent(kod)}.json`);
      if (!yanit.ok) throw new Error(String(yanit.status));
      const f = await yanit.json();
      if (f.kapanis.length < 2) throw new Error('kısa');
      fiyatOnbellek.set(kod, f);
    }
    return fiyatOnbellek.get(kod);
  }

  // Göstergeler kapanıştan hesaplanır (yalnız kapanış var): EMA ilk değerle başlar, RSI Wilder yumuşatması.
  function ema(v, n) {
    const a = 2 / (n + 1);
    const cikti = [];
    let p = v[0];
    v.forEach((x, i) => {
      p = i === 0 ? x : a * x + (1 - a) * p;
      cikti.push(p);
    });
    return cikti;
  }
  function rsi(v, n = 14) {
    const a = 1 / n;
    const cikti = v.map(() => null);
    let ag = null;
    let al = null;
    for (let i = 1; i < v.length; i++) {
      const d = v[i] - v[i - 1];
      const g = Math.max(d, 0);
      const l = Math.max(-d, 0);
      if (ag === null) { ag = g; al = l; } else { ag = a * g + (1 - a) * ag; al = a * l + (1 - a) * al; }
      cikti[i] = al === 0 ? 100 : 100 - 100 / (1 + ag / al);
    }
    return cikti;
  }
  // Haftanın pazartesisi anahtar olur; her haftanın son işlem günü haftalık kapanıştır.
  function haftaAnahtari(iso) {
    const d = new Date(`${iso}T00:00:00Z`);
    d.setUTCDate(d.getUTCDate() - ((d.getUTCDay() + 6) % 7));
    return d.toISOString().slice(0, 10);
  }
  function seriHesapla(f) {
    const gunluk = {
      tarihler: f.tarihler, kapanis: f.kapanis,
      ema144: ema(f.kapanis, 144), ema233: ema(f.kapanis, 233), ema377: ema(f.kapanis, 377), rsi14: rsi(f.kapanis),
    };
    const son = new Map();
    f.tarihler.forEach((t, i) => son.set(haftaAnahtari(t), { t, v: f.kapanis[i] }));
    const hafta = [...son.values()];
    const hk = hafta.map((x) => x.v);
    const haftalik = {
      tarihler: hafta.map((x) => x.t), kapanis: hk,
      ema144: ema(hk, 144), ema233: ema(hk, 233), rsi14: rsi(hk),
    };
    return { gunluk, hafta: haftalik };
  }

  // Alış ve satış noktaları işlem gününden sonraki ilk seri gününe konur.
  function isaretler(s, satirlar) {
    const liste = [];
    for (const r of satirlar) {
      const t = s.tarihler.find((d) => d >= r.islem_tarihi);
      if (!t) continue;
      const alis = r.islem === 'Alış';
      liste.push({ time: t, position: alis ? 'belowBar' : 'aboveBar', shape: 'circle', color: alis ? '#2d4fd6' : '#8c887d', text: r.islem });
    }
    return liste.sort((x, y) => (x.time < y.time ? -1 : x.time > y.time ? 1 : 0));
  }

  function gostergeleriYaz() {
    gostergeKap.innerHTML = '';
    for (const g of GOSTERGE[tf]) {
      const etiket = document.createElement('label');
      const kutu = document.createElement('input');
      kutu.type = 'checkbox';
      kutu.checked = secilenGosterge.has(g.k);
      kutu.addEventListener('change', () => {
        if (kutu.checked) secilenGosterge.add(g.k);
        else secilenGosterge.delete(g.k);
        grafikCiz();
      });
      const renk = document.createElement('i');
      renk.style.background = g.renk;
      etiket.append(kutu, renk, document.createTextNode(' ' + g.ad));
      gostergeKap.append(etiket);
    }
  }

  function grafikCiz() {
    if (grafik) { grafik.remove(); grafik = null; }
    grafikKap.textContent = '';
    if (!aktifFiyat) return;
    const s = seriOnbellek.get(aktifKod)[tf];
    grafik = createChart(grafikKap, {
      autoSize: true,
      layout: { background: { color: 'rgba(0, 0, 0, 0)' }, textColor: '#5d5b55', fontFamily: 'Inter, system-ui, sans-serif', fontSize: 12 },
      grid: { vertLines: { color: '#e9e7df' }, horzLines: { color: '#e9e7df' } },
      rightPriceScale: { borderColor: '#cfccc2' },
      timeScale: { borderColor: '#cfccc2', timeVisible: false },
    });
    const kapanis = grafik.addSeries(LineSeries, { color: '#151515', lineWidth: 2, title: 'Kapanış' });
    kapanis.setData(s.tarihler.map((t, i) => ({ time: t, value: s.kapanis[i] })));
    const isaret = isaretler(s, aktifSatirlar);
    if (isaret.length) createSeriesMarkers(kapanis, isaret);
    for (const g of GOSTERGE[tf]) {
      if (!secilenGosterge.has(g.k)) continue;
      const cizgi = grafik.addSeries(
        LineSeries,
        { color: g.renk, lineWidth: 1, title: g.ad, priceLineVisible: false, lastValueVisible: false },
        g.pane ?? 0,
      );
      cizgi.setData(s[g.k].map((v, i) => ({ time: s.tarihler[i], value: v })).filter((p) => p.value !== null && p.value !== undefined));
    }
    grafik.timeScale().fitContent();
  }

  function olcuYaz(satirlar, f) {
    const alis = satirlar.filter((r) => r.islem === 'Alış').length;
    const satis = satirlar.filter((r) => r.islem === 'Satış').length;
    const uyeler = new Set(satirlar.map((r) => r.uye)).size;
    const son = satirlar.map((r) => r.bildirim).sort().at(-1);
    let degisim = '–';
    let sinif = '';
    if (f) {
      const d = (f.kapanis.at(-1) / f.kapanis[0] - 1) * 100;
      degisim = yuzdeTr(d);
      sinif = d >= 0 ? 'yukari' : 'asagi';
    }
    const satirlarO = [
      ['Beyan', sayiTr.format(satirlar.length)],
      ['Alış', sayiTr.format(alis)],
      ['Satış', sayiTr.format(satis)],
      ['Üye', sayiTr.format(uyeler)],
      ['Son bildirim', gunAd(son)],
      ['Grafik aralığında', degisim, sinif],
    ];
    olcu.innerHTML = satirlarO
      .map(([etiket, deger, s]) => `<div><dt>${kacis(etiket)}</dt><dd class="${s ?? ''}">${kacis(deger)}</dd></div>`)
      .join('');
  }

  async function goster(kod) {
    const satirlar = veri[kod] ?? [];
    aktifKod = kod;
    aktifSatirlar = satirlar;
    if (!kod || satirlar.length === 0) {
      baslik.textContent = kod ? `${kod} için beyan yok` : '';
      aktifFiyat = null;
      if (grafik) { grafik.remove(); grafik = null; }
      grafikKap.innerHTML = '<p class="not">Bir hisse kodu seçin.</p>';
      olcu.innerHTML = '';
      govde.innerHTML = '';
      return;
    }
    baslik.textContent = kod;
    const sirali = [...satirlar].sort((a, b) => b.islem_tarihi.localeCompare(a.islem_tarihi));
    govde.innerHTML = sirali
      .map((r) => `<tr><td>${kacis(gunAd(r.bildirim))}</td><td>${kacis(gunAd(r.islem_tarihi))}</td><td>${kacis(r.uye)}</td><td>${kacis(r.parti)}</td><td>${kacis(r.islem)}</td><td>${kacis(r.tutar)}</td><td>${kacis(r.uyum)}</td><td>${r.belge ? `<a href="${kacis(r.belge)}" rel="noopener noreferrer">Belge</a>` : '–'}</td></tr>`)
      .join('');
    let f = null;
    try {
      f = await fiyatAl(kod);
      aktifFiyat = f;
      if (!seriOnbellek.has(kod)) seriOnbellek.set(kod, seriHesapla(f));
      gostergeleriYaz();
      grafikCiz();
    } catch {
      aktifFiyat = null;
      if (grafik) { grafik.remove(); grafik = null; }
      grafikKap.innerHTML = '<p class="not">Bu hisse için fiyat geçmişi yok; grafik gösterilmiyor.</p>';
    }
    olcuYaz(satirlar, f);
  }

  function hisseSec(kod) {
    const aday = (kod || '').trim().toUpperCase();
    if (giris) giris.value = aday;
    goster(aday);
  }

  // Hisse seçici (emtia ile aynı davranış): filtre, ok tuşları, Enter ve dış tıklamada kapanış.
  const secAc = (acik) => { secListe.hidden = !acik; };
  const secSec = (li) => {
    secAc(false);
    hisseSec(li.dataset.kod);
    panel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  const secFiltre = () => {
    const aranan = (giris.value || '').trim().toLocaleLowerCase('tr');
    let gorunen = 0;
    for (const li of secSecenekler) {
      li.classList.remove('aktif');
      const goster = !aranan || li.dataset.ad.toLocaleLowerCase('tr').includes(aranan);
      li.hidden = !goster;
      if (goster) gorunen++;
    }
    secAc(gorunen > 0);
  };
  giris.addEventListener('focus', secFiltre);
  giris.addEventListener('input', secFiltre);
  secListe.addEventListener('mousedown', (e) => {
    const li = e.target.closest('li');
    if (li) { e.preventDefault(); secSec(li); }
  });
  giris.addEventListener('keydown', (e) => {
    const gorunenler = secSecenekler.filter((li) => !li.hidden);
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (!gorunenler.length) return;
      const i = gorunenler.findIndex((li) => li.classList.contains('aktif'));
      const yeni = e.key === 'ArrowDown' ? (i + 1) % gorunenler.length : i <= 0 ? gorunenler.length - 1 : i - 1;
      gorunenler.forEach((li) => li.classList.remove('aktif'));
      gorunenler[yeni].classList.add('aktif');
      gorunenler[yeni].scrollIntoView({ block: 'nearest' });
      secAc(true);
    }
    if (e.key === 'Enter') {
      e.preventDefault();
      const hedef = gorunenler.find((li) => li.classList.contains('aktif')) ?? gorunenler[0];
      if (hedef) secSec(hedef);
      else hisseSec(giris.value);
    }
    if (e.key === 'Escape') secAc(false);
  });
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.hisse-sec')) secAc(false);
  });
  document.querySelectorAll('[data-kod-sec]').forEach((b) =>
    b.addEventListener('click', () => {
      hisseSec(b.dataset.kodSec);
      panel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );

  // Zaman aralığı: günlük ve haftalık seri aynı grafikte; göstergeler seçili aralığa göre yeniden yazılır.
  document.querySelectorAll('[data-tf]').forEach((dugme) => {
    dugme.addEventListener('click', () => {
      tf = dugme.dataset.tf;
      document.querySelectorAll('[data-tf]').forEach((d) => d.setAttribute('aria-pressed', String(d === dugme)));
      gostergeleriYaz();
      grafikCiz();
    });
  });

  // Tam ekran: önce açık katman kapanır; tarayıcı API'si varsa onu kullanır, yoksa sayfa üstü katman.
  const tamDugme = document.querySelector('[data-tam-ekran]');
  const tamMetni = () => {
    const acik = panel.classList.contains('tam-ekran') || document.fullscreenElement === panel;
    tamDugme.setAttribute('aria-label', acik ? 'Tam ekrandan çık' : 'Grafiği tam ekran aç');
    tamDugme.title = acik ? 'Kapat' : 'Tam ekran';
    tamDugme.classList.toggle('acik', acik);
  };
  tamDugme?.addEventListener('click', async () => {
    if (panel.classList.contains('tam-ekran')) {
      panel.classList.remove('tam-ekran');
    } else if (document.fullscreenElement === panel) {
      await document.exitFullscreen();
    } else {
      let tamamlandi = false;
      if (document.fullscreenEnabled) {
        try { await panel.requestFullscreen(); tamamlandi = true; } catch {}
      }
      if (!tamamlandi) panel.classList.add('tam-ekran');
    }
    tamMetni();
  });
  document.addEventListener('fullscreenchange', tamMetni);

  // Grafiği PNG olarak indir: çizgiler ve işaretler dahil; başlık, künye ve filigran eklenir.
  document.querySelector('[data-png]')?.addEventListener('click', async () => {
    if (!grafik) return;
    const ekran = grafik.takeScreenshot();
    const ust = 64;
    const tuval = document.createElement('canvas');
    tuval.width = ekran.width;
    tuval.height = ekran.height + ust;
    const g = tuval.getContext('2d');
    g.fillStyle = '#f4f3ee';
    g.fillRect(0, 0, tuval.width, tuval.height);
    g.fillStyle = '#151515';
    g.font = '600 20px Inter, system-ui, sans-serif';
    g.fillText(`${aktifKod} · ${tf === 'hafta' ? 'Haftalık' : 'Günlük'}`, 20, 32);
    g.fillStyle = '#6f6b62';
    g.font = '13px Inter, system-ui, sans-serif';
    g.fillText(['Kongre işlemleri', document.querySelector('.marka-metin small')?.textContent].filter(Boolean).join(' · '), 20, 52);
    try {
      const isaret = new Image();
      isaret.src = '/rasathane/isaret.svg';
      await isaret.decode();
      g.drawImage(isaret, tuval.width - 46, 14, 30, 30);
    } catch {}
    try {
      const filigran = new Image();
      filigran.src = '/rasathane/isaret.svg';
      await filigran.decode();
      const en = Math.min(tuval.width * 0.5, 340);
      g.globalAlpha = 0.07;
      g.drawImage(filigran, (tuval.width - en) / 2, ust + (ekran.height - en) / 2, en, en);
      g.globalAlpha = 1;
    } catch {}
    g.drawImage(ekran, 0, ust);
    tuval.toBlob((blob) => {
      if (!blob) return;
      const baglanti = document.createElement('a');
      baglanti.download = `rasathane-${aktifKod.toLocaleLowerCase('tr')}-${tf === 'hafta' ? 'hafta' : 'gunluk'}.png`;
      baglanti.href = URL.createObjectURL(blob);
      baglanti.click();
      setTimeout(() => URL.revokeObjectURL(baglanti.href), 1000);
    }, 'image/png');
  });

  // Tüm beyanlar: süzgeç, arama ve sıralama.
  const tablo = document.querySelector('[data-tablo]');
  const tumGovde = tablo?.querySelector('tbody');
  const satirlarT = tumGovde ? [...tumGovde.querySelectorAll('tr')] : [];
  const bos = document.querySelector('[data-bos]');
  const sayac = document.querySelector('[data-sayac]');
  const aramaKutusu = document.querySelector('[data-ara]');
  const suzSecimler = [...document.querySelectorAll('[data-suz]')];
  let siraliAnahtar = null;
  let yon = 1;

  function filtrele() {
    const aranan = (aramaKutusu?.value ?? '').trim().toLocaleLowerCase('tr');
    const secimler = Object.fromEntries(suzSecimler.map((s) => [s.dataset.suz, s.value]));
    let gorunen = 0;
    for (const tr of satirlarT) {
      const f = JSON.parse(tr.dataset.filtre || '{}');
      const secimTamam = Object.entries(secimler).every(([k, v]) => !v || String(f[k]) === v);
      const aramaTamam = !aranan || tr.textContent.toLocaleLowerCase('tr').includes(aranan);
      const goster = secimTamam && aramaTamam;
      tr.hidden = !goster;
      if (goster) gorunen++;
    }
    if (bos) bos.hidden = gorunen !== 0;
    if (sayac) sayac.textContent = `${gorunen.toLocaleString('tr-TR')} satır gösteriliyor`;
  }

  function sirala(th) {
    const anahtar = th.dataset.sirala;
    const basliklar = [...tablo.querySelectorAll('thead th')];
    const idx = basliklar.indexOf(th);
    yon = siraliAnahtar === anahtar ? -yon : 1;
    siraliAnahtar = anahtar;
    basliklar.forEach((b) => b.setAttribute('aria-sort', 'none'));
    th.setAttribute('aria-sort', yon === 1 ? 'ascending' : 'descending');
    const sirali = [...satirlarT].sort((a, b) => {
      const x = a.children[idx].dataset.v;
      const y = b.children[idx].dataset.v;
      const sx = x === '' ? null : Number(x);
      const sy = y === '' ? null : Number(y);
      if (sx === null && sy === null) return 0;
      if (sx === null) return 1;
      if (sy === null) return -1;
      if (Number.isNaN(sx) || Number.isNaN(sy)) return yon * x.localeCompare(y, 'tr');
      return yon * (sx - sy);
    });
    sirali.forEach((tr) => tumGovde.appendChild(tr));
  }

  filtrele();
  suzSecimler.forEach((s) => s.addEventListener('change', filtrele));
  aramaKutusu?.addEventListener('input', filtrele);
  document.querySelector('[data-sifirla]')?.addEventListener('click', () => {
    suzSecimler.forEach((s) => (s.value = ''));
    if (aramaKutusu) aramaKutusu.value = '';
    filtrele();
  });
  document.querySelectorAll('[data-sirala]').forEach((th) => {
    th.querySelector('button')?.addEventListener('click', () => sirala(th));
  });

  // İlk açılış: seçili hisse (son 90 günde en çok alınan).
  hisseSec(giris.value || '');
</script>
