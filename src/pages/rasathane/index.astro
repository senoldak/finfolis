---
import RasathaneKabuk from '../../layouts/RasathaneKabuk.astro';
import { BOLUMLER, sayfalariOku, veriDurumu } from '../../lib/rasathane/veri.mjs';
import { tarih } from '../../lib/rasathane/bicim.mjs';
import { join } from 'node:path';

const KOK = join(process.cwd(), 'public/rasathane/veri');
const durum = veriDurumu(KOK);
const sayfalar = sayfalariOku(KOK);
---
<RasathaneKabuk baslik="Rasathane" aciklama="Piyasa taramaları ve grafikler: süzülebilir tablolar, gecikmeli veri.">
  <h1>Rasathane</h1>
  <p class="not">Piyasa taramaları, süzülebilir tablolar ve her satırın grafiği. Veriler gecikmelidir.</p>
  {durum !== 'tamam' && <p class="not"><strong>Veri şu an alınamadı.</strong> Son iyi veriler gösteriliyor.</p>}
  {BOLUMLER.map((b) => {
    const liste = sayfalar.filter((s) => s.bolum === b.anahtar);
    return (
      <section style="margin:26px 0">
        <h2 style="font-size:18px;margin:0 0 6px"><a href={`/rasathane/${b.anahtar}/`}>{b.ad}</a></h2>
        {liste.length === 0 ? (
          <p class="not">Henüz veri yok.</p>
        ) : (
          <ul style="margin:0;padding-left:18px">
            {liste.map((s) => (
              <li>
                <a href={`/rasathane/${b.anahtar}/${s.sayfa}/`}>{s.veri.baslik}</a>
                <span class="not"> · {tarih(s.veri.guncellendi)}{s.eski ? ' (eski)' : ''}</span>
              </li>
            ))}
          </ul>
        )}
      </section>
    );
  })}
</RasathaneKabuk>
