---
import RasathaneKabuk from '../../../layouts/RasathaneKabuk.astro';
import { sayfalariOku } from '../../../lib/rasathane/veri.mjs';
import { sayi, yuzde, tarih } from '../../../lib/rasathane/bicim.mjs';
import { join } from 'node:path';
import { readFileSync } from 'node:fs';

const KOK = join(process.cwd(), 'public/rasathane/veri');
const sayfalar = sayfalariOku(KOK).filter((s) => s.bolum === 'emtia');
const bul = (ad) => sayfalar.find((s) => s.sayfa === ad);

const pano = bul('pano');
const hareketler = bul('hareketler');
const stoklar = bul('stoklar');
const fonlar = bul('fonlar');
const merkez = bul('merkez');

// Hareketler tarihe göre gruplanır. "Bugün" = piyasa verisinin son işlem günü (altın serisinin son tarihi).
const iso = (d) => d.toISOString().slice(0, 10);
const gunEkle = (x, n) => {
  const d = new Date(x + 'T00:00:00Z');
  d.setUTCDate(d.getUTCDate() + n);
  return iso(d);
};
const oncekiIsGunu = (x) => {
  let y = gunEkle(x, -1);
  while ([0, 6].includes(new Date(y + 'T00:00:00Z').getUTCDay())) y = gunEkle(y, -1);
  return y;
};
const haftaninPazartesi = (x) => gunEkle(x, -((new Date(x + 'T00:00:00Z').getUTCDay() + 6) % 7));
const sonIsGunu = (() => {
  try {
    const d = JSON.parse(readFileSync(join(KOK, 'emtia/seri/GC=F.json'), 'utf8'));
    return d.tarihler.at(-1);
  } catch {
    return pano ? new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Istanbul' }).format(new Date(pano.veri.guncellendi)) : '';
  }
})();
const T = sonIsGunu;
const guncel = T ? tarih(`${T}T12:00:00Z`) : '';
const dun = oncekiIsGunu(T);
const pzt = haftaninPazartesi(T);
const gecenPzt = gunEkle(pzt, -7);
const gecenPaz = gunEkle(pzt, -1);
const otuzGun = gunEkle(T, -30);
const kovalar = { bugun: [], dun: [], buHafta: [], gecenHafta: [], son30: [] };
for (const r of hareketler?.veri.satirlar ?? []) {
  const t = r.tarih;
  if (t === T) kovalar.bugun.push(r);
  else if (t === dun) kovalar.dun.push(r);
  else if (t >= pzt && t <= T) kovalar.buHafta.push(r);
  else if (t >= gecenPzt && t <= gecenPaz) kovalar.gecenHafta.push(r);
  else if (t >= otuzGun) kovalar.son30.push(r);
}
const hareketGruplari = [
  ['bugun', 'Bugün'],
  ['dun', 'Dün'],
  ['buHafta', 'Bu hafta'],
  ['gecenHafta', 'Geçen hafta'],
  ['son30', 'Son 30 gün'],
];
const tarihGoster = (x) => `${x.slice(8, 10)}.${x.slice(5, 7)}.${x.slice(0, 4)}`;
// Haftanın veri takvimi: bot kartının (cizim.TAKVIM) sitedeki karşılığı. Gün, haftanın Pazartesi'sine göre.
const TAKVIM = [
  { gun: 2, saat: 'Çarşamba 17:30', rapor: 'EIA petrol stokları', icerik: 'Ham petrol, benzin, distilat, Cushing' },
  { gun: 3, saat: 'Perşembe 17:30', rapor: 'EIA doğalgaz depoları', icerik: 'ABD çalışma gazı' },
  { gun: 4, saat: 'Cuma 22:30', rapor: 'CFTC pozisyon raporu', icerik: 'Fonların net pozisyonu (Salı itibarıyla)' },
];
const GUNLER = ['Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma'];
const KISA = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum'];
const takvimGunleri = pzt
  ? GUNLER.map((ad, i) => ({ ad, kisa: KISA[i], tarih: tarihGoster(gunEkle(pzt, i)), rapor: TAKVIM.find((t) => t.gun === i) }))
  : [];
const hareketGecmisiVar = Object.values(kovalar).some((g) => g.length > 0);
const ilkDolu = hareketGruplari.map(([a]) => a).find((a) => kovalar[a].length > 0) ?? 'bugun';

// Gösterilmeyen (iç) sütunlar.
const gizli = new Set(['uc']);
// Pano tablosunda gösterilmeyen sütunlar (grup süzgeçte ve ayrıntıda kalır).
const panoGizli = new Set(['grup', 'birim']);
// Sütun başlığı kısaltmaları.
const etiket = { gyb: 'YBB' };

function hucre(s, deger) {
  if (deger === null || deger === undefined || deger === '') return '–';
  if (typeof deger === 'boolean') return deger ? 'Evet' : 'Hayır';
  if (s.tur === 'yuzde') return yuzde(deger, s.basamak);
  if (s.tur === 'sayi') return sayi(deger, s.basamak);
  return String(deger);
}
function isaret(s, deger) {
  if (s.tur !== 'yuzde' || typeof deger !== 'number' || deger === 0) return '';
  return deger > 0 ? 'yukari' : 'asagi';
}
function gosterim(s, deger) {
  const i = isaret(s, deger);
  if (!i) return hucre(s, deger);
  return (i === 'yukari' ? '▲ ' : '▼ ') + yuzde(Math.abs(deger), s.basamak);
}

// Üstteki özet: pano'daki günlük hareket.
const panoSatirlar = pano?.veri.satirlar ?? [];

const suzgecGruplar = [...new Set(panoSatirlar.map((r) => r.grup).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'tr'));

function tablo(sayfa, dis = new Set()) {
  const sutunlar = sayfa.veri.sutunlar
    .filter((s) => !gizli.has(s.anahtar) && !dis.has(s.anahtar))
    .map((s) => ({ ...s, baslik: etiket[s.anahtar] ?? s.baslik }));
  return { sutunlar, satirlar: sayfa.veri.satirlar };
}
const panoT = pano ? tablo(pano, panoGizli) : null;
const stokT = stoklar ? tablo(stoklar) : null;
const fonT = fonlar ? tablo(fonlar) : null;
---
<RasathaneKabuk baslik="Emtia" aktif="emtia" bant="emtia" aciklama="Emtia piyasası tek ekranda: fiyatlar, hareketler, stoklar ve fon pozisyonları. Veriler gecikmelidir." bilgi={guncel ? `Son güncelleme: ${guncel} · Gecikmeli veri` : undefined}>
  {!pano ? (
    <p class="bos-tum">Emtia verisi henüz yok.</p>
  ) : (
    <>
      {takvimGunleri.length > 0 && (
        <section class="blok" aria-labelledby="h-takvim">
          <h2 id="h-takvim" class="sr-only">Haftanın Veri Takvimi</h2>
          <details class="takvim-ac">
            <summary>
              <span class="takvim-ozet">
                {takvimGunleri.map((g, i) => (
                  <>
                    {i > 0 && <span class="ayrac">|</span>}
                    <span>{g.kisa} {g.tarih.slice(0, 5)}{g.rapor ? ` · ${g.rapor.rapor}` : ''}</span>
                  </>
                ))}
              </span>
            </summary>
            <div class="takvim">
              {takvimGunleri.map((g) => (
                <div class="takvim-gun">
                  <span class="gun-ad">{g.ad}</span>
                  <span class="gun-tarih">{g.tarih}</span>
                  {g.rapor && (
                    <button type="button" class="rapor-dugme" data-rapor={g.rapor.icerik} data-saat={g.rapor.saat} aria-pressed="false">
                      <b>{g.rapor.rapor}</b>
                      <span>{g.rapor.saat}</span>
                    </button>
                  )}
                </div>
              ))}
            </div>
            <p class="takvim-detay" data-takvim-detay hidden></p>
          </details>
        </section>
      )}
      <header class="ust-satir">
        <h1 class="gizli-baslik">Emtia</h1>
      </header>

        <aside class="sag-panel" data-panel hidden aria-live="polite">
          <p class="panel-ust" data-panel-ust></p>
          <h2 data-panel-baslik></h2>
          <div class="kontroller">
            <div class="ust-cubuk">
              <div class="emtia-sec">
                <span class="sr-only">Emtia seç</span>
                <input type="text" data-emtia-sec placeholder="Emtia ara ve seç" autocomplete="off" role="combobox" aria-controls="sec-liste" aria-autocomplete="list" />
                <ul class="sec-liste" id="sec-liste" data-sec-liste role="listbox" hidden>
                  {panoT.satirlar.filter((r) => r.seri).map((r) => (
                    <li role="option" data-seri={r.seri} data-ad={`${r.ad} · ${r.seri}`}>
                      <span>{r.ad}</span><span class="kod">{r.seri}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="tf" role="group" aria-label="Zaman aralığı">
                <button type="button" data-tf="gunluk" aria-pressed="true">Günlük</button>
                <button type="button" data-tf="hafta" aria-pressed="false">Haftalık</button>
              </div>
              <div class="gosterge-satiri" data-gostergeler></div>
              <div class="ikonlar">
                <button type="button" class="ikon" data-tam-ekran aria-label="Grafiği tam ekran aç" title="Tam ekran">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
                </button>
                <button type="button" class="ikon" data-png aria-label="Grafiği PNG olarak indir" title="PNG indir">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>
                </button>
              </div>
            </div>
          </div>
          <dl class="olcu" data-olcu></dl>
          <div class="grafik-kap">
            <div data-grafik class="grafik"></div>
            <img class="marka" src="/rasathane/isaret.svg" alt="" />
          </div>
          <p class="ipucu">Yakınlaştırmak için fare tekerleği ya da iki parmak. Üzerine gelince değer görünür.</p>
          <p class="atif">Grafikler <a href="https://www.tradingview.com/" target="_blank" rel="noopener">TradingView Lightweight Charts</a> ile çizilir.</p>
        </aside>
      <div class="calisma">
        <section class="sol" aria-label="Emtia panosu">
          <div class="denetim">
            <label class="alan">
              <span class="etiket">Grup</span>
              <select data-suz="grup">
                <option value="">Tümü</option>
                {suzgecGruplar.map((g) => <option value={g}>{g}</option>)}
              </select>
            </label>
            <label class="alan ara">
              <span class="etiket">Ara</span>
              <input type="search" data-ara placeholder="Emtia adı" />
            </label>
            <button type="button" class="sifirla" data-sifirla>Sıfırla</button>
          </div>
          <div class="tablo-kutu">
            <table data-tablo>
              <thead>
                <tr>
                  {panoT.sutunlar.map((s) => (
                    <th data-sirala={s.anahtar} class={s.tur === 'metin' ? 'sol' : 'sag'} aria-sort="none" tabindex="0">{s.baslik}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {panoT.satirlar.map((r) => (
                  <tr data-seri={r.seri ?? ''} data-grup={r.grup ?? ''} data-birim={r.birim ?? ''} tabindex={r.seri ? 0 : undefined}>
                    {panoT.sutunlar.map((s) => (
                      <td data-v={r[s.anahtar] ?? ''} class={`${s.tur === 'metin' ? 'sol' : 'sag'} ${isaret(s, r[s.anahtar])}`}>
                        {s.tur === 'metin' ? hucre(s, r[s.anahtar]) : gosterim(s, r[s.anahtar])}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="bos" data-bos hidden>Eşleşen emtia yok.</p>
        </section>

      </div>

      <div class="alt-bloklar">
        {hareketGecmisiVar ? (
          <div class="hareket-grup">
            <div class="sekmeler" role="tablist" aria-label="Hareket dönemi">
              {hareketGruplari.map(([anahtar, ad]) => (
                <button type="button" role="tab" data-sekme={anahtar} aria-selected={anahtar === ilkDolu ? 'true' : 'false'}>
                  {ad} <span class="sayi">{kovalar[anahtar].length}</span>
                </button>
              ))}
            </div>
            {hareketGruplari.map(([anahtar]) => (
              <div role="tabpanel" data-panel-sekme={anahtar} hidden={anahtar !== ilkDolu}>
                {kovalar[anahtar].length === 0 ? (
                  <p class="bos">Bu dönemde hareket yok.</p>
                ) : (
                  <div class="tablo-kutu"><table>
                    <thead><tr>
                      <th class="sol">Tarih</th><th class="sol">Emtia</th><th class="sol">Hareket</th><th class="sag">Kapanış</th><th class="sag">Günlük</th>
                    </tr></thead>
                    <tbody>{kovalar[anahtar].map((r) => (
                      <tr data-seri={r.seri} tabindex={0}>
                        <td class="sol" data-v={r.tarih}>{tarihGoster(r.tarih)}</td>
                        <td class="sol">{r.ad}</td>
                        <td class="sol">{r.tur}</td>
                        <td class="sag" data-v={r.kapanis}>{sayi(r.kapanis, 2)}</td>
                        <td data-v={r.gunluk} class={`sag ${isaret({ tur: 'yuzde' }, r.gunluk)}`}>{gosterim({ tur: 'yuzde', basamak: 1 }, r.gunluk)}</td>
                      </tr>))}</tbody>
                  </table></div>
                )}
              </div>
            ))}
          </div>
        ) : (
          <p class="bos">Son 90 işlem gününde hareket yok.</p>
        )}
        {merkez && (
          <section class="blok" aria-labelledby="h-merkez">
            <h2 id="h-merkez">Merkez Bankaları Altın Rezervi</h2>
            <div class="tablo-kutu"><table>
              <thead><tr>
                <th class="sol">Ülke</th><th class="sol">Dönem</th><th class="sag">Ton</th><th class="sag">Son ay (ton)</th><th class="sag">1 yıl</th>
              </tr></thead>
              <tbody>{merkez.veri.satirlar.map((r) => (
                <tr data-seri={r.seri} tabindex={0}>
                  <td class="sol">{r.ad}</td>
                  <td class="sol">{r.donem}</td>
                  <td class="sag" data-v={r.ton}>{sayi(r.ton, 0)}</td>
                  <td class="sag" data-v={r.aylik ?? ''}>{sayi(r.aylik, 1)}</td>
                  <td data-v={r.yillik ?? ''} class={`sag ${isaret({ tur: 'yuzde' }, Math.abs(r.yillik ?? 0) < 0.0005 ? 0 : r.yillik)}`}>{Math.abs(r.yillik ?? 0) < 0.0005 ? yuzde(0, 1) : gosterim({ tur: 'yuzde', basamak: 1 }, r.yillik)}</td>
                </tr>))}</tbody>
            </table></div>
            <p class="bos">Kaynak: <a href="https://data.imf.org/en/datasets//IMF.STA:IL">IMF, International Liquidity (IL)</a>. Ton değeri, IMF'nin 35 SDR/ons sabit değerli verisinden bizim hesapladığımız değerdir. Son ay verisi IMF tarafından düzeltilebilir.</p>
          </section>
        )}
        {stokT && (
          <section class="blok" aria-labelledby="b-stok">
            <h2 id="b-stok">EIA Stokları</h2>
            <div class="tablo-kutu"><table>
              <thead><tr>{stokT.sutunlar.map((s) => <th class={s.tur === 'metin' ? 'sol' : 'sag'}>{s.baslik}</th>)}</tr></thead>
              <tbody>{stokT.satirlar.map((r) => (
                <tr data-seri={r.seri ?? ''} tabindex={r.seri ? 0 : undefined}>
                  {stokT.sutunlar.map((s) => <td data-v={r[s.anahtar] ?? ''} class={`${s.tur === 'metin' ? 'sol' : 'sag'} ${isaret(s, r[s.anahtar])}`}>{s.tur === 'metin' ? hucre(s, r[s.anahtar]) : gosterim(s, r[s.anahtar])}</td>)}
                </tr>))}</tbody>
            </table></div>
          </section>
        )}
        {fonT && (
          <section class="blok" aria-labelledby="b-fon">
            <h2 id="b-fon">CFTC Fon Pozisyonları</h2>
            <div class="tablo-kutu"><table>
              <thead><tr>{fonT.sutunlar.map((s) => <th class={s.tur === 'metin' ? 'sol' : 'sag'}>{s.baslik}</th>)}</tr></thead>
              <tbody>{fonT.satirlar.map((r) => (
                <tr data-seri={r.seri ?? ''} tabindex={r.seri ? 0 : undefined}>
                  {fonT.sutunlar.map((s) => <td data-v={r[s.anahtar] ?? ''} class={`${s.tur === 'metin' ? 'sol' : 'sag'} ${isaret(s, r[s.anahtar])}`}>{s.tur === 'metin' ? hucre(s, r[s.anahtar]) : gosterim(s, r[s.anahtar])}</td>)}
                </tr>))}</tbody>
            </table></div>
          </section>
        )}
      </div>
    </>
  )}
</RasathaneKabuk>

<style>
  .ust-satir { margin: 14px 0 20px; }
  .gizli-baslik { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  h1 { margin: 0 0 6px; font-size: clamp(28px, 5vw, 36px); line-height: 1.1; letter-spacing: -0.02em; font-weight: 700; }
  .meta { margin: 0; font-size: 13px; color: var(--ikincil); }
  .yukari { color: var(--yesil); }
  .asagi { color: var(--kirmizi); }

  .etiket { display: block; margin: 0 0 6px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ikincil); }
  .denetim { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px 12px; margin: 0 0 14px; }
  .alan { display: flex; flex-direction: column; min-width: 150px; }
  .alan.ara { flex: 1 1 200px; }
  select, input[type="search"] { font: inherit; font-size: 15px; height: 40px; padding: 0 12px; border: 1px solid var(--cizgi); border-radius: 3px; background: var(--beyaz); color: var(--murekkep); }
  input[type="search"] { width: 100%; }
  select:focus-visible, input:focus-visible, button:focus-visible, th:focus-visible, tr:focus-visible, a:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }
  .sifirla { font: inherit; font-size: 14px; font-weight: 600; height: 40px; padding: 0 16px; border: 1px solid var(--murekkep); border-radius: 3px; background: transparent; color: var(--murekkep); cursor: pointer; }
  .sifirla:hover { background: var(--murekkep); color: var(--kagit); }

  .calisma { display: block; }
  .sol { min-width: 0; }
  .tablo-kutu { overflow-x: auto; -webkit-overflow-scrolling: touch; border-top: 0; }
  table { border-collapse: collapse; width: 100%; min-width: 520px; font-size: 14px; font-variant-numeric: tabular-nums; }
  th, td { padding: 10px 12px; white-space: nowrap; border-bottom: 1px solid var(--cizgi); }
  th { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ikincil); cursor: pointer; user-select: none; background: var(--kagit); position: sticky; top: 0; }
  th[aria-sort="ascending"]::after { content: " ▲"; color: var(--mavi); }
  th[aria-sort="descending"]::after { content: " ▼"; color: var(--mavi); }
  .sol { text-align: left; }
  .sag { text-align: right; }
  td:first-child { font-weight: 600; }
  tbody tr[data-seri] { cursor: pointer; }
  tbody tr:hover { background: #efeee7; }
  tbody tr.secili { background: #e7ebfa; }
  td.yukari { color: var(--yesil); }
  td.asagi { color: var(--kirmizi); }
  .bos { margin: 14px 0 0; color: var(--ikincil); }
  .bos-tum { color: var(--ikincil); }

  .sag-panel { margin: 0 0 26px; }
  .sag-panel { padding-top: 14px; }
  .panel-ust { margin: 0 0 4px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ikincil); }
  .sag-panel h2 { margin: 0 0 10px; font-size: 22px; letter-spacing: -0.01em; }
  .olcu { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px 18px; margin: 0 0 14px; padding: 12px 0; border-top: 1px solid var(--cizgi); border-bottom: 1px solid var(--cizgi); font-size: 14px; }
  /* JS ile sonradan eklenen öğeler kapsamlı (scoped) stile girmez; global seçici gerekir. */
  .olcu :global(div) { display: flex; flex-direction: column; gap: 2px; }
  .olcu :global(dt) { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ikincil); }
  .olcu :global(dd) { margin: 0; font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; }
  .grafik { height: 420px; width: 100%; }
  .grafik-kap { position: relative; }
  .grafik { position: relative; z-index: 1; }
  .marka { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 58%; max-width: 340px; height: auto; opacity: 0.07; filter: blur(1.5px); pointer-events: none; z-index: 0; }
  .ipucu { margin: 8px 0 0; font-size: 13px; color: var(--ikincil); }
  .atif { margin: 8px 0 0; font-size: 12px; color: var(--ikincil); }
  .atif a { color: var(--ikincil); text-decoration: underline; text-underline-offset: 2px; }
  .kontroller { display: flex; flex-direction: column; gap: 10px; margin: 0 0 12px; }
  .emtia-sec { position: relative; }
  .sec-liste { position: absolute; top: 100%; left: 0; z-index: 30; width: 280px; max-height: 300px; overflow-y: auto; margin: 4px 0 0; padding: 4px 0; list-style: none; background: var(--beyaz); border: 1px solid var(--cizgi); border-radius: 3px; }
  .sec-liste li { display: flex; justify-content: space-between; gap: 12px; padding: 7px 12px; font-size: 13px; cursor: pointer; color: var(--murekkep); }
  .sec-liste li:hover, .sec-liste li.aktif { background: #efeee7; }
  .sec-liste .kod { color: var(--ikincil); }
  .emtia-sec input { width: 220px; height: 34px; padding: 0 10px; font: inherit; font-size: 13px; border: 1px solid var(--cizgi); border-radius: 3px; background: var(--beyaz); color: var(--murekkep); }
  .emtia-sec input:focus-visible { outline: 2px solid var(--mavi); outline-offset: 1px; }
  section[aria-labelledby="h-takvim"] { margin-top: 22px; }
  .takvim-ac > summary { list-style: none; display: flex; align-items: center; gap: 8px; padding: 8px 0; font-size: 13px; color: var(--murekkep); cursor: pointer; border-bottom: 1px solid var(--cizgi); }
  .takvim-ac > summary::-webkit-details-marker { display: none; }
  .takvim-ac > summary::before { content: '▸'; color: var(--ikincil); }
  .takvim-ac[open] > summary::before { content: '▾'; }
  .takvim-ozet { display: flex; flex-wrap: wrap; gap: 4px 10px; }
  .ayrac { color: var(--ikincil); }
  .takvim-ac .takvim { margin-top: 10px; }
  .takvim { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .takvim-gun { display: flex; flex-direction: column; gap: 3px; min-height: 58px; padding: 7px 9px; border: 1px solid var(--cizgi); border-radius: 0; background: var(--beyaz); }
  .gun-ad { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ikincil); }
  .gun-tarih { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--murekkep); }
  .rapor-dugme { margin-top: auto; display: flex; flex-direction: column; align-items: flex-start; gap: 1px; padding: 5px 7px; font: inherit; font-size: 12px; text-align: left; color: var(--murekkep); background: transparent; border: 1px solid var(--murekkep); border-radius: 0; cursor: pointer; }
  .rapor-dugme b { font-weight: 600; }
  .rapor-dugme span { font-size: 12px; color: var(--ikincil); }
  .rapor-dugme[aria-pressed="true"] { background: var(--murekkep); color: var(--kagit); }
  .rapor-dugme[aria-pressed="true"] span { color: var(--kagit); }
  .rapor-dugme:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }
  .takvim-detay { margin: 10px 0 0; font-size: 13px; color: var(--murekkep); }
  @media (max-width: 700px) { .takvim { grid-template-columns: 1fr; } }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ust-cubuk { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .ikonlar { display: flex; gap: 6px; flex-shrink: 0; }
  .ikon { width: 36px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--murekkep); border-radius: 3px; background: transparent; color: var(--murekkep); cursor: pointer; padding: 0; }
  .ikon svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ikon:hover, .ikon.acik { background: var(--murekkep); color: var(--kagit); }
  .ikon:focus-visible { outline: 2px solid var(--mavi); outline-offset: 2px; }
  .tf { display: inline-flex; border: 1px solid var(--murekkep); border-radius: 3px; overflow: hidden; }
  .tf button { font: inherit; font-size: 13px; font-weight: 600; height: 32px; padding: 0 12px; border: 0; background: transparent; color: var(--murekkep); cursor: pointer; }
  .tf button[aria-pressed="true"] { background: var(--murekkep); color: var(--kagit); }
  .tf button:focus-visible { outline: 2px solid var(--mavi); outline-offset: -2px; }
  .gosterge-satiri { display: flex; flex: 1 1 320px; flex-wrap: wrap; gap: 6px; font-size: 12px; color: var(--ikincil); }
  .gosterge-satiri :global(label) { display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px; border: 1px solid var(--cizgi); border-radius: 999px; cursor: pointer; color: var(--murekkep); white-space: nowrap; }
  .gosterge-satiri :global(i) { display: inline-block; width: 9px; height: 9px; border-radius: 50%; }
  .tam:hover { background: var(--murekkep); color: var(--kagit); }
  .sag-panel:fullscreen, .sag-panel.tam-ekran { background: var(--kagit); padding: 20px; overflow: auto; }
  .sag-panel.tam-ekran { position: fixed; inset: 0; z-index: 60; width: auto; }
  .sag-panel:fullscreen .grafik, .sag-panel.tam-ekran .grafik { height: calc(100vh - 230px); min-height: 320px; }

  .alt-bloklar { display: grid; grid-template-columns: 1fr; gap: 30px; margin-top: 34px; }
  .sayi { font-size: 13px; font-weight: 600; color: var(--ikincil); margin-left: 4px; }
  .sekmeler { display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid var(--cizgi); margin: 0 0 14px; }
  .sekmeler button { font: inherit; font-size: 14px; padding: 10px 14px; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; background: transparent; color: var(--ikincil); cursor: pointer; white-space: nowrap; }
  .sekmeler button:hover { color: var(--murekkep); }
  .sekmeler button[aria-selected="true"] { color: var(--murekkep); font-weight: 600; border-bottom-color: var(--mavi); }
  .sekmeler button:focus-visible { outline: 2px solid var(--mavi); outline-offset: -2px; }
  .blok h2 { margin: 0 0 10px; font-size: 18px; letter-spacing: -0.01em; }
  .blok { min-width: 0; }

  @media (max-width: 1024px) {
    .grafik { height: 260px; }
  }
</style>

<script>
  import { createChart, LineSeries, LineStyle, createSeriesMarkers } from 'lightweight-charts';
  import { GOSTERGE, KIJUN } from '../../../lib/rasathane/gostergeler.mjs';

  const panoTablo = document.querySelector('[data-tablo]');
  const govde = panoTablo.querySelector('tbody');
  const satirlar = [...govde.querySelectorAll('tr')];
  const bos = document.querySelector('[data-bos]');
  const aramaKutusu = document.querySelector('[data-ara]');
  const grupSecim = document.querySelector('[data-suz="grup"]');
  const panel = document.querySelector('[data-panel]');
  const panelUst = document.querySelector('[data-panel-ust]');
  const panelBaslik = document.querySelector('[data-panel-baslik]');
  const olcu = document.querySelector('[data-olcu]');
  const grafikKap = document.querySelector('[data-grafik]');
  let siraliAnahtar = null;
  let yon = 1;
  let grafik = null;
  let secili = null;

  function filtrele() {
    const aranan = aramaKutusu.value.trim().toLocaleLowerCase('tr');
    const grup = grupSecim.value;
    let gorunen = 0;
    for (const tr of satirlar) {
      const grupTamam = !grup || tr.dataset.grup === grup;
      const aramaTamam = !aranan || tr.textContent.toLocaleLowerCase('tr').includes(aranan);
      const goster = grupTamam && aramaTamam;
      tr.hidden = !goster;
      if (goster) gorunen++;
    }
    bos.hidden = gorunen !== 0;
  }

  function sirala(anahtar) {
    yon = siraliAnahtar === anahtar ? -yon : 1;
    siraliAnahtar = anahtar;
    const basliklar = [...panoTablo.querySelectorAll('thead th')];
    const idx = basliklar.findIndex((th) => th.dataset.sirala === anahtar);
    basliklar.forEach((th) => th.setAttribute('aria-sort', 'none'));
    basliklar[idx].setAttribute('aria-sort', yon === 1 ? 'ascending' : 'descending');
    const sirali = [...satirlar].sort((a, b) => {
      const x = a.children[idx].dataset.v;
      const y = b.children[idx].dataset.v;
      const sx = x === '' ? null : Number(x);
      const sy = y === '' ? null : Number(y);
      if (sx === null && sy === null) return 0;
      if (sx === null) return 1;
      if (sy === null) return -1;
      if (Number.isNaN(sx) || Number.isNaN(sy)) return yon * x.localeCompare(y, 'tr');
      return yon * (sx - sy);
    });
    sirali.forEach((tr) => govde.appendChild(tr));
  }

  // Her satır (pano, oranlar, hareketler, stoklar, fonlar) aynı panelde açılır: tek ekran.
  function ayrintiyiAc(tr) {
    const tablo = tr.closest('table');
    const basliklar = [...tablo.querySelectorAll('thead th')].map((th) => th.textContent.trim());
    const hucreler = [...tr.children];
    const ad = hucreler[0]?.textContent.trim() ?? '';
    secili?.classList.remove('secili');
    secili = tr;
    tr.classList.add('secili');

    panel.hidden = false;
    const meta = [];
    if (tr.dataset.grup) meta.push(tr.dataset.grup);
    if (tr.dataset.birim) meta.push(tr.dataset.birim);
    panelBaslik.textContent = ad;
    // Yahoo sembolü (ör. GC=F): veriyi kaynağıyla birlikte gösterir; sembolü olmayan satırlarda yok.
    const sembol = tr.dataset.seri ?? '';
    if (/^[A-Z0-9^.=-]+$/.test(sembol) && !/^(cftc|eia)-/.test(sembol)) {
      const kod = document.createElement('span');
      kod.textContent = sembol;
      kod.style.cssText = 'font-size: 13px; font-weight: 400; color: #6f6b62; margin-left: 10px;';
      panelBaslik.append(kod);
    }
    olcu.innerHTML = '';
    hucreler.slice(1).forEach((td, i) => {
      const etiket = basliklar[i + 1];
      if (!etiket) return;
      // Grup ve birim başlığın altında tek satır olarak; ölçüler ayrı listede.
      if (etiket === 'Grup' || etiket === 'Birim') { meta.push(td.textContent.trim()); return; }
      const div = document.createElement('div');
      const dt = document.createElement('dt');
      dt.textContent = etiket;
      const dd = document.createElement('dd');
      dd.textContent = td.textContent.trim();
      // Ölçü değerleri de işaretine göre renklenir (yükseliş yeşil, düşüş kırmızı).
      if (dd.textContent.includes('▲')) dd.style.color = '#1f7a4d';
      else if (dd.textContent.includes('▼')) dd.style.color = '#b3382c';
      div.append(dt, dd);
      olcu.append(div);
    });
    panelUst.textContent = meta.filter(Boolean).join(' · ');
    aktifSatir = tr;
    ciz();
  }

  // Zaman aralığı ve göstergeler ortak tanımdan gelir (src/lib/rasathane/gostergeler.mjs).
  const onbellek = new Map();
  const secilenGosterge = new Set();
  let tf = 'gunluk';
  let aktifSatir = null;
  const gosterge = document.querySelector('[data-gostergeler]');

  function gostergeKutulariniYaz() {
    gosterge.innerHTML = '';
    const liste = [...GOSTERGE[tf], ...KIJUN];
    for (const g of liste) {
      const etiket = document.createElement('label');
      etiket.className = 'gosterge';
      const kutu = document.createElement('input');
      kutu.type = 'checkbox';
      kutu.checked = secilenGosterge.has(g.k);
      kutu.addEventListener('change', () => {
        kutu.checked ? secilenGosterge.add(g.k) : secilenGosterge.delete(g.k);
        ciz();
      });
      const renk = document.createElement('i');
      renk.style.background = g.renk;
      etiket.append(kutu, renk, document.createTextNode(' ' + g.ad));
      gosterge.append(etiket);
    }
  }

  async function veriAl(seri, zaman = tf) {
    const dosya = zaman === 'hafta' ? `${seri}-hafta` : seri;
    if (!onbellek.has(dosya)) {
      const yanit = await fetch(`/rasathane/veri/emtia/seri/${dosya}.json`);
      if (!yanit.ok) throw new Error(String(yanit.status));
      onbellek.set(dosya, await yanit.json());
    }
    return onbellek.get(dosya);
  }

  // Eski biçim (noktalar) ve yeni biçim (tarihler + sutunlar) birlikte desteklenir.
  function bicimle(d) {
    if (d.noktalar) return { tarihler: d.noktalar.map((p) => p[0]), sutunlar: { kapanis: d.noktalar.map((p) => p[1]) } };
    return { tarihler: d.tarihler, sutunlar: d.sutunlar };
  }
  const nokta = (tarihler, degerler) =>
    tarihler.map((t, i) => ({ time: t, value: degerler[i] })).filter((p) => p.value !== null && p.value !== undefined);

  async function ciz() {
    if (!aktifSatir) return;
    const seri = aktifSatir.dataset.seri;
    if (grafik) { grafik.remove(); grafik = null; }
    grafikKap.textContent = '';
    if (!seri) { grafikKap.textContent = 'Bu satır için grafik yok.'; return; }
    try {
      const ham = await veriAl(seri, tf);
      const { tarihler, sutunlar } = bicimle(ham);
      grafik = createChart(grafikKap, {
        autoSize: true,
        layout: { background: { color: 'rgba(0, 0, 0, 0)' }, textColor: '#5d5b55', fontFamily: 'Inter, system-ui, sans-serif', fontSize: 12 },
        grid: { vertLines: { color: '#e9e7df' }, horzLines: { color: '#e9e7df' } },
        rightPriceScale: { borderColor: '#cfccc2' },
        timeScale: { borderColor: '#cfccc2', timeVisible: false },
      });
      const kapanis = grafik.addSeries(LineSeries, { color: '#151515', lineWidth: 2, title: 'Kapanış' });
      kapanis.setData(nokta(tarihler, sutunlar.kapanis));
      const gunler = new Set(tarihler);
      const isaretler = (ham.isaretler ?? [])
        .filter(([t]) => gunler.has(t))
        .map(([t, m]) => ({ time: t, position: 'aboveBar', shape: 'circle', color: '#b3382c', text: m }));
      if (isaretler.length) createSeriesMarkers(kapanis, isaretler);
      // Kijun: günlük ve haftalık ayrı göstergeler; her biri kendi kutusuyla açılır/kapanır.
      for (const k of KIJUN) {
        if (!secilenGosterge.has(k.k)) continue;
        const kaynak = bicimle(await veriAl(seri, k.dosya));
        if (!kaynak.sutunlar.kijun) continue;
        const cizgi = grafik.addSeries(LineSeries, {
          color: k.renk, lineWidth: 1, title: k.ad,
          lineStyle: LineStyle.Dashed, priceLineVisible: false, lastValueVisible: false,
        });
        cizgi.setData(nokta(kaynak.tarihler, kaynak.sutunlar.kijun));
      }
      for (const g of GOSTERGE[tf]) {
        if (!sutunlar[g.k] || !secilenGosterge.has(g.k)) continue;
        const cizgi = grafik.addSeries(
          LineSeries,
          {
            color: g.renk, lineWidth: 1, title: g.ad,
            lineStyle: g.kesik ? LineStyle.Dashed : LineStyle.Solid,
            priceLineVisible: false, lastValueVisible: false,
          },
          g.pane ?? 0,
        );
        cizgi.setData(nokta(tarihler, sutunlar[g.k]));
      }
      grafik.timeScale().fitContent();
    } catch {
      grafikKap.textContent = 'Grafik yüklenemedi.';
    }
  }

  document.querySelectorAll('[data-tf]').forEach((dugme) => {
    dugme.addEventListener('click', () => {
      tf = dugme.dataset.tf;
      document.querySelectorAll('[data-tf]').forEach((d) => d.setAttribute('aria-pressed', String(d === dugme)));
      gostergeKutulariniYaz();
      ciz();
    });
  });
  gostergeKutulariniYaz();

  // Tam ekran: önce açık katman kapanır; tarayıcı API'si varsa onu kullanır, yoksa sayfa üstü katman.
  const tamDugme = document.querySelector('[data-tam-ekran]');
  const tamMetni = () => {
    const acik = panel.classList.contains('tam-ekran') || document.fullscreenElement === panel;
    tamDugme.setAttribute('aria-label', acik ? 'Tam ekrandan çık' : 'Grafiği tam ekran aç');
    tamDugme.title = acik ? 'Kapat' : 'Tam ekran';
    tamDugme.classList.toggle('acik', acik);
  };
  tamDugme.addEventListener('click', async () => {
    if (panel.classList.contains('tam-ekran')) {
      panel.classList.remove('tam-ekran');
    } else if (document.fullscreenElement === panel) {
      await document.exitFullscreen();
    } else {
      let tamamlandi = false;
      if (document.fullscreenEnabled) {
        try {
          await panel.requestFullscreen();
          tamamlandi = true;
        } catch {}
      }
      if (!tamamlandi) panel.classList.add('tam-ekran');
    }
    tamMetni();
  });
  document.addEventListener('fullscreenchange', tamMetni);

  // Grafiği PNG olarak indir: çizgiler, göstergeler ve çizimler dahil (chart ekran görüntüsü).
  document.querySelector('[data-png]').addEventListener('click', async () => {
    if (!grafik) return;
    const ekran = grafik.takeScreenshot();
    const ust = 64;
    const tuval = document.createElement('canvas');
    tuval.width = ekran.width;
    tuval.height = ekran.height + ust;
    const g = tuval.getContext('2d');
    g.fillStyle = '#f4f3ee';
    g.fillRect(0, 0, tuval.width, tuval.height);
    g.fillStyle = '#151515';
    g.font = '600 20px Inter, system-ui, sans-serif';
    g.fillText(`${panelBaslik.textContent.trim()} · ${tf === 'hafta' ? 'Haftalık' : 'Günlük'}`, 20, 32);
    g.fillStyle = '#6f6b62';
    g.font = '13px Inter, system-ui, sans-serif';
    g.fillText([panelUst.textContent, document.querySelector('.marka-metin small')?.textContent].filter(Boolean).join(' · '), 20, 52);
    try {
      const isaret = new Image();
      isaret.src = '/rasathane/isaret.svg';
      await isaret.decode();
      g.drawImage(isaret, tuval.width - 46, 14, 30, 30);
    } catch {}
    try {
      const filigran = new Image();
      filigran.src = '/rasathane/isaret.svg';
      await filigran.decode();
      const en = Math.min(tuval.width * 0.5, 340);
      g.globalAlpha = 0.07;
      g.drawImage(filigran, (tuval.width - en) / 2, ust + (ekran.height - en) / 2, en, en);
      g.globalAlpha = 1;
    } catch {}
    g.drawImage(ekran, 0, ust);
    tuval.toBlob((blob) => {
      if (!blob) return;
      const ad = panelBaslik.textContent.trim().toLocaleLowerCase('tr').replace(/\s+/g, '-');
      const baglanti = document.createElement('a');
      baglanti.download = `rasathane-${ad}-${tf}.png`;
      baglanti.href = URL.createObjectURL(blob);
      baglanti.click();
      setTimeout(() => URL.revokeObjectURL(baglanti.href), 1000);
    }, 'image/png');
  });

  // Diğer tablolar (hareketler, EIA, CFTC): sütun başlığına tıklayınca sıralanır.
  document.querySelectorAll('table:not([data-tablo])').forEach((tbl) => {
    const govdeT = tbl.querySelector('tbody');
    tbl.querySelectorAll('thead th').forEach((th, idx) => {
      th.style.cursor = 'pointer';
      th.tabIndex = 0;
      let yonT = 0;
      const sirala = () => {
        yonT = yonT === 1 ? -1 : 1;
        const deger = (tr) => tr.children[idx]?.dataset.v ?? tr.children[idx]?.textContent.trim() ?? '';
        [...govdeT.querySelectorAll('tr')]
          .sort((a, b) => {
            const x = deger(a);
            const y = deger(b);
            const sx = x === '' ? null : Number(x);
            const sy = y === '' ? null : Number(y);
            if (sx === null && sy === null) return 0;
            if (sx === null) return 1;
            if (sy === null) return -1;
            if (Number.isNaN(sx) || Number.isNaN(sy)) return yonT * x.localeCompare(y, 'tr');
            return yonT * (sx - sy);
          })
          .forEach((tr) => govdeT.appendChild(tr));
      };
      th.addEventListener('click', sirala);
      th.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          sirala();
        }
      });
    });
  });

  // Grafik üstündeki emtia seçimi (kendi listesi): tabloya inmeden grafik değişir.
  const secKutu = document.querySelector('[data-emtia-sec]');
  const secListe = document.querySelector('[data-sec-liste]');
  const secSecenekler = [...secListe.querySelectorAll('li')];
  const secAc = (acik) => { secListe.hidden = !acik; };
  const secSec = (li) => {
    secKutu.value = li.dataset.ad;
    secAc(false);
    const satir = document.querySelector(`[data-tablo] tbody tr[data-seri="${li.dataset.seri}"]`);
    if (satir) ayrintiyiAc(satir);
  };
  const secFiltre = () => {
    const aranan = secKutu.value.trim().toLocaleLowerCase('tr');
    let gorunen = 0;
    for (const li of secSecenekler) {
      li.classList.remove('aktif');
      const goster = !aranan || li.dataset.ad.toLocaleLowerCase('tr').includes(aranan);
      li.hidden = !goster;
      if (goster) gorunen++;
    }
    secAc(gorunen > 0);
  };
  secKutu.addEventListener('focus', secFiltre);
  secKutu.addEventListener('input', secFiltre);
  secListe.addEventListener('mousedown', (e) => {
    const li = e.target.closest('li');
    if (li) {
      e.preventDefault();
      secSec(li);
    }
  });
  secKutu.addEventListener('keydown', (e) => {
    const gorunenler = secSecenekler.filter((li) => !li.hidden);
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (!gorunenler.length) return;
      const i = gorunenler.findIndex((li) => li.classList.contains('aktif'));
      const yeni = e.key === 'ArrowDown' ? (i + 1) % gorunenler.length : i <= 0 ? gorunenler.length - 1 : i - 1;
      gorunenler.forEach((li) => li.classList.remove('aktif'));
      gorunenler[yeni].classList.add('aktif');
      gorunenler[yeni].scrollIntoView({ block: 'nearest' });
      secAc(true);
    }
    if (e.key === 'Enter') {
      e.preventDefault();
      const hedef = gorunenler.find((li) => li.classList.contains('aktif')) ?? gorunenler[0];
      if (hedef) secSec(hedef);
    }
    if (e.key === 'Escape') secAc(false);
  });
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.emtia-sec')) secAc(false);
  });

  // Takvim: rapor gününe tıklanınca o raporun ne içerdiği görünür.
  document.querySelectorAll('[data-rapor]').forEach((dugme) => {
    dugme.addEventListener('click', () => {
      const detay = document.querySelector('[data-takvim-detay]');
      const acikMi = dugme.getAttribute('aria-pressed') === 'true';
      document.querySelectorAll('[data-rapor]').forEach((d) => d.setAttribute('aria-pressed', 'false'));
      if (acikMi) {
        detay.hidden = true;
        return;
      }
      dugme.setAttribute('aria-pressed', 'true');
      detay.textContent = `${dugme.querySelector('b').textContent}: ${dugme.dataset.rapor}`;
      detay.hidden = false;
    });
  });

  // Hareket dönemleri sekmeleri.
  document.querySelectorAll('[data-sekme]').forEach((dugme) => {
    dugme.addEventListener('click', () => {
      const hedef = dugme.dataset.sekme;
      document.querySelectorAll('[data-sekme]').forEach((d) => d.setAttribute('aria-selected', String(d === dugme)));
      document.querySelectorAll('[data-panel-sekme]').forEach((p) => { p.hidden = p.dataset.panelSekme !== hedef; });
    });
  });

  // Açılışta ilk emtia (Altın) seçili gelsin.
  const ilkSatir = document.querySelector('tbody tr[data-seri]');
  if (ilkSatir) ayrintiyiAc(ilkSatir);

  document.querySelectorAll('[data-sirala]').forEach((th) => {
    th.addEventListener('click', () => sirala(th.dataset.sirala));
    th.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); sirala(th.dataset.sirala); } });
  });
  document.querySelectorAll('tbody tr[data-seri]').forEach((tr) => {
    tr.addEventListener('click', () => ayrintiyiAc(tr));
    tr.addEventListener('keydown', (e) => { if (e.key === 'Enter') ayrintiyiAc(tr); });
  });
  grupSecim.addEventListener('change', filtrele);
  aramaKutusu.addEventListener('input', filtrele);
  document.querySelector('[data-sifirla]').addEventListener('click', () => {
    grupSecim.value = '';
    aramaKutusu.value = '';
    filtrele();
  });
</script>
