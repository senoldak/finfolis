---
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../../layouts/Base.astro';
import NewsCard from '../../../components/NewsCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { newsUrl, type Haber } from '../../../lib/news';
import { jsonLdMetni } from '../../../lib/json-ld.mjs';
import { konuSayfalari, konuUrl } from '../../../lib/konu-sayfalari';
import type { Konu } from '../../../lib/konular.mjs';
import { SITE_URL, WEBSITE_ID, kisalt } from '../../../lib/seo';

// Yalnızca en az üç haberi olan konuların sayfası üretilir (src/lib/konular.mjs, KONU_ESIGI).
// Sayfa başına 30 yazı; kategori sayfalarıyla aynı düzen: /konu/<x>/, /konu/<x>/2/ …
export const getStaticPaths = (async ({ paginate }) => {
  const sayfalar = await konuSayfalari();
  return sayfalar.flatMap(({ konu, haberler }) =>
    paginate(haberler, { params: { slug: konu.slug }, props: { konu }, pageSize: 30 }),
  );
}) satisfies GetStaticPaths;

interface Props {
  konu: Konu;
  page: Page<Haber>;
}

const { konu, page } = Astro.props;
const items = page.data;
const ilkSayfa = page.currentPage === 1;
const sayfaEki = ilkSayfa ? '' : ` · Sayfa ${page.currentPage}`;
const baslik = `${konu.ad} haberleri${sayfaEki}`;
const description = ilkSayfa
  ? kisalt(`${konu.ad} ile ilgili son haberler. ${konu.giris.split(/(?<=\.)\s/)[0]}`, 160)
  : `${konu.ad} ile ilgili haberler, sayfa ${page.currentPage}.`;
const egik = (u?: string) => (u ? (u.endsWith('/') ? u : `${u}/`) : undefined);
const onceki = egik(page.url.prev);
const sonraki = egik(page.url.next);
const pageUrl = `${SITE_URL}${egik(page.url.current)}`;
const konuTamUrl = `${SITE_URL}${konuUrl(konu.slug)}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': pageUrl,
      url: pageUrl,
      name: baslik,
      description,
      inLanguage: 'tr',
      isPartOf: { '@id': WEBSITE_ID },
      about: { '@type': konu.schema, name: konu.tamAd, ...(konu.sameAs ? { sameAs: konu.sameAs } : {}) },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: items.map((h, i) => ({
          '@type': 'ListItem',
          position: page.start + i + 1,
          url: `${SITE_URL}${newsUrl(h)}`,
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Konular', item: `${SITE_URL}/konu/` },
        { '@type': 'ListItem', position: 3, name: konu.ad, item: konuTamUrl },
        ...(ilkSayfa ? [] : [{ '@type': 'ListItem', position: 4, name: `Sayfa ${page.currentPage}`, item: pageUrl }]),
      ],
    },
  ],
};
---

<Base title={baslik} description={description}>
  <script slot="head" type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  <div class="container">
    <Breadcrumb
      yol={[
        { ad: 'Anasayfa', href: '/' },
        { ad: 'Konular', href: '/konu/' },
        { ad: konu.ad, href: konuUrl(konu.slug) },
        ...(ilkSayfa ? [] : [{ ad: `Sayfa ${page.currentPage}` }]),
      ]}
    />
    <header class="sayfa-bas sayfa-bas-duz">
      <h1>{konu.ad}{!ilkSayfa && <span class="sayfa-no"> · Sayfa {page.currentPage}</span>}</h1>
      <p>{page.total} haber</p>
    </header>
    {ilkSayfa && <p class="sayfa-giris">{konu.giris}</p>}
    <div class="liste liste-iki">
      {items.map((h) => <NewsCard haber={h} />)}
    </div>
    {
      page.lastPage > 1 && (
        <nav class="sayfalar" aria-label="Sayfalar">
          {onceki ? <a href={onceki}>← Daha yeni</a> : <span />}
          <span>
            Sayfa {page.currentPage} / {page.lastPage}
          </span>
          {sonraki ? <a href={sonraki}>Daha eski →</a> : <span />}
        </nav>
      )
    }
    <p class="veri-notu konu-notu">
      Bu sayfadaki haberler, konunun adı başlıkta, özette ya da metinde birden çok kez geçtiği için otomatik olarak
      listelenir. <a href="/konu/">Tüm konular</a>
    </p>
  </div>
</Base>
