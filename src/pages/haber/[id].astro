---
import { Image, getImage } from 'astro:assets';
import YasalUyari from '../../components/YasalUyari.astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RakamSeridi from '../../components/RakamSeridi.astro';
import Tablo from '../../components/Tablo.astro';
import Grafik from '../../components/Grafik.astro';
import NewsCard from '../../components/NewsCard.astro';
import Kisaca from '../../components/haber/Kisaca.astro';
import AracSatiri from '../../components/haber/AracSatiri.astro';
import NasilHazirlandi from '../../components/haber/NasilHazirlandi.astro';
import DahaOnce from '../../components/haber/DahaOnce.astro';
import Degisiklikler from '../../components/haber/Degisiklikler.astro';
import Yararli from '../../components/haber/Yararli.astro';
import YerHaritasi from '../../components/haber/YerHaritasi.astro';
import '../../styles/haber.css';
import '../../styles/graf.css';
import BultenDizini from '../../components/BultenDizini.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE, category as categoryOf, categoryName, formatDate } from '../../lib/site';
import { haberAlanlari, jsonLdMetni } from '../../lib/json-ld.mjs';
import { getNews, type Haber } from '../../lib/news';
import { KAPAK_DONUSUM } from '../../lib/gorsel.mjs';
import { ICERIK_LISANSI_URL, ORG_ID, PUBLISHER_LOGO, SITE_URL, WEBSITE_ID, kisalt, sameAs } from '../../lib/seo';
import { matchEntities } from '../../lib/entities';
import { indekslenir } from '../../lib/uzunluk.mjs';
import { googleaKapali } from '../../lib/arama-gorunurluk.mjs';
import { okumaSuresi, turEtiketi } from '../../lib/yazi-bilgisi.mjs';
import { duzeltmeNotu } from '../../lib/duzeltme.mjs';
import { resmiKaynaklar, adsizKaynakSatiri } from '../../lib/resmi-kaynak.mjs';
import { haberKaynaklari } from '../../lib/kaynak-adlari.mjs';
import { YAZAR, yazarSemasi, yazarUrl, kisiYazariMi } from '../../lib/yazar.mjs';
import { yapayZekaNotu, hataBildirAdresi, NASIL_BASLIK, YZ_SAYFASI } from '../../lib/yapay-zeka-notu.mjs';
import { adimlar } from '../../lib/yayin-ekibi.mjs';
import { dahaOnce } from '../../lib/daha-once.mjs';
import { ilBul } from '../../lib/yer-haritasi.mjs';
import { satirParcalari } from '../../lib/kunye.mjs';
import { analizMi } from '../../lib/yazi-turu.mjs';
import { ilgiliSec } from '../../lib/ilgili.mjs';
import { yazininKonulari, konuUrl } from '../../lib/konu-sayfalari';
import type { Konu } from '../../lib/konular.mjs';

export async function getStaticPaths() {
  const news = await getNews();
  // İlgili yazılar ortak varlıklara (kurum, şirket, ürün) göre seçilir; bülten ve kısa (noindex) yazı aday olmaz.
  const ogeler = news.map((h) => ({
    id: h.id,
    kategori: h.data.category,
    tarih: h.data.date.valueOf(),
    varliklar: matchEntities(`${h.data.title} ${h.data.description}`).map((e) => e.name),
    aday: h.data.tur !== 'bulten' && indekslenir(h.body),
  }));
  const idIle = new Map(news.map((h) => [h.id, h]));
  return Promise.all(
    news.map(async (haber, i) => ({
      params: { id: haber.id },
      props: {
        haber,
        related: ilgiliSec(ogeler[i], ogeler).map((id) => idIle.get(id)!),
        // Yazının geçtiği ve sayfası olan konular (src/lib/konular.mjs).
        konular: await yazininKonulari(haber),
        // Aynı konudaki eski yazılar (src/lib/daha-once.mjs); ilgili haberlerde tekrar edilmez.
        once: dahaOnce(ogeler[i], ogeler).map((id) => idIle.get(id)!),
      },
    })),
  );
}

interface Props {
  haber: Haber;
  related: Haber[];
  konular: Konu[];
  once: Haber[];
}

const { haber, konular, once } = Astro.props;
const related = Astro.props.related.filter((h) => !once.includes(h));
const { title, description, date, category, coverAlt, rakamlar, sirada, tablo, grafik, kaynaklar } = haber.data;
const duzeltme = duzeltmeNotu(haber.data, 'tr');
// Resmî kaynaklı haberde kurumun bağlantısı. Medya kaynaklı haberde yayının adı ve haberine bağlantı, derlemede şifreli
// kaynak izinden (src/lib/kaynak-adlari.mjs; hukuki koşullarla); çözülemezse ya da bültende adsız satır kalır.
const resmi = resmiKaynaklar(haber.data);
const medya = haberKaynaklari(haber.data);
const adsizKaynak = medya.length ? null : adsizKaynakSatiri(haber.data);
// Kısa yazılar bütün arama motorlarına kapalı (noindex, follow). Akış çevirileri, bültenler ve kalıp piyasa yazıları
// yalnız Google'a kapalı (googlebot);
// ikisi de site haritalarında yok (src/lib/arama-gorunurluk.mjs).
const noindex = !indekslenir(haber.body);
const googleNoindex = googleaKapali({ tur: haber.data.tur, icerikTuru: haber.data.icerikTuru, author: haber.data.author, uretim: haber.data.uretim, kaynaklar });
// Kapak her yaşta derlenir (dosya bütçesi: src/lib/gorsel.mjs).
const cover = haber.data.cover;
const { Content, headings } = await render(haber);
const cat = categoryOf(category);
const turEtiket = turEtiketi(haber.data);
const okumaDk = okumaSuresi(haber.body);

// og:image ve JSON-LD görseli: 1200px JPEG (Google Discover en az 1200px ister).
// Sayfadaki resim de aynı dönüşümü kullanır; dist'te tek dosya olur.
const og = cover ? await getImage({ src: cover, ...KAPAK_DONUSUM }) : undefined;
const ogImage = og?.src;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : new URL('/og-default.png', Astro.site).href;
const ogWidth = og ? Number(og.attributes.width) : 1200;
const ogHeight = og ? Number(og.attributes.height) : 630;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
// Sayfa sonundaki tek yapay zekâ notu: bot yazısı ve sahip yazısı için ayrı metin (src/lib/yapay-zeka-notu.mjs).
const yzNotu = yapayZekaNotu(haber.data, title, pageUrl);
// "Bu yazı nasıl hazırlandı" kartı adımı olan yazılarda (bot, zincir, sahibin yazısı); bülten ve elle yazı eski notu alır.
const kartVar = adimlar(haber.data).length > 0;
// Yer haritası ve contentLocation: ön bilgide il adı varsa (yalnız yer haberin özüyse yazılır).
const il = haber.data.yer ? ilBul(haber.data.yer) : null;
const published = date.toISOString();
// Değiştirilme tarihi: ön bilgide updated varsa o (yayından önceyse yok sayılır), yoksa yayın tarihi.
const updated = haber.data.updated && haber.data.updated > date ? haber.data.updated : undefined;
const modified = (updated ?? date).toISOString();
const catUrl = `${SITE_URL}/kategori/${cat.slug}/`;

const entities = matchEntities(`${title} ${description}`);

const articleSchema: Record<string, any> = {
  '@type': analizMi(haber.data) ? 'AnalysisNewsArticle' : 'NewsArticle',
  '@id': `${pageUrl}#article`,
  headline: kisalt(title, 110),
  description,
  image: [
    {
      '@type': 'ImageObject',
      url: ogImageUrl,
      width: ogWidth,
      height: ogHeight,
    },
  ],
  datePublished: published,
  dateModified: modified,
  // Görünen yazar her yazıda aynıdır (src/lib/yazar.mjs); ön bilgideki author alanı kullanılmaz.
  author: kisiYazariMi(haber.data) ? yazarSemasi(SITE_URL, ORG_ID) : { '@id': ORG_ID },
  // Yayıncının tek tanımı Base.astro'daki Organization düğümünde (src/lib/seo.ts); aynı @id ile çelişen ikinci logo yazılmaz.
  publisher: { '@id': ORG_ID },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  url: pageUrl,
  articleSection: analizMi(haber.data) ? [cat.name, 'Analiz'] : cat.name,
  inLanguage: 'tr',
  license: ICERIK_LISANSI_URL,
  isAccessibleForFree: true,
  isPartOf: { '@id': WEBSITE_ID },
};

if (entities.length > 0) {
  articleSchema.about = entities;
}
Object.assign(
  articleSchema,
  haberAlanlari({
    kaynaklar: resmi,
    medya,
    yer: il ? { ad: il.ad, boylam: il.m[0], enlem: il.m[1] } : null,
    duzeltme: haber.data.duzeltme,
    guncellendi: updated,
  }),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    articleSchema,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: cat.name, item: catUrl },
        { '@type': 'ListItem', position: 3, name: kisalt(title, 110), item: pageUrl },
      ],
    },
  ],
};
---

<Base
  title={title}
  description={description}
  image={ogImage}
  imageWidth={ogWidth}
  imageHeight={ogHeight}
  imageAlt={coverAlt ?? title}
  type="article"
  noindex={noindex}
  googleNoindex={googleNoindex}
>
  <Fragment slot="head">
    <meta name="author" content={kisiYazariMi(haber.data) ? YAZAR.ad : SITE.name} />
    {kisiYazariMi(haber.data) && <meta property="article:author" content={yazarUrl(SITE_URL)} />}
    <meta property="article:published_time" content={published} />
    <meta property="article:modified_time" content={modified} />
    <meta property="article:section" content={categoryName(category)} />
    <script type="application/ld+json" set:html={jsonLdMetni(jsonLd)} />
  </Fragment>

  <div class="container">
    <article class="makale">
      <Breadcrumb yol={[{ ad: 'Anasayfa', href: '/' }, { ad: cat.name, href: `/kategori/${cat.slug}/` }, { ad: kisalt(title, 70) }]} />
      <header class={`makale-bas ink-${cat.ink}`}>
        <h1>{title}</h1>
        <p class="makale-spot">{description}</p>
        <p class="kunye">
          <a href={`/kategori/${cat.slug}/`} class="kunye-kat">
            {cat.name}
          </a>
          {turEtiket && <span class="kunye-tur">{turEtiket}</span>}
          <span>
            Yazan: {kisiYazariMi(haber.data) ? <a rel="author" href={YAZAR.yol}>{YAZAR.ad}</a> : <strong>{SITE.name}</strong>}
          </span>
          <time datetime={date.toISOString()}>{formatDate(date, true)}</time>
          {okumaDk >= 2 && <span>{okumaDk} dk okuma</span>}
          {updated && (
            <span>
              Güncellendi: <time datetime={modified}>{formatDate(updated, true)}</time>
            </span>
          )}
        </p>
        <AracSatiri url={pageUrl} baslik={title} />
      </header>

      <Kisaca whyMatters={haber.data.why_matters} keyPoints={haber.data.key_points} />

      <RakamSeridi rakamlar={rakamlar} bas />

      {haber.data.tur === 'bulten' && <BultenDizini govde={haber.body} basliklar={headings} />}

      {
        cover && haber.data.coverSitede && (
          <figure class="makale-resim">
            <Image
              src={cover}
              alt={coverAlt ?? title}
              {...KAPAK_DONUSUM}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {tablo && <Tablo tablo={tablo} kaynak={kaynaklar[0]} tarih={date} />}
      {!tablo && grafik && <Grafik grafik={grafik} kaynak={kaynaklar[0]} tarih={date} />}

      <RakamSeridi sirada={sirada} />

      {il && <YerHaritasi yer={il.ad} />}

      {
        konular.length > 0 && (
          <nav class="konu-etiketleri" aria-label="Konular">
            <span>Konular</span>
            {konular.map((k) => (
              <a href={konuUrl(k.slug)}>{k.ad}</a>
            ))}
          </nav>
        )
      }

      <Degisiklikler duzeltme={duzeltme} guncellendi={updated} />

      <DahaOnce yazilar={once} baslik={title} tarih={date} />

      {
        resmi.length > 0 && (
          <p class="resmi-kaynak" id="kaynaklar">
            {resmi.length > 1 ? 'Resmî kaynaklar:' : 'Resmî kaynak:'}{' '}
            {resmi.map((k, i) => (
              <>
                {i > 0 && ', '}
                <a href={k.url} rel="noopener">{k.ad}</a>
              </>
            ))}
          </p>
        )
      }

      {
        medya.length > 0 && (
          <p class="resmi-kaynak" id="kaynaklar">
            {medya.length > 1 ? 'Kaynaklar:' : 'Kaynak:'}{' '}
            {medya.map((k, i) => (
              <>
                {i > 0 && ', '}
                <a href={k.url} rel="nofollow noopener">{k.ad}</a>
              </>
            ))}
          </p>
        )
      }

      {adsizKaynak && <p class="resmi-kaynak">{adsizKaynak}</p>}

      {
        kartVar ? (
          <NasilHazirlandi veri={haber.data} hataAdresi={hataBildirAdresi(title, pageUrl)} yayin={date} guncellendi={updated} kaynakSayisi={resmi.length + medya.length} medya={medya.length} />
        ) : yzNotu.satirlar ? (
          <section class="uretim-notu nasil-hazirlandi" aria-labelledby="nasil-hazirlandi">
            <h2 id="nasil-hazirlandi" class="nasil-baslik">{NASIL_BASLIK}</h2>
            <dl>
              {yzNotu.satirlar.map((s) => (
                <div>
                  <dt>{s.etiket}</dt>
                  <dd>{satirParcalari(s.metin, s.baglanti).map((x) => (x.adres ? <a href={x.adres}>{x.metin}</a> : x.metin))}</dd>
                </div>
              ))}
            </dl>
            <p class="nasil-baglantilar">
              <a href={yzNotu.baglanti}>{yzNotu.baglantiMetni}</a> · <a href={YZ_SAYFASI.adres}>{YZ_SAYFASI.metin}</a>
            </p>
          </section>
        ) : (
          <p class="uretim-notu">
            {yzNotu.metin} <a href={yzNotu.baglanti}>{yzNotu.baglantiMetni}</a>
          </p>
        )
      }

      <YasalUyari />

      <Yararli slug={haber.id} />

      {SITE.social.telegram && (
        <p class="kanal-notu">
          Yeni haberler <a href={SITE.social.telegram} rel="noopener" target="_blank">Telegram kanalımızda</a>.
        </p>
      )}
    </article>

    {
      related.length > 0 && (
        <section class="bolum ilgili">
          <h2 class="bolum-baslik">İlgili haberler</h2>
          <div class="liste liste-iki">
            {related.map((h) => (
              <NewsCard haber={h} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

<script>
  // Okur araçları: yazı boyu, Dinle, Paylaş, sözcük açıklaması, "Bu haber işine yaradı mı?".
  import '../../scripts/okur-araclari.ts';
  // Yazı grafikleri (src/lib/graf/yazi-grafik.mjs): dokununca ve üzerine gelince değer.
  import '../../scripts/graf.mjs';
</script>
