---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RakamSeridi from '../../components/RakamSeridi.astro';
import Tablo from '../../components/Tablo.astro';
import Grafik from '../../components/Grafik.astro';
import NewsCard from '../../components/NewsCard.astro';
import SentezBlok from '../../components/SentezBlok.astro';
import { SITE, category as categoryOf, categoryName, formatDate } from '../../lib/site';
import { getNews, type Haber } from '../../lib/news';
import { gorselVar } from '../../lib/gorsel.mjs';
import { ORG_ID, SITE_URL, WEBSITE_ID, kisalt } from '../../lib/seo';
import { matchEntities } from '../../lib/entities';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((haber) => ({
    params: { id: haber.id },
    props: { haber, related: news.filter((h) => h !== haber && h.data.category === haber.data.category).slice(0, 3) },
  }));
}

interface Props {
  haber: Haber;
  related: Haber[];
}

const { haber, related } = Astro.props;
const { title, description, date, category, coverAlt, author, rakamlar, sirada, tablo, grafik, kaynaklar } = haber.data;
// Eski haberde kapak yok: ne resim ne og:image dosyası üretilir.
const cover = gorselVar(date) ? haber.data.cover : undefined;
const { Content } = await render(haber);
const cat = categoryOf(category);

// og:image ve JSON-LD görseli: 1200px JPEG (Google Discover en az 1200px ister).
const og = cover ? await getImage({ src: cover, width: 1200, format: 'jpeg' }) : undefined;
const ogImage = og?.src;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : new URL('/og-default.png', Astro.site).href;
const ogWidth = og ? Number(og.attributes.width) : 1200;
const ogHeight = og ? Number(og.attributes.height) : 630;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const share = encodeURIComponent(pageUrl);
const shareText = encodeURIComponent(title);
const published = date.toISOString();
// Ayrı bir güncelleme tarihi alanı yok; değiştirilme tarihi yayın tarihidir.
const modified = published;
const catUrl = `${SITE_URL}/kategori/${cat.slug}/`;

const entities = matchEntities(`${title} ${description}`);

const articleSchema: Record<string, any> = {
  '@type': 'NewsArticle',
  '@id': `${pageUrl}#article`,
  headline: kisalt(title, 110),
  description,
  image: [
    {
      '@type': 'ImageObject',
      url: ogImageUrl,
      width: ogWidth,
      height: ogHeight,
    },
  ],
  datePublished: published,
  dateModified: modified,
  author:
    !author || author === SITE.name
      ? { '@type': 'Organization', '@id': ORG_ID, name: SITE.name, url: `${SITE_URL}/` }
      : { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'NewsMediaOrganization',
    '@id': ORG_ID,
    name: SITE.name,
    url: `${SITE_URL}/`,
    publishingPrinciples: `${SITE_URL}/hakkimizda/`,
    knowsAbout: ['Finans', 'Borsa', 'Ekonomi', 'Kripto'],
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  url: pageUrl,
  articleSection: cat.name,
  inLanguage: 'tr',
  isAccessibleForFree: true,
  isPartOf: { '@id': WEBSITE_ID },
};

if (entities.length > 0) {
  articleSchema.about = entities;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    articleSchema,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Anasayfa', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: cat.name, item: catUrl },
        { '@type': 'ListItem', position: 3, name: kisalt(title, 110), item: pageUrl },
      ],
    },
  ],
};
---

<Base
  title={title}
  description={description}
  image={ogImage}
  imageWidth={ogWidth}
  imageHeight={ogHeight}
  imageAlt={coverAlt ?? title}
  type="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
    <meta property="article:modified_time" content={modified} />
    <meta property="article:section" content={categoryName(category)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="container">
    <article class="makale">
      <header class={`makale-bas ink-${cat.ink}`}>
        <h1>{title}</h1>
        <p class="makale-spot">{description}</p>
        <p class="kunye">
          <a href={`/kategori/${cat.slug}/`} class="kunye-kat">
            <svg aria-hidden="true">
              <use href={`#s-${cat.icon}`} />
            </svg>
            {cat.name}
          </a>
          <strong>{author}</strong>
          <time datetime={date.toISOString()}>{formatDate(date, true)}</time>
        </p>
      </header>

      <SentezBlok whyMatters={haber.data.why_matters} keyPoints={haber.data.key_points} description={description} />

      {
        cover && haber.data.coverSitede && (
          <figure class="makale-resim">
            <Image
              src={cover}
              alt={coverAlt ?? title}
              width={1200}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {tablo && kaynaklar[0] && <Tablo tablo={tablo} kaynak={kaynaklar[0]} tarih={date} />}
      {!tablo && grafik && kaynaklar[0] && <Grafik grafik={grafik} kaynak={kaynaklar[0]} tarih={date} />}

      <RakamSeridi rakamlar={rakamlar} sirada={sirada} />


      <aside class="tavsiye-degil" aria-label="Yasal uyarı">
        <strong>Yatırım tavsiyesi değildir.</strong> Bu yazıdaki bilgi, yorum ve rakamlar yatırım danışmanlığı kapsamında
        değildir. Yatırım kararlarınızı kendi araştırmanıza dayanarak, gerekirse yetkili kuruluşlardan destek alarak verin.
      </aside>

      <div class="paylas">
        <span>Paylaş</span>
        <a href={`https://x.com/intent/post?url=${share}&text=${shareText}`} target="_blank" rel="noopener">X</a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${share}`} target="_blank" rel="noopener">Facebook</a>
        <a href={`https://wa.me/?text=${shareText}%20${share}`} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="bolum ilgili">
          <h2 class="bolum-baslik">İlgili yazılar</h2>
          <div class="liste liste-iki">
            {related.map((h) => (
              <NewsCard haber={h} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
