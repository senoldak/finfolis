---
import { SITE, CATEGORIES, YAZAR } from '../lib/site';
import { YASAL_UYARI, YASAL_UYARI_BASLIK, YASAL_UYARI_EK } from '../lib/yasal-uyari.mjs';
import { getNews } from '../lib/news';
import { analizMi } from '../lib/yazi-turu.mjs';
import { jsonLdMetni } from '../lib/json-ld.mjs';
import Pictograms from '../components/Pictograms.astro';
import Logo from '../components/Logo.astro';
import VeriAtif from '../components/VeriAtif.astro';
import { kisalt, siteJsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  // Yalnız Google'a kapalı (googlebot meta etiketi); robots etiketi ve canonical açık kalır.
  googleNoindex?: boolean;
}

// Menülerde yalnız yazısı olan kategoriler görünür (boş kategori sayfası "henüz yazı yok" der).
const menuHaberleri = await getNews({ indeksli: true });
const doluKategoriler = new Set(menuHaberleri.map((h) => h.data.category));
// "Analiz" bağlantısı yalnız yayımlanmış en az bir analiz varken görünür.
const harAnaliz = menuHaberleri.some((h) => analizMi(h.data));
const menuKategorileri = CATEGORIES.filter((c) => doluKategoriler.has(c.slug));

const {
  title,
  description: rawDescription,
  image,
  imageWidth,
  imageHeight,
  imageAlt,
  type = 'website',
  noindex = false,
  googleNoindex = false,
} = Astro.props;
// Arama sonucunda kesilmesin diye en çok 160 karakter; boşsa site açıklaması.
const description = kisalt(rawDescription?.trim() || SITE.description, 160);
const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
// Uzun başlıklarda site adı eklenmez (Google ~60 karakterden sonrasını keser).
const fullTitle = title ? (title.length > 55 ? title : `${title} | ${SITE.name}`) : `${SITE.name} | Karmaşadan uzakta`;
const ogTitle = title ?? fullTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/og-default.png', Astro.site).href;
const ogWidth = imageWidth ?? 1200;
const ogHeight = imageHeight ?? 630;
const ogAlt = imageAlt ?? title ?? SITE.name;
const xHandle = SITE.social.x ? `@${SITE.social.x.replace(/\/+$/, '').split('/').pop()}` : undefined;
const current = Astro.url.pathname;
// Veri sayfalarına (ana sayfa hariç) atıf düğmesi.
const veriSayfasi = current.startsWith('/veri/') && current !== '/veri/';
const today = new Date().toLocaleDateString(SITE.locale, {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Istanbul',
});
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {/* Yalnız Google'a kapalı sayfa: diğer arama motorları ve yapay zekâ arama botları (ChatGPT, Perplexity, Bing) görmeye devam eder. */}
    {googleNoindex && !noindex && <meta name="googlebot" content="noindex, follow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/bricolage-latin-v1.woff2" as="font" type="font/woff2" crossorigin />
    <!-- ş, ğ, İ ve ₺ latin-ext alt kümesinde; Türkçe metinde neredeyse her satırda gerekir. -->
    <link rel="preload" href="/fonts/bricolage-latin-ext-v1.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f4f3ee" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogWidth)} />
    <meta property="og:image:height" content={String(ogHeight)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {xHandle && <meta name="twitter:site" content={xHandle} />}
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={jsonLdMetni(siteJsonLd)} />
    <!-- Cloudflare Web Analytics -->
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "3d01f5eb08d1413c9777e5cb4bf2af7e"}'></script>
    <!-- End Cloudflare Web Analytics -->
    <slot name="head" />
  </head>
  <body>
    <Pictograms />
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <header class="masthead">
      <div class="container masthead-ic">
        <div class="masthead-sol">
          <a href="/" class="wordmark" aria-label={`${SITE.name} anasayfa`}>
            <Logo class="wordmark-isaret" />
            <span class="wordmark-metin">{SITE.name}</span>
          </a>
          <span class="wordmark-ayrac" aria-hidden="true">|</span>
          <span class="wordmark-slogan">Karmaşadan uzakta.</span>
        </div>

        <nav class="nav" aria-label="Ana Menü">
          {
            menuKategorileri.map((c) => (
              <a
                href={`/kategori/${c.slug}/`}
                class={`ink-${c.ink}`}
                aria-current={current.startsWith(`/kategori/${c.slug}`) ? 'page' : undefined}
              >
                {c.name}
              </a>
            ))
          }
          {
            harAnaliz && (
              <a href="/analiz/" class="ink-black" aria-current={current.startsWith('/analiz') ? 'page' : undefined}>
                Analiz
              </a>
            )
          }
          <span class="nav-bolucu" aria-hidden="true"></span>
          <a href="/veri/" class="nav-vurgu" aria-current={current.startsWith('/veri') ? 'page' : undefined}>
            Veriler
          </a>
          <a href="/hesapla/" class="nav-ikincil" aria-current={current.startsWith('/hesapla') ? 'page' : undefined}>
            Hesapla
          </a>
          <a href="/sozluk/" class="nav-ikincil" aria-current={current.startsWith('/sozluk') ? 'page' : undefined}>
            Sözlük
          </a>
        </nav>

        <div class="masthead-sag">
          <p class="masthead-tarih">{today}</p>
          <a href="/arama/" class="masthead-ara" aria-current={current.startsWith('/arama') ? 'page' : undefined}>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            Ara
          </a>
        </div>
      </div>
    </header>

    <main id="icerik">
      <slot />
      {veriSayfasi && <VeriAtif />}
    </main>

    <footer class="site-footer">
      <div class="container footer-izgara">
        <!-- 1. Sütun: Marka & Künye -->
        <div class="footer-kolon footer-marka-kolon">
          <a href="/" class="wordmark wordmark-sm">
            <Logo class="wordmark-isaret" />
            <span>{SITE.name}</span>
          </a>
          <p class="footer-slogan">Karmaşadan uzakta.</p>
          <p class="footer-tanim">
            Finansal piyasaların karmaşıklığını çözen, yatırım kararlarını veriye dayalı içgörülerle güçlendiren bağımsız analiz platformu.
          </p>
          <dl class="footer-kunye">
            <div>
              <dt>Yayın Yönetmeni ve Editör</dt>
              <dd><a href={YAZAR.yol}>{YAZAR.ad}</a></dd>
            </div>
          </dl>
          <div class="footer-sosyal">
            {SITE.social.telegram && <a href={SITE.social.telegram} rel="noopener" target="_blank" aria-label="Telegram kanalı">Telegram</a>}
            {SITE.social.linkedin && <a href={SITE.social.linkedin} rel="noopener noreferrer" target="_blank" aria-label="LinkedIn">LinkedIn</a>}
            {SITE.social.x && <a href={SITE.social.x} rel="noopener noreferrer" target="_blank" aria-label="X">X</a>}
            <a href="/rss.xml">RSS</a>
          </div>
        </div>

        <!-- 2. Sütun: Yayınlar & Analiz -->
        <div class="footer-kolon">
          <h2 class="footer-baslik">Yayınlar & Analiz</h2>
          <nav class="footer-liste" aria-label="Yayınlar">
            {menuKategorileri.map((c) => <a href={`/kategori/${c.slug}/`}>{c.name}</a>)}
            {harAnaliz && <a href="/analiz/"><strong>Analiz Dosyaları</strong></a>}
            <a href="/konu/">Konular Dizini</a>
            <a href="/arsiv/">Haber Arşivi</a>
            <a href={YAZAR.yol}>Yazar Sayfası</a>
          </nav>
        </div>

        <!-- 3. Sütun: Veriler & Araçlar -->
        <div class="footer-kolon">
          <h2 class="footer-baslik">Veri & Araçlar</h2>
          <nav class="footer-liste" aria-label="Veriler ve Araçlar">
            <a href="/veri/makro-soklar/"><strong>Makro Şoklar & Borsa</strong></a>
            <a href="/veri/bist-100-tufe/">BİST 100 / TÜFE (Reel Borsa)</a>
            <a href="/veri/reel-bist-30/">TÜFE'den Arındırılmış BİST 30</a>
            <a href="/veri/politika-faizi/">Politika Faizi (TCMB)</a>
            <a href="/veri/enflasyon/">Yıllık Enflasyon (TÜİK)</a>
            <a href="/veri/doviz-kurlari/">Döviz Kurları</a>
            <a href="/veri/">Tüm Veri Sayfaları</a>
            <a href="/hesapla/">Hesaplayıcılar</a>
            <a href="/sozluk/">Finans Sözlüğü</a>
          </nav>
        </div>

        <!-- 4. Sütun: Kurumsal & İlkeler -->
        <div class="footer-kolon">
          <h2 class="footer-baslik">Kurumsal & İlkeler</h2>
          <nav class="footer-liste" aria-label="Kurumsal">
            <a href="/hakkimizda/">Hakkımızda</a>
            <a href="/yayin-ilkeleri/">Yayın İlkeleri</a>
            <a href="/standartlar-raporu/">Standartlar Raporu</a>
            <a href="/seffaflik/">Şeffaflık</a>
            <a href="/yapay-zeka-kullanimi/">Yapay Zekâ Kullanımı</a>
            <a href="/duzeltme-politikasi/">Düzeltme Politikası</a>
            <a href="/duzeltmeler/">Düzeltmeler</a>
            <a href="/sikayet/">Şikâyet Bildirimi</a>
            <a href="/yasal/">Yasal Bilgilendirme</a>
            <a href="/gizlilik/">Gizlilik Politikası</a>
          </nav>
        </div>
      </div>

      <!-- Boncuk Okuma Notu -->
      <div class="container footer-boncuk-notu">
        <p>
          <span class="boncuk-isaret" aria-hidden="true">●</span>
          <strong>Boncuklar nasıl okunur?</strong> Rakamları abaküs boncuklarıyla gösteriyoruz. Her boncuk, yanındaki açıklamada yazan miktara eşittir; miktar arttıkça boncuk büyümez, sayısı artar. Her tel on boncuktur. Gri boncuklar karşılaştırma içindir.
        </p>
      </div>

      <div class="container footer-alt">
        <p class="uyari">
          <strong>{YASAL_UYARI_BASLIK}:</strong> {YASAL_UYARI} {YASAL_UYARI_EK}
        </p>
        <p>
          İçerik <a href="https://creativecommons.org/licenses/by-nc/4.0/deed.tr" rel="license noopener">CC BY-NC 4.0</a>: {SITE.name} kaynak gösterilerek ticari olmayan amaçlarla serbestçe kullanılabilir.
        </p>
        <p>© {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
